---
import SeoHead from '../components/shared/SeoHead.astro';
import type { Lang } from '../i18n';
import MateGame from '../components/games/MateGame.astro';
import SiteHeader from '../components/shared/SiteHeader.astro';
import SiteFooter from '../components/shared/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
  lang: Lang;
  backUrl: string;
  backText: string;
  accentColor?: 'turquesa' | 'dorado';
}

const {
  title,
  description = '',
  lang,
  backUrl,
  backText,
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL;
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
    <link rel="icon" href={`${baseUrl}favicon.ico`} />
    <title>{title}</title>
    <SeoHead title={title} description={description} lang={lang === 'en' ? 'en' : 'es'} canonical={new URL(Astro.url.pathname, Astro.site).toString()} />
  </head>
  <body class="bg-white dark:bg-slate-900 text-[#082D3A] dark:text-slate-100 transition-colors">
    <SiteHeader current="portfolio" lang={lang === 'en' ? 'en' : 'es'} />

    <!-- Main Content -->
    <main class="max-w-4xl mx-auto px-6 pt-8 pb-16">
      <a
        id="backLink"
        href={backUrl}
        class="inline-block mb-8 text-sm text-slate-600 dark:text-slate-400 hover:text-[#16B6C9] dark:hover:text-[#7DE3FF] transition"
      >
        {backText}
      </a>
      <slot />
    </main>

    <SiteFooter lang={lang === 'en' ? 'en' : 'es'} />

    <!-- Game Tab -->
    <button
      id="gameTabBtn"
      class="fixed bottom-0 right-6 bg-[#0A1E28] hover:bg-[#082D3A] text-white px-3 py-1.5 rounded-t-lg shadow-md transition-transform duration-300 ease-out hover:-translate-y-0.5 text-lg z-40 cursor-pointer border-none"
      title="Jugar Mate Run"
    >
      🧉
    </button>

    <!-- Mate Game Modal -->
    <MateGame />

  </body>
</html>
