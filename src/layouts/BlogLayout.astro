---
import SeoHead from "../components/shared/SeoHead.astro";
import { getBlogPosts, normalizeBaseUrl } from "../utils/blog";
import { SITE_CONFIG } from "../data/config";
import SiteHeader from "../components/shared/SiteHeader.astro";
import SiteFooter from "../components/shared/SiteFooter.astro";
import "../styles/brand.css";
import "../styles/personal-skin.css";
import { getSettings } from "../utils/portal-data";
import { getRecursos } from "../utils/recursos";

interface Props {
  title: string;
  description?: string;
  seo?: boolean;
  blogTitle?: string;
  blogSubtitle?: string;
  lang?: string;
  titleAsH1?: boolean;
  // false en paginas de lectura (articulo, privacidad): sin titulo, pestanas ni barra lateral
  listing?: boolean;
  active?: 'articulos' | 'zona-lab';
}

const {
  title,
  description,
  seo = true,
  blogTitle = SITE_CONFIG.blogName,
  blogSubtitle = "Artículos y pensamientos",
  lang = "es",
  titleAsH1 = false,
  listing = true,
  active = 'articulos',
} = Astro.props;
const showLab = (await getSettings()).sections.recursos;
const TitleTag = titleAsH1 ? "h1" : "div";
const normalizedBase = normalizeBaseUrl(import.meta.env.BASE_URL);

// Get all categories dynamically from posts
const posts = await getBlogPosts();
const allCategories = Array.from(
  new Set(posts.flatMap((post) => post.categories)),
).sort();
const isLab = active === 'zona-lab';
const recursos = isLab ? await getRecursos() : [];
const items: { year: number; cats: string[] }[] = isLab
  ? recursos.map((r) => ({ year: r.createdAt.getFullYear(), cats: r.categories }))
  : posts.map((post) => ({ year: post.pubDate.getFullYear(), cats: post.categories }));
const byYear = new Map<number, number>();
for (const it of items) byYear.set(it.year, (byYear.get(it.year) ?? 0) + 1);
const years = [...byYear.entries()].sort((a, b) => b[0] - a[0]);
const sideCategories = Array.from(new Set(items.flatMap((it) => it.cats))).sort();
const slugOf = (c: string) => c.toLowerCase().replace(/\s+/g, "-");
const showAside = listing;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description || title} />
    <link
      rel="icon"
      type="image/svg+xml"
      href={`${normalizedBase}favicon-mauricio.svg`}
    />
    <title>{title}</title>
    {seo && <SeoHead title={title} description={description || title} lang="es" canonical={new URL(Astro.url.pathname, Astro.site).toString()} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600;700&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body
    class="pt-skin min-h-screen flex flex-col bg-white text-vcl-petroleo antialiased"
    style="font-family: 'Montserrat', -apple-system, BlinkMacSystemFont, sans-serif; font-size: 18px; line-height: 27px;"
  >
    <div class="site-container min-h-screen flex flex-col">
      <SiteHeader current="blog" lang="es" />

      <!-- Main -->
      <div class="site-inner flex-1 py-10">
        <div class="content-sidebar-wrap max-w-[1140px] mx-auto px-5">
          {listing && (
            <div class="blog-top">
              <TitleTag class="blog-name"><a href={`${normalizedBase}blog/`}>{blogTitle} <small>(Blog)</small></a></TitleTag>
              <p class="blog-tagline">{blogSubtitle}</p>
              {showLab && (
                <nav class="blog-tabs2" aria-label="Secciones del blog">
                  <a href={`${normalizedBase}blog/`} aria-current={active === 'articulos' ? 'page' : undefined}>Artículos</a>
                  <a href={`${normalizedBase}zona-lab/`} aria-current={active === 'zona-lab' ? 'page' : undefined}>Zona Lab</a>
                </nav>
              )}
            </div>
          )}
          <div class:list={['blog-grid', showAside && 'blog-grid--aside']}>
            <main class="content blog-main">
              <slot />
            </main>
            {showAside && (
              <aside class="blog-aside" aria-label="Buscar y filtrar" data-mode={isLab ? 'lab' : 'posts'}>
                <details class="blog-aside-box" open>
                  <summary>Buscar y filtrar</summary>
                  <form class="blog-aside-search" role="search" action={isLab ? undefined : `${normalizedBase}blog/search/`} method="get" data-lab-form={isLab ? '' : undefined}>
                    <label class="sr-only" for="blog-q">{isLab ? 'Buscar recursos' : 'Buscar artículos'}</label>
                    <input id="blog-q" name="q" type="search" placeholder={isLab ? 'Buscar recursos…' : 'Buscar artículos…'} autocomplete="off" />
                  </form>
                  {sideCategories.length > 0 && (
                    <label class="blog-aside-field">
                      <span>Etiqueta</span>
                      <select id="blog-tags-select" data-base={`${normalizedBase}blog/category/`}>
                        <option value="">Todas</option>
                        {sideCategories.map((c) => (
                          <option value={isLab ? c : slugOf(c)} selected={!isLab && Astro.url.pathname === `${normalizedBase}blog/category/${slugOf(c)}/`}>{c}</option>
                        ))}
                      </select>
                    </label>
                  )}
                  {years.length > 0 && (
                    <div class="blog-aside-years">
                      <span>{isLab ? 'Año' : 'Archivo'}</span>
                      <ul>
                        {years.map(([y, n]) => (
                          <li>
                            {isLab
                              ? <button type="button" data-year={y}>{y} <small>({n})</small></button>
                              : <a href={`${normalizedBase}blog/archives/#year-${y}`}>{y} <small>({n})</small></a>}
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}
                </details>
              </aside>
            )}
          </div>
        </div>
      </div>

      <SiteFooter lang="es" />
    </div>

    <script is:inline>
      (function () {
        var aside = document.querySelector('.blog-aside');
        var sel = document.getElementById('blog-tags-select');
        if (!aside || !sel) return;
        if (aside.dataset.mode !== 'lab') {
          sel.addEventListener('change', function () { if (sel.value) location.href = sel.dataset.base + sel.value + '/'; });
          return;
        }
        var input = document.getElementById('blog-q');
        var cards = [].slice.call(document.querySelectorAll('[data-lab-item]'));
        var empty = document.getElementById('lab-empty');
        var year = '';
        var yearBtns = [].slice.call(aside.querySelectorAll('[data-year]'));
        function apply() {
          var q = (input.value || '').toLowerCase().trim();
          var cat = sel.value;
          var shown = 0;
          cards.forEach(function (c) {
            var ok = (!q || c.dataset.text.indexOf(q) > -1) &&
                     (!cat || c.dataset.cats.split('|').indexOf(cat) > -1) &&
                     (!year || c.dataset.year === year);
            c.style.display = ok ? '' : 'none';
            if (ok) shown++;
          });
          if (empty) empty.style.display = shown ? 'none' : '';
          yearBtns.forEach(function (b) { b.setAttribute('aria-pressed', b.dataset.year === year ? 'true' : 'false'); });
        }
        input.addEventListener('input', apply);
        input.form.addEventListener('submit', function (e) { e.preventDefault(); });
        sel.addEventListener('change', apply);
        yearBtns.forEach(function (b) {
          b.addEventListener('click', function () { year = year === b.dataset.year ? '' : b.dataset.year; apply(); });
        });
      })();
    </script>

    <style is:global>
      /* ==========================================
         RESET
         ========================================== */
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      img {
        max-width: 100%;
        height: auto;
      }

      /* ==========================================
         ENTRY / ARTICLE - Shared styles
         (Used in both PostCard and [slug] pages)
         ========================================== */
      .entry-title {
        font-size: 26px;
        font-weight: 600;
        line-height: 1.2;
        margin-bottom: 20px;
        color: #082d3a;
      }

      .entry-title a {
        color: #082d3a;
      }

      .entry-title a:hover {
        color: #16b6c9;
      }

      /* Entry Meta */
      .entry-meta {
        font-size: 14px;
        font-weight: 400;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: #8b94ab;
      }

      .entry-meta .by {
        font-style: italic;
        text-transform: lowercase;
      }

      .entry-meta .entry-author-name {
        font-weight: 400;
        text-transform: uppercase;
      }

      .entry-meta a {
        color: #5c6785;
        text-decoration: underline;
      }

      .entry-meta a:hover {
        color: #16b6c9;
      }

      /* ==========================================
         ENTRY CONTENT
         Font: 18px, line-height 27px
         Paragraph margin: 28px
         ========================================== */
      .entry-content {
        font-size: 18px;
        line-height: 27px;
        color: #082d3a;
      }

      .entry-content p {
        margin-bottom: 28px;
      }

      .entry-content a {
        color: #16b6c9;
        text-decoration: underline;
        text-underline-offset: 2px;
      }

      .entry-content a:hover {
        color: #082d3a;
      }

      .entry-content h2 {
        font-size: 24px;
        font-weight: 700;
        line-height: 1.2;
        margin: 40px 0 20px;
        color: #082d3a;
      }

      .entry-content h3 {
        font-size: 22px;
        font-weight: 700;
        line-height: 1.2;
        margin: 0 0 20px;
        color: #082d3a;
      }

      .entry-content h4 {
        font-size: 20px;
        font-weight: 600;
        line-height: 1.2;
        margin: 30px 0 15px;
        color: #082d3a;
      }

      .entry-content strong {
        font-weight: 700;
      }

      .entry-content em {
        font-style: italic;
      }

      .entry-content ul,
      .entry-content ol {
        margin: 0 0 28px 30px;
      }

      .entry-content li {
        margin-bottom: 8px;
      }

      .entry-content blockquote {
        margin: 28px 0;
        padding-left: 20px;
        border-left: 3px solid #16b6c9;
        font-style: italic;
        color: #5c6785;
      }

      .entry-content figure {
        margin: 28px 0;
      }

      .entry-content img {
        display: block;
        margin-left: auto;
        margin-right: auto;
        max-width: 100%;
        height: auto;
      }

      .entry-content figcaption {
        margin-top: 10px;
        font-size: 14px;
        font-style: italic;
        text-align: center;
        color: #8b94ab;
      }

      /* Code */
      .entry-content pre {
        margin: 28px 0;
        padding: 20px;
        background: #1a1a1a;
        color: #f5f5f5;
        border-radius: 4px;
        overflow-x: auto;
        font-size: 14px;
        line-height: 1.5;
      }

      .entry-content code {
        font-family: Consolas, Monaco, "Courier New", monospace;
        font-size: 0.9em;
        background: #e6fafc;
        color: #082d3a;
        padding: 2px 5px;
        border-radius: 3px;
      }

      .entry-content pre code {
        background: transparent;
        color: inherit;
        padding: 0;
      }

      /* ==========================================
         FEATURED IMAGE
         ========================================== */
      .wp-block-image {
        margin-bottom: 28px;
      }

      /* Herramientas del blog: una sola fila fina sobre la lista, sin título ni bandas */
      /* Estructura del blog: titulo + pestanas Articulos | Zona Lab, y barra lateral con busqueda/etiqueta/archivo */
      .blog-top { margin-bottom: 28px; border-bottom: 1px solid #e4e8f0; }
      .blog-name { margin: 0; font-family: Raleway, Montserrat, system-ui, sans-serif; font-size: clamp(1.8rem, 5vw, 2.4rem); font-weight: 300; line-height: 1.1; color: #082d3a; }
      .blog-name a { color: inherit; text-decoration: none; }
      .blog-name small { font-size: .45em; font-weight: 400; color: #5c6785; }
      .blog-tagline { margin: 6px 0 14px; font-size: .95rem; font-style: italic; color: #5c6785; }
      .blog-tabs2 { display: flex; gap: 28px; }
      .blog-tabs2 a { padding: 8px 0; font-family: Raleway, Montserrat, system-ui, sans-serif; font-size: 16.67px; font-weight: 700; color: #5c6785; text-decoration: none; border-bottom: 3px solid transparent; margin-bottom: -1px; }
      .blog-tabs2 a:hover { color: #082d3a; }
      .blog-tabs2 a[aria-current="page"] { color: #082d3a; border-bottom-color: #16b6c9; }
      .blog-grid { display: block; }
      .blog-main { width: 100%; max-width: 820px; margin: 0; }
      @media (min-width: 960px) {
        .blog-grid--aside { display: grid; grid-template-columns: minmax(0, 1fr) 250px; gap: 48px; align-items: start; }
        .blog-grid--aside .blog-main { max-width: none; }
        .blog-aside { position: sticky; top: 24px; margin-top: 0; }
        .blog-aside-box > summary { pointer-events: none; }
      }
      .blog-aside { margin-top: 24px; font-size: 14px; }
      .blog-aside-box > summary { font: 600 12px/1 Montserrat, system-ui, sans-serif; letter-spacing: .1em; text-transform: uppercase; color: #5c6785; cursor: pointer; padding: 0 0 12px; list-style: none; }
      .blog-aside-box > summary::-webkit-details-marker { display: none; }
      .blog-aside-search input { width: 100%; border: 1px solid #b9c4d6; border-radius: 0; background: #fff; padding: 9px 10px; font: 300 14px Montserrat, system-ui, sans-serif; color: #082d3a; outline: 0; }
      .blog-aside-search input:focus { border-color: #16b6c9; }
      .blog-aside-field { display: block; margin-top: 18px; }
      .blog-aside-field span, .blog-aside-years span { display: block; margin-bottom: 6px; font: 600 12px/1 Montserrat, system-ui, sans-serif; letter-spacing: .1em; text-transform: uppercase; color: #5c6785; }
      .blog-aside-field select { width: 100%; border: 1px solid #b9c4d6; border-radius: 0; background: #fff; padding: 9px 10px; font: 300 14px Montserrat, system-ui, sans-serif; color: #082d3a; cursor: pointer; }
      .blog-aside-years { margin-top: 22px; }
      .blog-aside-years ul { margin: 0; padding: 0; list-style: none; }
      .blog-aside-years a { display: flex; justify-content: space-between; padding: 6px 0; border-bottom: 1px solid #eef1f6; color: #082d3a; text-decoration: none; }
      .blog-aside-years a:hover, .blog-aside-years button:hover { color: #0b6e7d; }
      .blog-aside-years button { width: 100%; display: flex; justify-content: space-between; padding: 6px 0; border: 0; border-bottom: 1px solid #eef1f6; background: transparent; color: #082d3a; font: inherit; cursor: pointer; text-align: left; }
      .blog-aside-years button[aria-pressed="true"] { color: #0b6e7d; font-weight: 600; }
      .blog-aside-years small { color: #8b94ab; font-size: 12px; }
      .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

      /* ==========================================
         NAVIGATION
         ========================================== */
      .nav-primary .menu li a {
        transition: color 0.15s ease;
      }

      /* Primary: Blog */
      .nav-primary .menu-primary {
        color: #16b6c9;
        font-weight: 700;
      }
      .nav-primary .menu-primary:hover {
        text-decoration: underline;
        text-underline-offset: 4px;
      }

      /* Meta: Acerca de */
      .nav-primary .menu-meta {
        font-style: italic;
        opacity: 0.85;
      }

      /* Tags: pill with # prefix */
      .nav-primary .menu-tag {
        display: inline-flex;
        align-items: center;
        padding: 6px 11px;
        margin: 6px 0;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: #5c6785;
        background: #f4f6fa;
        border: 1px solid #e4e8f0;
        border-radius: 999px;
        text-decoration: none;
        transition: all 0.15s ease;
      }
      .nav-primary .menu-tag::before {
        content: "#";
        opacity: 0.55;
        margin-right: 4px;
      }
      .nav-primary .menu-tag:hover {
        background: #e6fafc;
        border-color: #16b6c9;
        color: #082d3a;
      }
      .nav-primary .menu-tag[aria-current="page"] {
        background: #e6fafc;
        border-color: #16b6c9;
        color: #082d3a;
      }

      /* Divider between groups */
      .nav-primary .menu-divider {
        width: 1px;
        align-self: stretch;
        background: #e4e8f0;
        margin: 12px 6px;
        list-style: none;
      }
      @media (max-width: 640px) {
        .nav-primary .menu-divider {
          display: none;
        }
      }

      /* ==========================================
         RESPONSIVE
         ========================================== */
      @media (max-width: 640px) {
        body {
          font-size: 16px;
          line-height: 24px;
        }

        .entry-title {
          font-size: 22px;
        }

        .entry-content {
          font-size: 16px;
          line-height: 24px;
        }

        .entry-content p {
          margin-bottom: 24px;
        }

        .entry-content h3 {
          font-size: 20px;
        }
      }
    </style>
  </body>
</html>
