---
import SiteHeader from '../components/shared/SiteHeader.astro';
import SiteFooter from '../components/shared/SiteFooter.astro';
import SeoHead from '../components/shared/SeoHead.astro';
import MateGame from '../components/games/MateGame.astro';
import PromptModal from '../components/shared/PromptModal.astro';
import type { LayoutType } from '../data/layout-features';
import { getLayoutFeatures } from '../data/layout-features';
import { isCompanyBuild } from '../data/site-target';
import { getSiteNav } from '../data/site-nav';
import '../styles/brand.css';

interface Props {
	title?: string;
	description?: string;
	lang?: string;
	layoutType?: LayoutType;
	// Override individual features if needed
	showHeader?: boolean;
	showFooter?: boolean;
	showMateGame?: boolean;
	showPromptModal?: boolean;
	noindex?: boolean;
	// Ítem marcado como actual en el menú del shell y destino del selector ES/EN
	current?: string;
	altHref?: string;
	// URL canónica (por defecto, la de la página actual en el dominio del build)
	canonical?: string;
}

const {
	title = getSiteNav().brand.name,
	description = getSiteNav().brand.name,
	lang = "es",
	layoutType = 'public',
	showHeader: showHeaderOverride,
	showFooter: showFooterOverride,
	showMateGame: showMateGameOverride,
	showPromptModal = false,
	noindex = false,
	current,
	altHref,
	canonical,
} = Astro.props;

// Get features from config, allow overrides
const features = getLayoutFeatures(layoutType);
const showHeader = showHeaderOverride ?? features.showMainHeader;
const showFooter = showFooterOverride ?? features.showMainFooter;
const showMateGame = !isCompanyBuild && (showMateGameOverride ?? features.showMateGame);

const baseUrl = import.meta.env.BASE_URL;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).toString();
---

<!DOCTYPE html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
		<link rel="icon" href={`${baseUrl}favicon.ico`} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600;700&display=swap" rel="stylesheet" />
		<title>{title}</title>
		{!noindex && <SeoHead title={title} description={description} lang={lang === 'en' ? 'en' : 'es'} canonical={canonicalUrl} />}
		<slot name="head" />
	</head>
	<body class="min-h-screen flex flex-col p-0 bg-white text-vcl-petroleo font-vclBody font-light">
		{showHeader && <SiteHeader current={current} lang={lang === 'en' ? 'en' : 'es'} altHref={altHref} />}

		<!-- Main Content -->
		<main class="flex-1">
			<slot />
		</main>

		{showFooter && <SiteFooter lang={lang === 'en' ? 'en' : 'es'} />}

		{showMateGame && (
			<>
				<!-- Game Tab -->
				<button 
					id="gameTabBtn"
					class="fixed bottom-0 right-6 bg-black hover:bg-gray-900 text-white px-3 py-1.5 rounded-t-lg shadow-md transition-transform duration-300 ease-out hover:-translate-y-0.5 text-lg z-40 cursor-pointer border-none"
					title="Jugar Mate Run"
				>
					🧉
				</button>

				<!-- Mate Game Modal -->
				<MateGame />
			</>
		)}

		{showPromptModal && <PromptModal />}
	</body>
</html>
