---
import { BRAND_NAME } from '../data/brand';
import { homeHref } from '../data/site-target';
const baseUrl = import.meta.env.BASE_URL;
const brandHref = homeHref();
---

<header class="top-0 left-0 right-0 z-50">
    <div class="px-8 bg-vcl-navy">
        <a
            href={brandHref}
            class="inline-flex items-center gap-2 py-2 text-vcl-cian hover:text-white transition-colors duration-500"
        >
            <img src={`${baseUrl}logo-vl-icon.svg`} alt="" class="h-5 w-5" />
            <span class="font-vclHead font-semibold text-xs tracking-[0.3em]">{BRAND_NAME}</span>
        </a>
    </div>
</header>