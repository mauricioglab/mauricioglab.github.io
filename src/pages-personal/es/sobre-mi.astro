---
import { Image } from 'astro:assets';
import BaseTailwind from '@layouts/BaseTailwind.astro';
import SocialLinks from '@components/shared/SocialLinks.astro';
import { c, md } from '@utils/content';
import { getGallery } from '@utils/portal-data';
import { SITE_CONFIG } from '@data/config';
import oficina from '../../assets/mauricio/retrato-oficina.png';

export const prerender = true;

const gallery = await getGallery();
const mosaic = [1, 2, 3].map((n) => gallery.get(`mosaico-${n}`)!);
const trail = Array.from({ length: 10 }, (_, i) => gallery.get(`trayectoria-${i + 1}`)!);
const pageTitle = await c('sobre-mi', 'page_title');
const subtitle = await c('sobre-mi', 'subtitle');
const bio = await Promise.all([1, 2, 3, 4].map((n) => c('sobre-mi', `bio_p${n}`)));

---

<BaseTailwind
  title="Sobre mí | Mauricio González"
  description="Trayectoria de Mauricio González como docente y desarrollador: desarrollo de software, ciencia de datos e inteligencia artificial aplicada."
  current="sobre-mi"
  showMateGame={false}
>
  <div class="pt">
    <h1 class="pt-page-title">{pageTitle}</h1>

    <section class="pt-about" aria-labelledby="profesion">
      <div class="pt-about-portrait">
        <Image src={oficina} alt="Mauricio González sonriendo en su escritorio, con libros de inteligencia artificial y desarrollo de software" widths={[640, 900, 1199]} sizes="(max-width: 899px) 100vw, 640px" format="webp" loading="eager" fetchpriority="high" style="object-position: 45% 25%" />
      </div>
      <div class="pt-about-bio">
        <h2 id="profesion">{subtitle}</h2>
        {bio.map((p) => <p set:html={md(p)} />)}
        <p>Podés ver mis <a class="pt-link-gold" href="/es/portfolio/">proyectos</a> y <a class="pt-link-gold" href="/es/disertaciones/">charlas</a>, o leer el <a class="pt-link-gold" href="/blog/">blog</a>.</p>
        <nav class="pt-social pt-social-inline" aria-label="Redes sociales"><SocialLinks /></nav>
        <div class="pt-about-links">
          <a class="pt-button pt-button-cv" href="/es/contacto/">Contáctame</a>
        </div>
      </div>
    </section>

    <div class="pt-mosaic" aria-label="Mosaico de fotos">
      {mosaic.map((m) => (
        <figure>
          {m.image_url ? <img src={m.image_url} alt={m.alt} loading="lazy" /> : <div class="pt-ph">Foto pendiente</div>}
        </figure>
      ))}
    </div>

    <div class="pt-trail" aria-label="Trayectoria">
      {trail.map((t, i) => (
        <figure class:list={{ 'pt-trail-wide': i >= 8 }}>
          <div class="pt-trail-img">{t.image_url ? <img src={t.image_url} alt={t.alt} loading="lazy" /> : <div class="pt-ph">Foto pendiente</div>}</div>
          <figcaption>{t.caption}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</BaseTailwind>
