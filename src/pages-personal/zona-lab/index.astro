---
import BlogLayout from '../../layouts/BlogLayout.astro';
import RecursoCard from '../../components/recursos/RecursoCard.astro';
import { getRecursos } from '../../utils/recursos';
import { getSiteNav } from '../../data/site-nav';

export const prerender = true;

const SITE_NAME = getSiteNav().brand.name;
const recursos = await getRecursos();
---

<BlogLayout
  title={`Zona Lab | ${SITE_NAME}`}
  description="Recursos de estudio para alumnos: videos y reportes con su resumen."
  active="zona-lab"
>
  {recursos.length === 0 ? (
    <p class="text-center text-[#5c6785]">Todavía no hay recursos publicados.</p>
  ) : (
    <div class="grid gap-6 sm:grid-cols-2">
      {recursos.map((r) => (
        <div
          data-lab-item
          data-text={`${r.title} ${r.description ?? ''} ${r.categories.join(' ')}`.toLowerCase()}
          data-cats={r.categories.join('|')}
          data-year={String(r.createdAt.getFullYear())}
        >
          <RecursoCard recurso={r} />
        </div>
      ))}
    </div>
    <p id="lab-empty" class="text-center text-[#5c6785]" style="display:none">No hay recursos que coincidan.</p>
  )}
</BlogLayout>

<style is:global>
  .rc-card.reveal { opacity: 1; transform: none; }
</style>
