---
import BlogLayout from '../../layouts/BlogLayout.astro';
import { getBlogPosts, normalizeBaseUrl } from '../../utils/blog';
import { SITE_CONFIG } from '../../data/config';
import PostCard from '../../components/blog/PostCard.astro';

export const prerender = true;

const posts = await getBlogPosts();
const normalizedBase = normalizeBaseUrl(import.meta.env.BASE_URL);
---

<BlogLayout 
  title={`${SITE_CONFIG.blogName} | ${SITE_CONFIG.siteName}`}
  description="Artículos y reflexiones sobre inteligencia artificial, tecnología, filosofía y libros."
  blogSubtitle="Artículos y pensamientos"
  active="articulos"
>
  {posts.length === 0 ? (
    <p class="text-center text-[#5c6785]">No hay posts disponibles.</p>
  ) : (
    <div role="list">
      {posts.map((post, i) => (
        <PostCard post={post} featured={i === 0} />
      ))}
    </div>
  )}
</BlogLayout>
