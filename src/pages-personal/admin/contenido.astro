---
import BaseTailwind from '../../layouts/BaseTailwind.astro';
import AbmPanel from '../../components/admin/AbmPanel';
import { RESOURCES } from '../../data/admin-resources';
import { SITE_CONFIG } from '../../data/config';
import '../../styles/admin.css';

export const prerender = true;
---

<BaseTailwind
  title="Contenido del sitio"
  description="Textos, proyectos, galería, menú y CV del sitio"
  lang="es"
  layoutType="admin"
  showMateGame={false}
  noindex
>
  <div class="pt">
    <h1 class="pt-page-title">Contenido del sitio</h1>
    <div class="pt-folio">
      <AbmPanel client:load siteId={SITE_CONFIG.siteId} siteName={SITE_CONFIG.author} resources={RESOURCES} />
    </div>
  </div>
</BaseTailwind>
