---
import WizardModal from './shared/WizardModal.astro';
---
<div x-data="recursosAdmin" x-init="init(); $watch(() => user, (u) => { if (u && userRole === 'admin') loadRecursos(); else recursos = []; })" class="max-w-4xl mx-auto p-4 md:p-6">
  <!-- Header -->
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold">📚 Zona Lab</h1>
    <div class="flex items-center gap-3">
      <a :href="`${window.__RECURSOS_BASE__}zona-lab/`" class="text-sm text-slate-400 hover:text-white">Ver sitio →</a>
      <button @click="abrirWizardNuevo()" class="px-4 py-2 bg-indigo-700 hover:bg-indigo-800 text-white text-sm font-bold rounded-lg">+ Nuevo recurso</button>
    </div>
  </div>

  <!-- Actividad reciente -->
  <div x-show="opHistory.length" class="mb-4">
    <details class="group text-xs bg-slate-800 rounded-xl p-3">
      <summary class="text-slate-400 hover:text-slate-200 cursor-pointer select-none font-bold">
        Actividad reciente (<span x-text="opHistory.length"></span>)
      </summary>
      <div class="mt-1.5 space-y-1">
        <template x-for="h in opHistory" :key="h.ts">
          <div class="flex items-start gap-2" :class="h.ok ? 'text-slate-400' : 'text-red-400'">
            <span x-text="h.ok ? '✓' : '✗'"></span>
            <span class="font-bold" x-text="h.label"></span>
            <span class="font-mono" x-text="h.elapsed"></span>
            <span class="truncate" x-text="h.result"></span>
          </div>
        </template>
      </div>
    </details>
  </div>

  <!-- Lista -->
  <div class="bg-slate-800 rounded-xl p-5">
    <h2 class="text-base font-bold mb-3">Recursos existentes</h2>
    <div x-show="!recursos.length" class="text-sm text-slate-400">Sin recursos todavía.</div>
    <div class="space-y-2">
      <template x-for="p in recursos" :key="p.id">
        <div class="bg-slate-900 border border-slate-700 rounded-lg p-3">
          <div class="flex items-start justify-between gap-2">
            <p class="text-sm font-bold" x-text="p.title"></p>
            <span class="text-[10px] px-2 py-0.5 rounded-full shrink-0" :class="p.draft ? 'bg-yellow-500/20 text-yellow-400' : 'bg-green-500/20 text-green-400'" x-text="p.draft ? 'borrador' : 'publicado'"></span>
          </div>
          <p class="text-xs text-slate-400 mt-1" x-text="p.source_type === 'youtube' ? '🎬 ' : '🌐 ' + new Date(p.created_at).toLocaleDateString('es-ES')"></p>
          <div class="flex gap-2 mt-2 text-xs">
            <button @click="cargarRecurso(p)" class="text-indigo-400 hover:text-indigo-300 font-bold">Editar</button>
            <button @click="toggleDraft(p)" class="text-slate-400 hover:text-white font-bold" x-text="p.draft ? 'Publicar' : 'A borrador'"></button>
            <button @click="borrarRecurso(p)" class="text-red-400 hover:text-red-300 font-bold">Eliminar</button>
          </div>
        </div>
      </template>
    </div>
  </div>

  <!-- ===== Asistente ===== -->
  <WizardModal steps={["Link + frase", "Revisar y publicar"]} newLabel="Nuevo recurso" editLabel="Editar recurso">
    <!-- Paso 1: Link + frase -->
    <div x-show="wizardStep === 1" class="space-y-3">
      <h3 class="text-sm font-bold text-slate-200">Link + frase → recurso</h3>
      <div>
        <label class="block text-xs font-bold text-slate-300 mb-1">Link de YouTube o reporte *</label>
        <input x-model="url" type="url" placeholder="https://www.youtube.com/watch?v=... o https://..." class="w-full px-3 py-2 bg-slate-900 border border-slate-600 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-600">
      </div>
      <div>
        <label class="block text-xs font-bold text-slate-300 mb-1">Frase / idea semilla * <span class="font-normal text-slate-500">(la IA la mejora)</span></label>
        <textarea x-model="frase" rows="4" class="w-full px-3 py-2 bg-slate-900 border border-slate-600 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-600" placeholder="Ej: 'Esto explica por qué no conviene usar la misma contraseña en todos lados y cómo se roban las cuentas'"></textarea>
      </div>
      <div class="flex justify-end">
        <button @click="generar()" :disabled="busy || !url || !frase" class="px-4 py-2 bg-indigo-700 hover:bg-indigo-800 disabled:opacity-60 text-sm font-bold rounded-lg">⚡ Generar recurso →</button>
      </div>
    </div>

    <!-- Paso 2: Revisar y publicar -->
    <div x-show="wizardStep === 2" class="space-y-3">
      <h3 class="text-sm font-bold text-slate-200">Revisá y ajustá el recurso</h3>

      <div x-show="sourceUrl" class="text-xs text-slate-400 bg-slate-900 border border-slate-700 rounded-lg p-3 flex flex-wrap items-center gap-2">
        <span class="font-bold text-slate-200">Fuente:</span>
        <span class="font-mono truncate max-w-full" x-text="sourceUrl"></span>
        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold" :class="sourceType === 'youtube' ? 'bg-red-500/20 text-red-400' : 'bg-blue-500/20 text-blue-400'" x-text="sourceType === 'youtube' ? 'YouTube' : 'Web'"></span>
        <span x-show="!hadSource" class="text-amber-300">(sin transcripción — se usó solo tu frase)</span>
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-300 mb-1">Título</label>
        <input x-model="borrador.title" type="text" class="w-full px-3 py-2 bg-slate-900 border border-slate-600 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-600">
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-bold text-slate-300 mb-1">Categorías</label>
          <div class="flex flex-col gap-2">
            <select x-model="selectedCategory" @change="addCategory()" class="w-full px-3 py-2 bg-slate-900 border border-slate-600 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-600">
              <option value="">Elegí una categoría…</option>
              <template x-for="cat in availableCategories" :key="cat">
                <option :value="cat" x-text="cat"></option>
              </template>
            </select>
            <div class="flex flex-wrap gap-2" x-show="selectedCategories.length">
              <template x-for="(cat, i) in selectedCategories" :key="i">
                <span class="inline-flex items-center gap-1.5 bg-slate-700 rounded-full px-3 py-1 text-xs font-bold text-slate-100">
                  <span x-text="cat"></span>
                  <button type="button" @click="removeCategory(i)" class="text-slate-300 hover:text-red-400 font-bold leading-none" title="Quitar categoría">✕</button>
                </span>
              </template>
            </div>
          </div>
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-300 mb-1">Temas (puente con el Blog)</label>
          <div class="flex flex-col gap-2">
            <select x-model="selectedTema" @change="addTema()" class="w-full px-3 py-2 bg-slate-900 border border-slate-600 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-600">
              <option value="">Elegí un tema…</option>
              <template x-for="tema in availableTemas" :key="tema">
                <option :value="tema" x-text="tema"></option>
              </template>
            </select>
            <div class="flex flex-wrap gap-2" x-show="selectedTemas.length">
              <template x-for="(tema, i) in selectedTemas" :key="i">
                <span class="inline-flex items-center gap-1.5 bg-indigo-600/30 border border-indigo-500/40 rounded-full px-3 py-1 text-xs font-bold text-indigo-200">
                  <span x-text="tema"></span>
                  <button type="button" @click="removeTema(i)" class="text-indigo-300 hover:text-red-400 font-bold leading-none" title="Quitar tema">✕</button>
                </span>
              </template>
            </div>
            <p class="text-[10px] text-slate-500">Estos temas matchean este recurso con los posts del Blog.</p>
          </div>
        </div>
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-300 mb-1">Descripción (SEO)</label>
        <input x-model="borrador.description" type="text" class="w-full px-3 py-2 bg-slate-900 border border-slate-600 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-600">
      </div>

      <div>
        <div class="flex items-center justify-between mb-1">
          <label class="block text-xs font-bold text-slate-300">Contenido (Markdown)</label>
          <div class="flex gap-2">
            <button @click="togglePreview()" type="button" class="text-xs text-indigo-400 hover:text-indigo-300 font-bold">
              <span x-text="showPreview ? 'Editar' : 'Vista previa'"></span>
            </button>
            <span x-show="showPreview" @click="showPreview = false" class="text-xs text-slate-500 cursor-pointer">✕</span>
          </div>
        </div>
        <textarea x-show="!showPreview" x-model="borrador.bodyMarkdown" rows="12" class="w-full px-3 py-2 bg-slate-900 border border-slate-600 rounded-lg text-sm font-mono focus:outline-none focus:ring-2 focus:ring-indigo-600"></textarea>
        <div x-show="showPreview" class="bg-slate-900 border border-slate-600 rounded-lg p-4 text-sm max-h-[420px] overflow-y-auto markdown-preview" x-html="previewHtml"></div>
      </div>

      <div x-show="coverUrl" class="rounded-lg overflow-hidden border border-slate-600 max-w-sm">
        <img :src="coverUrl" alt="Portada" class="w-full aspect-video object-cover">
      </div>

      <div class="border-t border-slate-700 pt-4 flex flex-wrap gap-3">
        <button @click="publicar(false)" :disabled="busy" class="px-5 py-2 bg-green-700 hover:bg-green-800 disabled:opacity-60 text-sm font-bold rounded-lg">
          <span x-text="editingId ? 'Actualizar y publicar' : 'Publicar'"></span>
        </button>
        <button @click="publicar(true)" :disabled="busy" class="px-5 py-2 bg-slate-700 hover:bg-slate-600 disabled:opacity-60 text-sm font-bold rounded-lg">Guardar borrador</button>
      </div>
    </div>
  </WizardModal>
</div>

<script>
  import Alpine from 'alpinejs';
  import { supabase } from '../../lib/supabase';
  import { RECURSOS_CATEGORIES } from '../../data/recursos-categories';
  import { TEMAS, normalizeTemas } from '../../data/temas';

  const BASE = import.meta.env.BASE_URL;
  window.__RECURSOS_BASE__ = BASE.endsWith('/') ? BASE : `${BASE}/`;

  function slugify(text: string) {
    return (text || '')
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-+|-+$/g, '')
      .slice(0, 80) || 'recurso';
  }

  function escapeHtml(s: string) {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }
  function inlineMd(s: string) {
    return escapeHtml(s)
      .replace(/`([^`]+)`/g, '<code>$1</code>')
      .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
      .replace(/(^|[^*])\*([^*]+)\*/g, '$1<em>$2</em>')
      .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>');
  }
  function renderMarkdown(md: string) {
    if (!md) return '';
    const lines = md.split(/\r?\n/);
    let html = '';
    let inCode = false;
    let listType: string | null = null;
    for (const raw of lines) {
      const line = raw.replace(/\s+$/, '');
      if (line.startsWith('```')) {
        if (inCode) { html += '</code></pre>'; inCode = false; }
        else { html += '<pre><code>'; inCode = true; }
        continue;
      }
      if (inCode) { html += escapeHtml(line) + '\n'; continue; }
      const h = line.match(/^(#{1,6})\s+(.*)$/);
      if (h) {
        const lvl = h[1].length;
        if (listType) { html += `</${listType}>`; listType = null; }
        html += `<h${lvl}>${inlineMd(h[2])}</h${lvl}>`;
        continue;
      }
      if (/^\s*(-|\*|\+)\s+/.test(line)) {
        const content = line.replace(/^\s*(-|\*|\+)\s+/, '');
        if (listType !== 'ul') { if (listType) html += `</${listType}>`; html += '<ul>'; listType = 'ul'; }
        html += `<li>${inlineMd(content)}</li>`;
        continue;
      }
      if (/^\s*\d+\.\s+/.test(line)) {
        const content = line.replace(/^\s*\d+\.\s+/, '');
        if (listType !== 'ol') { if (listType) html += `</${listType}>`; html += '<ol>'; listType = 'ol'; }
        html += `<li>${inlineMd(content)}</li>`;
        continue;
      }
      if (line.startsWith('> ')) {
        if (listType) { html += `</${listType}>`; listType = null; }
        html += `<blockquote>${inlineMd(line.slice(2))}</blockquote>`;
        continue;
      }
      if (listType) { html += `</${listType}>`; listType = null; }
      if (line.trim() === '') continue;
      html += `<p>${inlineMd(line)}</p>`;
    }
    if (inCode) html += '</code></pre>';
    if (listType) html += `</${listType}>`;
    return html;
  }

  const OP_STEPS: Record<string, string[]> = {
    generar: ['Conectar', 'Traer el texto de la fuente', 'Mejorar la frase con IA', 'Armar el recurso'],
    publicar: ['Guardar en la base'],
  };
  const OP_MSGS: Record<string, string[]> = {
    generar: ['Conectando…', 'Leyendo el link…', 'Mejorando tu frase con DeepSeek…', 'Armando el artículo…'],
    publicar: ['Guardando en la base…'],
  };

  Alpine.data('recursosAdmin', () => ({
    wizardOpen: false,
    wizardStep: 1,

    url: '',
    frase: '',
    borrador: { title: '', description: '', bodyMarkdown: '' } as any,
    selectedCategory: '',
    selectedCategories: [] as string[],
    selectedTema: '',
    selectedTemas: [] as string[],
    coverUrl: '',
    sourceUrl: '',
    sourceType: 'web',
    sourceTitle: '',
    videoId: '',
    hadSource: true,
    editingId: null as any,
    showPreview: false,
    previewHtml: '',
    busy: false,
    status: '',
    recursos: [] as any[],
    op: null as any,
    opHistory: [] as any[],

    async init() {},

    abrirWizardNuevo() {
      this.nuevoRecurso();
      this.wizardStep = 1;
      this.wizardOpen = true;
    },

    async loadRecursos() {
      const { data, error } = await supabase
        .from('recursos')
        .select('*')
        .order('created_at', { ascending: false });
      if (!error) this.recursos = data || [];
    },

    get availableCategories() {
      return RECURSOS_CATEGORIES.filter((c) => !this.selectedCategories.includes(c));
    },

    addCategory() {
      const cat = this.selectedCategory;
      if (cat && !this.selectedCategories.includes(cat)) {
        this.selectedCategories = [...this.selectedCategories, cat];
      }
      this.selectedCategory = '';
    },

    removeCategory(index: number) {
      this.selectedCategories = this.selectedCategories.filter((_, i) => i !== index);
    },

    get availableTemas() {
      return TEMAS.filter((t) => !this.selectedTemas.includes(t));
    },

    addTema() {
      const t = this.selectedTema;
      if (t && !this.selectedTemas.includes(t)) {
        this.selectedTemas = [...this.selectedTemas, t];
      }
      this.selectedTema = '';
    },

    removeTema(index: number) {
      this.selectedTemas = this.selectedTemas.filter((_, i) => i !== index);
    },

    setTemas(list: string[]) {
      this.selectedTemas = normalizeTemas(list || []);
    },

    startOp(id: string, label: string, steps: string[], messages: string[]) {
      this.clearOpInterval();
      const now = Date.now();
      this.op = {
        id, label, startedAt: now, elapsed: '0:00', messages, msgIndex: 0, stepIndex: 0,
        steps: steps.map((s, i) => ({ label: s, status: i === 0 ? 'active' : 'pending', ts: i === 0 ? now : null })),
        interval: null as any, msgInterval: null as any, finished: false,
      };
      this.busy = true;
      this.status = messages[0] || '';
      this.op.interval = setInterval(() => this.tickOp(), 1000);
      this.op.msgInterval = setInterval(() => this.rotateOpMsg(), 3000);
    },

    clearOpInterval() {
      if (this.op?.interval) { clearInterval(this.op.interval); this.op.interval = null; }
      if (this.op?.msgInterval) { clearInterval(this.op.msgInterval); this.op.msgInterval = null; }
    },

    tickOp() {
      if (!this.op || this.op.finished) return;
      const now = Date.now();
      const secs = Math.floor((now - this.op.startedAt) / 1000);
      this.op.elapsed = `${Math.floor(secs / 60)}:${String(secs % 60).padStart(2, '0')}`;
      const cur = this.op.steps[this.op.stepIndex];
      if (cur && cur.status === 'active' && cur.ts && now - cur.ts > 8000) {
        cur.status = 'done';
        const next = this.op.stepIndex + 1;
        if (next < this.op.steps.length) {
          this.op.steps[next].status = 'active';
          this.op.steps[next].ts = now;
          this.op.stepIndex = next;
        }
      }
      this.op = { ...this.op };
    },

    rotateOpMsg() {
      if (!this.op || this.op.finished) return;
      const len = this.op.messages?.length || 1;
      this.op.msgIndex = (this.op.msgIndex + 1) % len;
      this.op = { ...this.op };
    },

    _opElapsed(): string {
      const secs = Math.floor((Date.now() - (this.op?.startedAt || Date.now())) / 1000);
      return `${Math.floor(secs / 60)}:${String(secs % 60).padStart(2, '0')}`;
    },

    finishOp(successMsg: string) {
      if (!this.op) { this.busy = false; return; }
      const o = this.op;
      this.clearOpInterval();
      o.steps.forEach((s: any) => { if (s.status !== 'error') s.status = 'done'; });
      o.finished = true;
      this.opHistory.unshift({ id: o.id, label: o.label, ok: true, result: successMsg, elapsed: this._opElapsed(), ts: Date.now() });
      this.opHistory = this.opHistory.slice(0, 5);
      this.status = successMsg;
      this.busy = false;
      this.op = null;
    },

    failOp(errorMsg: string) {
      if (!this.op) { this.busy = false; return; }
      const o = this.op;
      this.clearOpInterval();
      const cur = o.steps[o.stepIndex] || o.steps[o.steps.length - 1];
      if (cur) cur.status = 'error';
      o.finished = true;
      this.opHistory.unshift({ id: o.id, label: o.label, ok: false, result: errorMsg, elapsed: this._opElapsed(), ts: Date.now() });
      this.opHistory = this.opHistory.slice(0, 5);
      this.status = errorMsg;
      this.busy = false;
      this.op = null;
    },

    async generar() {
      if (!this.url || !this.frase) { this.status = 'Completá link y frase.'; return; }
      this.startOp('generar', 'Generar recurso', OP_STEPS.generar, OP_MSGS.generar);
      try {
        const { data, error } = await supabase.functions.invoke('recurso-generate', {
          body: { url: this.url.trim(), frase: this.frase.trim() },
        });
        if (error) throw new Error(error.context?.error || error.message);
        if (data.error) throw new Error(data.error);

        this.borrador = {
          title: data.title || '',
          description: data.description || '',
          bodyMarkdown: data.bodyMarkdown || '',
        };
        this.setCategories(data.categories || []);
        this.setTemas(data.topicos || []);
        this.coverUrl = data.coverUrl || '';
        this.sourceUrl = data.sourceUrl || this.url.trim();
        this.sourceType = data.sourceType || 'web';
        this.sourceTitle = data.sourceTitle || '';
        this.videoId = data.videoId || '';
        this.hadSource = data.hadSource !== false;
        this.editingId = null;
        this.showPreview = false;
        this.finishOp('Recurso generado. Revisalo, ajustalo y publicá.');
        this.wizardStep = 2;
      } catch (e) {
        this.failOp((e as Error).message);
      }
    },

    setCategories(list: string[]) {
      this.selectedCategories = (list || []).filter((c: string) =>
        RECURSOS_CATEGORIES.includes(c as any)
      );
    },

    togglePreview() {
      this.previewHtml = renderMarkdown(this.borrador?.bodyMarkdown || '');
      this.showPreview = !this.showPreview;
    },

    async uniqueSlug(base: string) {
      const { data } = await supabase.from('recursos').select('slug');
      const existing = new Set((data || []).map((r) => r.slug));
      if (!existing.has(base)) return base;
      let i = 2;
      while (existing.has(`${base}-${i}`)) i++;
      return `${base}-${i}`;
    },

    async publicar(draft: boolean) {
      if (!this.borrador?.title || !this.borrador?.bodyMarkdown) {
        this.status = 'No hay recurso para publicar.';
        return;
      }
      this.startOp('publicar', draft ? 'Guardar borrador' : 'Publicar', OP_STEPS.publicar, OP_MSGS.publicar);
      try {
        const payload: any = {
          title: this.borrador.title,
          source_url: this.sourceUrl,
          source_type: this.sourceType,
          source_title: this.sourceTitle,
          video_id: this.videoId || null,
          description: this.borrador.description,
          body_markdown: this.borrador.bodyMarkdown,
          categories: this.selectedCategories,
          topicos: normalizeTemas(this.selectedTemas),
          cover_url: this.coverUrl || null,
          draft,
        };
        if (this.editingId) {
          payload.slug = slugify(this.borrador.title);
          const res = await supabase.from('recursos').update(payload).eq('id', this.editingId);
          if (res.error) throw new Error(res.error.message);
        } else {
          payload.slug = await this.uniqueSlug(slugify(this.borrador.title));
          const res = await supabase.from('recursos').insert(payload);
          if (res.error) throw new Error(res.error.message);
        }
        this.editingId = null;
        await this.loadRecursos();
        this.finishOp(
          draft
            ? 'Borrador guardado.'
            : '¡Publicado! Aparece en /zona-lab tras el próximo build (cron 12 hs o deploy manual).'
        );
        this.wizardOpen = false;
      } catch (e) {
        this.failOp((e as Error).message);
      }
    },

    async toggleDraft(p: any) {
      const res = await supabase.from('recursos').update({ draft: !p.draft }).eq('id', p.id);
      if (!res.error) this.loadRecursos();
    },

    async borrarRecurso(p: any) {
      if (!window.confirm(`¿Eliminar "${p.title}"? Esta acción no se puede deshacer.`)) return;
      const res = await supabase.from('recursos').delete().eq('id', p.id);
      if (!res.error) {
        if (this.editingId === p.id) this.nuevoRecurso();
        this.loadRecursos();
      }
    },

    cargarRecurso(p: any) {
      this.editingId = p.id;
      this.borrador = {
        title: p.title,
        description: p.description,
        bodyMarkdown: p.body_markdown,
      };
      this.setCategories(p.categories || []);
      this.setTemas(p.topicos || []);
      this.coverUrl = p.cover_url || '';
      this.sourceUrl = p.source_url || '';
      this.sourceType = p.source_type || 'web';
      this.sourceTitle = p.source_title || '';
      this.videoId = p.video_id || '';
      this.hadSource = true;
      this.showPreview = false;
      this.url = '';
      this.frase = '';
      this.wizardStep = 2;
      this.wizardOpen = true;
    },

    nuevoRecurso() {
      this.editingId = null;
      this.borrador = { title: '', description: '', bodyMarkdown: '' };
      this.url = '';
      this.frase = '';
      this.selectedCategory = '';
      this.selectedCategories = [];
      this.selectedTema = '';
      this.selectedTemas = [];
      this.coverUrl = '';
      this.sourceUrl = '';
      this.sourceType = 'web';
      this.sourceTitle = '';
      this.videoId = '';
      this.hadSource = true;
      this.showPreview = false;
    },
  }));
</script>
