            <div x-show="showPreview" class="prose-pre:bg-slate-950 bg-slate-900 border border-slate-600 rounded-lg p-4 text-sm max-h-[420px] overflow-y-auto markdown-preview" x-html="previewHtml"></div>
          </div>

          <!-- Imagen -->
          <div class="border-t border-slate-700 pt-4 space-y-3">
