  <style>
    [x-cloak] { display: none !important; }
    .markdown-preview h1, .markdown-preview h2, .markdown-preview h3 { font-weight: 700; margin: 0.75em 0 0.4em; }
    .markdown-preview h1 { font-size: 1.4em; } .markdown-preview h2 { font-size: 1.2em; } .markdown-preview h3 { font-size: 1.05em; }
    .markdown-preview p { margin: 0.5em 0; }
    .markdown-preview ul, .markdown-preview ol { margin: 0.5em 0 0.5em 1.4em; list-style: disc; }
    .markdown-preview ol { list-style: decimal; }
    .markdown-preview code { background: #0f172a; padding: 1px 5px; border-radius: 4px; font-size: 0.9em; }
    .markdown-preview pre { background: #0f172a; padding: 10px; border-radius: 6px; overflow-x: auto; margin: 0.5em 0; }
    .markdown-preview pre code { background: transparent; padding: 0; }
    .markdown-preview blockquote { border-left: 3px solid #6366f1; padding-left: 12px; color: #94a3b8; font-style: italic; margin: 0.5em 0; }
    .markdown-preview a { color: #818cf8; text-decoration: underline; }
    .markdown-preview img { max-width: 100%; border-radius: 6px; }
    .markdown-preview strong { font-weight: 700; }
    .markdown-preview em { font-style: italic; }
  </style>
</div>

<script>
  import Alpine from 'alpinejs';
  import {
    supabase,
    resolveLoginUser,
    markSessionStart,
    clearSessionStart,
    scheduleSessionEnd,
  } from '../../lib/supabase';

  window.Alpine = Alpine;

  const BASE = import.meta.env.BASE_URL;
  window.__BLOG_BASE__ = BASE.endsWith('/') ? BASE : `${BASE}/`;

  function slugify(text: string) {
    return (text || '')
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-+|-+$/g, '')
      .slice(0, 80) || 'post';
  }

  // Preview minimalista de markdown (solo para el editor)
  function escapeHtml(s: string) {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }
  function inlineMd(s: string) {
    return escapeHtml(s)
      .replace(/`([^`]+)`/g, '<code>$1</code>')
      .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
      .replace(/(^|[^*])\*([^*]+)\*/g, '$1<em>$2</em>')
      .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>');
  }
  function renderMarkdown(md: string) {
    if (!md) return '';
    const lines = md.split(/\r?\n/);
    let html = '';
    let inCode = false;
    let listType = null;
    for (const raw of lines) {
      const line = raw.replace(/\s+$/, '');
      if (line.startsWith('```')) {
        if (inCode) { html += '</code></pre>'; inCode = false; }
        else { html += '<pre><code>'; inCode = true; }
        continue;
      }
      if (inCode) { html += escapeHtml(line) + '\n'; continue; }
      const h = line.match(/^(#{1,6})\s+(.*)$/);
      if (h) {
        const lvl = h[1].length;
        if (listType) { html += `</${listType}>`; listType = null; }
        html += `<h${lvl}>${inlineMd(h[2])}</h${lvl}>`;
        continue;
      }
      if (/^\s*(-|\*|\+)\s+/.test(line)) {
        const content = line.replace(/^\s*(-|\*|\+)\s+/, '');
        if (listType !== 'ul') { if (listType) html += `</${listType}>`; html += '<ul>'; listType = 'ul'; }
        html += `<li>${inlineMd(content)}</li>`;
        continue;
      }
      if (/^\s*\d+\.\s+/.test(line)) {
        const content = line.replace(/^\s*\d+\.\s+/, '');
        if (listType !== 'ol') { if (listType) html += `</${listType}>`; html += '<ol>'; listType = 'ol'; }
        html += `<li>${inlineMd(content)}</li>`;
        continue;
      }
      if (line.startsWith('> ')) {
        if (listType) { html += `</${listType}>`; listType = null; }
        html += `<blockquote>${inlineMd(line.slice(2))}</blockquote>`;
        continue;
      }
      if (listType) { html += `</${listType}>`; listType = null; }
      if (line.trim() === '') continue;
      html += `<p>${inlineMd(line)}</p>`;
    }
    if (inCode) html += '</code></pre>';
    if (listType) html += `</${listType}>`;
    return html;
  }

  Alpine.data('blogAdmin', () => ({
    loadingAuth: true,
    user: null as any,
    userRole: null as any,
    loginEmail: 'cervantes',
    loginPassword: '',
    loginError: '',

    form: { tema: '', enfoque: '', tono: '', fraseClave: '', tiempoLecturaMin: '5', autor: 'MG Lab' },
    propuestas: [] as any[],
    propuestaIndex: -1,
    borrador: null as any,
    review: null as any,
    iteracion: 0,
    correccionPrompt: '',
    categoriesText: '',
    coverPrompt: '',
    coverUrl: '',
    editingId: null as any,
    showPreview: false,
    previewHtml: '',
    busy: false,
    status: '',
    posts: [] as any[],

    async init() {
      const { data } = await supabase.auth.getSession();
      if (data?.session?.user) {
        this.user = data.session.user;
        await this.loadProfile();
        if (this.userRole === 'admin') this.loadPosts();
      }
      this.loadingAuth = false;
    },

    async loadProfile() {
      const { data } = await supabase
        .from('profiles')
        .select('role')
        .eq('id', this.user.id)
        .maybeSingle();
      this.userRole = data?.role || null;
    },

    async login() {
      this.loginError = '';
      this.busy = true;
      try {
        const { data, error } = await supabase.auth.signInWithPassword({
          email: resolveLoginUser(this.loginEmail),
          password: this.loginPassword,
        });
        if (error) throw error;
        this.user = data.user;
        this.loginPassword = '';
        await this.loadProfile();
        markSessionStart();
        scheduleSessionEnd(() => this.logout(true));
        if (this.userRole === 'admin') this.loadPosts();
      } catch (e) {
        this.loginError = (e as Error).message || 'Error al iniciar sesión';
      } finally {
        this.busy = false;
      }
    },

    async logout(auto = false) {
      if (!auto) clearSessionStart();
      await supabase.auth.signOut();
      this.user = null;
      this.userRole = null;
      this.posts = [];
    },

    async loadPosts() {
      const { data, error } = await supabase
        .from('blogs')
        .select('*')
        .order('pub_date', { ascending: false });
      if (!error) this.posts = data || [];
    },

    async generarPropuestas() {
      if (!this.form.tema) { this.status = 'Ingresá un tema.'; return; }
      this.busy = true;
      this.status = 'Generando propuestas...';
      try {
        const { data, error } = await supabase.functions.invoke('blog-proposals', { body: this.form });
        if (error) throw new Error(error.context?.error || error.message);
        this.propuestas = data.propuestas || [];
        this.propuestaIndex = -1;
        this.status = `${this.propuestas.length} propuesta(s) generadas. Elegí una.`;
      } catch (e) {
        this.status = (e as Error).message;
      } finally {
        this.busy = false;
      }
    },

    async redactar() {
      if (this.propuestaIndex < 0) { this.status = 'Elegí una propuesta.'; return; }
      this.busy = true;
      this.status = 'Redactando... (puede tardar)';
      try {
        const { data, error } = await supabase.functions.invoke('blog-write', {
          body: { ...this.form, propuesta: this.propuestas[this.propuestaIndex] },
        });
        if (error) throw new Error(error.context?.error || error.message);
        this.borrador = data.borrador;
        this.review = null;
        this.iteracion = 0;
        this.correccionPrompt = '';
        this.categoriesText = (data.borrador.categories || []).join(', ');
        this.coverUrl = '';
        this.coverPrompt = '';
        this.showPreview = false;
        this.status = 'Borrador listo. Revisalo, ajustá y publicá.';
      } catch (e) {
        this.status = (e as Error).message;
      } finally {
        this.busy = false;
      }
    },

    async revisar() {
      if (!this.borrador) { this.status = 'Primero redactá el post.'; return; }
      this.busy = true;
      this.status = 'Revisando con el crítico IA...';
      try {
        const { data, error } = await supabase.functions.invoke('blog-review', {
          body: {
            borrador: {
              title: this.borrador.title,
              categories: this.borrador.categories || [],
              description: this.borrador.description,
              bodyMarkdown: this.borrador.bodyMarkdown,
            },
            tiempoLecturaMin: Number(this.form.tiempoLecturaMin) || null,
          },
        });
        if (error) throw new Error(error.context?.error || error.message);
        this.review = data.review || null;
        this.status = this.review?.aprobado
          ? 'El crítico aprobó el borrador. Listo para publicar.'
          : 'El crítico marcó problemas. Podés aplicar correcciones o editarlas a mano.';
      } catch (e) {
        this.status = (e as Error).message;
      } finally {
        this.busy = false;
      }
    },

    async aplicarCorrecciones() {
      if (!this.borrador) { this.status = 'Primero redactá el post.'; return; }
      const instruccion = (this.correccionPrompt || '').trim();
      if (!this.review && !instruccion) {
        this.status = 'Escribí una corrección abajo o corré el crítico con "Revisar con IA".';
        return;
      }
      if (this.iteracion >= 2) { this.status = 'Tope de revisiones alcanzado.'; return; }
      this.busy = true;
      this.status = 'Aplicando correcciones del IA...';
      try {
        const { data, error } = await supabase.functions.invoke('blog-revise', {
          body: {
            borrador: {
              title: this.borrador.title,
              categories: this.borrador.categories || [],
              description: this.borrador.description,
              bodyMarkdown: this.borrador.bodyMarkdown,
            },
            problemas: this.review?.problemas || [],
            instruccion,
            tiempoLecturaMin: Number(this.form.tiempoLecturaMin) || null,
          },
        });
        if (error) throw new Error(error.context?.error || error.message);
        this.borrador = data.borrador;
        this.categoriesText = (data.borrador.categories || []).join(', ');
        this.iteracion++;
        this.review = null;
        this.correccionPrompt = '';
        this.showPreview = false;
        this.status = `Corrección aplicada (iteración ${this.iteracion}/2). Revisá de nuevo.`;
      } catch (e) {
        this.status = (e as Error).message;
      } finally {
        this.busy = false;
      }
    },

    async generarImagen() {
      if (!this.borrador) { this.status = 'Primero redactá el post.'; return; }
      this.busy = true;
      this.status = 'Generando imagen de tapa... (puede tardar)';
      try {
        const { data, error } = await supabase.functions.invoke('blog-cover', {
          body: {
            title: this.borrador.title,
            description: this.borrador.description,
            bodyMarkdown: this.borrador.bodyMarkdown,
            prompt: this.coverPrompt || null,
          },
        });
        if (error) throw new Error(error.context?.error || error.message);
        this.coverUrl = data.coverUrl;
        this.coverPrompt = data.prompt;
        this.status = 'Imagen de tapa lista.';
      } catch (e) {
        this.status = (e as Error).message;
      } finally {
        this.busy = false;
      }
    },

    async uniqueSlug(base: string) {
      const { data } = await supabase.from('blogs').select('slug');
      const existing = new Set((data || []).map((r) => r.slug));
      if (!existing.has(base)) return base;
      let i = 2;
      while (existing.has(`${base}-${i}`)) i++;
      return `${base}-${i}`;
    },

    async publicar(draft: boolean) {
      if (!this.borrador?.title || !this.borrador?.bodyMarkdown) {
        this.status = 'No hay borrador para publicar.';
        return;
      }
      this.busy = true;
      this.status = draft ? 'Guardando borrador...' : 'Publicando...';
      try {
        const payload: any = {
          title: this.borrador.title,
          pub_date: new Date().toISOString().slice(0, 10),
          author: this.form.autor || 'MG Lab',
          categories: this.categoriesText.split(',').map((s) => s.trim()).filter(Boolean),
          description: this.borrador.description,
          body_markdown: this.borrador.bodyMarkdown,
          cover_url: this.coverUrl || null,
          draft,
        };
        if (this.editingId) {
          payload.slug = slugify(this.borrador.title);
          const res = await supabase.from('blogs').update(payload).eq('id', this.editingId);
          if (res.error) throw new Error(res.error.message);
        } else {
          payload.slug = await this.uniqueSlug(slugify(this.borrador.title));
          const res = await supabase.from('blogs').insert(payload);
          if (res.error) throw new Error(res.error.message);
        }
        this.status = draft
          ? 'Borrador guardado.'
          : '¡Publicado! Aparece en /blog tras el próximo build (cron 12 hs o deploy manual).';
        this.editingId = null;
        await this.loadPosts();
      } catch (e) {
        this.status = (e as Error).message;
      } finally {
        this.busy = false;
      }
    },

    async toggleDraft(p: any) {
      const res = await supabase.from('blogs').update({ draft: !p.draft }).eq('id', p.id);
      if (!res.error) this.loadPosts();
    },

    async borrarPost(p: any) {
      if (!window.confirm(`¿Eliminar "${p.title}"? Esta acción no se puede deshacer.`)) return;
      const res = await supabase.from('blogs').delete().eq('id', p.id);
      if (!res.error) {
        if (this.editingId === p.id) this.nuevoPost();
        this.loadPosts();
      }
    },

    cargarPost(p: any) {
      this.editingId = p.id;
      this.form.autor = p.author;
      this.borrador = {
        title: p.title,
        description: p.description,
        bodyMarkdown: p.body_markdown,
        categories: p.categories || [],
      };
this.review = null;
      this.iteracion = 0;
      this.correccionPrompt = '';
      this.coverUrl = p.cover_url || '';
      this.coverPrompt = '';
      this.showPreview = false;
      window.scrollTo({ top: 0, behavior: 'smooth' });
    },

    togglePreview() {
      this.previewHtml = renderMarkdown(this.borrador?.bodyMarkdown || '');
      this.showPreview = !this.showPreview;
    },

    nuevoPost() {
      this.editingId = null;
      this.borrador = null;
      this.review = null;
      this.iteracion = 0;
      this.correccionPrompt = '';
      this.coverUrl = '';
      this.coverPrompt = '';
      this.propuestas = [];
      this.propuestaIndex = -1;
      this.showPreview = false;
      this.form.tema = '';
      this.form.enfoque = '';
      this.form.tono = '';
      this.form.fraseClave = '';
      this.form.tiempoLecturaMin = '5';
    },
  }));

  Alpine.start();
</script>