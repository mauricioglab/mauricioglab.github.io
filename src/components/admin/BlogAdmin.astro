<div x-data="blogAdmin" x-init="init()" class="min-h-screen bg-slate-900 text-white" x-cloak>
  <!-- ============ LOGIN / GATE ============ -->
  <div x-show="!user || userRole !== 'admin'" class="min-h-screen flex items-center justify-center p-6">
    <div class="w-full max-w-sm">
      <div class="bg-slate-800 rounded-xl p-6 shadow-xl">
        <h1 class="text-xl font-bold mb-1">📝 Admin Blog</h1>
        <p class="text-sm text-slate-400 mb-4">Acceso restringido al equipo docente.</p>

        <div x-show="user && userRole && userRole !== 'admin'">
          <p class="text-sm text-red-400 bg-red-500/10 border border-red-500/30 rounded-lg p-3 mb-4">
            Tu usuario no tiene rol <strong>admin</strong>. Contactá al administrador.
          </p>
          <button @click="logout()" class="w-full py-2 bg-slate-700 hover:bg-slate-600 text-white text-sm font-bold rounded-lg">
            Cerrar sesión
          </button>
        </div>

        <template x-if="!user">
          <div>
            <div x-show="loadingAuth" class="text-center text-sm text-slate-400 py-6">Cargando...</div>
            <form x-show="!loadingAuth" @submit.prevent="login()">
              <div class="mb-3">
                <label class="block text-xs font-bold text-slate-300 mb-1">Usuario o Email</label>
                <input x-model="loginEmail" type="text" class="w-full px-3 py-2 bg-slate-900 border border-slate-600 rounded-lg text-sm text-white focus:outline-none focus:ring-2 focus:ring-indigo-600">
              </div>
              <div class="mb-4">
                <label class="block text-xs font-bold text-slate-300 mb-1">Contraseña</label>
                <input x-model="loginPassword" type="password" class="w-full px-3 py-2 bg-slate-900 border border-slate-600 rounded-lg text-sm text-white focus:outline-none focus:ring-2 focus:ring-indigo-600" required>
              </div>
              <p x-show="loginError" class="text-xs text-red-400 mb-3 font-bold" x-text="loginError"></p>
              <button type="submit" class="w-full py-2 bg-indigo-700 hover:bg-indigo-800 text-white text-sm font-bold rounded-lg" :disabled="loadingAuth">
                <span x-text="loadingAuth ? '...' : 'Ingresar'"></span>
              </button>
            </form>
            <a :href="`${window.__BLOG_BASE__}blog/`" class="block w-full text-center text-xs text-slate-500 hover:text-slate-300 mt-3">← Volver al blog</a>
          </div>
        </template>
      </div>
    </div>
  </div>

  <!-- ============ ADMIN ============ -->
  <div x-show="user && userRole === 'admin'" class="max-w-7xl mx-auto p-4 md:p-6">
    <!-- Header -->
    <div class="flex items-center justify-between mb-6">
      <div>
        <h1 class="text-2xl font-bold">📝 Admin Blog</h1>
        <p class="text-sm text-slate-400" x-text="user ? user.email : ''"></p>
      </div>
      <div class="flex items-center gap-3">
        <a :href="`${window.__BLOG_BASE__}blog/`" class="text-sm text-slate-400 hover:text-white">Ver blog</a>
        <button @click="logout()" class="px-3 py-1.5 bg-red-600/20 text-red-400 rounded-lg hover:bg-red-600/30 text-sm">Salir</button>
      </div>
    </div>

    <!-- Consola de actividad -->
    <div class="mb-4 space-y-2">
      <template x-if="op">
        <div class="rounded-lg border border-indigo-500/40 bg-slate-800/90 overflow-hidden">
          <div class="shimmer-bar h-1"></div>
          <div class="p-4 space-y-3">
            <div class="flex items-center justify-between gap-3">
              <div class="flex items-center gap-2 text-sm font-bold text-indigo-200">
                <span class="spinner spinner-sm"></span>
                <span x-text="op.label"></span>
              </div>
              <span class="text-xs font-mono text-slate-400">⏱ <span x-text="op.elapsed"></span></span>
            </div>
            <p class="text-xs text-indigo-300" x-text="op.messages[op.msgIndex]"></p>
            <div class="space-y-1.5">
              <template x-for="(step, i) in op.steps" :key="i">
                <div class="flex items-center gap-2 text-xs">
                  <span x-show="step.status === 'active'" class="spinner spinner-xs"></span>
                  <span x-show="step.status === 'done'" class="text-green-400 font-bold">✓</span>
                  <span x-show="step.status === 'error'" class="text-red-400 font-bold">✗</span>
                  <span x-show="step.status === 'pending'" class="w-2 h-2 rounded-full bg-slate-600"></span>
                  <span :class="step.status === 'active' ? 'text-slate-100 font-bold' : step.status === 'done' ? 'text-green-300' : step.status === 'error' ? 'text-red-300' : 'text-slate-500'" x-text="step.label"></span>
                </div>
              </template>
            </div>
          </div>
        </div>
      </template>
      <div x-show="!op && status" class="px-4 py-3 rounded-lg bg-indigo-600/15 border border-indigo-500/30 text-sm" x-text="status"></div>
      <template x-if="opHistory.length">
        <details class="group text-xs">
          <summary class="text-slate-400 hover:text-slate-200 cursor-pointer select-none font-bold">
            Actividad reciente (<span x-text="opHistory.length"></span>)
          </summary>
          <div class="mt-1.5 space-y-1">
            <template x-for="h in opHistory" :key="h.ts">
              <div class="flex items-start gap-2" :class="h.ok ? 'text-slate-400' : 'text-red-400'">
                <span x-text="h.ok ? '✓' : '✗'"></span>
                <span class="font-bold" x-text="h.label"></span>
                <span class="font-mono" x-text="h.elapsed"></span>
                <span class="truncate" x-text="h.result"></span>
              </div>
            </template>
          </div>
        </details>
      </template>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- ===== Editor ===== -->
      <section class="lg:col-span-2 space-y-6">
        <!-- Form de tema -->
        <div class="bg-slate-800 rounded-xl p-5 space-y-3">
          <h2 class="text-base font-bold">1. Tema del post</h2>
          <div>
            <label class="block text-xs font-bold text-slate-300 mb-1">Tema *</label>
            <input x-model="form.tema" type="text" class="w-full px-3 py-2 bg-slate-900 border border-slate-600 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-600">
          </div>
          <div class="flex flex-col sm:flex-row gap-2">
            <input x-model="urlRef" type="text" placeholder="Pegá la URL de un reportaje o artículo para traer su texto..." class="flex-1 px-3 py-2 bg-slate-900 border border-slate-600 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-600">
            <button @click="traerTextoUrl()" :disabled="busy" class="shrink-0 px-4 py-2 bg-slate-700 hover:bg-slate-600 disabled:opacity-60 text-sm font-bold rounded-lg inline-flex items-center gap-2 justify-center">
              <span x-show="op && op.id === 'url'" class="spinner spinner-xs"></span>
              <span x-text="op && op.id === 'url' ? 'Trayendo…' : '⬇ Traer texto'"></span>
            </button>
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-300 mb-1">
              Frase / idea semilla o referencia <span class="font-normal text-slate-500">(acepta varios párrafos)</span>
            </label>
            <textarea x-model="form.fraseClave" rows="6" class="w-full px-3 py-2 bg-slate-900 border border-slate-600 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-600"></textarea>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
            <div>
              <label class="block text-xs font-bold text-slate-300 mb-1">Enfoque <span class="font-normal text-slate-500">(opcional)</span></label>
              <input x-model="form.enfoque" type="text" placeholder="Ej: el caso real detrás del tema" class="w-full px-3 py-2 bg-slate-900 border border-slate-600 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-600">
            </div>
            <div>
              <label class="block text-xs font-bold text-slate-300 mb-1">Tono</label>
              <select x-model="form.tono" class="w-full px-3 py-2 bg-slate-900 border border-slate-600 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-600">
                <option value="Cercano y directo">Cercano y directo</option>
                <option value="Técnico y profesional">Técnico y profesional</option>
                <option value="Formal">Formal</option>
                <option value="Motivador">Motivador</option>
                <option value="Con humor / irónico">Con humor / irónico</option>
                <option value="Periodístico">Periodístico</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-bold text-slate-300 mb-1">Min. lectura</label>
              <input x-model="form.tiempoLecturaMin" type="number" min="1" class="w-full px-3 py-2 bg-slate-900 border border-slate-600 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-600">
            </div>
          </div>
          <button @click="generarPropuestas()" :disabled="busy" class="px-4 py-2 bg-indigo-700 hover:bg-indigo-800 disabled:opacity-60 text-sm font-bold rounded-lg inline-flex items-center gap-2 justify-center">
            <span x-show="op && op.id === 'propuestas'" class="spinner spinner-xs"></span>
            <span x-text="op && op.id === 'propuestas' ? 'Generando…' : 'Generar propuestas'"></span>
          </button>
          <template x-if="temasHistory.length">
            <div class="border-t border-slate-700 pt-3 space-y-1.5">
              <p class="text-xs font-bold text-slate-400">
                Historial de temas
                <span class="font-normal text-slate-500">(últimos <span x-text="temasHistory.length"></span>/10)</span>
              </p>
              <div class="space-y-1">
                <template x-for="e in temasHistory" :key="e.id">
                  <div class="flex items-start gap-2 bg-slate-900 rounded-lg p-2 text-xs">
                    <div class="flex-1 min-w-0">
                      <p class="text-slate-200 truncate" x-text="e.tema"></p>
                      <p class="text-slate-500 text-[10px] mt-0.5">
                        <span x-show="e.enfoque" x-text="'enfoque: ' + e.enfoque + ' · '"></span>
                        <span x-text="new Date(e.savedAt).toLocaleString()"></span>
                      </p>
                    </div>
                    <button @click="useTemaEntry(e.id)" class="text-indigo-400 hover:text-indigo-300 font-bold shrink-0">Usar</button>
                    <button @click="deleteTemaEntry(e.id)" class="text-red-400 hover:text-red-300 font-bold shrink-0" title="Borrar">✕</button>
                  </div>
                </template>
              </div>
            </div>
          </template>
        </div>

        <!-- Propuestas -->
        <div x-show="propuestas.length > 0 || (op && op.id === 'propuestas')" class="bg-slate-800 rounded-xl p-5 space-y-3">
          <h2 class="text-base font-bold">2. Elegí un ángulo</h2>
          <div x-show="op && op.id === 'propuestas'" class="space-y-2">
            <template x-for="n in 3" :key="n">
              <div class="skeleton h-20 w-full"></div>
            </template>
          </div>
          <div x-show="!(op && op.id === 'propuestas')" class="space-y-2">
            <template x-for="(prop, i) in propuestas" :key="i">
              <label class="block cursor-pointer">
                <div
                  class="p-3 rounded-lg border transition flex gap-3 items-start"
                  :class="propuestaIndex === i ? 'border-indigo-500 bg-indigo-600/20' : 'border-slate-600 bg-slate-900 hover:border-slate-500'"
                >
                  <input type="radio" name="propuesta" :value="i" x-model="propuestaIndex" class="mt-1">
                  <div>
                    <p class="font-bold text-sm" x-text="prop.tituloSugerido"></p>
                    <p class="text-xs text-indigo-300 italic" x-text="prop.angulo"></p>
                    <p class="text-sm text-slate-300 mt-1" x-text="prop.resumen"></p>
                  </div>
                </div>
              </label>
            </template>
          </div>
          <button @click="redactar()" :disabled="busy || propuestaIndex < 0" class="px-4 py-2 bg-indigo-700 hover:bg-indigo-800 disabled:opacity-60 text-sm font-bold rounded-lg inline-flex items-center gap-2 justify-center">
            <span x-show="op && op.id === 'redactar'" class="spinner spinner-xs"></span>
            <span x-text="op && op.id === 'redactar' ? 'Redactando…' : 'Redactar post'"></span>
          </button>
        </div>

        <!-- Borrador -->
        <template x-if="borrador">
          <div class="bg-slate-800 rounded-xl p-5 space-y-3">
            <h2 class="text-base font-bold">3. Revisá y ajustá el borrador</h2>
          <div class="flex flex-wrap items-center gap-3">
            <button @click="revisar()" :disabled="busy" class="px-4 py-2 bg-indigo-700 hover:bg-indigo-800 disabled:opacity-60 text-sm font-bold rounded-lg inline-flex items-center gap-2 justify-center">
              <span x-show="op && op.id === 'revisar'" class="spinner spinner-xs"></span>
              <span x-text="op && op.id === 'revisar' ? 'Revisando…' : (review ? 'Volver a revisar' : '🔍 Revisar con IA')"></span>
            </button>
            <span x-show="iteracion > 0" class="text-xs text-slate-500">Correcciones aplicadas: <span x-text="iteracion"></span>/2</span>
          </div>
          <div x-show="op && (op.id === 'revisar' || op.id === 'corregir')" class="skeleton h-28 w-full"></div>
          <template x-if="review">
          <div class="rounded-lg border p-4 space-y-3"
               :class="review && review.aprobado ? 'bg-green-600/10 border-green-500/30' : 'bg-amber-600/10 border-amber-500/30'">
            <div class="flex items-center justify-between gap-2">
              <p class="text-sm font-bold" :class="review && review.aprobado ? 'text-green-300' : 'text-amber-300'">
                <span x-text="review && review.aprobado ? '✓ Aprobado por el crítico' : '✗ Necesita ajustes'"></span>
              </p>
              <span x-show="review && review.nota != null" class="text-xs opacity-80">Nota <span x-text="review ? review.nota : ''"></span>/10</span>
            </div>
            <p x-show="review && review.resumen" class="text-xs text-slate-300" x-text="review ? review.resumen : ''"></p>
            <div x-show="review && review.problemas && review.problemas.length" class="space-y-1.5">
              <p class="text-xs font-bold text-slate-300">Problemas a corregir:</p>
              <template x-for="(prob, i) in review.problemas" :key="i">
                <div class="text-xs bg-slate-900 rounded-lg p-2">
                  <p>
                    <span class="font-bold text-indigo-300" x-text="prob.tipo"></span>
                    <span x-show="prob.donde" class="text-slate-500" x-text="' · ' + prob.donde"></span>
                  </p>
                  <p x-show="prob.fixSugerido" class="text-slate-300 mt-0.5" x-text="prob.fixSugerido"></p>
                </div>
              </template>
            </div>
            <p x-show="review && review.aprobado" class="text-xs text-green-300">
              El crítico lo aprobó. Si igual querés, pedile un ajuste abajo.
            </p>
            <p x-show="review && !review.aprobado && iteracion >= 2" class="text-xs text-amber-300">
              Tope de revisiones alcanzado. Editá a mano o publicá el borrador.
            </p>
          </div>
          </template>
          <div class="bg-slate-900 border border-slate-700 rounded-lg p-3 space-y-2">
            <label class="block text-xs font-bold text-slate-300">
              Pedile una corrección al IA <span class="font-normal text-slate-500">(opcional)</span>
            </label>
            <textarea x-model="correccionPrompt" rows="2" class="w-full px-3 py-2 bg-slate-800 border border-slate-600 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-600"
                      placeholder="Ej: 'Hacelo más corto (5 min)', 'Agregá una sección sobre deploy', 'Cambiá el tono a más formal', 'Reescribí el hook'"></textarea>
            <div class="flex flex-wrap items-center gap-3">
              <button @click="aplicarCorrecciones()" :disabled="busy || iteracion >= 2"
                      class="px-4 py-2 bg-indigo-700 hover:bg-indigo-800 disabled:opacity-60 text-sm font-bold rounded-lg inline-flex items-center gap-2 justify-center">
                <span x-show="op && op.id === 'corregir'" class="spinner spinner-xs"></span>
                <span x-text="op && op.id === 'corregir' ? 'Corrigiendo…' : '✨ Aplicar corrección'"></span>
              </button>
              <span x-show="iteracion >= 2" class="text-xs text-amber-300">Tope de 2 correcciones alcanzado.</span>
            </div>
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-300 mb-1">Título</label>
            <input x-model="borrador.title" type="text" class="w-full px-3 py-2 bg-slate-900 border border-slate-600 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-600">
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-bold text-slate-300 mb-1">Categorías (separadas por coma)</label>
              <input x-model="categoriesText" type="text" class="w-full px-3 py-2 bg-slate-900 border border-slate-600 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-600">
            </div>
            <div>
              <label class="block text-xs font-bold text-slate-300 mb-1">Descripción (SEO)</label>
              <input x-model="borrador.description" type="text" class="w-full px-3 py-2 bg-slate-900 border border-slate-600 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-600">
            </div>
          </div>

          <div>
            <div class="flex items-center justify-between mb-1">
              <label class="block text-xs font-bold text-slate-300">Contenido (Markdown)</label>
              <div class="flex gap-2">
                <button @click="togglePreview()" type="button" class="text-xs text-indigo-400 hover:text-indigo-300 font-bold">
                  <span x-text="showPreview ? 'Editar' : 'Vista previa'"></span>
                </button>
                <span x-show="showPreview" @click="showPreview = false" class="text-xs text-slate-500 cursor-pointer">✕</span>
              </div>
            </div>
            <textarea x-show="!showPreview" x-model="borrador.bodyMarkdown" rows="14" class="w-full px-3 py-2 bg-slate-900 border border-slate-600 rounded-lg text-sm font-mono focus:outline-none focus:ring-2 focus:ring-indigo-600"></textarea>
            <div x-show="showPreview" class="prose-pre:bg-slate-950 bg-slate-900 border border-slate-600 rounded-lg p-4 text-sm max-h-[420px] overflow-y-auto markdown-preview" x-html="previewHtml"></div>
          </div>

          <!-- Imagen -->
          <div class="border-t border-slate-700 pt-4 space-y-3">
            <h3 class="text-sm font-bold text-slate-200">4. Imagen de tapa (800x450)</h3>
            <div x-show="op && op.id === 'imagen'" class="rounded-lg overflow-hidden border border-slate-700">
              <div class="skeleton aspect-video w-full"></div>
            </div>
            <div x-show="coverUrl && !(op && op.id === 'imagen')" class="rounded-lg overflow-hidden border border-slate-600">
              <img :src="coverUrl" alt="Tapa generada" class="w-full aspect-video object-cover">
            </div>
            <div>
              <label class="block text-xs font-bold text-slate-300 mb-1">Prompt de la tapa (generado por DeepSeek, editable)</label>
              <textarea x-model="coverPrompt" rows="2" class="w-full px-3 py-2 bg-slate-900 border border-slate-600 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-600" placeholder="Dejalo vacío para que DeepSeek lo genere solo."></textarea>
            </div>
            <button @click="generarImagen()" :disabled="busy" class="px-4 py-2 bg-indigo-700 hover:bg-indigo-800 disabled:opacity-60 text-sm font-bold rounded-lg inline-flex items-center gap-2 justify-center">
              <span x-show="op && op.id === 'imagen'" class="spinner spinner-xs"></span>
              <span x-text="op && op.id === 'imagen' ? 'Generando…' : (coverUrl ? 'Regenerar imagen' : 'Generar imagen')"></span>
            </button>
          </div>

          <!-- Publicar -->
          <div class="border-t border-slate-700 pt-4 flex flex-wrap gap-3">
            <button @click="publicar(false)" :disabled="busy" class="px-5 py-2 bg-green-700 hover:bg-green-800 disabled:opacity-60 text-sm font-bold rounded-lg inline-flex items-center gap-2 justify-center">
              <span x-show="op && op.id === 'publicar'" class="spinner spinner-xs"></span>
              <span x-text="op && op.id === 'publicar' ? 'Guardando…' : (editingId ? 'Actualizar y publicar' : 'Publicar')"></span>
            </button>
            <button @click="publicar(true)" :disabled="busy" class="px-5 py-2 bg-slate-700 hover:bg-slate-600 disabled:opacity-60 text-sm font-bold rounded-lg inline-flex items-center gap-2 justify-center">
              <span x-show="op && op.id === 'publicar'" class="spinner spinner-xs"></span>
              <span x-text="op && op.id === 'publicar' ? 'Guardando…' : 'Guardar borrador'"></span>
            </button>
            <button @click="nuevoPost()" class="px-5 py-2 border border-slate-600 hover:border-slate-500 text-sm font-bold rounded-lg">Nuevo post</button>
          </div>
          </div>
        </template>
      </section>

      <!-- ===== Lista de posts ===== -->
      <aside class="space-y-4">
        <div class="bg-slate-800 rounded-xl p-5">
          <h2 class="text-base font-bold mb-3">Posts existentes</h2>
          <div x-show="!posts.length" class="text-sm text-slate-400">Sin posts todavía.</div>
          <div class="space-y-2">
            <template x-for="p in posts" :key="p.id">
              <div class="bg-slate-900 border border-slate-700 rounded-lg p-3">
                <div class="flex items-start justify-between gap-2">
                  <p class="text-sm font-bold" x-text="p.title"></p>
                  <span class="text-[10px] px-2 py-0.5 rounded-full shrink-0" :class="p.draft ? 'bg-yellow-500/20 text-yellow-400' : 'bg-green-500/20 text-green-400'" x-text="p.draft ? 'borrador' : 'publicado'"></span>
                </div>
                <p class="text-xs text-slate-400 mt-1" x-text="p.pub_date + ' · ' + (p.categories || []).join(', ')"></p>
                <div class="flex gap-2 mt-2 text-xs">
                  <button @click="cargarPost(p)" class="text-indigo-400 hover:text-indigo-300 font-bold">Editar</button>
                  <button @click="toggleDraft(p)" class="text-slate-400 hover:text-white font-bold" x-text="p.draft ? 'Publicar' : 'A borrador'"></button>
                  <button @click="borrarPost(p)" class="text-red-400 hover:text-red-300 font-bold">Eliminar</button>
                </div>
              </div>
            </template>
          </div>
        </div>

        <div class="bg-slate-800 rounded-xl p-5 text-xs text-slate-400 space-y-2">
          <h3 class="text-sm font-bold text-slate-200">Notas</h3>
          <p>Redactá con el actor, revisá con el crítico IA (hook, precisión, tono y extensión) y aplicá correcciones hasta 2 rondas. Siempre podés editar a mano o publicar.</p>
          <p>Al publicar, el post se guarda en la base y aparece en <span class="text-slate-200">/blog</span> tras el próximo build (el deploy corre cada 12 hs o manual desde GitHub).</p>
          <p>Las llaves de IA viven como secrets de Supabase: nunca viajan al navegador.</p>
        </div>
      </aside>
    </div>
  </div>

  <style>
    [x-cloak] { display: none !important; }
    @keyframes mglab-spin { to { transform: rotate(360deg); } }
    .spinner { display: inline-block; border-radius: 9999px; border: 2px solid rgba(255,255,255,.18); border-top-color: #818cf8; animation: mglab-spin .7s linear infinite; vertical-align: middle; }
    .spinner-sm { width: 14px; height: 14px; }
    .spinner-xs { width: 10px; height: 10px; border-width: 2px; }
    @keyframes mglab-shimmer { 0% { transform: translateX(-100%); } 100% { transform: translateX(100%); } }
    .shimmer-bar { position: relative; overflow: hidden; background: rgba(99,102,241,.18); }
    .shimmer-bar::after { content: ""; position: absolute; top: 0; bottom: 0; left: 0; width: 40%; background: linear-gradient(90deg, transparent, rgba(129,140,248,.8), transparent); animation: mglab-shimmer 1.1s infinite; }
    .skeleton { position: relative; overflow: hidden; background: rgba(255,255,255,.06); border-radius: 8px; }
    .skeleton::after { content: ""; position: absolute; top: 0; bottom: 0; left: 0; width: 60%; background: linear-gradient(90deg, transparent, rgba(255,255,255,.12), transparent); transform: translateX(-100%); animation: mglab-shimmer 1.3s infinite; }
    .markdown-preview h1, .markdown-preview h2, .markdown-preview h3 { font-weight: 700; margin: 0.75em 0 0.4em; }
    .markdown-preview h1 { font-size: 1.4em; } .markdown-preview h2 { font-size: 1.2em; } .markdown-preview h3 { font-size: 1.05em; }
    .markdown-preview p { margin: 0.5em 0; }
    .markdown-preview ul, .markdown-preview ol { margin: 0.5em 0 0.5em 1.4em; list-style: disc; }
    .markdown-preview ol { list-style: decimal; }
    .markdown-preview code { background: #0f172a; padding: 1px 5px; border-radius: 4px; font-size: 0.9em; }
    .markdown-preview pre { background: #0f172a; padding: 10px; border-radius: 6px; overflow-x: auto; margin: 0.5em 0; }
    .markdown-preview pre code { background: transparent; padding: 0; }
    .markdown-preview blockquote { border-left: 3px solid #6366f1; padding-left: 12px; color: #94a3b8; font-style: italic; margin: 0.5em 0; }
    .markdown-preview a { color: #818cf8; text-decoration: underline; }
    .markdown-preview img { max-width: 100%; border-radius: 6px; }
    .markdown-preview strong { font-weight: 700; }
    .markdown-preview em { font-style: italic; }
  </style>
</div>

<script>
  import Alpine from 'alpinejs';
  import {
    supabase,
    resolveLoginUser,
    markSessionStart,
    clearSessionStart,
    scheduleSessionEnd,
  } from '../../lib/supabase';

  window.Alpine = Alpine;

  const BASE = import.meta.env.BASE_URL;
  window.__BLOG_BASE__ = BASE.endsWith('/') ? BASE : `${BASE}/`;

  function slugify(text: string) {
    return (text || '')
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-+|-+$/g, '')
      .slice(0, 80) || 'post';
  }

  // Preview minimalista de markdown (solo para el editor)
  function escapeHtml(s: string) {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }
  function inlineMd(s: string) {
    return escapeHtml(s)
      .replace(/`([^`]+)`/g, '<code>$1</code>')
      .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
      .replace(/(^|[^*])\*([^*]+)\*/g, '$1<em>$2</em>')
      .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>');
  }
  function renderMarkdown(md: string) {
    if (!md) return '';
    const lines = md.split(/\r?\n/);
    let html = '';
    let inCode = false;
    let listType = null;
    for (const raw of lines) {
      const line = raw.replace(/\s+$/, '');
      if (line.startsWith('```')) {
        if (inCode) { html += '</code></pre>'; inCode = false; }
        else { html += '<pre><code>'; inCode = true; }
        continue;
      }
      if (inCode) { html += escapeHtml(line) + '\n'; continue; }
      const h = line.match(/^(#{1,6})\s+(.*)$/);
      if (h) {
        const lvl = h[1].length;
        if (listType) { html += `</${listType}>`; listType = null; }
        html += `<h${lvl}>${inlineMd(h[2])}</h${lvl}>`;
        continue;
      }
      if (/^\s*(-|\*|\+)\s+/.test(line)) {
        const content = line.replace(/^\s*(-|\*|\+)\s+/, '');
        if (listType !== 'ul') { if (listType) html += `</${listType}>`; html += '<ul>'; listType = 'ul'; }
        html += `<li>${inlineMd(content)}</li>`;
        continue;
      }
      if (/^\s*\d+\.\s+/.test(line)) {
        const content = line.replace(/^\s*\d+\.\s+/, '');
        if (listType !== 'ol') { if (listType) html += `</${listType}>`; html += '<ol>'; listType = 'ol'; }
        html += `<li>${inlineMd(content)}</li>`;
        continue;
      }
      if (line.startsWith('> ')) {
        if (listType) { html += `</${listType}>`; listType = null; }
        html += `<blockquote>${inlineMd(line.slice(2))}</blockquote>`;
        continue;
      }
      if (listType) { html += `</${listType}>`; listType = null; }
      if (line.trim() === '') continue;
      html += `<p>${inlineMd(line)}</p>`;
    }
    if (inCode) html += '</code></pre>';
    if (listType) html += `</${listType}>`;
    return html;
  }

  const OP_STEPS: Record<string, string[]> = {
    url: ['Conectar', 'Extraer el texto', 'Limpiar el texto'],
    propuestas: ['Conectar', 'Analizar el tema', 'Buscar ángulos', 'Armar respuesta'],
    redactar: ['Conectar', 'Redactar el borrador', 'Parsear respuesta'],
    revisar: ['Conectar', 'Revisar calidad', 'Chequear extensión'],
    corregir: ['Conectar', 'Aplicar correcciones', 'Parsear respuesta'],
    imagen: ['Conectar', 'Prompt de tapa', 'Generar imagen', 'Subir a storage'],
    publicar: ['Guardar en la base'],
  };
  const OP_MSGS: Record<string, string[]> = {
    url: ['Conectando…', 'Extrayendo el artículo…', 'Limpiando el texto…'],
    propuestas: ['Conectando con DeepSeek…', 'Analizando el tema…', 'Buscando ángulos distintos…', 'Redactando resúmenes…'],
    redactar: ['Redactando el borrador…', 'Puliendo el hook…', 'Ajustando la estructura…'],
    revisar: ['Revisando hook y precisión…', 'Chequeando tono…', 'Verificando extensión…'],
    corregir: ['Aplicando correcciones…', 'Reescribiendo pasajes…', 'Puliendo detalles…'],
    imagen: ['Consultando al director de arte…', 'Generando la imagen 16:9…', 'Subiendo a storage…'],
    publicar: ['Guardando en la base…'],
  };

  Alpine.data('blogAdmin', () => ({
    loadingAuth: true,
    user: null as any,
    userRole: null as any,
    loginEmail: 'cervantes',
    loginPassword: '',
    loginError: '',

    form: { tema: '', enfoque: '', tono: 'Cercano y directo', fraseClave: '', tiempoLecturaMin: '5' },
    urlRef: '',
    propuestas: [] as any[],
    propuestaIndex: -1,
    borrador: null as any,
    review: null as any,
    iteracion: 0,
    correccionPrompt: '',
    categoriesText: '',
    temasHistory: [] as any[],
    coverPrompt: '',
    coverUrl: '',
    editingId: null as any,
    showPreview: false,
    previewHtml: '',
    busy: false,
    status: '',
    posts: [] as any[],
    op: null as any,
    opHistory: [] as any[],

    async init() {
      const { data } = await supabase.auth.getSession();
      if (data?.session?.user) {
        this.user = data.session.user;
        await this.loadProfile();
        if (this.userRole === 'admin') this.loadPosts();
      }
      this.loadingAuth = false;
      this.loadTemasHistory();
    },

    async loadProfile() {
      const { data } = await supabase
        .from('profiles')
        .select('role')
        .eq('id', this.user.id)
        .maybeSingle();
      this.userRole = data?.role || null;
    },

    async login() {
      this.loginError = '';
      this.busy = true;
      try {
        const { data, error } = await supabase.auth.signInWithPassword({
          email: resolveLoginUser(this.loginEmail),
          password: this.loginPassword,
        });
        if (error) throw error;
        this.user = data.user;
        this.loginPassword = '';
        await this.loadProfile();
        markSessionStart();
        scheduleSessionEnd(() => this.logout(true));
        if (this.userRole === 'admin') this.loadPosts();
      } catch (e) {
        this.loginError = (e as Error).message || 'Error al iniciar sesión';
      } finally {
        this.busy = false;
      }
    },

    async logout(auto = false) {
      if (!auto) clearSessionStart();
      this.clearOpInterval();
      this.op = null;
      this.busy = false;
      await supabase.auth.signOut();
      this.user = null;
      this.userRole = null;
      this.posts = [];
    },

    async loadPosts() {
      const { data, error } = await supabase
        .from('blogs')
        .select('*')
        .order('pub_date', { ascending: false });
      if (!error) this.posts = data || [];
    },

    loadTemasHistory() {
      try {
        const raw = localStorage.getItem('mglab_blog_temas_history');
        const arr = raw ? JSON.parse(raw) : [];
        this.temasHistory = Array.isArray(arr) ? arr : [];
      } catch {
        this.temasHistory = [];
      }
    },

    persistTemasHistory() {
      try {
        localStorage.setItem('mglab_blog_temas_history', JSON.stringify(this.temasHistory));
      } catch {}
    },

    saveTemaEntry() {
      const tema = (this.form.tema || '').trim();
      if (!tema) return;
      const entry = {
        id: (typeof crypto !== 'undefined' && crypto.randomUUID)
          ? crypto.randomUUID()
          : `${Date.now()}-${Math.random().toString(36).slice(2)}`,
        tema,
        enfoque: (this.form.enfoque || '').trim() || null,
        tono: (this.form.tono || '').trim() || null,
        fraseClave: (this.form.fraseClave || '').trim() || null,
        savedAt: new Date().toISOString(),
      };
      this.temasHistory = [
        entry,
        ...this.temasHistory.filter(
          (e: any) => (e.tema || '').toLowerCase() !== tema.toLowerCase()
        ),
      ].slice(0, 10);
      this.persistTemasHistory();
    },

    deleteTemaEntry(id: string) {
      this.temasHistory = this.temasHistory.filter((e: any) => e.id !== id);
      this.persistTemasHistory();
    },

    useTemaEntry(id: string) {
      const e = this.temasHistory.find((x: any) => x.id === id);
      if (!e) return;
      this.form.tema = e.tema || '';
      this.form.enfoque = e.enfoque || '';
      this.form.tono = e.tono || 'Cercano y directo';
      this.form.fraseClave = e.fraseClave || '';
    },

    startOp(id: string, label: string, steps: string[], messages: string[]) {
      this.clearOpInterval();
      const now = Date.now();
      this.op = {
        id,
        label,
        startedAt: now,
        elapsed: '0:00',
        messages,
        msgIndex: 0,
        stepIndex: 0,
        steps: steps.map((s, i) => ({
          label: s,
          status: i === 0 ? 'active' : 'pending',
          ts: i === 0 ? now : null,
        })),
        interval: null as any,
        msgInterval: null as any,
        finished: false,
      };
      this.busy = true;
      this.status = messages[0] || '';
      this.op.interval = setInterval(() => this.tickOp(), 1000);
      this.op.msgInterval = setInterval(() => this.rotateOpMsg(), 3000);
    },

    clearOpInterval() {
      if (this.op?.interval) { clearInterval(this.op.interval); this.op.interval = null; }
      if (this.op?.msgInterval) { clearInterval(this.op.msgInterval); this.op.msgInterval = null; }
    },

    tickOp() {
      if (!this.op || this.op.finished) return;
      const now = Date.now();
      const secs = Math.floor((now - this.op.startedAt) / 1000);
      this.op.elapsed = `${Math.floor(secs / 60)}:${String(secs % 60).padStart(2, '0')}`;
      const cur = this.op.steps[this.op.stepIndex];
      if (cur && cur.status === 'active' && cur.ts && now - cur.ts > 8000) {
        cur.status = 'done';
        const next = this.op.stepIndex + 1;
        if (next < this.op.steps.length) {
          this.op.steps[next].status = 'active';
          this.op.steps[next].ts = now;
          this.op.stepIndex = next;
        }
      }
      this.op = { ...this.op };
    },

    rotateOpMsg() {
      if (!this.op || this.op.finished) return;
      const len = this.op.messages?.length || 1;
      this.op.msgIndex = (this.op.msgIndex + 1) % len;
      this.op = { ...this.op };
    },

    _opElapsed(): string {
      const secs = Math.floor((Date.now() - (this.op?.startedAt || Date.now())) / 1000);
      return `${Math.floor(secs / 60)}:${String(secs % 60).padStart(2, '0')}`;
    },

    finishOp(successMsg: string) {
      if (!this.op) { this.busy = false; return; }
      const o = this.op;
      this.clearOpInterval();
      o.steps.forEach((s: any) => { if (s.status !== 'error') s.status = 'done'; });
      o.finished = true;
      this.opHistory.unshift({
        id: o.id,
        label: o.label,
        ok: true,
        result: successMsg,
        elapsed: this._opElapsed(),
        ts: Date.now(),
      });
      this.opHistory = this.opHistory.slice(0, 5);
      this.status = successMsg;
      this.busy = false;
      this.op = null;
    },

    failOp(errorMsg: string) {
      if (!this.op) { this.busy = false; return; }
      const o = this.op;
      this.clearOpInterval();
      const cur = o.steps[o.stepIndex] || o.steps[o.steps.length - 1];
      if (cur) cur.status = 'error';
      o.finished = true;
      this.opHistory.unshift({
        id: o.id,
        label: o.label,
        ok: false,
        result: errorMsg,
        elapsed: this._opElapsed(),
        ts: Date.now(),
      });
      this.opHistory = this.opHistory.slice(0, 5);
      this.status = errorMsg;
      this.busy = false;
      this.op = null;
    },

    async traerTextoUrl() {
      const url = (this.urlRef || '').trim();
      if (!url) { this.status = 'Pegá una URL primero.'; return; }
      this.startOp('url', 'Traer texto de la URL', OP_STEPS.url, OP_MSGS.url);
      try {
        const { data, error } = await supabase.functions.invoke('blog-fetch-url', { body: { url } });
        if (error) throw new Error(error.context?.error || error.message);
        this.form.fraseClave = data.text || '';
        this.finishOp('Texto traído. Ajustalo si hace falta y generá propuestas.');
      } catch (e) {
        this.failOp((e as Error).message);
      }
    },

    async generarPropuestas() {
      if (!this.form.tema) { this.status = 'Ingresá un tema.'; return; }
      this.startOp('propuestas', 'Generar propuestas', OP_STEPS.propuestas, OP_MSGS.propuestas);
      try {
        const { data, error } = await supabase.functions.invoke('blog-proposals', { body: this.form });
        if (error) throw new Error(error.context?.error || error.message);
        this.propuestas = data.propuestas || [];
        this.propuestaIndex = -1;
        this.saveTemaEntry();
        this.finishOp(`${this.propuestas.length} propuesta(s) generadas. Elegí una.`);
      } catch (e) {
        this.failOp((e as Error).message);
      }
    },

    async redactar() {
      if (this.propuestaIndex < 0) { this.status = 'Elegí una propuesta.'; return; }
      this.startOp('redactar', 'Redactar el post', OP_STEPS.redactar, OP_MSGS.redactar);
      try {
        const { data, error } = await supabase.functions.invoke('blog-write', {
          body: { ...this.form, propuesta: this.propuestas[this.propuestaIndex] },
        });
        if (error) throw new Error(error.context?.error || error.message);
        this.borrador = data.borrador;
        this.review = null;
        this.iteracion = 0;
        this.correccionPrompt = '';
        this.categoriesText = (data.borrador.categories || []).join(', ');
        this.coverUrl = '';
        this.coverPrompt = '';
        this.showPreview = false;
        this.finishOp('Borrador listo. Revisalo, ajustá y publicá.');
      } catch (e) {
        this.failOp((e as Error).message);
      }
    },

    async revisar() {
      if (!this.borrador) { this.status = 'Primero redactá el post.'; return; }
      this.startOp('revisar', 'Revisar con el crítico IA', OP_STEPS.revisar, OP_MSGS.revisar);
      try {
        const { data, error } = await supabase.functions.invoke('blog-review', {
          body: {
            borrador: {
              title: this.borrador.title,
              categories: this.borrador.categories || [],
              description: this.borrador.description,
              bodyMarkdown: this.borrador.bodyMarkdown,
            },
            tiempoLecturaMin: Number(this.form.tiempoLecturaMin) || null,
          },
        });
        if (error) throw new Error(error.context?.error || error.message);
        this.review = data.review || null;
        this.finishOp(
          this.review?.aprobado
            ? 'El crítico aprobó el borrador. Listo para publicar.'
            : 'El crítico marcó problemas. Podés aplicar correcciones o editarlas a mano.'
        );
      } catch (e) {
        this.failOp((e as Error).message);
      }
    },

    async aplicarCorrecciones() {
      if (!this.borrador) { this.status = 'Primero redactá el post.'; return; }
      const instruccion = (this.correccionPrompt || '').trim();
      if (!this.review && !instruccion) {
        this.status = 'Escribí una corrección abajo o corré el crítico con "Revisar con IA".';
        return;
      }
      if (this.iteracion >= 2) { this.status = 'Tope de revisiones alcanzado.'; return; }
      this.startOp('corregir', 'Aplicar corrección', OP_STEPS.corregir, OP_MSGS.corregir);
      try {
        const { data, error } = await supabase.functions.invoke('blog-revise', {
          body: {
            borrador: {
              title: this.borrador.title,
              categories: this.borrador.categories || [],
              description: this.borrador.description,
              bodyMarkdown: this.borrador.bodyMarkdown,
            },
            problemas: this.review?.problemas || [],
            instruccion,
            tiempoLecturaMin: Number(this.form.tiempoLecturaMin) || null,
          },
        });
        if (error) throw new Error(error.context?.error || error.message);
        this.borrador = data.borrador;
        this.categoriesText = (data.borrador.categories || []).join(', ');
        this.iteracion++;
        this.review = null;
        this.correccionPrompt = '';
        this.showPreview = false;
        this.finishOp(`Corrección aplicada (iteración ${this.iteracion}/2). Revisá de nuevo.`);
      } catch (e) {
        this.failOp((e as Error).message);
      }
    },

    async generarImagen() {
      if (!this.borrador) { this.status = 'Primero redactá el post.'; return; }
      this.startOp('imagen', 'Generar imagen de tapa', OP_STEPS.imagen, OP_MSGS.imagen);
      try {
        const { data, error } = await supabase.functions.invoke('blog-cover', {
          body: {
            title: this.borrador.title,
            description: this.borrador.description,
            bodyMarkdown: this.borrador.bodyMarkdown,
            prompt: this.coverPrompt || null,
          },
        });
        if (error) throw new Error(error.context?.error || error.message);
        this.coverUrl = data.coverUrl;
        this.coverPrompt = data.prompt;
        this.finishOp('Imagen de tapa lista.');
      } catch (e) {
        this.failOp((e as Error).message);
      }
    },

    async uniqueSlug(base: string) {
      const { data } = await supabase.from('blogs').select('slug');
      const existing = new Set((data || []).map((r) => r.slug));
      if (!existing.has(base)) return base;
      let i = 2;
      while (existing.has(`${base}-${i}`)) i++;
      return `${base}-${i}`;
    },

    async publicar(draft: boolean) {
      if (!this.borrador?.title || !this.borrador?.bodyMarkdown) {
        this.status = 'No hay borrador para publicar.';
        return;
      }
      this.startOp('publicar', draft ? 'Guardar borrador' : 'Publicar', OP_STEPS.publicar, OP_MSGS.publicar);
      try {
        const payload: any = {
          title: this.borrador.title,
          pub_date: new Date().toISOString().slice(0, 10),
          author: 'Mauricio Gonzalez',
          categories: this.categoriesText.split(',').map((s) => s.trim()).filter(Boolean),
          description: this.borrador.description,
          body_markdown: this.borrador.bodyMarkdown,
          cover_url: this.coverUrl || null,
          draft,
        };
        if (this.editingId) {
          payload.slug = slugify(this.borrador.title);
          const res = await supabase.from('blogs').update(payload).eq('id', this.editingId);
          if (res.error) throw new Error(res.error.message);
        } else {
          payload.slug = await this.uniqueSlug(slugify(this.borrador.title));
          const res = await supabase.from('blogs').insert(payload);
          if (res.error) throw new Error(res.error.message);
        }
        this.editingId = null;
        await this.loadPosts();
        this.finishOp(
          draft
            ? 'Borrador guardado.'
            : '¡Publicado! Aparece en /blog tras el próximo build (cron 12 hs o deploy manual).'
        );
      } catch (e) {
        this.failOp((e as Error).message);
      }
    },

    async toggleDraft(p: any) {
      const res = await supabase.from('blogs').update({ draft: !p.draft }).eq('id', p.id);
      if (!res.error) this.loadPosts();
    },

    async borrarPost(p: any) {
      if (!window.confirm(`¿Eliminar "${p.title}"? Esta acción no se puede deshacer.`)) return;
      const res = await supabase.from('blogs').delete().eq('id', p.id);
      if (!res.error) {
        if (this.editingId === p.id) this.nuevoPost();
        this.loadPosts();
      }
    },

    cargarPost(p: any) {
      this.editingId = p.id;
      this.borrador = {
        title: p.title,
        description: p.description,
        bodyMarkdown: p.body_markdown,
        categories: p.categories || [],
      };
this.review = null;
      this.iteracion = 0;
      this.correccionPrompt = '';
      this.coverUrl = p.cover_url || '';
      this.coverPrompt = '';
      this.showPreview = false;
      window.scrollTo({ top: 0, behavior: 'smooth' });
    },

    togglePreview() {
      this.previewHtml = renderMarkdown(this.borrador?.bodyMarkdown || '');
      this.showPreview = !this.showPreview;
    },

    nuevoPost() {
      this.editingId = null;
      this.borrador = null;
      this.review = null;
      this.iteracion = 0;
      this.correccionPrompt = '';
      this.coverUrl = '';
      this.coverPrompt = '';
      this.propuestas = [];
      this.propuestaIndex = -1;
      this.showPreview = false;
      this.form.tema = '';
      this.form.enfoque = '';
      this.form.tono = 'Cercano y directo';
      this.form.fraseClave = '';
      this.form.tiempoLecturaMin = '5';
      this.urlRef = '';
    },
  }));

  Alpine.start();
</script>