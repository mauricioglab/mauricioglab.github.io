            </div>
            <button @click="generarImagen()" :disabled="busy" class="px-4 py-2 bg-indigo-700 hover:bg-indigo-800 disabled:opacity-50 text-sm font-bold rounded-lg">
              <span x-text="busy ? 'Generando imagen...' : (coverUrl ? 'Regenerar imagen' : 'Generar imagen')"></span>
            </button>
          </div>

          <!-- Publicar -->
          <div class="border-t border-slate-700 pt-4 flex flex-wrap gap-3">
            <button @click="publicar(false)" :disabled="busy" class="px-5 py-2 bg-green-700 hover:bg-green-800 disabled:opacity-50 text-sm font-bold rounded-lg">
              <span x-text="busy ? 'Publicando...' : (editingId ? 'Actualizar y publicar' : 'Publicar')"></span>
            </button>
            <button @click="publicar(true)" :disabled="busy" class="px-5 py-2 bg-slate-700 hover:bg-slate-600 disabled:opacity-50 text-sm font-bold rounded-lg">Guardar borrador</button>
            <button @click="nuevoPost()" class="px-5 py-2 border border-slate-600 hover:border-slate-500 text-sm font-bold rounded-lg">Nuevo post</button>
