---
import BlogAdmin from './BlogAdmin.astro';
import DisertacionesAdmin from './DisertacionesAdmin.astro';
import MovimientoAdmin from './MovimientoAdmin.astro';
import RecursosAdmin from './RecursosAdmin.astro';
import {
  getAllPages,
  getPagesByCategory,
  categoryLabels,
  type PageCategory,
} from '../../data/pages-registry';

const base = import.meta.env.BASE_URL;
const b = base.endsWith('/') ? base : `${base}/`;

const categories: PageCategory[] = ['public', 'landing', 'project', 'tool'];

const pagesByCategory = categories.map((cat) => ({
  category: cat,
  label: categoryLabels[cat],
  pages: getPagesByCategory(cat).map((p) => ({
    ...p,
    url: p.url.startsWith('/') ? `${b}${p.url.slice(1)}` : p.url,
  })),
})).filter((c) => c.pages.length > 0);

const totalPages = getAllPages().length;
---

<div x-data="gestionAdmin()" x-init="init()" class="min-h-screen bg-slate-900 text-white" x-cloak>
  <!-- ============ LOGIN / GATE ============ -->
  <div x-show="!user || userRole !== 'admin'" class="min-h-screen flex items-center justify-center p-6">
    <div class="w-full max-w-sm">
      <div class="bg-slate-800 rounded-xl p-6 shadow-xl">
        <h1 class="text-xl font-bold mb-1">🗂️ Panel de Gestión</h1>
        <p class="text-sm text-slate-400 mb-4">Acceso restringido al equipo docente.</p>

        <div x-show="user && userRole && userRole !== 'admin'">
          <p class="text-sm text-red-400 bg-red-500/10 border border-red-500/30 rounded-lg p-3 mb-4">
            Tu usuario no tiene rol <strong>admin</strong>. Contactá al administrador.
          </p>
          <button @click="logout()" class="w-full py-2 bg-slate-700 hover:bg-slate-600 text-white text-sm font-bold rounded-lg">
            Cerrar sesión
          </button>
        </div>

        <template x-if="!user">
          <div>
            <div x-show="loadingAuth" class="text-center text-sm text-slate-400 py-6">Cargando...</div>
            <form x-show="!loadingAuth" @submit.prevent="login()">
              <div class="mb-3">
                <label class="block text-xs font-bold text-slate-300 mb-1">Usuario o Email</label>
                <input x-model="loginEmail" type="text" class="w-full px-3 py-2 bg-slate-900 border border-slate-600 rounded-lg text-sm text-white focus:outline-none focus:ring-2 focus:ring-indigo-600">
              </div>
              <div class="mb-4">
                <label class="block text-xs font-bold text-slate-300 mb-1">Contraseña</label>
                <input x-model="loginPassword" type="password" class="w-full px-3 py-2 bg-slate-900 border border-slate-600 rounded-lg text-sm text-white focus:outline-none focus:ring-2 focus:ring-indigo-600" required>
              </div>
              <p x-show="loginError" class="text-xs text-red-400 mb-3 font-bold" x-text="loginError"></p>
              <button type="submit" class="w-full py-2 bg-indigo-700 hover:bg-indigo-800 text-white text-sm font-bold rounded-lg" :disabled="loadingAuth || busy">
                <span x-text="busy ? '...' : 'Ingresar'"></span>
              </button>
            </form>
          </div>
        </template>
      </div>
    </div>
  </div>

  <!-- ============ GESTIÓN ============ -->
  <div x-show="user && userRole === 'admin'" class="max-w-7xl mx-auto p-4 md:p-6">
    <div class="flex items-center justify-between mb-4">
      <div>
        <h1 class="text-2xl font-bold">🗂️ Panel de Gestión</h1>
        <p class="text-sm text-slate-400" x-text="user ? user.email : ''"></p>
      </div>
      <button @click="logout()" class="px-3 py-1.5 bg-red-600/20 text-red-400 rounded-lg hover:bg-red-600/30 text-sm">Salir</button>
    </div>

    <div class="border-b border-slate-700 mb-6 flex gap-1 overflow-x-auto" role="tablist">
      <button
        @click="setTab('enlaces')"
        class="px-4 py-2.5 text-sm font-bold border-b-2 -mb-px transition whitespace-nowrap"
        :class="activeTab === 'enlaces' ? 'border-indigo-500 text-white' : 'border-transparent text-slate-400 hover:text-slate-200'"
        role="tab" :aria-selected="activeTab === 'enlaces'"
      >🔗 Enlaces</button>
      <button
        @click="setTab('blog')"
        class="px-4 py-2.5 text-sm font-bold border-b-2 -mb-px transition whitespace-nowrap"
        :class="activeTab === 'blog' ? 'border-indigo-500 text-white' : 'border-transparent text-slate-400 hover:text-slate-200'"
        role="tab" :aria-selected="activeTab === 'blog'"
      >📝 Blog</button>
      <button
        @click="setTab('disertaciones')"
        class="px-4 py-2.5 text-sm font-bold border-b-2 -mb-px transition whitespace-nowrap"
        :class="activeTab === 'disertaciones' ? 'border-indigo-500 text-white' : 'border-transparent text-slate-400 hover:text-slate-200'"
        role="tab" :aria-selected="activeTab === 'disertaciones'"
      >🎤 Disertaciones</button>
      <button
        @click="setTab('movimiento')"
        class="px-4 py-2.5 text-sm font-bold border-b-2 -mb-px transition whitespace-nowrap"
        :class="activeTab === 'movimiento' ? 'border-indigo-500 text-white' : 'border-transparent text-slate-400 hover:text-slate-200'"
        role="tab" :aria-selected="activeTab === 'movimiento'"
      >🤸 Movimiento</button>
      <button
        @click="setTab('recursos')"
        class="px-4 py-2.5 text-sm font-bold border-b-2 -mb-px transition whitespace-nowrap"
        :class="activeTab === 'recursos' ? 'border-indigo-500 text-white' : 'border-transparent text-slate-400 hover:text-slate-200'"
        role="tab" :aria-selected="activeTab === 'recursos'"
      >📚 Zona Lab</button>
    </div>

    <div x-show="activeTab === 'enlaces'" class="space-y-6">
      <div>
        <h2 class="text-base font-bold mb-3">📊 Resumen de contenido</h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
          <template x-for="card in dashboardCards" :key="card.key">
            <button @click="setTab(card.key)" class="text-left bg-slate-800 hover:bg-slate-700/80 transition rounded-xl p-4">
              <div class="flex items-center gap-2 text-sm text-slate-400 mb-2">
                <span x-text="card.icon"></span>
                <span x-text="card.label"></span>
              </div>
              <template x-if="statsLoading">
                <div class="h-7 w-10 skeleton rounded"></div>
              </template>
              <template x-if="!statsLoading">
                <div>
                  <p class="text-2xl font-bold" x-text="card.total"></p>
                  <p class="text-xs text-slate-500">
                    <span x-text="card.published"></span> publicados · <span x-text="card.draft"></span> borradores
                  </p>
                </div>
              </template>
            </button>
          </template>
        </div>
      </div>

      <div class="flex items-center justify-between">
        <p class="text-sm text-slate-400">{totalPages} páginas en el sitio</p>
        <a href={b} class="text-sm text-slate-400 hover:text-white">← Inicio</a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {pagesByCategory.map((group) => (
          <section class="bg-slate-800 rounded-xl p-4">
            <h2 class="text-base font-bold mb-3 flex items-center gap-2">
              {group.category === 'public' && '🌐'}
              {group.category === 'landing' && '🚀'}
              {group.category === 'project' && '📁'}
              {group.category === 'tool' && '🛠️'}
              {group.label}
              <span class="text-xs font-normal text-slate-500">({group.pages.length})</span>
            </h2>
            <div class="space-y-1">
              {group.pages.map((page) => (
                <a
                  href={page.url}
                  class="flex items-center gap-2 p-2 rounded-lg bg-slate-700/50 hover:bg-slate-700 transition group text-sm"
                >
                  {page.icon && <span>{page.icon}</span>}
                  <span class="text-slate-200 group-hover:text-white transition truncate">{page.name}</span>
                </a>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>

    <div x-show="activeTab === 'blog'"><BlogAdmin /></div>
    <div x-show="activeTab === 'disertaciones'"><DisertacionesAdmin /></div>
    <div x-show="activeTab === 'movimiento'"><MovimientoAdmin /></div>
    <div x-show="activeTab === 'recursos'"><RecursosAdmin /></div>
  </div>

  <style is:global>
    [x-cloak] { display: none !important; }
    @keyframes mglab-spin { to { transform: rotate(360deg); } }
    .spinner { display: inline-block; border-radius: 9999px; border: 2px solid rgba(255,255,255,.18); border-top-color: #818cf8; animation: mglab-spin .7s linear infinite; vertical-align: middle; }
    .spinner-sm { width: 14px; height: 14px; }
    .spinner-xs { width: 10px; height: 10px; border-width: 2px; }
    @keyframes mglab-shimmer { 0% { transform: translateX(-100%); } 100% { transform: translateX(100%); } }
    .shimmer-bar { position: relative; overflow: hidden; background: rgba(99,102,241,.18); }
    .shimmer-bar::after { content: ""; position: absolute; top: 0; bottom: 0; left: 0; width: 40%; background: linear-gradient(90deg, transparent, rgba(129,140,248,.8), transparent); animation: mglab-shimmer 1.1s infinite; }
    .skeleton { position: relative; overflow: hidden; background: rgba(255,255,255,.06); border-radius: 8px; }
    .skeleton::after { content: ""; position: absolute; top: 0; bottom: 0; left: 0; width: 60%; background: linear-gradient(90deg, transparent, rgba(255,255,255,.12), transparent); transform: translateX(-100%); animation: mglab-shimmer 1.3s infinite; }
    .markdown-preview h1, .markdown-preview h2, .markdown-preview h3 { font-weight: 700; margin: 0.75em 0 0.4em; }
    .markdown-preview h1 { font-size: 1.4em; } .markdown-preview h2 { font-size: 1.2em; } .markdown-preview h3 { font-size: 1.05em; }
    .markdown-preview p { margin: 0.5em 0; }
    .markdown-preview ul, .markdown-preview ol { margin: 0.5em 0 0.5em 1.4em; list-style: disc; }
    .markdown-preview ol { list-style: decimal; }
    .markdown-preview code { background: #0f172a; padding: 1px 5px; border-radius: 4px; font-size: 0.9em; }
    .markdown-preview pre { background: #0f172a; padding: 10px; border-radius: 6px; overflow-x: auto; margin: 0.5em 0; }
    .markdown-preview pre code { background: transparent; padding: 0; }
    .markdown-preview blockquote { border-left: 3px solid #6366f1; padding-left: 12px; color: #94a3b8; font-style: italic; margin: 0.5em 0; }
    .markdown-preview a { color: #818cf8; text-decoration: underline; }
    .markdown-preview img { max-width: 100%; border-radius: 6px; }
    .markdown-preview strong { font-weight: 700; }
    .markdown-preview em { font-style: italic; }
  </style>
</div>

<script>
  import Alpine from 'alpinejs';
  import {
    supabase,
    resolveLoginUser,
    markSessionStart,
    clearSessionStart,
    scheduleSessionEnd,
    enforceSessionExpiry,
  } from '../../lib/supabase';

  window.Alpine = Alpine;

  const TABS = ['enlaces', 'blog', 'disertaciones', 'movimiento', 'recursos'];

  Alpine.data('gestionAdmin', () => ({
    loadingAuth: true,
    user: null as any,
    userRole: null as any,
    loginEmail: 'cervantes',
    loginPassword: '',
    loginError: '',
    busy: false,
    activeTab: 'enlaces',
    statsLoading: true,
    dashboardCards: [
      { key: 'blog', icon: '📝', label: 'Blog', total: 0, published: 0, draft: 0 },
      { key: 'disertaciones', icon: '🎤', label: 'Disertaciones', total: 0, published: 0, draft: 0 },
      { key: 'movimiento', icon: '🤸', label: 'Movimiento', total: 0, published: 0, draft: 0 },
      { key: 'recursos', icon: '📚', label: 'Zona Lab', total: 0, published: 0, draft: 0 },
    ] as any[],

    async init() {
      const hash = (location.hash || '').replace('#', '');
      if (TABS.includes(hash)) this.activeTab = hash;

      if (await enforceSessionExpiry()) { this.loadingAuth = false; return; }
      const { data } = await supabase.auth.getSession();
      if (data?.session?.user) {
        this.user = data.session.user;
        await this.loadProfile();
        if (this.userRole === 'admin') this.loadStats();
      }
      this.loadingAuth = false;
    },

    async loadProfile() {
      const { data } = await supabase
        .from('profiles')
        .select('role')
        .eq('id', this.user.id)
        .maybeSingle();
      this.userRole = data?.role || null;
    },

    async loadStats() {
      this.statsLoading = true;
      try {
        const count = (rows: any[], isDraft: (r: any) => boolean) => {
          const total = rows.length;
          const draft = rows.filter(isDraft).length;
          return { total, draft, published: total - draft };
        };
        const [blogs, disertaciones, movimiento, recursos] = await Promise.all([
          supabase.from('blogs').select('id, draft'),
          supabase.from('disertaciones').select('id, draft'),
          supabase.from('movimiento_programas').select('id, data'),
          supabase.from('recursos').select('id, draft'),
        ]);
        const s = {
          blog: count(blogs.data || [], (r) => !!r.draft),
          disertaciones: count(disertaciones.data || [], (r) => !!r.draft),
          movimiento: count(movimiento.data || [], (r) => !!r.data?.draft),
          recursos: count(recursos.data || [], (r) => !!r.draft),
        };
        this.dashboardCards = this.dashboardCards.map((c) => ({ ...c, ...s[c.key] }));
      } finally {
        this.statsLoading = false;
      }
    },

    async login() {
      this.loginError = '';
      this.busy = true;
      try {
        const { data, error } = await supabase.auth.signInWithPassword({
          email: resolveLoginUser(this.loginEmail),
          password: this.loginPassword,
        });
        if (error) throw error;
        this.user = data.user;
        this.loginPassword = '';
        await this.loadProfile();
        markSessionStart();
        scheduleSessionEnd(() => this.logout(true));
        if (this.userRole === 'admin') this.loadStats();
      } catch (e) {
        this.loginError = (e as Error).message || 'Error al iniciar sesión';
      } finally {
        this.busy = false;
      }
    },

    async logout(auto = false) {
      if (!auto) clearSessionStart();
      await supabase.auth.signOut();
      this.user = null;
      this.userRole = null;
    },

    setTab(tab: string) {
      this.activeTab = tab;
      history.replaceState(null, '', '#' + tab);
    },
  }));

  Alpine.start();
</script>
