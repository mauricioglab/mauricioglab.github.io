---
---
<div x-show="busy" class="absolute inset-0 z-10 bg-slate-900/90 backdrop-blur-sm rounded-b-xl flex items-center justify-center p-6">
  <div class="w-full max-w-sm space-y-3">
    <div x-show="op" class="space-y-3">
      <div class="flex items-center justify-between gap-3">
        <div class="flex items-center gap-2 text-sm font-bold text-indigo-200">
          <span class="spinner spinner-sm"></span>
          <span x-text="op?.label"></span>
        </div>
        <span class="text-xs font-mono text-slate-400">⏱ <span x-text="op?.elapsed"></span></span>
      </div>
      <p class="text-xs text-indigo-300 text-center" x-text="op?.messages?.[op?.msgIndex]"></p>
      <div class="space-y-1.5">
        <template x-for="(step, i) in (op?.steps ?? [])" :key="i">
          <div class="flex items-center gap-2 text-xs">
            <span x-show="step.status === 'active'" class="spinner spinner-xs"></span>
            <span x-show="step.status === 'done'" class="text-green-400 font-bold">✓</span>
            <span x-show="step.status === 'error'" class="text-red-400 font-bold">✗</span>
            <span x-show="step.status === 'pending'" class="w-2 h-2 rounded-full bg-slate-600"></span>
            <span :class="step.status === 'active' ? 'text-slate-100 font-bold' : step.status === 'done' ? 'text-green-300' : step.status === 'error' ? 'text-red-300' : 'text-slate-500'" x-text="step.label"></span>
          </div>
        </template>
      </div>
    </div>
    <div x-show="!op && status" class="px-4 py-3 rounded-lg bg-indigo-600/15 border border-indigo-500/30 text-sm text-center" x-text="status"></div>
  </div>
</div>
