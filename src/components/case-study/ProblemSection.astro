---
/**
 * Problem Section Component
 * Displays the problem description and list of challenges
 */

type AccentColor = 'turquesa' | 'dorado';

interface Props {
  title: string;
  intro: string;
  items: string[];
  accentColor: AccentColor;
}

const { title, intro, items, accentColor } = Astro.props;

// Mapeos de color VeloCityLab (bullet en petróleo sobre fondo claro para contraste;
// en modo oscuro el acento de marca sí puede usarse como texto).
const colorClasses: Record<AccentColor, {
  sectionBg: string;
  sectionBorder: string;
  bulletColor: string;
}> = {
  turquesa: {
    sectionBg: 'bg-[#E6FAFC] dark:bg-[#0b6e7d]/20',
    sectionBorder: 'border-[#a6e9f1] dark:border-[#0b6e7d]',
    bulletColor: 'text-[#082D3A] dark:text-[#7DE3FF]',
  },
  dorado: {
    sectionBg: 'bg-[#FBF3DD] dark:bg-[#8A6A1F]/20',
    sectionBorder: 'border-[#e9d9a8] dark:border-[#8A6A1F]',
    bulletColor: 'text-[#082D3A] dark:text-[#D4AF37]',
  },
};

const colors = colorClasses[accentColor];
---

<section class="mb-16">
  <h2 class="text-3xl font-bold mb-6">{title}</h2>
  <div class:list={['rounded-xl p-8 border', colors.sectionBg, colors.sectionBorder]}>
    <p class="text-slate-700 dark:text-slate-300 leading-relaxed mb-4">{intro}</p>
    <ul class="space-y-3 text-slate-700 dark:text-slate-300">
      {items.map(item => (
        <li class="flex items-start gap-3">
          <span class:list={['font-bold', colors.bulletColor]}>•</span>
          <span>{item}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
