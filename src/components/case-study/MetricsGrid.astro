---
/**
 * Metrics Grid Component
 * Displays results metrics in a colored grid
 */

export interface Metric {
  value: string;
  label: string;
}

type AccentColor = 'turquesa' | 'dorado';

interface Props {
  title: string;
  metrics: Metric[];
  learnings?: {
    title: string;
    items: Array<{ label: string; text: string }>;
  };
  accentColor: AccentColor;
}

const { title, metrics, learnings, accentColor } = Astro.props;

// Tarjetas de métrica: alternan entre los dos acentos de marca (texto siempre en
// petróleo/blanco para mantener contraste, el color de marca va en el fondo/borde).
const metricColorClasses = [
  { bg: 'bg-gradient-to-br from-[#E6FAFC] to-[#c5f0f6] dark:from-[#0b6e7d]/30 dark:to-[#0b6e7d]/10', border: 'border-[#a6e9f1] dark:border-[#0b6e7d]', text: 'text-[#082D3A] dark:text-[#7DE3FF]' },
  { bg: 'bg-gradient-to-br from-[#FBF3DD] to-[#f5e7c0] dark:from-[#8A6A1F]/30 dark:to-[#8A6A1F]/10', border: 'border-[#e9d9a8] dark:border-[#8A6A1F]', text: 'text-[#082D3A] dark:text-[#D4AF37]' },
];

// Color de los checks de aprendizajes, según el acento del proyecto
const checkColorClasses: Record<AccentColor, string> = {
  turquesa: 'text-[#082D3A] dark:text-[#7DE3FF]',
  dorado: 'text-[#082D3A] dark:text-[#D4AF37]',
};

const checkColor = checkColorClasses[accentColor];
---

<section class="mb-16">
  <h2 class="text-3xl font-bold mb-6">{title}</h2>
  <div class="grid md:grid-cols-2 gap-6 mb-8">
    {metrics.map((metric, idx) => {
      const colorIdx = idx % metricColorClasses.length;
      const colors = metricColorClasses[colorIdx];
      return (
        <div class:list={['rounded-xl p-6 border', colors.bg, colors.border]}>
          <div class:list={['text-3xl font-bold mb-2', colors.text]}>{metric.value}</div>
          <div class="text-slate-700 dark:text-slate-300">{metric.label}</div>
        </div>
      );
    })}
  </div>

  {learnings && (
    <div class="bg-slate-50 dark:bg-slate-800 rounded-xl p-8 border border-slate-200 dark:border-slate-700">
      <h3 class="text-xl font-bold mb-4">{learnings.title}</h3>
      <ul class="space-y-3">
        {learnings.items.map(item => (
          <li class="flex items-start gap-3">
            <span class:list={['font-bold', checkColor]}>✓</span>
            <span><strong>{item.label}</strong> {item.text}</span>
          </li>
        ))}
      </ul>
    </div>
  )}
</section>
