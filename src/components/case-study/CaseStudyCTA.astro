---
/**
 * Case Study CTA Component
 * Final call-to-action section with gradient background
 */

// ContactModal is triggered via data-contact-trigger attribute

type AccentColor = 'turquesa' | 'dorado';

interface Props {
  title: string;
  subtitle: string;
  buttonText: string;
  accentColor: AccentColor;
}

const { title, subtitle, buttonText, accentColor } = Astro.props;

// Degradado petróleo -> acento de marca (mismo patrón que el CTA final de Servicios).
const gradientClasses: Record<AccentColor, string> = {
  turquesa: 'bg-gradient-to-r from-[#082D3A] to-[#16B6C9]',
  dorado: 'bg-gradient-to-r from-[#082D3A] to-[#D4AF37]',
};

const subtitleClasses: Record<AccentColor, string> = {
  turquesa: 'text-[#7DE3FF]',
  dorado: 'text-[#FBF3DD]',
};

const buttonClasses: Record<AccentColor, string> = {
  turquesa: 'text-[#082D3A] hover:bg-[#E6FAFC]',
  dorado: 'text-[#082D3A] hover:bg-[#FBF3DD]',
};

const gradient = gradientClasses[accentColor];
---

<section class:list={['rounded-xl p-8 text-white text-center', gradient]}>
  <h2 class="text-2xl font-bold mb-4">{title}</h2>
  <p class:list={['mb-6', subtitleClasses[accentColor]]}>{subtitle}</p>
  <button
    data-contact-trigger
    class:list={['inline-block px-6 py-3 bg-white rounded-lg font-semibold transition cursor-pointer', buttonClasses[accentColor]]}
  >
    {buttonText}
  </button>
</section>
