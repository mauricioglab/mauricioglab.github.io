---
/**
 * Case Study Header Component
 * Displays badge, title, description, stats and action links
 */

export interface Stat {
  value: string;
  label: string;
}

export interface Link {
  text: string;
  url: string;
  primary?: boolean;
}

type AccentColor = 'turquesa' | 'dorado';

interface Props {
  badge: string;
  title: string;
  description: string;
  stats: Stat[];
  links: Link[];
  accentColor: AccentColor;
}

const { badge, title, description, stats, links, accentColor } = Astro.props;

// Mapeos de color VeloCityLab (turquesa/dorado como tinte de acento; el texto
// siempre en petróleo/blanco para asegurar contraste, nunca color de marca fino).
const colorClasses: Record<AccentColor, {
  badgeBg: string;
  badgeText: string;
  primaryBtn: string;
  secondaryBtnHover: string;
}> = {
  turquesa: {
    badgeBg: 'bg-[#E6FAFC] dark:bg-[#0b6e7d]/25',
    badgeText: 'text-[#082D3A] dark:text-[#7DE3FF]',
    primaryBtn: 'bg-[#082D3A] hover:bg-[#0b6e7d]',
    secondaryBtnHover: 'hover:border-[#16B6C9]',
  },
  dorado: {
    badgeBg: 'bg-[#FBF3DD] dark:bg-[#8A6A1F]/25',
    badgeText: 'text-[#082D3A] dark:text-[#D4AF37]',
    primaryBtn: 'bg-[#082D3A] hover:bg-[#8A6A1F]',
    secondaryBtnHover: 'hover:border-[#D4AF37]',
  },
};

const colors = colorClasses[accentColor];
---

<section class="mb-16">
  <div class="mb-8">
    <span class:list={['px-4 py-2 rounded-full text-sm font-semibold', colors.badgeBg, colors.badgeText]}>
      {badge}
    </span>
  </div>
  <h1 class="text-5xl font-extrabold mb-6 text-[#082D3A] dark:text-white">{title}</h1>
  <p class="text-xl text-slate-600 dark:text-slate-400 leading-relaxed mb-8">{description}</p>

  <div class="grid grid-cols-3 gap-4 mb-8">
    {stats.map(stat => (
      <div class="bg-slate-50 dark:bg-slate-800 rounded-lg p-4">
        <div class="text-2xl font-bold text-[#082D3A] dark:text-white">{stat.value}</div>
        <div class="text-sm text-slate-600 dark:text-slate-400">{stat.label}</div>
      </div>
    ))}
  </div>

  <div class="flex flex-wrap gap-4">
    {links.map(link => (
      <a
        href={link.url}
        target="_blank"
        class:list={[
          'px-6 py-3 rounded-lg font-semibold transition',
          link.primary
            ? [colors.primaryBtn, 'text-white']
            : ['border-2 border-slate-300 dark:border-slate-600', colors.secondaryBtnHover]
        ]}
      >
        {link.text}
      </a>
    ))}
  </div>
</section>
