---
import type { Lang } from '../../i18n';
import { useTranslations } from '../../i18n';
import type { ProfileId } from '../../data/profiles';
import { profiles } from '../../data/profiles';
import { getProjectsByProfile } from '../../data/projects';
import ProjectCard from './ProjectCard.astro';

interface Props {
  profileId: ProfileId;
  lang?: Lang;
}

const { profileId, lang = 'es' } = Astro.props;
const profile = profiles[profileId];
const projects = getProjectsByProfile(profileId);
const content = await useTranslations<any>(lang, profileId);
const t = await useTranslations<any>(lang, 'portfolio');

// Static Tailwind classes (purging-safe)
const accentMap: Record<ProfileId, { badge: string; button: string }> = {
  developer: {
    badge: 'bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300',
    button: 'bg-blue-600 hover:bg-blue-700',
  },
  analista: {
    badge: 'bg-slate-200 text-slate-700 dark:bg-slate-700 dark:text-slate-200',
    button: 'bg-slate-900 hover:bg-slate-700',
  },
  'ia-engineer': {
    badge: 'bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-300',
    button: 'bg-emerald-600 hover:bg-emerald-700',
  },
  freelance: {
    badge: 'bg-orange-100 text-orange-700 dark:bg-orange-900/30 dark:text-orange-300',
    button: 'bg-orange-600 hover:bg-orange-700',
  },
  speaker: {
    badge: 'bg-purple-100 text-purple-700 dark:bg-purple-900/30 dark:text-purple-300',
    button: 'bg-purple-600 hover:bg-purple-700',
  },
  docente: {
    badge: 'bg-teal-100 text-teal-700 dark:bg-teal-900/30 dark:text-teal-300',
    button: 'bg-teal-600 hover:bg-teal-700',
  },
};

const accent = accentMap[profileId];
const profileUrl = `/${lang}/landing/${profileId}`;
---

<section
  id={profileId}
  class="scroll-mt-24 py-16 sm:py-20 bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-700 transition-colors"
>
  <div class="max-w-7xl mx-auto px-4">
    <div class="mb-10">
      <span class:list={['inline-block px-4 py-1 rounded-full text-sm font-bold mb-4', accent.badge]}>
        {content.subtitle}
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold mb-3 text-slate-900 dark:text-white">
        {content.title}
      </h2>
      <p class="text-slate-600 dark:text-slate-400 max-w-2xl mb-6 leading-relaxed">
        {content.description}
      </p>
      <div class="flex flex-wrap gap-3">
        <a
          href={profile.cvUrl}
          class:list={['px-5 py-2.5 rounded-lg text-sm font-bold text-white transition', accent.button]}
        >
          <i class="fas fa-file-pdf mr-2"></i>{t.downloadCV}
        </a>
        <a
          href={profileUrl}
          class="border px-5 py-2.5 rounded-lg text-sm font-bold transition border-slate-300 dark:border-slate-600 text-slate-700 dark:text-slate-300 hover:border-slate-900 dark:hover:border-white"
        >
          <i class="fas fa-user mr-2"></i>{t.viewProfile}
        </a>
      </div>
    </div>

    {projects.length > 0 ? (
      <div class="grid md:grid-cols-2 gap-8">
        {projects.map((project) => (
          <ProjectCard project={project} profileId={profileId} lang={lang} />
        ))}
      </div>
    ) : (
      <div class="rounded-2xl border border-dashed border-slate-300 dark:border-slate-600 p-10 text-center">
        <p class="text-slate-500 dark:text-slate-400 text-sm italic">{t.emptyProjects}</p>
      </div>
    )}
  </div>
</section>
