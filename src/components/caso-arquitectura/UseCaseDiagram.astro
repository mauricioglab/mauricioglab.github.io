---
interface Caso {
  objetivo: string;
  id: string;
}
interface Props {
  actor: string;
  sistema: string;
  casos: Caso[];
  caption?: string;
}
const { actor, sistema, casos, caption } = Astro.props;

const FONT_SIZE = 12;
const ID_FONT_SIZE = 9.5;
const LINE_H = 13;
const CHAR_W = 6.4;
const OVAL_MIN_W = 170;
const OVAL_MAX_W = 260;
const OVAL_MIN_H = 46;
const OVAL_GAP = 18;
const MAX_CHARS_PER_LINE = 26;
const ACTOR_W = 44;
const ACTOR_LABEL_H = 34;
const BOUNDARY_PAD_X = 26;
const BOUNDARY_PAD_TOP = 34;
const BOUNDARY_LABEL_H = 24;
const CONNECTOR_W = 60;

function wrap(label: string, maxCharsPerLine = MAX_CHARS_PER_LINE) {
  const words = label.split(' ');
  const lines: string[] = [];
  let cur = '';
  for (const w of words) {
    const next = cur ? `${cur} ${w}` : w;
    if (next.length > maxCharsPerLine && cur) {
      lines.push(cur);
      cur = w;
    } else {
      cur = next;
    }
  }
  if (cur) lines.push(cur);
  return lines;
}

const ovalW = Math.min(
  OVAL_MAX_W,
  Math.max(OVAL_MIN_W, Math.max(...casos.map(c => c.objetivo.length)) * CHAR_W * 0.62)
);

let cursorY = BOUNDARY_PAD_TOP + BOUNDARY_LABEL_H;
const positioned = casos.map(c => {
  const lines = wrap(c.objetivo, Math.floor((ovalW - 20) / CHAR_W));
  const rows = lines.length + 1; // + la línea del HU-id
  const ovalH = Math.max(OVAL_MIN_H, rows * LINE_H + 22);
  const y = cursorY;
  cursorY = y + ovalH + OVAL_GAP;
  return { ...c, lines, y, ovalH };
});

const boundaryH = positioned.length > 0
  ? positioned[positioned.length - 1].y + positioned[positioned.length - 1].ovalH + BOUNDARY_PAD_TOP / 2
  : BOUNDARY_PAD_TOP + BOUNDARY_LABEL_H + OVAL_MIN_H;

const boundaryX = ACTOR_W + CONNECTOR_W;
const boundaryW = ovalW + BOUNDARY_PAD_X * 2;
const W = boundaryX + boundaryW + 8;
const H = Math.max(boundaryH + BOUNDARY_PAD_TOP / 2, ACTOR_W + ACTOR_LABEL_H + 20);
const actorCx = ACTOR_W / 2 + 4;
const actorCy = H / 2;
const ovalX = boundaryX + (boundaryW - ovalW) / 2;
---
<figure class="diagram-figure">
  <svg viewBox={`0 0 ${W} ${H}`} width={W} height={H} role="img" aria-label={caption ? `${actor} — ${caption}` : `Casos de uso de ${actor}`} class="max-w-full h-auto">
    <rect x={boundaryX} y="0" width={boundaryW} height={H} rx="10" fill="var(--color-paper-alt)" stroke="var(--color-diagram-gold)" stroke-width="1.4" />
    <text x={boundaryX + boundaryW / 2} y="18" text-anchor="middle" font-family="var(--font-body)" font-size="11.5" font-weight="700" fill="var(--color-ink)">{sistema}</text>

    <circle cx={actorCx} cy={actorCy - 24} r="7" fill="none" stroke="var(--color-diagram-indigo)" stroke-width="1.6" />
    <line x1={actorCx} y1={actorCy - 17} x2={actorCx} y2={actorCy + 3} stroke="var(--color-diagram-indigo)" stroke-width="1.6" />
    <line x1={actorCx - 10} y1={actorCy - 9} x2={actorCx + 10} y2={actorCy - 9} stroke="var(--color-diagram-indigo)" stroke-width="1.6" />
    <line x1={actorCx} y1={actorCy + 3} x2={actorCx - 9} y2={actorCy + 19} stroke="var(--color-diagram-indigo)" stroke-width="1.6" />
    <line x1={actorCx} y1={actorCy + 3} x2={actorCx + 9} y2={actorCy + 19} stroke="var(--color-diagram-indigo)" stroke-width="1.6" />
    <text x={actorCx} y={actorCy + 33} text-anchor="middle" font-family="var(--font-body)" font-size="10.5" font-weight="600" fill="var(--color-ink)">
      {wrap(actor, 16).map((l, i) => <tspan x={actorCx} dy={i === 0 ? 0 : 12}>{l}</tspan>)}
    </text>

    {positioned.map(p => (
      <line
        x1={ACTOR_W} y1={actorCy}
        x2={ovalX} y2={p.y + p.ovalH / 2}
        stroke="var(--color-line)" stroke-width="1.2"
      />
    ))}

    {positioned.map(p => {
      const cx = ovalX + ovalW / 2;
      const cy = p.y + p.ovalH / 2;
      const rows = p.lines.length + 1;
      const startDy = -(rows - 1) * LINE_H / 2;
      return (
        <g>
          <ellipse cx={cx} cy={cy} rx={ovalW / 2} ry={p.ovalH / 2} fill="var(--color-teal-tint)" stroke="var(--color-teal)" stroke-width="1.4" />
          <text x={cx} y={cy} text-anchor="middle" font-family="var(--font-body)" fill="var(--color-ink)">
            {p.lines.map((l, i) => (
              <tspan x={cx} dy={i === 0 ? startDy : LINE_H} font-size={FONT_SIZE}>{l}</tspan>
            ))}
            <tspan x={cx} dy={LINE_H} font-size={ID_FONT_SIZE} fill="var(--color-ink-faint)">{p.id}</tspan>
          </text>
        </g>
      );
    })}
  </svg>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
