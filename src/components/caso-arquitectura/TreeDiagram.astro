---
interface Branch {
  label: string;
  children: string[];
}
interface Props {
  root: string;
  branches: Branch[];
  caption?: string;
}
const { root, branches, caption } = Astro.props;

const COL_W = 148;
const GAP_X = 14;
const BOX_H = 42;
const ROW_GAP = 14;
const TOP_PAD = 40;
const FONT_SIZE = 11.5;

const W = branches.length * COL_W + (branches.length - 1) * GAP_X + 20;
const maxRows = Math.max(...branches.map(b => b.children.length + 1));
const totalH = TOP_PAD + maxRows * (BOX_H + ROW_GAP) + 20;

function wrap(label: string, maxChars: number) {
  const words = label.split(' ');
  const lines: string[] = [];
  let cur = '';
  for (const w of words) {
    const next = cur ? `${cur} ${w}` : w;
    if (next.length > maxChars && cur) {
      lines.push(cur);
      cur = w;
    } else {
      cur = next;
    }
  }
  if (cur) lines.push(cur);
  return lines;
}

const cols = branches.map((b, i) => {
  const x = 10 + i * (COL_W + GAP_X);
  const rows = [b.label, ...b.children].map((label, ri) => ({
    label,
    lines: wrap(label, 20),
    y: TOP_PAD + ri * (BOX_H + ROW_GAP),
    isBranch: ri === 0,
  }));
  return { x, rows };
});

const rootX = W / 2;
const rootY = 12;
const rootW = Math.min(180, Math.max(90, root.length * 8 + 30));
---
<figure class="diagram-figure">
  <svg viewBox={`0 0 ${W} ${totalH}`} width={W} height={totalH} role="img" aria-label={caption ?? 'Diagrama de paquetes'} class="max-w-full h-auto">
    <defs>
      <marker id="tarrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--color-diagram-gold)" />
      </marker>
    </defs>

    {cols.map(col => (
      <line x1={rootX} y1={rootY + 20} x2={col.x + COL_W / 2} y2={TOP_PAD - 2} stroke="var(--color-diagram-gold)" stroke-width="1.3" marker-end="url(#tarrow)" />
    ))}

    <rect x={rootX - rootW / 2} y={rootY} width={rootW} height="26" rx="13" fill="var(--color-navy)" />
    <text x={rootX} y={rootY + 17.5} text-anchor="middle" font-family="var(--font-body)" font-size="12.5" font-weight="700" fill="var(--color-sand)">{root}</text>

    {cols.map(col => (
      <g>
        {col.rows.slice(0, -1).map((r, i) => {
          const next = col.rows[i + 1];
          const cx = col.x + COL_W / 2;
          return <line x1={cx} y1={r.y + BOX_H} x2={cx} y2={next.y - 2} stroke="var(--color-diagram-gold-line)" stroke-width="1.3" marker-end="url(#tarrow)" />;
        })}
        {col.rows.map(r => {
          const cx = col.x + COL_W / 2;
          const cy = r.y + BOX_H / 2;
          const startDy = -(r.lines.length - 1) * 13 / 2;
          return (
            <g>
              <rect
                x={col.x} y={r.y} width={COL_W} height={BOX_H} rx="7"
                fill={r.isBranch ? 'var(--color-teal-tint)' : 'var(--color-paper)'}
                stroke={r.isBranch ? 'var(--color-teal)' : 'var(--color-line)'}
                stroke-width={r.isBranch ? '1.6' : '1.1'}
              />
              <text x={cx} y={cy} text-anchor="middle" font-family="var(--font-body)" font-size={FONT_SIZE} font-weight={r.isBranch ? '600' : '400'} fill="var(--color-ink)">
                {r.lines.map((l, i) => (
                  <tspan x={cx} dy={i === 0 ? startDy : 13}>{l}</tspan>
                ))}
              </text>
            </g>
          );
        })}
      </g>
    ))}
  </svg>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
