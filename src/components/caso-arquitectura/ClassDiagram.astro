---
interface ClaseUML {
  nombre: string;
  atributos: string[];
  nota?: string;
}
interface Asociacion {
  desde: string;
  hasta: string;
  multiplicidadDesde: string;
  multiplicidadHasta: string;
  label?: string;
  dashed?: boolean;
}
interface Props {
  clases: ClaseUML[];
  asociaciones: Asociacion[];
  caption?: string;
}
const { clases, asociaciones, caption } = Astro.props;

const BOX_W = 220;
const HEADER_H = 30;
const ATTR_H = 18;
const ATTR_PAD = 10;
const COLS = 2;
const COL_GAP = 90;
const ROW_GAP = 70;

const positions: Record<string, { x: number; y: number; w: number; h: number }> = {};
clases.forEach((c, i) => {
  const col = i % COLS;
  const row = Math.floor(i / COLS);
  const h = HEADER_H + c.atributos.length * ATTR_H + ATTR_PAD * 2 + (c.nota ? 20 : 0);
  positions[c.nombre] = {
    x: 20 + col * (BOX_W + COL_GAP),
    y: 20 + row * (ROW_GAP + 140),
    w: BOX_W,
    h,
  };
});

let cursorY = 20;
const rows = Math.ceil(clases.length / COLS);
for (let r = 0; r < rows; r++) {
  const rowClases = clases.filter((_, i) => Math.floor(i / COLS) === r);
  const rowH = Math.max(...rowClases.map(c => positions[c.nombre].h));
  rowClases.forEach(c => { positions[c.nombre].y = cursorY; });
  cursorY += rowH + ROW_GAP;
}

const W = COLS * (BOX_W + COL_GAP) - COL_GAP + 40;
const H = cursorY;

function edgePoint(from: { x: number; y: number; w: number; h: number }, to: { x: number; y: number; w: number; h: number }) {
  const fromCX = from.x + from.w / 2;
  const fromCY = from.y + from.h / 2;
  const toCX = to.x + to.w / 2;
  const toCY = to.y + to.h / 2;
  if (Math.abs(fromCX - toCX) > Math.abs(fromCY - toCY)) {
    return {
      x1: fromCX < toCX ? from.x + from.w : from.x,
      y1: fromCY,
      x2: fromCX < toCX ? to.x : to.x + to.w,
      y2: toCY,
    };
  }
  return {
    x1: fromCX,
    y1: fromCY < toCY ? from.y + from.h : from.y,
    x2: toCX,
    y2: fromCY < toCY ? to.y : to.y + to.h,
  };
}
---
<figure class="diagram-figure">
  <svg viewBox={`0 0 ${W} ${H}`} width={W} height={H} role="img" aria-label={caption ?? 'Diagrama de clases'} class="max-w-full h-auto">
    {asociaciones.map(a => {
      const from = positions[a.desde];
      const to = positions[a.hasta];
      if (!from || !to) return null;
      const { x1, y1, x2, y2 } = edgePoint(from, to);
      const midX = (x1 + x2) / 2;
      const midY = (y1 + y2) / 2;
      return (
        <g>
          <line x1={x1} y1={y1} x2={x2} y2={y2} stroke="var(--color-diagram-gold)" stroke-width="1.3" stroke-dasharray={a.dashed ? '4 3' : undefined} />
          <text x={x1 + (x2 - x1) * 0.14} y={y1 + (y2 - y1) * 0.14 - 6} font-family="var(--font-body)" font-size="10.5" font-weight="600" fill="var(--color-diagram-text-muted)">{a.multiplicidadDesde}</text>
          <text x={x2 - (x2 - x1) * 0.14} y={y2 - (y2 - y1) * 0.14 - 6} font-family="var(--font-body)" font-size="10.5" font-weight="600" fill="var(--color-diagram-text-muted)">{a.multiplicidadHasta}</text>
          {a.label && (
            <text x={midX} y={midY - 6} text-anchor="middle" font-family="var(--font-body)" font-size="10.5" fill="var(--color-diagram-gold-text)">{a.label}</text>
          )}
        </g>
      );
    })}

    {clases.map(c => {
      const p = positions[c.nombre];
      return (
        <g>
          <rect x={p.x} y={p.y} width={p.w} height={p.h} fill="var(--color-paper)" stroke="var(--color-diagram-gold)" stroke-width="1.5" />
          <rect x={p.x} y={p.y} width={p.w} height={HEADER_H} fill="var(--color-navy)" />
          <text x={p.x + p.w / 2} y={p.y + HEADER_H / 2 + 4.5} text-anchor="middle" font-family="var(--font-body)" font-size="12.5" font-weight="700" fill="var(--color-sand)">{c.nombre}</text>
          <line x1={p.x} y1={p.y + HEADER_H} x2={p.x + p.w} y2={p.y + HEADER_H} stroke="var(--color-diagram-gold)" stroke-width="1" />
          {c.atributos.map((attr, ai) => (
            <text x={p.x + 12} y={p.y + HEADER_H + ATTR_PAD + ai * ATTR_H + 12} font-family="ui-monospace, monospace" font-size="10.5" fill="var(--color-ink)">{attr}</text>
          ))}
          {c.nota && (
            <text x={p.x + p.w / 2} y={p.y + p.h - 8} text-anchor="middle" font-family="var(--font-body)" font-size="9.5" font-style="italic" fill="var(--color-diagram-gold-text)">{c.nota}</text>
          )}
        </g>
      );
    })}
  </svg>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
