---
interface Props {
  rows: string[][];
  compact?: boolean;
}
const { rows, compact = false } = Astro.props;
const [header, ...body] = rows;
---
{rows.length > 0 && (
  <div class:list={["data-table", { "data-table-compact": compact }]}>
    <table>
      <thead>
        <tr>
          {header.map(h => <th>{h}</th>)}
        </tr>
      </thead>
      <tbody>
        {body.map(row => (
          <tr>
            {row.map(cell => <td>{cell}</td>)}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
)}
