---
interface Nodo {
  nombre: string;
}
interface Columna {
  tipo: 'externa' | 'proceso' | 'almacen';
  titulo: string;
  nodos: Nodo[];
}
interface Flujo {
  desdeCol: number;
  desdeNodo: string;
  hastaCol: number;
  hastaNodo: string;
  label: string;
}
interface Props {
  columnas: Columna[];
  flujos: Flujo[];
  caption?: string;
}
const { columnas, flujos, caption } = Astro.props;

const COL_W = 210;
const GAP_X = 64;
const BOX_H = 36;
const ROW_GAP = 10;
const TOP_PAD = 38;
const FONT_SIZE = 11.5;

const cols = columnas.map((c, ci) => {
  const x = 10 + ci * (COL_W + GAP_X);
  const rows = c.nodos.map((n, ri) => ({
    ...n,
    y: TOP_PAD + ri * (BOX_H + ROW_GAP),
  }));
  return { tipo: c.tipo, titulo: c.titulo, x, rows };
});

const W = columnas.length * COL_W + (columnas.length - 1) * GAP_X + 20;
const maxRows = Math.max(...columnas.map(c => c.nodos.length));
const H = TOP_PAD + maxRows * (BOX_H + ROW_GAP) + 16;

function findBox(colIdx: number, nombre: string) {
  const col = cols[colIdx];
  const row = col.rows.find(r => r.nombre === nombre);
  return { col, row };
}
---
<figure class="diagram-figure">
  <svg viewBox={`0 0 ${W} ${H}`} width={W} height={H} role="img" aria-label={caption ?? 'Diagrama de flujo de datos'} class="max-w-full h-auto">
    <defs>
      <marker id="dfd-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--color-diagram-indigo)" />
      </marker>
    </defs>

    {cols.map(col => (
      <text x={col.x} y={20} font-family="var(--font-body)" font-size="11" font-weight="700" letter-spacing="0.04em" fill="var(--color-diagram-gold-text)">{col.titulo.toUpperCase()}</text>
    ))}

    {flujos.map(f => {
      const from = findBox(f.desdeCol, f.desdeNodo);
      const to = findBox(f.hastaCol, f.hastaNodo);
      if (!from.row || !to.row) return null;
      const forward = f.hastaCol >= f.desdeCol;
      const x1 = forward ? from.col.x + COL_W : from.col.x;
      const y1 = from.row.y + BOX_H / 2;
      const x2 = forward ? to.col.x : to.col.x + COL_W;
      const y2 = to.row.y + BOX_H / 2;
      const midX = (x1 + x2) / 2;
      return (
        <g>
          <path d={`M ${x1} ${y1} C ${midX} ${y1}, ${midX} ${y2}, ${x2} ${y2}`} fill="none" stroke="var(--color-diagram-indigo)" stroke-width="1.4" marker-end="url(#dfd-arrow)" />
          <rect x={midX - (f.label.length * 4.3 + 10) / 2} y={(y1 + y2) / 2 - 9} width={f.label.length * 4.3 + 10} height="16" rx="8" fill="var(--color-diagram-indigo-tint)" stroke="var(--color-diagram-indigo)" stroke-width="0.8" />
          <text x={midX} y={(y1 + y2) / 2 + 3} text-anchor="middle" font-family="var(--font-body)" font-size="9.5" font-weight="600" fill="var(--color-diagram-indigo-text)">{f.label}</text>
        </g>
      );
    })}

    {cols.map(col => (
      <g>
        {col.rows.map(r => {
          const cx = col.x + COL_W / 2;
          const cy = r.y + BOX_H / 2;
          const isProceso = col.tipo === 'proceso';
          const isAlmacen = col.tipo === 'almacen';
          return (
            <g>
              {isAlmacen ? (
                <>
                  <line x1={col.x} y1={r.y} x2={col.x + COL_W} y2={r.y} stroke="var(--color-diagram-gold-dashed)" stroke-width="1.3" />
                  <line x1={col.x} y1={r.y + BOX_H} x2={col.x + COL_W} y2={r.y + BOX_H} stroke="var(--color-diagram-gold-dashed)" stroke-width="1.3" />
                </>
              ) : (
                <rect
                  x={col.x} y={r.y} width={COL_W} height={BOX_H} rx={isProceso ? BOX_H / 2 : 4}
                  fill={isProceso ? 'var(--color-teal-tint)' : 'var(--color-paper)'}
                  stroke={isProceso ? 'var(--color-teal)' : 'var(--color-diagram-indigo)'}
                  stroke-width={isProceso ? '1.7' : '1.3'}
                />
              )}
              <text x={cx} y={cy + 4} text-anchor="middle" font-family="var(--font-body)" font-size={FONT_SIZE} font-weight={isProceso ? '600' : '400'} fill="var(--color-ink)">
                {r.nombre}
              </text>
            </g>
          );
        })}
      </g>
    ))}
  </svg>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
