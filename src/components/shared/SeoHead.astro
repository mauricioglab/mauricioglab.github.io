---
import { SITE_CONFIG } from '../../data/config';
import { isCompanyBuild, COMPANY_ORIGIN, PERSONAL_ORIGIN } from '../../data/site-target';
import { getSiteNav } from '../../data/site-nav';

interface Props {
  title: string;
  description: string;
  lang: 'es' | 'en';
  canonical: string;
  type?: 'website' | 'profile';
}

const { title, description, lang, canonical, type = 'website' } = Astro.props;

const origin = isCompanyBuild ? COMPANY_ORIGIN : PERSONAL_ORIGIN;
const siteName = getSiteNav(lang).brand.name;

// Páginas bilingües (/es/… y /en/…): declarar la alternativa en el otro idioma.
const path = Astro.url.pathname;
const bilingual = /^\/(es|en)\//.test(path);
const alternates = bilingual
  ? (['es', 'en'] as const).map((l) => ({ lang: l, href: `${origin}${path.replace(/^\/(es|en)\//, `/${l}/`)}` }))
  : [];

// Imagen para compartir: solo la empresa tiene una (logo oficial). En el dominio personal no se
// publica ninguna hasta tener una propia, para no mostrar la marca de la empresa como identidad.
const ogImage = isCompanyBuild ? `${COMPANY_ORIGIN}/logo-vl-full.png` : null;

const schema = isCompanyBuild
  ? {
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: siteName,
      url: `${COMPANY_ORIGIN}/`,
      logo: `${COMPANY_ORIGIN}/logo-vl-icon.svg`,
      address: { '@type': 'PostalAddress', addressLocality: 'Córdoba', addressCountry: 'AR' },
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: SITE_CONFIG.author,
      jobTitle: lang === 'es' ? 'Software Engineer · IA & Automatización' : 'Software Engineer · AI & Automation',
      url: `${PERSONAL_ORIGIN}/`,
      address: { '@type': 'PostalAddress', addressLocality: 'Córdoba', addressCountry: 'AR' },
      sameAs: [SITE_CONFIG.linkedin, SITE_CONFIG.github],
      knowsLanguage: ['es', 'en'],
    };
---

<link rel="canonical" href={canonical} />
{alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
{alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={alternates[0].href} />}
<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content={lang === 'es' ? 'es_AR' : 'en_US'} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
{ogImage && <meta property="og:image" content={ogImage} />}
<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{ogImage && <meta name="twitter:image" content={ogImage} />}
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
