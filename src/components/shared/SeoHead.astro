---
import { SITE_CONFIG } from '../../data/config';
import { getSiteNav } from '../../data/site-nav';

interface Props {
  title: string;
  description: string;
  lang: 'es' | 'en';
  canonical: string;
  type?: 'website' | 'profile';
}

const { title, description, lang, canonical, type = 'website' } = Astro.props;

const origin = SITE_CONFIG.siteUrl.replace(/\/$/, '');
const siteName = getSiteNav(lang).brand.name;

// Páginas bilingües (/es/… y /en/…): declarar la alternativa en el otro idioma.
const path = Astro.url.pathname;
const bilingual = /^\/(es|en)\//.test(path) && !/^\/es\/(?:sobre-mi|contacto)\/?$/.test(path);
const alternates = bilingual
  ? (['es', 'en'] as const).map((l) => ({ lang: l, href: `${origin}${path.replace(/^\/(es|en)\//, `/${l}/`)}` }))
  : [];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE_CONFIG.author,
  jobTitle: lang === 'es' ? 'Software Engineer · IA & Automatización' : 'Software Engineer · AI & Automation',
  url: `${origin}/`,
  address: { '@type': 'PostalAddress', addressLocality: 'Córdoba', addressCountry: 'AR' },
  sameAs: [SITE_CONFIG.linkedin, SITE_CONFIG.github],
  knowsLanguage: ['es', 'en'],
};
---

<link rel="canonical" href={canonical} />
{alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
{alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={alternates[0].href} />}
<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content={lang === 'es' ? 'es_AR' : 'en_US'} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
