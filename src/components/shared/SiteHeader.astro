---
import { getSiteNav, type Lang } from '../../data/site-nav';

interface Props {
  current?: string;
  lang?: Lang;
  altHref?: string;
}

const { current, lang = 'es', altHref } = Astro.props;
const nav = getSiteNav(lang);
const altLang: Lang = lang === 'es' ? 'en' : 'es';

// Por defecto, el equivalente en el otro idioma si la URL lleva /es/ o /en/;
// si no, la portada de empresa en el otro idioma. Así el botón nunca desaparece.
const path = Astro.url.pathname;
const swapped = /^\/(es|en)\//.test(path) ? path.replace(/^\/(es|en)\//, `/${altLang}/`) : `/${altLang}/servicios/`;
const langHref = altHref ?? swapped;

const isCurrent = (id: string, children?: { id: string }[]) =>
  id === current || (children ?? []).some((c) => c.id === current);
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600;700&display=swap" rel="stylesheet" />

<header class="site-header">
  <div class="sh-row">
    <a class="sh-brand" href={nav.brand.href}>
      {nav.brand.icon && <img src={nav.brand.icon} alt="" class="sh-brand-icon" />}
      <span>{nav.brand.name}</span>
    </a>

    <nav class="sh-nav" aria-label="Sitio">
      <ul class="sh-bar">
        {nav.items.map((item) => (
          <li class:list={{ "sh-dd": !!item.children }}>
            {item.children ? (
              <details class="sh-dd-menu">
                <summary class:list={{ current: isCurrent(item.id, item.children) }}>{item.label}</summary>
                <ul>
                  {item.children.map((c) => (
                    <li>
                      {c.id === current ? <span aria-current="page">{c.label}</span> : <a href={c.href}>{c.label}</a>}
                    </li>
                  ))}
                </ul>
              </details>
            ) : item.id === current ? (
              <span aria-current="page">{item.label}</span>
            ) : (
              <a href={item.href} rel={item.external ? 'noopener' : undefined}>
                {item.label}{item.external ? ' ↗' : ''}
              </a>
            )}
          </li>
        ))}
        {nav.contact.kind === 'link' && (
          <li><a href="#contacto" data-contact-trigger>{nav.contact.label}</a></li>
        )}
      </ul>

      <details class="sh-menu">
        <summary>Menú</summary>
        <ul>
          {nav.items.map((item) =>
            item.children ? (
              <>
                <li class="sh-group-label">{item.label}</li>
                {item.children.map((c) => (
                  <li>{c.id === current ? <span aria-current="page">{c.label}</span> : <a href={c.href}>{c.label}</a>}</li>
                ))}
              </>
            ) : (
              <li>
                {item.id === current ? (
                  <span aria-current="page">{item.label}</span>
                ) : (
                  <a href={item.href} rel={item.external ? 'noopener' : undefined}>
                    {item.label}{item.external ? ' ↗' : ''}
                  </a>
                )}
              </li>
            ),
          )}
          {nav.contact.kind === 'link' && (
            <li><a href="#contacto" data-contact-trigger>{nav.contact.label}</a></li>
          )}
        </ul>
      </details>
    </nav>

    <div class="sh-actions">
      {nav.langSwitch && (
        <a class="sh-lang" href={langHref} hreflang={altLang} lang={altLang}>{altLang.toUpperCase()}</a>
      )}
      {nav.contact.kind === 'button' && (
        <button type="button" class="sh-cta" data-contact-trigger>{nav.contact.label}</button>
      )}
    </div>
  </div>
</header>

<style is:global>
  :root { --site-header-h: 64px; }
  html { scrollbar-gutter: stable; }
</style>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--site-header-h);
    flex-shrink: 0;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: saturate(1.4) blur(8px);
    border-bottom: 1px solid #e4e8f0;
    font-family: 'Montserrat', system-ui, sans-serif;
    color: #082d3a;
    font-size: 14px;
    line-height: 1.25;
    letter-spacing: normal;
  }
  .site-header :is(a, span, summary, button, li) { font-family: 'Montserrat', system-ui, sans-serif; line-height: 1.25; }
  .sh-row {
    max-width: 1100px;
    height: 100%;
    margin: 0 auto;
    padding: 0 28px;
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .sh-brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    font-size: 15px;
    letter-spacing: 0.02em;
    color: #082d3a;
    text-decoration: none;
    white-space: nowrap;
    margin-right: auto;
  }
  .sh-brand-icon { width: 22px; height: 22px; flex-shrink: 0; }

  .sh-nav { position: relative; flex: none; }
  .sh-nav ul { display: flex; align-items: center; gap: 0.15rem; list-style: none; margin: 0; padding: 0; }
  .sh-nav a,
  .sh-nav span,
  .sh-nav summary {
    font-size: 14px;
    text-decoration: none;
    padding: 6px 10px;
    border-radius: 8px;
    color: #5c6785;
    white-space: nowrap;
    cursor: pointer;
  }
  .sh-nav a:hover,
  .sh-nav summary:hover { color: #082d3a; background: #f4f6fa; }
  .sh-nav span[aria-current='page'],
  .sh-nav summary.current { color: #082d3a; font-weight: 600; }
  .sh-nav summary { list-style: none; }
  .sh-nav summary::-webkit-details-marker { display: none; }

  .sh-dd { position: relative; }
  .sh-dd-menu > summary::after { content: ' ▾'; font-size: 0.7em; }
  .sh-dd-menu > ul {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    z-index: 60;
    min-width: 190px;
    padding: 8px;
    flex-direction: column;
    align-items: stretch;
    background: #fff;
    border: 1px solid #e4e8f0;
    border-radius: 12px;
    box-shadow: 0 12px 30px -18px rgba(8, 45, 58, 0.35);
  }

  .sh-menu { display: none; }
  .sh-menu > summary {
    border: 1px solid #e4e8f0;
    font-weight: 600;
    color: #082d3a;
  }
  .sh-menu .sh-group-label {
    padding: 8px 10px 2px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #8b94ab;
  }

  .sh-actions { display: flex; align-items: center; gap: 0.5rem; flex-shrink: 0; }
  .sh-lang {
    font-size: 13px;
    font-weight: 600;
    color: #5c6785;
    border: 1px solid #e4e8f0;
    background: #fff;
    padding: 7px 14px;
    border-radius: 999px;
    text-decoration: none;
  }
  .sh-lang:hover { border-color: #16b6c9; color: #082d3a; }
  .sh-cta {
    font-family: inherit;
    font-size: 13px;
    font-weight: 600;
    color: #fff;
    background: #082d3a;
    border: none;
    padding: 10px 18px;
    border-radius: 10px;
    cursor: pointer;
  }
  .sh-cta:hover { opacity: 0.9; }

  @media (max-width: 1040px) {
    .sh-nav .sh-bar { display: none; }
    .sh-menu { display: block; }
    .sh-menu:not([open]) > ul { display: none; }
    .sh-menu[open] > ul {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      position: absolute;
      top: calc(100% + 8px);
      right: 0;
      z-index: 60;
      min-width: 200px;
      padding: 8px;
      background: #fff;
      border: 1px solid #e4e8f0;
      border-radius: 12px;
      box-shadow: 0 12px 30px -18px rgba(8, 45, 58, 0.35);
    }
  }
  @media (max-width: 560px) {
    .sh-row { padding: 0 16px; gap: 0.5rem; }
    .sh-brand { font-size: 14px; }
  }
</style>
