---
import HomeClusters from './HomeClusters.astro';
import { SITE_CONFIG } from '../../data/config';
import { isCompanyBuild } from '../../data/site-target';

const base = import.meta.env.BASE_URL;
const b = base.endsWith("/") ? base : `${base}/`;

const resolveUrl = (url: string) => url.startsWith('/') ? `${b}${url.slice(1)}` : url;

// En el dominio empresa solo existen estas secciones (el resto es del dominio personal).
const companyLinks = [
  { label: 'Servicios', url: '/es/servicios/' },
  { label: 'Portfolio', url: '/es/portfolio/' },
  { label: 'Disertaciones', url: '/disertaciones/' },
  { label: 'Velocity', url: '/es/velocity/' },
];
---

<main>
  <div class="home-split mx-auto max-w-6xl h-[calc(100vh-112px)] min-h-[560px] flex flex-col md:flex-row">

    <!-- Left: Clusters -->
    <section class="home-clusters md:w-1/2 px-6 sm:px-10 py-8 md:py-10 overflow-y-auto">
      {isCompanyBuild ? (
        <nav aria-label="Secciones principales" class="border-t border-[#e4e8f0]">
          <ul class="divide-y divide-[#e4e8f0]">
            {companyLinks.map((link) => (
              <li class="py-3">
                <a href={resolveUrl(link.url)} class="text-[15px] font-medium text-vcl-petroleo hover:text-vcl-turquesa transition-colors">{link.label} →</a>
              </li>
            ))}
          </ul>
        </nav>
      ) : (
        <HomeClusters />
      )}
    </section>

    <!-- Divider -->
    <div class="hidden md:block w-px bg-[#e4e8f0]"></div>

    <!-- Right: 404 message -->
    <section class="home-greeting md:w-1/2 px-6 sm:px-10 py-8 md:py-10 flex items-center justify-center">
      <div class="text-center space-y-6 max-w-md">
        <div class="text-7xl sm:text-8xl font-bold text-[#1e40af] leading-none select-none tracking-tight">
          404
        </div>
        <div class="space-y-2">
          <h1 class="text-2xl sm:text-3xl font-semibold text-[#141a2e]">
            Página no encontrada
          </h1>
          <p class="text-base text-[#5c6785]">
            El contenido que buscás no está acá o cambió de lugar.
          </p>
        </div>
        <div class="flex flex-wrap justify-center gap-3 pt-2">
          <a
            href="/"
            class="px-6 py-3 rounded-lg bg-[#1e40af] text-white text-sm font-semibold shadow-sm hover:bg-[#1d4ed8] transition-colors"
          >
            ← Volver al inicio
          </a>
          <a
            href={resolveUrl(isCompanyBuild ? '/es/servicios/' : '/blog/')}
            class="px-6 py-3 rounded-lg bg-white text-[#1e40af] border border-[#c7d4f0] text-sm font-semibold hover:bg-[#eef2ff] transition-colors"
          >
            {isCompanyBuild ? 'Servicios' : `${SITE_CONFIG.blogName} (Blog)`}
          </a>
        </div>
      </div>
    </section>
  </div>
</main>

<style>
  @media (max-width: 767px) {
    .home-split { height: auto; min-height: calc(100vh - 112px); }
    .home-clusters { overflow-y: visible; }
    .home-greeting { min-height: 40vh; }
  }
</style>