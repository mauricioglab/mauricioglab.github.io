---
// Fila de redes de la plantilla personal. Se edita en el panel (Redes sociales): se puede mostrar, ocultar, ordenar y cambiar el enlace.
// Regla: visible + enlace = icono con vínculo; visible sin enlace = marcador «pendiente»; no visible = no se muestra.
import { getSettings } from '../../utils/portal-data';
import { SOCIAL_BY_KEY } from '../../data/social-icons';

interface Props { lang?: 'es' | 'en' }
const { lang = 'es' } = Astro.props;
const name = 'Mauricio González';
const en = lang === 'en';
const { networks } = await getSettings();
const items = networks.filter((n) => n.show && SOCIAL_BY_KEY[n.key]);
const hrefOf = (key: string, url: string) => (key === 'email' && url && !/^mailto:/i.test(url) ? `mailto:${url}` : url);
---

<ul>
  {items.map((n) => {
    const def = SOCIAL_BY_KEY[n.key];
    return (
      <li>
        {n.url ? (
          <a href={hrefOf(n.key, n.url)} aria-label={en ? `${def.label} of ${name}` : `${def.label} de ${name}`} title={def.label} rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={def.path} /></svg></a>
        ) : (
          <span class="pt-social-ph" role="img" aria-label={en ? `${def.label}: profile pending` : `${def.label}: perfil pendiente de confirmar`} title={en ? `${def.label}: pending` : `${def.label}: pendiente de confirmar`}><svg viewBox="0 0 24 24" aria-hidden="true"><path d={def.path} /></svg></span>
        )}
      </li>
    );
  })}
</ul>
