---
import ContactModal from './ContactModal.astro';
import { getSiteNav, type Lang } from '../../data/site-nav';
import '../../styles/personal-profile.css';
import { getSettings } from '../../utils/portal-data';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const nav = getSiteNav(lang);
const year = new Date().getFullYear();
const showCuriosidades = (await getSettings(lang)).sections.curiosidades;
---

<footer class="pt-footer">
  <p>
    <a class="pt-footer-name" href="/">{nav.brand.name}</a>, &copy; {year}
    {showCuriosidades && <> &middot; <a class="pt-footer-small" href="/curiosidades/">{lang === 'en' ? 'Curiosities' : 'Curiosidades'}</a></>}
  </p>
</footer>

<ContactModal lang={lang} />
