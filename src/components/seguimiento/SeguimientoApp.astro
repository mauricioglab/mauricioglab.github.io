    async guardarEncuentro(encId) {
      if (!this.canEdit) return;
      this.saved = false;
      
      try {
        const grupoId = this.selectedGrupo;
        const local = this.localData[encId];
        const asist = this.localAsist[encId];
        
        if (!local && !asist) return;
        
        // Determinar si es primera vez o modificación
        const key = `${encId}_${grupoId}`;
        const hasExisting = !!this.data[encId]?.[grupoId]?.FN || !!this.data[encId]?.[grupoId]?.DEV || !!this.data[encId]?.[grupoId]?.SM;
        const isModificacion = hasExisting || (this.evalMeta[key]?.es_modificacion);
        const maxNota = 10;
        
        // Validar notas
        const dims = ['FN', 'DEV', 'SM'];
        for (const dim of dims) {
          const val = local?.[dim];
          if (val !== null && val !== '' && val !== undefined) {
            const numVal = Number(val);
            if (numVal < 1 || numVal > maxNota) {
              alert(`La nota de ${dim} para ${encId} debe estar entre 1 y ${maxNota}.`);
              return;
            }
          }
        }
        
        const evalPayload = {
          grupo_id: grupoId,
          encuentro_meta_id: encId,
          practica: this.grupoActual?.practica || 'P2',
          fn: local?.FN || null,
          dev: local?.DEV || null,
          sm: local?.SM || null,
          feedback_fn: local?.feedback?.FN || '',
          feedback_dev: local?.feedback?.DEV || '',
          feedback_sm: local?.feedback?.SM || '',
        };
        
        // Manejar fechas y estado de modificación
        if (isModificacion) {
          evalPayload.es_modificacion = true;
          evalPayload.fecha_modificacion = new Date().toISOString();
          evalPayload.override_limite = false;
          if (this.evalMeta[key]?.fecha_primera_nota) {
            evalPayload.fecha_primera_nota = this.evalMeta[key].fecha_primera_nota;
          }
        } else {
          evalPayload.fecha_primera_nota = new Date().toISOString();
          evalPayload.es_modificacion = false;
          evalPayload.override_limite = false;
        }
        
        const existingEvalId = this.evalMeta[key]?.id;
        let evalId = existingEvalId;
        if (evalId) {
          const { error } = await supabase.from('evaluaciones').update(evalPayload).eq('id', evalId);
          if (error) throw error;
        } else {
          const { data: newEval, error } = await supabase
            .from('evaluaciones')
            .insert(evalPayload)
            .select('id')
            .single();
          if (error) throw error;
          evalId = newEval.id;
        }
        
        if (asist) {
          for (const [nombre, estado] of Object.entries(asist)) {
            if (!estado) continue;
            const { error: asErr } = await supabase
              .from('asistencias')
              .upsert({ evaluacion_id: evalId, integrante_nombre: nombre, estado }, { onConflict: 'evaluacion_id,integrante_nombre' });
            if (asErr) throw asErr;
          }
        }
        
        if (!this.data[encId]) this.data[encId] = {};
        if (!this.data[encId][grupoId]) this.data[encId][grupoId] = {};
        this.data[encId][grupoId] = {
          FN: local?.FN || undefined,
          DEV: local?.DEV || undefined,
          SM: local?.SM || undefined,
          fb: {
            FN: local?.feedback?.FN || '',
            DEV: local?.feedback?.DEV || '',
            SM: local?.feedback?.SM || '',
          },
          asistencia: { ...asist },
        };
        
        this.evalMeta[key] = {
          fecha_primera_nota: evalPayload.fecha_primera_nota,
          fecha_modificacion: evalPayload.fecha_modificacion,
          es_modificacion: evalPayload.es_modificacion,
          override_limite: evalPayload.override_limite
        };
        
        this.saved = true;
        setTimeout(() => this.saved = false, 2000);
      } catch (e) {
        console.error('Error saving:', e);
        alert('Error al guardar: ' + e.message);
      }
    },
    
    // --- GRUPO CRUD ---
    openAddGrupoModal() {
      this.editingGrupoId = null;
      const carreraId = this.carreraFilter && this.carreraFilter !== 'Todas' ? this.carreraFilter : 'analista-sistemas';
      this.newGrupo = {
        proyecto: '',
        comision: '',
        practica: this.practicasDeCarrera(carreraId)[0]?.codigo || 'P1',
        carrera_id: carreraId,
        integrantes: [{nombre:'',rol:'',observacion:'', tagEstado:'cursando', dbId:null}]
      };
      this.addGrupoError = '';
      this.showAddGrupo = true;
    },

    onNewGrupoCarreraChange() {
      const lista = this.practicasDeCarrera(this.newGrupo.carrera_id);
      if (!lista.find(p => p.codigo === this.newGrupo.practica)) {
        this.newGrupo.practica = lista[0]?.codigo || 'P1';
      }
    },

    openEditGrupoModal() {
      const g = this.grupoActual;
      if (!g) return;
      this.editingGrupoId = g.id;
      this.newGrupo = {
        proyecto: g.proyecto,
        comision: g.comision || '',
        practica: g.practica || 'P2',
        carrera_id: g.carrera_id || 'analista-sistemas',
        integrantes: g.integrantes.map(i => ({
          nombre: i.nombre,
          rol: i.rol || '',
          observacion: i.obs || '',
          tagEstado: this.tagEstadoDesdeTags(i.tags || [], g.practica),
          dbId: i.id || null
        }))
      };
      this.addGrupoError = '';
      this.showAddGrupo = true;
    },

    // --- TRASLADO A TUTORÍAS (transferencia puntual y reversible P3 <-> TutoriasPost) ---
    puedeTrasladarATutorias(g) {
      if (!g) return false;
      const cat = this.practicasCatalogo.find(p => p.carrera_id === (g.carrera_id || 'analista-sistemas') && p.codigo === 'TutoriasPost');
      return !!cat && g.practica === 'P3';
    },

    esTrasladado(g) {
      return !!g && g.practica === 'TutoriasPost' && !!g.practica_origen;
    },

    abrirTraslado(g) {
      if (!this.canEdit || !g) return;
      this.trasladoGrupo = g;
      this.trasladoError = '';
      this.showTraslado = true;
    },

    async confirmarTraslado() {
      if (!this.trasladoGrupo || !this.canEdit) return;
      this.trasladoSaving = true;
      this.trasladoError = '';
      try {
        const g = this.trasladoGrupo;
        const esDevolucion = this.esTrasladado(g);
        const nuevaPractica = esDevolucion ? g.practica_origen : 'TutoriasPost';
        const nuevoOrigen = esDevolucion ? null : g.practica;
        const { error } = await supabase.from('grupos')
          .update({ practica: nuevaPractica, practica_origen: nuevoOrigen })
          .eq('id', g.id);
        if (error) throw error;
        const idx = this.grupos.findIndex(x => x.id === g.id);
        if (idx >= 0) {
          this.grupos[idx] = { ...this.grupos[idx], practica: nuevaPractica, practica_origen: nuevoOrigen };
        }
        for (const encId of Object.keys(this.data)) {
          if (this.data[encId] && this.data[encId][g.id]) delete this.data[encId][g.id];
        }
        const gidSufix = `_${g.id}`;
        for (const k of Object.keys(this.evalMeta)) {
          if (k.endsWith(gidSufix)) delete this.evalMeta[k];
        }
        this.showTraslado = false;
        this.trasladoGrupo = null;
      } catch (e) {
        this.trasladoError = 'Error: ' + (e.message || e);
      } finally {
        this.trasladoSaving = false;
      }
    },
    
    async guardarGrupoModal() {
      if (!this.canEdit) return;
      this.loadingAddGrupo = true;
      this.addGrupoError = '';
      
      try {
        if (!this.newGrupo.proyecto.trim()) {
          throw new Error('El nombre del proyecto es obligatorio');
        }
        const validIntegrantes = this.newGrupo.integrantes.filter(i => i.nombre.trim());
        if (validIntegrantes.length === 0) {
          throw new Error('Debe haber al menos un integrante');
        }
        
        if (this.editingGrupoId) {
          // EDITAR GRUPO EXISTENTE
          const grupoId = this.editingGrupoId;
          const { error: gErr } = await supabase.from('grupos').update({
            proyecto: this.newGrupo.proyecto.trim(),
            comision: this.newGrupo.comision.trim(),
            practica: this.newGrupo.practica,
            carrera_id: this.newGrupo.carrera_id
          }).eq('id', grupoId);
          if (gErr) throw gErr;

          const { data: currentInts, error: intErr } = await supabase
            .from('integrantes')
            .select('*')
            .eq('grupo_id', grupoId);
          if (intErr) throw intErr;

          const currentMap = new Map();
          (currentInts || []).forEach(i => currentMap.set(i.id, i));
          const handledIds = new Set();

          for (const int of validIntegrantes) {
            if (int.dbId && currentMap.has(int.dbId)) {
              const { error } = await supabase.from('integrantes').update({
                nombre: int.nombre.trim(),
                rol: int.rol.trim(),
                observacion: int.observacion.trim(),
                tags: this.tagsParaIntegrante(this.newGrupo.practica, int.tagEstado)
              }).eq('id', int.dbId);
              if (error) throw error;
              handledIds.add(int.dbId);
            } else {
              const { data: newInt, error } = await supabase.from('integrantes').insert({
                grupo_id: grupoId,
                nombre: int.nombre.trim(),
                rol: int.rol.trim(),
                observacion: int.observacion.trim(),
                tags: this.tagsParaIntegrante(this.newGrupo.practica, int.tagEstado)
              }).select('id').single();
              if (error) throw error;
              handledIds.add(newInt.id);
            }
          }

          for (const [id] of currentMap) {
            if (!handledIds.has(id)) {
              const { error } = await supabase.from('integrantes').delete().eq('id', id);
              if (error) throw error;
            }
          }

          const gIdx = this.grupos.findIndex(g => g.id === grupoId);
          if (gIdx >= 0) {
            const prevPractica = this.grupos[gIdx].practica;
            this.grupos[gIdx] = {
              ...this.grupos[gIdx],
              proyecto: this.newGrupo.proyecto.trim(),
              comision: this.newGrupo.comision.trim(),
              practica: this.newGrupo.practica,
              carrera_id: this.newGrupo.carrera_id,
              integrantes: validIntegrantes.map(i => ({
                id: i.dbId,
                nombre: i.nombre.trim(),
                rol: i.rol.trim(),
                obs: i.observacion.trim(),
                tags: this.tagsParaIntegrante(this.newGrupo.practica, i.tagEstado)
              }))
            };
            if (prevPractica !== this.newGrupo.practica) {
              for (const encId of Object.keys(this.data)) {
                if (this.data[encId] && this.data[encId][grupoId]) delete this.data[encId][grupoId];
              }
              const gidSufix = `_${grupoId}`;
              for (const k of Object.keys(this.evalMeta)) {
                if (k.endsWith(gidSufix)) delete this.evalMeta[k];
              }
            }
          }

        } else {
          // CREAR NUEVO GRUPO
          const nextId = Math.max(0, ...this.grupos.map(g => g.id)) + 1;

          const { error: gErr } = await supabase.from('grupos').insert({
            id: nextId,
            proyecto: this.newGrupo.proyecto.trim(),
            comision: this.newGrupo.comision.trim(),
            practica: this.newGrupo.practica,
            carrera_id: this.newGrupo.carrera_id
          });
          if (gErr) throw gErr;

          const intRows = validIntegrantes.map(i => ({
            grupo_id: nextId,
            nombre: i.nombre.trim(),
            rol: i.rol.trim(),
            observacion: i.observacion.trim(),
            tags: this.tagsParaIntegrante(this.newGrupo.practica, i.tagEstado)
          }));
          const { error: intErr } = await supabase.from('integrantes').insert(intRows);
          if (intErr) throw intErr;

          this.grupos.push({
            id: nextId,
            proyecto: this.newGrupo.proyecto.trim(),
            comision: this.newGrupo.comision.trim(),
            practica: this.newGrupo.practica,
            carrera_id: this.newGrupo.carrera_id,
            activo: true,
            alertas: [],
            integrantes: validIntegrantes.map(i => ({
              nombre: i.nombre.trim(),
              rol: i.rol.trim(),
              obs: i.observacion.trim(),
              tags: this.tagsParaIntegrante(this.newGrupo.practica, i.tagEstado)
            }))
          });
        }

        // Reset
        const carreraReset = this.carreraFilter && this.carreraFilter !== 'Todas' ? this.carreraFilter : 'analista-sistemas';
        this.newGrupo = {
          proyecto: '',
          comision: '',
          practica: this.practicasDeCarrera(carreraReset)[0]?.codigo || 'P1',
          carrera_id: carreraReset,
          integrantes: [{nombre:'',rol:'',observacion:'', tagEstado:'cursando', dbId:null}]
        };
        this.editingGrupoId = null;
        this.showAddGrupo = false;
        
      } catch (e) {
        this.addGrupoError = e.message || 'Error al guardar grupo';
      } finally {
        this.loadingAddGrupo = false;
      }
    },
    
    confirmDeleteGrupo() {
      this.grupoToDelete = this.grupoActual;
      this.showConfirmDelete = true;
    },
    
    async eliminarGrupoConfirmado() {
      if (!this.grupoToDelete || !this.canEdit) return;
      this.loadingDelete = true;
      
      try {
        const grupoId = this.grupoToDelete.id;
        const { error } = await supabase.from('grupos').update({ activo: false }).eq('id', grupoId);
        if (error) throw error;
        
        this.grupos = this.grupos.map(g => g.id === this.grupoToDelete.id ? { ...g, activo: false } : g);
        
        this.showConfirmDelete = false;
        this.grupoToDelete = null;
        this.view = 'resumen';
        
      } catch (e) {
        alert('Error al desactivar: ' + e.message);
      } finally {
        this.loadingDelete = false;
      }
    },

    async reactivarGrupo(id) {
      if (!this.canEdit) return;
      try {
        const { error } = await supabase.from('grupos').update({ activo: true }).eq('id', id);
        if (error) throw error;
        this.grupos = this.grupos.map(g => g.id === id ? { ...g, activo: true } : g);
      } catch (e) {
        alert('Error al reactivar: ' + e.message);
      }
    },
    
    async guardarComision() {
      if (!this.canEdit) return;
      this.addComisionError = '';
      
      try {
        if (!this.newComision.id.trim() || !this.newComision.nombre.trim()) {
          throw new Error('Código y nombre son obligatorios');
        }
        
        const comData = {
          id: this.newComision.id.trim(),
          nombre: this.newComision.nombre.trim(),
          activa: true
        };
        const { error } = await supabase.from('comisiones').insert(comData);
        if (error) throw error;

        this.comisiones.push({ id: this.newComision.id.trim(), ...comData });
        this.comisiones.sort((a, b) => a.nombre.localeCompare(b.nombre));
        
        this.newComision = { id: '', nombre: '' };
        this.showAddComision = false;
        
      } catch (e) {
        this.addComisionError = e.message || 'Error al crear comisión';
      }
    },
    
    get importTotalChanges() {
      if (!this.importDiff) return 0;
      const d = this.importDiff;
      const sel = this.importGroupSelection || {};
      const isSelected = (gId) => sel[gId] !== false;
      const countItems = (arr, gField) => arr.filter(item => isSelected(item[gField])).length;
      return countItems(d.grupos?.added || [], 'id')
        + countItems(d.grupos?.modified || [], 'id')
        + countItems(d.integrantes?.added || [], 'grupo_id')
        + countItems(d.integrantes?.modified || [], 'grupo_id')
        + countItems(d.evaluaciones?.added || [], 'grupo_id')
        + countItems(d.evaluaciones?.modified || [], 'grupo_id')
        + countItems(d.asistencias?.added || [], 'grupo_id')
        + countItems(d.asistencias?.modified || [], 'grupo_id');
    },
    
    get importSelectedNew() {
      if (!this.importDiff) return 0;
      const sel = this.importGroupSelection || {};
      const isSelected = (gId) => sel[gId] !== false;
      const d = this.importDiff;
      return (d.grupos?.added || []).filter(g => isSelected(g.id)).length
        + (d.integrantes?.added || []).filter(i => isSelected(i.grupo_id)).length
        + (d.evaluaciones?.added || []).filter(e => isSelected(e.grupo_id)).length
        + (d.asistencias?.added || []).filter(a => isSelected(a.grupo_id)).length;
    },
    
    get importSelectedModified() {
      if (!this.importDiff) return 0;
      const sel = this.importGroupSelection || {};
      const isSelected = (gId) => sel[gId] !== false;
      const d = this.importDiff;
      return (d.grupos?.modified || []).filter(g => isSelected(g.id)).length
        + (d.integrantes?.modified || []).filter(i => isSelected(i.grupo_id)).length
        + (d.evaluaciones?.modified || []).filter(e => isSelected(e.grupo_id)).length
        + (d.asistencias?.modified || []).filter(a => isSelected(a.grupo_id)).length;
    },
    
    get importSelectedOverwrites() {
      if (!this.importDiff) return 0;
      const sel = this.importGroupSelection || {};
      const isSelected = (gId) => sel[gId] !== false;
      const d = this.importDiff;
      return (d.grupos?.modified || []).filter(g => isSelected(g.id)).length
        + (d.integrantes?.modified || []).filter(i => isSelected(i.grupo_id)).length
        + (d.evaluaciones?.modified || []).filter(e => isSelected(e.grupo_id)).length
        + (d.asistencias?.modified || []).filter(a => isSelected(a.grupo_id)).length;
    },
    
    get importDiffByGroup() {
      if (!this.importDiff) return [];
      const d = this.importDiff;
      const groupMap = {};
      const getGroup = (id) => {
        if (!groupMap[id]) {
          const g = this.grupos.find(g => g.id === id);
          groupMap[id] = {
            id: id,
            proyecto: g ? g.proyecto : `Grupo ${id}`,
            comision: g ? g.comision : '',
            isNew: false,
            grupoChanges: [],
            integrantesAdded: [],
            integrantesModified: [],
            encuentros: {},
          };
        }
        return groupMap[id];
      };

      d.grupos.added.forEach(g => {
        const grp = getGroup(g.id);
        grp.isNew = true;
        grp.proyecto = g.proyecto;
        grp.comision = g.comision || '';
        grp.integrantesAdded = g.integrantes.map(i => ({ ...i }));
      });
      d.grupos.modified.forEach(g => {
        const grp = getGroup(g.id);
        grp.proyecto = g.proyecto;
        grp.comision = g.comision || '';
        grp.grupoChanges = g.changes || [];
      });
      d.integrantes.added.forEach(i => {
        const grp = getGroup(i.grupo_id);
        grp.integrantesAdded.push(i);
      });
      d.integrantes.modified.forEach(i => {
        const grp = getGroup(i.grupo_id);
        grp.integrantesModified.push(i);
      });
      d.evaluaciones.added.forEach(e => {
        const grp = getGroup(e.grupo_id);
        if (!grp.encuentros[e.encuentro_meta_id]) grp.encuentros[e.encuentro_meta_id] = { notasAdded: [], notasModified: [], fbAdded: [], fbModified: [], asistAdded: [], asistModified: [] };
        const enc = grp.encuentros[e.encuentro_meta_id];
        ['FN', 'DEV', 'SM'].forEach(dim => {
          if (e.dimensions[dim]) {
            if (e.dimensions[dim].puntaje) enc.notasAdded.push({ dimension: dim, puntaje: e.dimensions[dim].puntaje });
            if (e.dimensions[dim].feedback && e.dimensions[dim].feedback.trim()) {
              const txt = e.dimensions[dim].feedback.trim();
              enc.fbAdded.push({ dimension: dim, feedback: txt.length > 60 ? txt.substring(0, 60) + '...' : txt });
            }
          }
        });
      });
      d.evaluaciones.modified.forEach(e => {
        const grp = getGroup(e.grupo_id);
        if (!grp.encuentros[e.encuentro_meta_id]) grp.encuentros[e.encuentro_meta_id] = { notasAdded: [], notasModified: [], fbAdded: [], fbModified: [], asistAdded: [], asistModified: [] };
        const enc = grp.encuentros[e.encuentro_meta_id];
        (e.changes || []).forEach(ch => {
          if (ch.type === 'nota_added') enc.notasAdded.push({ dimension: ch.dimension, puntaje: ch.value });
          else if (ch.type === 'nota_modified') enc.notasModified.push({ dimension: ch.dimension, from: ch.from, to: ch.to });
          else if (ch.type === 'fb_added') enc.fbAdded.push({ dimension: ch.dimension, feedback: ch.value });
          else if (ch.type === 'fb_modified') enc.fbModified.push({ dimension: ch.dimension, from: ch.from, to: ch.to });
        });
      });
      d.asistencias.added.forEach(a => {
        const grp = getGroup(a.grupo_id);
        if (!grp.encuentros[a.encuentro_meta_id]) grp.encuentros[a.encuentro_meta_id] = { notasAdded: [], notasModified: [], fbAdded: [], fbModified: [], asistAdded: [], asistModified: [] };
        grp.encuentros[a.encuentro_meta_id].asistAdded.push(a);
      });
      d.asistencias.modified.forEach(a => {
        const grp = getGroup(a.grupo_id);
        if (!grp.encuentros[a.encuentro_meta_id]) grp.encuentros[a.encuentro_meta_id] = { notasAdded: [], notasModified: [], fbAdded: [], fbModified: [], asistAdded: [], asistModified: [] };
        grp.encuentros[a.encuentro_meta_id].asistModified.push(a);
      });

      const encIds = ['E1', 'E2', 'E3', 'E4', 'E5', 'E6', 'E7'];
      const result = Object.values(groupMap).sort((a, b) => a.id - b.id);
      result.forEach(grp => {
        grp.encuentrosOrdered = encIds.filter(eid => grp.encuentros[eid]).map(eid => ({ id: eid, ...grp.encuentros[eid] }));
        
        const g = this.grupos.find(g => g.id === grp.id);
        grp.currentAvg = this.calcNota(this.promedioEncuentros(grp.id));
        grp.currentPct = this.calcPctStr(this.promedioEncuentros(grp.id));
        
        const projectedData = {};
        this.planillaPara(g?.carrera_id, g?.practica || 'P2').forEach(enc => {
          if (!projectedData[enc.id]) projectedData[enc.id] = {};
          const existing = this.data[enc.id]?.[grp.id];
          if (existing) {
            projectedData[enc.id] = { ...existing, fb: { ...(existing.fb || {}) } };
          }
        });
        if (this.importGroupSelection[grp.id] !== false) {
          d.evaluaciones.added.forEach(e => {
            if (e.grupo_id !== grp.id) return;
            if (!projectedData[e.encuentro_meta_id]) projectedData[e.encuentro_meta_id] = {};
            const entry = projectedData[e.encuentro_meta_id];
            ['FN', 'DEV', 'SM'].forEach(dim => {
              if (e.dimensions[dim] && e.dimensions[dim].puntaje) entry[dim] = e.dimensions[dim].puntaje;
            });
            if (e.dimensions.FN?.feedback) { if (!entry.fb) entry.fb = {}; entry.fb.FN = e.dimensions.FN.feedback; }
            if (e.dimensions.DEV?.feedback) { if (!entry.fb) entry.fb = {}; entry.fb.DEV = e.dimensions.DEV.feedback; }
            if (e.dimensions.SM?.feedback) { if (!entry.fb) entry.fb = {}; entry.fb.SM = e.dimensions.SM.feedback; }
          });
          d.evaluaciones.modified.forEach(e => {
            if (e.grupo_id !== grp.id) return;
            if (!projectedData[e.encuentro_meta_id]) projectedData[e.encuentro_meta_id] = {};
            const entry = projectedData[e.encuentro_meta_id];
            (e.changes || []).forEach(ch => {
              if (ch.type === 'nota_added') entry[ch.dimension] = ch.value;
              else if (ch.type === 'nota_modified') entry[ch.dimension] = ch.to;
            });
          });
        }
        let sum = 0, count = 0;
        encIds.forEach(encId => {
          const sc = projectedData[encId];
          if (!sc) return;
          const vals = [sc.FN, sc.DEV, sc.SM].filter(v => v !== undefined && v !== null && v !== '');
          if (vals.length > 0) {
            sum += vals.reduce((a, b) => a + Number(b), 0) / (vals.length * 10);
            count++;
          }
        });
        const projectedPct = count > 0 ? sum / count : null;
        grp.projectedAvg = projectedPct !== null ? this.calcNota(projectedPct) : null;
        grp.projectedPct = projectedPct !== null ? this.calcPctStr(projectedPct) : null;
      });
      return result;
    },
    
    async handleExcelImport(event) {
      const file = event.target.files[0];
      if (!file) return;
      
      this.importLoading = true;
      this.importLoadingMsg = 'Leyendo archivo Excel...';
      this.importDiff = null;
      this.importResult = null;
      this.showImportModal = true;
      
      try {
        const excelData = await parseExcelFile(file);
        
        this.importLoadingMsg = 'Comparando con datos existentes...';
        
        const { data: intData, error: intErr } = await supabase.from('integrantes').select('*');
        if (intErr) throw intErr;
        const integrantesData = (intData || []).map(i => ({
          id: i.id, grupo_id: i.grupo_id, nombre: i.nombre, rol: i.rol || '', observacion: i.observacion || ''
        }));

        const diff = buildDiff(excelData, this.grupos, this.data, this.evalMeta, integrantesData);
        this.importDiff = diff;
        this.importGroupSelection = {};
        this.importDiffByGroup.forEach(g => { this.importGroupSelection[g.id] = true; });
        this.importLoading = false;
      } catch (e) {
        console.error('Error importando Excel:', e);
        alert('Error al leer el archivo Excel: ' + e.message);
        this.showImportModal = false;
        this.importLoading = false;
      }
      
      event.target.value = '';
    },
    
    async applyImport() {
      if (this.importDryRun) return;
      if (!this.importDiff || this.importTotalChanges === 0) return;
      
      this.importLoading = true;
      this.importLoadingMsg = 'Aplicando cambios a la base de datos...';
      
      try {
        const filteredDiff = this.filterDiffBySelection(this.importDiff);
        const result = await applyDiffToSupabase(filteredDiff, supabase);
        this.importResult = result;
        this.importLoading = false;
        
        await this.loadFromSupabase();
      } catch (e) {
        console.error('Error aplicando importación:', e);
        alert('Error al aplicar cambios: ' + e.message);
        this.importLoading = false;
      }
    },
    
    filterDiffBySelection(diff) {
      const sel = this.importGroupSelection || {};
      const isSelected = (gId) => sel[gId] !== false;
      return {
        grupos: {
          added: (diff.grupos?.added || []).filter(g => isSelected(g.id)),
          modified: (diff.grupos?.modified || []).filter(g => isSelected(g.id)),
          unchanged: diff.grupos?.unchanged || [],
        },
        integrantes: {
          added: (diff.integrantes?.added || []).filter(i => isSelected(i.grupo_id)),
          modified: (diff.integrantes?.modified || []).filter(i => isSelected(i.grupo_id)),
          unchanged: diff.integrantes?.unchanged || [],
        },
        evaluaciones: {
          added: (diff.evaluaciones?.added || []).filter(e => isSelected(e.grupo_id)),
          modified: (diff.evaluaciones?.modified || []).filter(e => isSelected(e.grupo_id)),
          unchanged: diff.evaluaciones?.unchanged || [],
        },
        asistencias: {
          added: (diff.asistencias?.added || []).filter(a => isSelected(a.grupo_id)),
          modified: (diff.asistencias?.modified || []).filter(a => isSelected(a.grupo_id)),
          unchanged: diff.asistencias?.unchanged || [],
        },
      };
    }
  }));

  Alpine.start();
</script>
