          >
            <span x-text="planillaSaving ? 'Guardando...' : 'Guardar planilla'"></span>
          </button>
        </div>
      </div>
    </div>

    <!-- VISTA GRUPO DETALLE -->
    <div x-show="view === 'grupo' && selectedGrupo && !loadingData" x-transition>
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <button @click="view = 'resumen'" class="w-9 h-9 flex items-center justify-center rounded-lg border border-gray-300 bg-white text-gray-600 hover:text-gray-900 hover:bg-gray-50">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <div class="flex-1 min-w-0">
          <h2 class="text-base sm:text-lg font-extrabold text-gray-900 truncate" x-text="`G${grupoActual?.id} · ${grupoActual?.proyecto}`"></h2>
          <p class="text-xs text-gray-600 font-medium truncate" x-text="`Grupo ${grupoActual?.id} ${grupoActual?.comision ? '· ' + grupoActual.comision : ''} ${grupoActual?.practica ? '· ' + grupoActual.practica : ''}`"></p>
          <span x-show="esTrasladado(grupoActual)" class="inline-flex items-center px-1.5 py-0.5 mt-1 rounded-md bg-purple-100 text-purple-700 text-[10px] font-bold">↔ En Tutorías (trasladado desde PP3)</span>
        </div>
        
        <!-- Selector de encuentros -->
        <div class="flex gap-1 overflow-x-auto order-last w-full sm:w-auto sm:order-none">
          <template x-for="enc in encuentrosMeta" :key="enc.id">
            <button 
              @click="activeE = enc.id"
              class="flex-shrink-0 px-2 py-1 rounded-md border text-xs font-bold transition"
              :class="activeE === enc.id ? 'border-indigo-700 bg-indigo-700 text-white' : 'border-gray-300 bg-white text-gray-600 hover:bg-gray-50'"
            >
              <span x-text="enc.id"></span>
            </button>
          </template>
        </div>
        
        <div class="flex items-center gap-2 flex-wrap">
          <button 
            x-show="canEdit"
            @click="openEditGrupoModal()"
            class="w-9 h-9 flex items-center justify-center rounded-lg border border-gray-300 bg-white text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition"
            title="Editar grupo"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
          </button>
          <button
            x-show="canEdit && grupoActual?.activo === false"
            @click="reactivarGrupo(selectedGrupo)"
            class="px-3 h-9 flex items-center gap-1 rounded-lg border border-green-200 bg-green-50 text-green-700 hover:bg-green-100 transition text-xs font-bold"
            title="Reactivar grupo"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M1 4v6h6"/><path d="M3.51 15a9 9 0 102.13-9.36L1 10"/></svg>
            Reactivar
          </button>
          <button
            x-show="canEdit && puedeTrasladarATutorias(grupoActual)"
            @click="abrirTraslado(grupoActual)"
            class="px-3 h-9 flex items-center gap-1 rounded-lg border border-purple-200 bg-purple-50 text-purple-700 hover:bg-purple-100 transition text-xs font-bold"
            title="Trasladar a Tutorías"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 1l4 4-4 4"/><path d="M3 11V9a4 4 0 014-4h14"/><path d="M7 23l-4-4 4-4"/><path d="M21 13v2a4 4 0 01-4 4H3"/></svg>
            Trasladar a Tutorías
          </button>
          <button
            x-show="canEdit && esTrasladado(grupoActual)"
            @click="abrirTraslado(grupoActual)"
            class="px-3 h-9 flex items-center gap-1 rounded-lg border border-purple-200 bg-purple-50 text-purple-700 hover:bg-purple-100 transition text-xs font-bold"
            title="Devolver a PP3"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 1l4 4-4 4"/><path d="M3 11V9a4 4 0 014-4h14"/><path d="M7 23l-4-4 4-4"/><path d="M21 13v2a4 4 0 01-4 4H3"/></svg>
            Devolver a PP3
          </button>
          <button
            x-show="canEdit"
            @click="confirmDeleteGrupo()"
            class="w-9 h-9 flex items-center justify-center rounded-lg border border-red-200 bg-red-50 text-red-600 hover:bg-red-100 transition"
            title="Desactivar grupo"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"/></svg>
          </button>
          <span x-show="saved" class="text-xs text-green-700 font-bold">✓ Guardado</span>
        </div>
      </div>

      <!-- Alertas del grupo -->
      <div x-show="grupoActual" class="flex flex-wrap items-center gap-2 mb-3">
        <template x-for="at in alertasTipos" :key="at.id">
          <button 
            @click="toggleAlerta(selectedGrupo, at.id)"
            class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg border text-xs font-bold transition"
            :class="tieneAlerta(selectedGrupo, at.id) ? alertaColor(at.id) : 'border-gray-200 bg-white text-gray-400 hover:bg-gray-50'"
            :title="tieneAlerta(selectedGrupo, at.id) ? 'Quitar ' + at.nombre : 'Marcar ' + at.nombre"
          >
            <span x-text="alertaIcon(at.id)"></span>
            <span x-text="at.nombre"></span>
          </button>
        </template>
        <span x-show="!canEdit && grupoAlertas(selectedGrupo).length === 0" class="text-xs text-gray-400">Sin alertas</span>
      </div>

      <!-- Encuentro activo -->
      <div class="bg-white rounded-xl p-4 mb-3 border border-gray-200 shadow-sm" x-show="encuentroActual">
        <h3 class="font-bold text-sm text-gray-900 mb-1" x-text="encuentroActual?.nombre"></h3>
        <p class="text-xs text-gray-600 italic mb-4 font-medium" x-text="encuentroActual?.pregunta"></p>

        <!-- Asistencia -->
        <div class="mb-4">
          <h4 class="text-xs font-bold text-gray-700 uppercase tracking-wide mb-2">Asistencia</h4>
          <div class="space-y-2">
            <template x-for="int in grupoActual?.integrantes" :key="int.nombre">
              <div class="flex items-center justify-between gap-2 py-1 border-b border-gray-50">
                <div class="min-w-0">
                  <div class="flex flex-wrap items-center gap-1">
                    <span class="text-sm text-gray-900 font-bold" x-text="int.nombre"></span>
                    <span class="text-xs text-gray-600 font-medium" x-text="int.rol"></span>
                    <span x-show="int.obs" class="text-xs text-amber-600 font-bold" x-text="'('+int.obs+')'"></span>
                  </div>
                  <template x-for="tag in (int.tags || [])" :key="tag">
                    <span class="inline-flex items-center px-1.5 py-0.5 mt-0.5 mr-1 rounded-md bg-indigo-50 text-indigo-700 text-[10px] font-bold" x-text="tag"></span>
                  </template>
                </div>
                <div class="flex gap-1 shrink-0" x-show="canEdit">
                  <template x-for="opt in ['Presente (Presencial)','Presente (Virtual)','Ausente','Justificado']" :key="opt">
                    <button 
                      @click="setAsist(int.nombre, localAsist[activeE]?.[int.nombre] === opt ? '' : opt)"
                      class="w-7 h-7 rounded-md border text-xs flex items-center justify-center transition font-bold"
                      :class="localAsist[activeE]?.[int.nombre] === opt ? asistBtnClass(opt) : 'border-gray-300 text-gray-400 bg-white'"
                      x-text="opt === 'Presente (Presencial)' ? 'P' : opt === 'Presente (Virtual)' ? 'V' : opt === 'Ausente' ? '✕' : '−'"
                    ></button>
                  </template>
                </div>
                <span x-show="!canEdit" class="text-xs font-bold" :class="asistTextClass(localAsist[activeE]?.[int.nombre])" x-text="localAsist[activeE]?.[int.nombre] || '—'"></span>
              </div>
            </template>
          </div>
        </div>

        <!-- Dimensiones -->
        <h4 class="text-xs font-bold text-gray-700 uppercase tracking-wide mb-2">Evaluación de Dimensiones</h4>
        <template x-for="[dim, label, color] in [['FN','FN — Análisis Funcional','text-indigo-600'],['DEV','DEV — Técnico','text-sky-600'],['SM','SM/PO — Gestión','text-amber-600']]" :key="dim">
          <div class="mb-3 p-3 rounded-lg bg-gray-50 border border-gray-200">
            <div class="flex items-center gap-2 mb-2">
              <span class="font-bold text-sm flex-shrink-0" :class="color" x-text="label"></span>
              <span class="text-xs text-gray-500">|</span>
              <span class="text-xs text-gray-600 font-medium flex-1" x-text="criterioActual(dim)"></span>
              <input
                x-show="canEdit"
                type="number" min="0" max="10" step="0.5"
                :value="localData[activeE]?.[dim] ?? ''"
                @change="setField(activeE, dim, $event.target.value === '' ? null : Number($event.target.value))"
                class="w-14 px-2 py-1 border border-gray-300 rounded-lg text-sm text-center focus:outline-none focus:ring-2 focus:ring-indigo-600 text-gray-900 font-bold flex-shrink-0"
              >
              <span x-show="!canEdit" class="font-bold text-sm text-gray-900 flex-shrink-0" x-text="localData[activeE]?.[dim] ?? '—'"></span>
            </div>
            <input 
              x-show="canEdit"
              placeholder="Retroalimentación..."
              :value="localData[activeE]?.feedback?.[dim] ?? ''"
                @change="setFb(activeE, dim, $event.target.value)"
              class="w-full px-3 py-2 border border-gray-300 rounded-lg text-xs focus:outline-none focus:ring-2 focus:ring-indigo-600 text-gray-900"
            >
            <p x-show="!canEdit" class="text-xs text-gray-700 font-medium" x-text="localData[activeE]?.feedback?.[dim] || 'Sin feedback'"></p>
          </div>
        </template>

        <!-- Fechas -->
        <div class="mt-3 pt-3 border-t border-gray-200 space-y-2" x-data="{ key: activeE + '_' + selectedGrupo, meta: evalMeta[activeE + '_' + selectedGrupo] || {} }">
          <div x-show="meta.fecha_primera_nota" class="flex items-center justify-between text-xs text-gray-500">
            <span>Primera nota: <span x-text="meta.fecha_primera_nota ? new Date(meta.fecha_primera_nota).toLocaleDateString('es-AR') : '—'"></span></span>
            <span x-show="meta.fecha_modificacion">Modificación: <span x-text="new Date(meta.fecha_modificacion).toLocaleDateString('es-AR')"></span></span>
          </div>
        </div>

        <!-- Nota calculada -->
        <div class="flex items-center justify-end gap-2 mt-2">
          <span class="text-sm text-gray-700 font-bold">Nota:</span>
          <span 
            class="inline-flex items-center justify-center min-w-[3rem] h-8 rounded-lg text-sm font-bold"
            :class="notaBadgeClass(calcNota(calcPct(localData[activeE])))"
            x-text="calcNota(calcPct(localData[activeE]))"
          ></span>
          <span class="text-xs text-gray-400" x-text="calcPctStr(calcPct(localData[activeE]))"></span>
          <span class="text-gray-400 mx-1">|</span>
          <span class="text-sm text-gray-600 font-medium">Promedio:</span>
          <span 
            class="inline-flex items-center justify-center min-w-[3rem] h-8 rounded-lg text-sm font-bold"
            :class="notaBadgeClass(calcNota(promedioEncuentros(selectedGrupo)))"
            x-text="calcNota(promedioEncuentros(selectedGrupo))"
          ></span>
          <span class="text-xs text-gray-400" x-text="calcPctStr(promedioEncuentros(selectedGrupo))"></span>
        </div>
      </div>
    </div>

    <!-- VISTA ENCUENTRO DETALLE -->
    <div x-show="view === 'encuentro' && selectedEnc && !loadingData" x-transition>
      <div class="flex items-center gap-3 mb-4">
        <button @click="view = 'resumen'" class="w-9 h-9 flex items-center justify-center rounded-lg border border-gray-300 bg-white text-gray-600 hover:text-gray-900 hover:bg-gray-50">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <div>
          <h2 class="text-lg font-extrabold text-gray-900" x-text="encuentroSeleccionado?.nombre"></h2>
          <p class="text-xs text-gray-600 italic font-medium" x-text="encuentroSeleccionado?.pregunta"></p>
        </div>
      </div>

      <div class="space-y-2">
        <template x-for="grupo in gruposConProyecto" :key="grupo.id">
          <div class="bg-white rounded-xl p-3 flex items-center gap-3 border border-gray-200 shadow-sm">
            <div class="flex-1">
              <div class="font-bold text-sm text-gray-900">
                <span class="text-gray-500 font-bold mr-1" x-text="`G${grupo.id}`"></span>
                <span x-text="grupo.proyecto"></span>
              </div>
              <div class="flex gap-2 mt-1.5">
                <template x-for="dim in ['FN','DEV','SM']" :key="dim">
                  <span class="text-xs font-medium" :class="data[selectedEnc]?.[grupo.id]?.[dim] !== undefined ? 'text-gray-900 font-bold' : 'text-gray-400'">
                    <span x-text="dim"></span>: <span x-text="data[selectedEnc]?.[grupo.id]?.[dim] ?? '—'"></span>
                  </span>
                </template>
              </div>
            </div>
            <span 
              class="inline-flex items-center justify-center min-w-[2.5rem] h-7 rounded-md text-sm font-bold"
              :class="notaBadgeClass(calcNota(calcPct(data[selectedEnc]?.[grupo.id])))"
              x-text="calcNota(calcPct(data[selectedEnc]?.[grupo.id]))"
            ></span>
            <span class="text-[10px] text-gray-400" x-text="calcPctStr(calcPct(data[selectedEnc]?.[grupo.id]))"></span>
            <button 
              x-show="canEdit"
              @click="editGrupoEncuentro(grupo.id)"
              class="w-8 h-8 flex items-center justify-center rounded-lg border border-gray-300 bg-white text-indigo-700 hover:bg-indigo-50"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            </button>
          </div>
        </template>
      </div>
    </div>
  </main>

  <!-- Import Excel Modal -->
  <div 
    x-show="showImportModal"
    x-transition
    class="fixed inset-0 bg-black/60 flex items-end sm:items-center justify-center z-50 sm:p-4"
    @click.self="showImportModal = false"
  >
    <div class="bg-white rounded-t-2xl sm:rounded-xl p-6 w-full max-w-5xl border border-gray-300 shadow-lg max-h-[90vh] flex flex-col">
      <h2 class="text-lg font-bold text-gray-900 mb-1">Importar desde Excel</h2>
      <p class="text-xs text-gray-500 mb-3">Revisá los cambios antes de confirmar.</p>

      <label class="flex items-start gap-2 mb-3 p-3 rounded-lg border-2 cursor-pointer select-none transition"
        :class="importDryRun ? 'border-amber-400 bg-amber-50' : 'border-gray-200 bg-white'">
        <input type="checkbox" x-model="importDryRun" class="w-4 h-4 mt-0.5 rounded border-gray-300 text-amber-600 focus:ring-amber-500">
        <div>
          <span class="text-sm font-bold" :class="importDryRun ? 'text-amber-800' : 'text-gray-700'">Modo práctica</span>
          <p class="text-xs" :class="importDryRun ? 'text-amber-700' : 'text-gray-500'">
            Solo ver cambios sin guardar. Activado por defecto para revisar qué se pisaría. Desactivá esta opción para poder confirmar la importación.
          </p>
        </div>
      </label>

      <div x-show="importDryRun" class="mb-3 p-3 bg-amber-100 border border-amber-300 rounded-lg text-xs text-amber-800 flex items-center gap-2">
        <svg class="w-5 h-5 flex-shrink-0 text-amber-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"/></svg>
        <span class="font-medium">No se guardarán cambios. Desactivá "Modo práctica" para habilitar la confirmación.</span>
      </div>

      <!-- Loading -->
      <div x-show="importLoading" class="text-center py-8">
        <div class="inline-block w-8 h-8 border-2 border-indigo-700 border-t-transparent rounded-full animate-spin"></div>
        <p class="text-sm text-gray-600 mt-2 font-medium" x-text="importLoadingMsg"></p>
      </div>

      <!-- Diff content grouped by group -->
      <div x-show="!importLoading && importDiff" class="space-y-3 overflow-y-auto flex-1 min-h-0">
        <!-- Summary -->
        <div class="p-3 bg-gray-50 rounded-lg border border-gray-200 text-xs">
          <div class="grid grid-cols-4 gap-2 text-center">
            <div>
              <div class="text-green-700 font-extrabold text-lg" x-text="importSelectedNew"></div>
              <div class="text-gray-600 font-bold">Nuevos</div>
            </div>
            <div>
              <div class="text-amber-700 font-extrabold text-lg" x-text="importSelectedModified"></div>
              <div class="text-gray-600 font-bold">Modificados</div>
            </div>
            <div>
              <div class="text-gray-400 font-extrabold text-lg" x-text="importTotalChanges"></div>
              <div class="text-gray-600 font-bold">Total</div>
            </div>
            <div>
              <div class="text-red-600 font-extrabold text-lg" x-text="importSelectedOverwrites"></div>
              <div class="text-gray-600 font-bold">Se sobreescriben</div>
            </div>
          </div>
        </div>

        <!-- Grouped by group -->
        <template x-for="grp in importDiffByGroup" :key="'grp-' + grp.id">
          <div class="rounded-lg border transition-opacity" :class="importGroupSelection[grp.id] !== false ? (grp.isNew ? 'border-green-300 bg-green-50/30 opacity-100' : 'border-gray-200 bg-white opacity-100') : 'border-gray-300 bg-gray-50 opacity-50'">
            <!-- Group header with radio + projected average -->
            <div class="px-3 py-2 flex items-center gap-3 border-b" :class="grp.isNew ? 'border-green-300 bg-green-50' : 'border-gray-200 bg-gray-50'">
              <div class="flex items-center gap-2 flex-shrink-0">
                <label class="flex items-center gap-1 cursor-pointer">
                  <input type="radio" :name="'import-grp-' + grp.id" value="1" class="w-3.5 h-3.5 text-emerald-600 focus:ring-emerald-500 border-gray-300" :checked="importGroupSelection[grp.id] !== false" @change="importGroupSelection[grp.id] = true">
                  <span class="text-xs font-bold text-emerald-700">Sí</span>
                </label>
                <label class="flex items-center gap-1 cursor-pointer">
                  <input type="radio" :name="'import-grp-' + grp.id" value="0" class="w-3.5 h-3.5 text-gray-400 focus:ring-gray-400 border-gray-300" :checked="importGroupSelection[grp.id] === false" @change="importGroupSelection[grp.id] = false">
                  <span class="text-xs font-bold text-gray-500">No</span>
                </label>
              </div>
              <div class="min-w-0">
                <div class="flex items-center gap-2">
                  <span class="text-xs font-bold px-1.5 py-0.5 rounded" :class="grp.isNew ? 'bg-green-600 text-white' : 'bg-gray-500 text-white'" x-text="grp.isNew ? '+ Nuevo' : '~ Cambios'"></span>
                  <span class="font-bold text-sm text-gray-900 truncate" x-text="`G${grp.id} · ${grp.proyecto}`"></span>
                  <span x-show="grp.comision" class="text-xs text-gray-600" x-text="grp.comision"></span>
                </div>
                <div class="flex items-center gap-1 mt-0.5" x-show="grp.projectedAvg !== null || grp.currentAvg !== null">
                  <span class="text-xs text-gray-500">Promedio:</span>
                  <span class="text-xs font-medium" x-text="grp.currentAvg || '—'"></span>
                  <template x-if="grp.currentPct">
                    <span class="text-[10px] text-gray-400" x-text="grp.currentPct"></span>
                  </template>
                  <template x-if="grp.currentAvg !== null && grp.projectedAvg !== null && grp.projectedAvg !== grp.currentAvg">
                    <span class="text-xs text-gray-400">→</span>
                  </template>
                  <template x-if="grp.currentAvg !== null && grp.projectedAvg !== null && grp.projectedAvg !== grp.currentAvg">
                    <span class="text-xs font-bold" :class="parseFloat(grp.projectedAvg) > parseFloat(grp.currentAvg) ? 'text-green-700' : 'text-red-600'" x-text="grp.projectedAvg"></span>
                  </template>
                  <template x-if="grp.currentAvg !== null && grp.projectedAvg !== null && parseFloat(grp.projectedAvg) > parseFloat(grp.currentAvg)">
                    <span class="text-xs text-green-600">↑</span>
                  </template>
                  <template x-if="grp.currentAvg !== null && grp.projectedAvg !== null && parseFloat(grp.projectedAvg) < parseFloat(grp.currentAvg)">
                    <span class="text-xs text-red-500">↓</span>
                  </template>
                  <template x-if="grp.currentAvg === null && grp.projectedAvg !== null">
                    <span class="text-xs font-bold text-green-700" x-text="grp.projectedAvg"></span>
                  </template>
                </div>
                <template x-for="ch in grp.grupoChanges">
                  <span class="text-xs text-amber-700 font-medium" x-text="`${ch.field}: ${ch.from} → ${ch.to}`"></span>
                </template>
              </div>
            </div>

            <div class="px-3 py-2 space-y-2">
              <!-- New group integrantes -->
              <template x-if="grp.isNew && grp.integrantesAdded.length > 0">
                <div>
                  <div class="text-xs font-bold text-gray-600 mb-1">Integrantes</div>
                  <div class="flex flex-wrap gap-1">
                    <template x-for="i in grp.integrantesAdded" :key="'ia-' + grp.id + i.nombre">
                      <span class="inline-flex items-center text-xs px-2 py-0.5 rounded-full bg-green-100 text-green-800 border border-green-200">
                        <span class="font-medium" x-text="i.nombre"></span>
                        <span x-show="i.rol" class="text-green-600 ml-1" x-text="`(${i.rol})`"></span>
                      </span>
                    </template>
                  </div>
                </div>
              </template>

              <!-- Integrantes added to existing group -->
              <template x-if="!grp.isNew && grp.integrantesAdded.length > 0">
                <div>
                  <div class="text-xs font-bold text-green-700 mb-1">+ Integrantes nuevos</div>
                  <div class="flex flex-wrap gap-1">
                    <template x-for="i in grp.integrantesAdded" :key="'ia2-' + grp.id + i.nombre">
                      <span class="inline-flex items-center text-xs px-2 py-0.5 rounded-full bg-green-100 text-green-800 border border-green-200">
                        <span class="font-medium" x-text="i.nombre"></span>
                        <span x-show="i.rol" class="text-green-600 ml-1" x-text="`(${i.rol})`"></span>
                      </span>
                    </template>
                  </div>
                </div>
              </template>

              <!-- Integrantes modified -->
              <template x-if="grp.integrantesModified.length > 0">
                <div>
                  <div class="text-xs font-bold text-amber-700 mb-1">~ Integrantes modificados</div>
                  <div class="space-y-1">
                    <template x-for="i in grp.integrantesModified" :key="'im-' + grp.id + i.nombre">
                      <div class="text-xs flex flex-wrap items-center gap-1">
                        <span class="font-bold text-gray-900" x-text="i.nombre"></span>
                        <template x-for="ch in i.changes" :key="ch.field">
                          <span class="text-amber-700" x-text="ch.field + ': &quot;' + ch.from + '&quot; → &quot;' + ch.to + '&quot;'"></span>
                        </template>
                      </div>
                    </template>
                  </div>
                </div>
              </template>

              <!-- Encuentros -->
              <template x-for="enc in grp.encuentrosOrdered" :key="'enc-' + grp.id + enc.id">
                <div class="rounded-md border border-gray-200 bg-gray-50/50 overflow-hidden">
                  <div class="px-2 py-1.5 bg-indigo-50 border-b border-indigo-100">
                    <span class="text-xs font-bold text-indigo-700" x-text="enc.id"></span>
                  </div>
                  <div class="px-2 py-1.5 space-y-1">
                    <!-- Notas nuevas -->
                    <template x-if="enc.notasAdded.length > 0">
                      <div class="flex flex-wrap gap-x-3 gap-y-0.5">
                        <template x-for="n in enc.notasAdded" :key="'na-' + n.dimension">
                          <span class="text-xs">
                            <span class="font-bold text-gray-700" x-text="n.dimension"></span>
                            <span class="text-green-700 font-bold" x-text="`+${n.puntaje}`"></span>
                          </span>
                        </template>
                      </div>
                    </template>
                    <!-- Notas modificadas -->
                    <template x-if="enc.notasModified.length > 0">
                      <div class="flex flex-wrap gap-x-3 gap-y-0.5">
                        <template x-for="n in enc.notasModified" :key="'nm-' + n.dimension">
                          <span class="text-xs">
                            <span class="font-bold text-gray-700" x-text="n.dimension"></span>
                            <span class="text-red-600 line-through" x-text="n.from"></span>
                            <span class="text-gray-400 mx-0.5">→</span>
                            <span class="text-green-700 font-bold" x-text="n.to"></span>
                          </span>
                        </template>
                      </div>
                    </template>
                    <!-- Feedback nuevo -->
                    <template x-if="enc.fbAdded.length > 0">
                      <div class="space-y-0.5">
                        <template x-for="f in enc.fbAdded" :key="'fba-' + f.dimension">
                          <div class="text-xs text-gray-600">
                            <span class="font-medium" x-text="f.dimension + ' retro:'"></span>
                            <span class="text-green-700" x-text="f.feedback ? '&quot;' + f.feedback + '&quot;' : ' (vacío)'"></span>
                          </div>
                        </template>
                      </div>
                    </template>
                    <!-- Feedback modificado -->
                    <template x-if="enc.fbModified.length > 0">
                      <div class="space-y-0.5">
                        <template x-for="f in enc.fbModified" :key="'fbm-' + f.dimension">
                          <div class="text-xs text-gray-600">
                            <span class="font-medium" x-text="f.dimension + ' retro:'"></span>
                            <span class="text-red-600 line-through" x-text="f.from ? '&quot;' + f.from + '&quot;' : '(vacío)'"></span>
                            <span class="text-gray-400 mx-0.5">→</span>
                            <span class="text-green-700" x-text="f.to ? '&quot;' + f.to + '&quot;' : '(vacío)'"></span>
                          </div>
                        </template>
                      </div>
                    </template>
                    <!-- Asistencias nuevas -->
                    <template x-if="enc.asistAdded.length > 0">
                      <div>
                        <div class="text-xs font-bold text-green-700 mt-1">Asistencia</div>
                        <div class="flex flex-wrap gap-1">
                          <template x-for="a in enc.asistAdded" :key="'aa-' + a.integrante_nombre">
                            <span class="inline-flex items-center text-xs px-1.5 py-0.5 rounded bg-green-50 text-green-800 border border-green-200">
                              <span x-text="a.integrante_nombre"></span>
                              <span class="font-bold ml-1" x-text="a.estado"></span>
                            </span>
                          </template>
                        </div>
                      </div>
                    </template>
                    <!-- Asistencias modificadas -->
                    <template x-if="enc.asistModified.length > 0">
                      <div>
                        <div class="text-xs font-bold text-amber-700 mt-1">Asistencia</div>
                        <div class="flex flex-wrap gap-1">
                          <template x-for="a in enc.asistModified" :key="'am-' + a.integrante_nombre">
                            <span class="inline-flex items-center text-xs px-1.5 py-0.5 rounded bg-amber-50 text-amber-800 border border-amber-200">
                              <span x-text="a.integrante_nombre"></span>
                              <span class="text-red-600 line-through ml-1" x-text="a.from"></span>
                              <span class="text-gray-400 mx-0.5">→</span>
                              <span class="font-bold" x-text="a.estado"></span>
                            </span>
                          </template>
                        </div>
                      </div>
                    </template>
                  </div>
                </div>
              </template>
            </div>
          </div>
        </template>

        <!-- No changes -->
        <div x-show="importDiff && importTotalChanges === 0" class="text-center py-8">
          <p class="text-sm text-gray-500 font-medium">No hay cambios para aplicar.</p>
        </div>
      </div>

      <!-- Results -->
      <div x-show="importResult" class="mt-3 p-3 bg-green-50 rounded-lg border border-green-200 text-xs">
        <h3 class="font-bold text-green-800 mb-1">Importación exitosa</h3>
        <p x-text="'Grupos: ' + (importResult?.grupos || 0) + ' | Integrantes: ' + (importResult?.integrantes || 0) + ' | Evaluaciones: ' + (importResult?.evaluaciones || 0) + ' | Asistencias: ' + (importResult?.asistencias || 0)"></p>
        <template x-if="importResult?.errors?.length > 0">
          <div class="mt-2">
            <p class="font-bold text-red-700">Errores:</p>
            <template x-for="err in importResult?.errors" :key="err">
              <p class="text-red-600" x-text="err"></p>
            </template>
          </div>
        </template>
      </div>

      <div class="flex gap-2 mt-3 flex-shrink-0">
        <button 
          x-show="!importResult && !importDryRun"
          @click="applyImport()"
          :disabled="importLoading || importTotalChanges === 0"
          class="flex-1 py-2.5 bg-emerald-700 text-white text-sm font-bold rounded-lg hover:bg-emerald-800 transition disabled:opacity-50 disabled:cursor-not-allowed"
        >
          Confirmar importación
        </button>
        <button 
          x-show="!importResult && importDryRun"
          :disabled="true"
          class="flex-1 py-2.5 bg-gray-300 text-gray-500 text-sm font-bold rounded-lg cursor-not-allowed"
        >
          Confirmar importación (desactivar modo práctica primero)
        </button>
        <button 
          @click="showImportModal = false; importDiff = null; importResult = null;"
          class="flex-1 py-2.5 border border-gray-300 text-gray-700 text-sm font-bold rounded-lg hover:bg-gray-50 transition"
        >
          Cerrar
        </button>
      </div>
    </div>
  </div>

  <!-- Login Modal -->
  <div 
    x-show="showLogin" 
    x-transition
    class="fixed inset-0 bg-black/60 flex items-end sm:items-center justify-center z-50 sm:p-4"
    @click.self="showLogin = false"
  >
    <div class="bg-white rounded-t-2xl sm:rounded-xl p-6 w-full max-w-sm border border-gray-300 shadow-lg max-h-[90vh] overflow-y-auto">
      <!-- Login view -->
<template x-if="!showForgotPassword">
        <div>
          <h2 class="text-lg font-bold text-gray-900 mb-1">Acceso para equipo docente</h2>
          <p class="text-xs text-gray-500 mb-3">Seleccioná tu usuario e ingresá tu contraseña.</p>

          <!-- Lista de profesores -->
          <div x-init="fetchProfesores()" x-show="profesores.length > 0" class="mb-4 grid grid-cols-1 gap-2">
            <template x-for="prof in profesores" :key="prof.email">
              <button 
                type="button"
                @click="loginEmail = prof.email; loginPassword = ''"
                class="w-full py-2 px-3 text-left text-sm rounded-lg border transition flex items-center justify-between"
                :class="loginEmail === prof.email 
                  ? 'bg-indigo-700 border-indigo-700 text-white shadow-md' 
                  : 'bg-white border-gray-200 text-gray-700 hover:border-indigo-400 hover:bg-indigo-50'"
              >
                <span class="font-bold" x-text="prof.nombre"></span>
                <span class="text-xs" :class="loginEmail === prof.email ? 'text-indigo-200' : 'text-gray-400'" x-text="prof.email"></span>
              </button>
            </template>
          </div>
          <div x-show="profesores.length === 0 && loadingAuth" class="mb-4 text-center text-xs text-gray-400 py-2">
            Cargando usuarios...
          </div>

          <form @submit.prevent="login()">
            <div class="mb-3">
              <label class="block text-xs font-bold text-gray-700 mb-1">Usuario o Email</label>
              <input 
                x-model="loginEmail"
                type="text"
                class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-600 bg-white"
                required
              >
            </div>
            <div class="mb-4">
              <label class="block text-xs font-bold text-gray-700 mb-1">Contraseña</label>
              <input 
                x-model="loginPassword"
                type="password"
                class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-600 bg-white"
                required
              >
            </div>
            <p x-show="loginError" class="text-xs text-red-600 mb-3 font-bold" x-text="loginError"></p>
            <div class="flex gap-2">
              <button 
                type="button"
                @click="showLogin = false"
                class="flex-1 py-2 border border-gray-300 text-gray-700 text-sm font-bold rounded-lg hover:bg-gray-50"
              >
                Cerrar
              </button>
              <button 
                type="submit"
                class="flex-1 py-2 bg-indigo-700 text-white text-sm font-bold rounded-lg hover:bg-indigo-800"
                :disabled="loadingAuth"
              >
                <span x-text="loadingAuth ? '...' : 'Ingresar'"></span>
              </button>
            </div>
          </form>

          <button 
            type="button"
            @click="showForgotPassword = true; loginError = ''"
            class="block w-full text-center text-xs text-indigo-700 hover:text-indigo-900 mt-3 font-medium"
          >
            ¿Olvidaste tu contraseña?
          </button>
        </div>
      </template>
      <!-- Forgot password view -->
      <template x-if="showForgotPassword">
        <div>
          <h2 class="text-lg font-bold text-gray-900 mb-1">Recuperar contraseña</h2>
          <p class="text-xs text-gray-500 mb-4" x-show="!forgotPasswordSent">Ingresá tu email y te enviaremos un enlace para restablecer tu contraseña.</p>
          <div x-show="forgotPasswordSent" class="text-center py-2">
            <svg class="w-10 h-10 mx-auto text-green-500 mb-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <p class="text-sm text-gray-700 font-bold mb-1">Enlace enviado</p>
            <p class="text-xs text-gray-500">Revisá tu casilla de email (y la carpeta de spam) para restablecer tu contraseña.</p>
          </div>
          <form x-show="!forgotPasswordSent" @submit.prevent="sendPasswordReset()">
            <div class="mb-3">
              <label class="block text-xs font-bold text-gray-700 mb-1">Email</label>
              <input 
                x-model="forgotPasswordEmail"
                type="email"
                class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-600 bg-white"
                required
              >
            </div>
            <p x-show="forgotPasswordError" class="text-xs text-red-600 mb-3 font-bold" x-text="forgotPasswordError"></p>
            <div class="flex gap-2">
              <button 
                type="button"
                @click="showForgotPassword = false; forgotPasswordError = ''; forgotPasswordSent = false"
                class="flex-1 py-2 border border-gray-300 text-gray-700 text-sm font-bold rounded-lg hover:bg-gray-50"
              >
                Volver
              </button>
              <button 
                type="submit"
                class="flex-1 py-2 bg-indigo-700 text-white text-sm font-bold rounded-lg hover:bg-indigo-800"
                :disabled="loadingAuth"
              >
                <span x-text="loadingAuth ? '...' : 'Enviar enlace'"></span>
              </button>
            </div>
          </form>
          <button 
            x-show="forgotPasswordSent"
            type="button"
            @click="showForgotPassword = false; forgotPasswordSent = false; showLogin = false"
            class="block w-full text-center text-xs text-indigo-700 hover:text-indigo-900 mt-3 font-medium"
          >
            Volver al inicio de sesión
          </button>
        </div>
      </template>
    </div>
  </div>

  <!-- Add/Edit Grupo Modal -->
  <div 
    x-show="showAddGrupo" 
    x-transition
    class="fixed inset-0 bg-black/60 flex items-end sm:items-center justify-center z-50 sm:p-4"
    @click.self="showAddGrupo = false"
  >
    <div class="bg-white rounded-t-2xl sm:rounded-xl p-6 w-full max-w-md border border-gray-300 shadow-lg max-h-[90vh] overflow-y-auto">
      <h2 class="text-lg font-bold text-gray-900 mb-4" x-text="editingGrupoId ? 'Editar Grupo' : 'Agregar Grupo'"></h2>
      <form @submit.prevent="guardarGrupoModal()">
        <div class="mb-3">
          <label class="block text-xs font-bold text-gray-700 mb-1">Proyecto</label>
          <input 
            x-model="newGrupo.proyecto"
            class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-600"
            required
          >
        </div>
        <div class="mb-3" x-show="carrerasActivas.length > 1">
          <label class="block text-xs font-bold text-gray-700 mb-1">Carrera</label>
          <select
            x-model="newGrupo.carrera_id"
            @change="onNewGrupoCarreraChange()"
            class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-600 bg-white"
          >
            <template x-for="c in carrerasActivas" :key="c.id">
              <option :value="c.id" x-text="c.nombre"></option>
            </template>
          </select>
        </div>
        <div class="mb-3">
          <label class="block text-xs font-bold text-gray-700 mb-1">Comisión</label>
          <div class="flex gap-2">
            <select
              x-model="newGrupo.comision"
              class="flex-1 px-3 py-2 border border-gray-300 rounded-lg text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-600 bg-white"
            >
              <option value="">Seleccionar comisión...</option>
              <template x-for="c in comisiones" :key="c.id">
                <option :value="c.id" x-text="c.nombre"></option>
              </template>
            </select>
            <button
              type="button"
              x-show="canEdit"
              @click="showAddComision = true"
              class="px-3 py-2 bg-gray-100 text-gray-700 rounded-lg text-sm font-bold hover:bg-gray-200"
              title="Agregar comisión"
            >+</button>
          </div>
        </div>
        <div class="mb-3">
          <label class="block text-xs font-bold text-gray-700 mb-1">Práctica</label>
          <select
            x-model="newGrupo.practica"
            class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-600 bg-white"
          >
            <template x-for="p in practicasDeCarrera(newGrupo.carrera_id)" :key="p.id">
              <option :value="p.codigo" x-text="p.nombre"></option>
            </template>
          </select>
        </div>
        
        <div class="mb-3">
          <div class="flex items-center justify-between mb-2">
            <label class="text-xs font-bold text-gray-700">Integrantes</label>
            <button 
              type="button"
              @click="newGrupo.integrantes.push({nombre:'',rol:'',observacion:'', tagEstado:'cursando', dbId:null})"
              class="px-2 py-1 text-xs bg-indigo-100 text-indigo-700 rounded font-bold hover:bg-indigo-200"
            >
              + Agregar
            </button>
          </div>
          <div class="space-y-2">
            <template x-for="(int, idx) in newGrupo.integrantes" :key="idx">
              <div class="flex gap-2 items-start p-2 bg-gray-50 rounded-lg border border-gray-200">
                <div class="flex-1 space-y-1">
                  <input 
                    x-model="int.nombre"
                    placeholder="Nombre"
                    class="w-full px-2 py-1 text-xs border border-gray-300 rounded text-gray-900 focus:outline-none focus:ring-1 focus:ring-indigo-600"
                    required
                  >
                  <select 
                    x-model="int.rol"
                    class="w-full px-2 py-1 text-xs border border-gray-300 rounded text-gray-900 focus:outline-none focus:ring-1 focus:ring-indigo-600 bg-white"
                  >
                    <option value="">Seleccionar rol...</option>
                    <option value="Funcional">Funcional</option>
                    <option value="Desarrollador">Desarrollador</option>
                    <option value="Scrum">Scrum</option>
                    <option value="Funcional/Desarrollador">Funcional/Desarrollador</option>
                    <option value="Funcional/Scrum">Funcional/Scrum</option>
                    <option value="Desarrollador/Scrum">Desarrollador/Scrum</option>
                    <option value="Funcional/Desarrollador/Scrum">Funcional/Desarrollador/Scrum</option>
                  </select>
                  <input 
                    x-model="int.observacion"
                    placeholder="Observación (opcional)"
                    class="w-full px-2 py-1 text-xs border border-gray-300 rounded text-gray-900 focus:outline-none focus:ring-1 focus:ring-indigo-600"
                  >
                  <select 
                    x-model="int.tagEstado"
                    class="w-full px-2 py-1 text-xs border border-gray-300 rounded text-gray-900 focus:outline-none focus:ring-1 focus:ring-indigo-600 bg-white"
                    :title="`Estado en ${newGrupo.practica} (tag)`"
                  >
                    <option value="cursando">Estado: Cursando</option>
                    <option value="regular">Estado: Regularizado</option>
                    <option value="rendida">Estado: Rendido</option>
                  </select>
                </div>
                <button 
                  type="button"
                  @click="newGrupo.integrantes.splice(idx, 1)"
                  class="w-6 h-6 flex items-center justify-center text-red-600 hover:bg-red-50 rounded"
                  title="Eliminar integrante"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
              </div>
            </template>
          </div>
        </div>
        
        <p x-show="addGrupoError" class="text-xs text-red-600 mb-3 font-bold" x-text="addGrupoError"></p>
        <div class="flex gap-2">
          <button 
            type="button"
            @click="showAddGrupo = false"
            class="flex-1 py-2 border border-gray-300 text-gray-700 text-sm font-bold rounded-lg hover:bg-gray-50"
          >
            Cancelar
          </button>
          <button 
            type="submit"
            class="flex-1 py-2 bg-indigo-700 text-white text-sm font-bold rounded-lg hover:bg-indigo-800"
            :disabled="loadingAddGrupo"
          >
            <span x-text="loadingAddGrupo ? '...' : (editingGrupoId ? 'Guardar Cambios' : 'Crear Grupo')"
          ></button>
        </div>
      </form>
    </div>
  </div>

  <!-- Confirm Delete Modal -->
  <div 
    x-show="showConfirmDelete" 
    x-transition
    class="fixed inset-0 bg-black/60 flex items-end sm:items-center justify-center z-50 sm:p-4"
    @click.self="showConfirmDelete = false"
  >
    <div class="bg-white rounded-t-2xl sm:rounded-xl p-6 w-full max-w-sm border border-gray-300 shadow-lg max-h-[90vh] overflow-y-auto">
      <h2 class="text-lg font-bold text-red-600 mb-2">Desactivar Grupo</h2>
      <p class="text-sm text-gray-700 mb-4">
        ¿Estás seguro de que deseas desactivar <strong x-text="grupoToDelete?.proyecto"></strong>? El grupo quedará oculto pero sus datos se conservan.
      </p>
      <div class="flex gap-2">
        <button 
          @click="showConfirmDelete = false"
          class="flex-1 py-2 border border-gray-300 text-gray-700 text-sm font-bold rounded-lg hover:bg-gray-50"
        >
          Cancelar
        </button>
        <button 
          @click="eliminarGrupoConfirmado()"
          class="flex-1 py-2 bg-red-600 text-white text-sm font-bold rounded-lg hover:bg-red-700"
          :disabled="loadingDelete"
        >
          <span x-text="loadingDelete ? '...' : 'Desactivar'"></span>
        </button>
      </div>
    </div>
  </div>

  <!-- Modal Traslado a Tutorías -->
  <div
    x-show="showTraslado"
    x-transition
    class="fixed inset-0 bg-black/60 flex items-end sm:items-center justify-center z-50 sm:p-4"
    @click.self="showTraslado = false"
  >
    <div class="bg-white rounded-t-2xl sm:rounded-xl p-6 w-full max-w-sm border border-gray-300 shadow-lg max-h-[90vh] overflow-y-auto">
      <h2 class="text-lg font-bold text-purple-700 mb-2" x-text="esTrasladado(trasladoGrupo) ? 'Devolver a PP3' : 'Trasladar a Tutorías'"></h2>
      <p class="text-sm text-gray-700 mb-4" x-show="!esTrasladado(trasladoGrupo)">
        <strong x-text="trasladoGrupo?.proyecto"></strong> pasa de PP3 a Tutorías para trabajo intensivo. Podés devolverlo a PP3 en cualquier momento desde el mismo botón.
      </p>
      <p class="text-sm text-gray-700 mb-4" x-show="esTrasladado(trasladoGrupo)">
        <strong x-text="trasladoGrupo?.proyecto"></strong> vuelve a PP3, la práctica desde la que fue trasladado.
      </p>
      <p x-show="trasladoError" class="text-xs text-red-600 mb-3 font-bold" x-text="trasladoError"></p>
      <div class="flex gap-2">
        <button
          @click="showTraslado = false"
          class="flex-1 py-2 border border-gray-300 text-gray-700 text-sm font-bold rounded-lg hover:bg-gray-50"
        >
          Cancelar
        </button>
        <button
          @click="confirmarTraslado()"
          class="flex-1 py-2 bg-purple-700 text-white text-sm font-bold rounded-lg hover:bg-purple-800"
          :disabled="trasladoSaving"
        >
          <span x-text="trasladoSaving ? '...' : (esTrasladado(trasladoGrupo) ? 'Devolver a PP3' : 'Confirmar traslado')"></span>
        </button>
      </div>
    </div>
  </div>

  <!-- Add Comision Modal -->
  <div 
    x-show="showAddComision" 
    x-transition
    class="fixed inset-0 bg-black/60 flex items-end sm:items-center justify-center z-50 sm:p-4"
    @click.self="showAddComision = false"
  >
    <div class="bg-white rounded-t-2xl sm:rounded-xl p-6 w-full max-w-sm border border-gray-300 shadow-lg max-h-[90vh] overflow-y-auto">
      <h2 class="text-lg font-bold text-gray-900 mb-4">Agregar Comisión</h2>
      <form @submit.prevent="guardarComision()">
        <div class="mb-3">
          <label class="block text-xs font-bold text-gray-700 mb-1">Código</label>
          <input 
            x-model="newComision.id"
            placeholder="Ej: 51NMS"
            class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-600"
            required
          >
        </div>
        <div class="mb-4">
          <label class="block text-xs font-bold text-gray-700 mb-1">Nombre</label>
          <input 
            x-model="newComision.nombre"
            placeholder="Ej: 51NMS"
            class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-600"
            required
          >
        </div>
        <p x-show="addComisionError" class="text-xs text-red-600 mb-3 font-bold" x-text="addComisionError"></p>
        <div class="flex gap-2">
          <button 
            type="button"
            @click="showAddComision = false"
            class="flex-1 py-2 border border-gray-300 text-gray-700 text-sm font-bold rounded-lg hover:bg-gray-50"
          >
            Cancelar
          </button>
          <button 
            type="submit"
            class="flex-1 py-2 bg-indigo-700 text-white text-sm font-bold rounded-lg hover:bg-indigo-800"
          >
            Crear
          </button>
        </div>
      </form>
    </div>
  </div>

  <style>
    [x-cloak] { display: none !important; }
  </style>
</div>

<script>
  import Alpine from 'alpinejs';
  import Plotly from 'plotly.js-dist-min';
  import { supabase, resolveLoginUser, markSessionStart, clearSessionStart, scheduleSessionEnd, enforceSessionExpiry } from '../../lib/supabase';
  import { ENCUENTROS_META, ENCUENTROS_CARGADOS, GRUPOS_INICIALES } from './encuentros-data.js';
  import { parseExcelFile, buildDiff, applyDiffToSupabase } from './excel-import.js';

  window.Alpine = Alpine;

  Alpine.data('seguimientoApp', () => ({
    // --- STATE ---
    view: 'resumen',
    filtro: '',
    filtroIntegrante: '',
    sortCol: 'id',
    sortDir: 'asc',
    page: 1,
    perPage: 25,
    alertasTipos: [],
    selectedGrupo: null,
    selectedEnc: null,
    activeE: 'E1',
    showLogin: false,
    showAddGrupo: false,
    showConfirmDelete: false,
    showAddComision: false,
    showImportModal: false,
    importLoading: false,
    importLoadingMsg: '',
    importDiff: null,
    importResult: null,
    importDryRun: true,
    importGroupSelection: {},
    loginEmail: 'cervantes',
    loginPassword: 'cervantes123',
    loginError: '',
    showForgotPassword: false,
    forgotPasswordEmail: '',
    forgotPasswordSent: false,
    forgotPasswordError: '',
    addGrupoError: '',
    addComisionError: '',
    loading: false,
    loadingAuth: false,
    profesores: [],
    loadingData: true,
    loadingAddGrupo: false,
    loadingDelete: false,
    user: null,
    userRole: null,
    saved: false,
    saveTimeout: null,
    practicaFilter: 'Todas',
    carreraFilter: 'analista-sistemas',
    mostrarInactivos: false,
    editingGrupoId: null,
    mobileMenuOpen: false,

    // Traslado a Tutorías (transferencia puntual y reversible P3 <-> TutoriasPost)
    showTraslado: false,
    trasladoGrupo: null,
    trasladoSaving: false,
    trasladoError: '',

    // Promoción / Transferencia
    showPromover: false,
    promocionCarrera: 'analista-sistemas',
    promocionPP: 'P1',
    promocionFiltroPromovibles: false,
    promoSel: {},
    promoRindieron: {},
    promoSaving: false,
    promoResultado: '',
    promoResultadoError: false,
    alumnosSeguimiento: [],

    // Stats filters
    statsComisionFilter: '',
    statsPracticaFilter: '',
    statsEncuentroFilter: '',
    statsResumen: { evaluados: 0, promocionados: 0, regulares: 0, libres: 0 },

    planilla: {},
    planillaEditorCarrera: 'analista-sistemas',
    planillaEditorPP: 'P1',
    showPlanillaEditor: false,
    planillaSaving: false,
    planillaError: '',
    grupos: [],
    comisiones: [],
    carreras: [],
    practicasCatalogo: [],
    data: {},
    localData: {},
    localAsist: {},
    evalMeta: {},
    grupoToDelete: null,

    newGrupo: {
      proyecto: '',
      comision: '',
      practica: 'P2',
      carrera_id: 'analista-sistemas',
      integrantes: [{nombre:'',rol:'',observacion:'', tagEstado:'cursando', dbId:null}]
    },

    newComision: {
      id: '',
      nombre: ''
    },

    // --- HELPERS (dentro del componente para scope correcto en Alpine) ---
    calcPct(scores) {
      if (!scores) return null;
      const vals = [scores.FN, scores.DEV, scores.SM].filter(v => v !== undefined && v !== null && v !== "");
      if (!vals.length) return null;
      return vals.reduce((a, b) => a + Number(b), 0) / (vals.length * 10);
    },

    calcNota(pct) {
      if (pct === null || pct === undefined) return "—";
      const nota = pct < 0.6 ? 1 + pct * 5 : pct * 15 - 5;
      return nota.toFixed(1);
    },

    calcPctStr(pct) {
      if (pct === null || pct === undefined) return "—";
      return Math.round(pct * 100) + "%";
    },

    notaColor(nota) {
      if (nota === "—") return "text-gray-400";
      const n = parseFloat(nota);
      if (n >= 7) return "text-green-700";
      if (n >= 4) return "text-amber-700";
      return "text-red-700";
    },

    notaBadgeClass(nota) {
      if (nota === "—") return "bg-gray-100 text-gray-400";
      const n = parseFloat(nota);
      if (n >= 7) return "bg-green-100 text-green-700";
      if (n >= 4) return "bg-amber-100 text-amber-700";
      return "bg-red-100 text-red-700";
    },

    pctColor(pct) {
      if (pct >= 0.8) return "bg-green-600";
      if (pct >= 0.6) return "bg-amber-500";
      return "bg-red-600";
    },

    asistBtnClass(val) {
      const map = {
        "Presente (Presencial)": "border-green-600 text-green-700 bg-green-100",
        "Presente (Virtual)": "border-sky-600 text-sky-700 bg-sky-100",
        Ausente: "border-red-600 text-red-700 bg-red-100",
        Justificado: "border-amber-600 text-amber-700 bg-amber-100"
      };
      return map[val] || "";
    },

    asistTextClass(val) {
      const map = {
        "Presente (Presencial)": "text-green-700 font-bold",
        "Presente (Virtual)": "text-sky-700 font-bold",
        Ausente: "text-red-700 font-bold",
        Justificado: "text-amber-700 font-bold"
      };
      return map[val] || "text-gray-500";
    },

    tieneAlerta(grupoId, alertaId) {
      const g = this.grupos.find(g => g.id === grupoId);
      return g && g.alertas && g.alertas.includes(alertaId);
    },

    alertaIcon(alertaId) {
      const map = { riesgo: '⚠️', comunicarse: '📞' };
      return map[alertaId] || '🔔';
    },

    alertaColor(alertaId) {
      const map = { riesgo: 'bg-amber-100 text-amber-700 border-amber-300', comunicarse: 'bg-blue-100 text-blue-700 border-blue-300' };
      return map[alertaId] || 'bg-gray-100 text-gray-700 border-gray-300';
    },

    alertaNombre(alertaId) {
      const t = this.alertasTipos.find(a => a.id === alertaId);
      return t ? t.nombre : alertaId;
    },

    grupoAlertas(grupoId) {
      const g = this.grupos.find(g => g.id === grupoId);
      return g && g.alertas ? g.alertas : [];
    },

    async toggleAlerta(grupoId, alertaId) {
      if (!this.canEdit) return;
      const g = this.grupos.find(g => g.id === grupoId);
      if (!g) return;
      const alertas = g.alertas ? [...g.alertas] : [];
      const idx = alertas.indexOf(alertaId);
      if (idx >= 0) {
        alertas.splice(idx, 1);
      } else {
        alertas.push(alertaId);
      }
      try {
        const { error } = await supabase.from('grupos').update({ alertas }).eq('id', grupoId);
        if (error) throw error;
        g.alertas = alertas;
      } catch (e) {
        console.error('Error toggling alerta:', e);
      }
    },

    dimColor(dim) {
      const map = { FN: "text-indigo-700", DEV: "text-sky-700", SM: "text-amber-700" };
      return map[dim] || "";
    },

    dimBarColor(dim) {
      const map = { FN: "bg-indigo-600", DEV: "bg-sky-600", SM: "bg-amber-500" };
      return map[dim] || "";
    },

    // --- LIFECYCLE ---
    async init() {
      this.loadFallbackData();
      await this.loadFromSupabase();
      await this.checkSession();
      if (!this.canEdit) {
        this.view = 'resumen';
      }
      this.loadingData = false;
    },

    loadFallbackData() {
      this.grupos = [];
      const d = {};
      ENCUENTROS_META.forEach(e => { d[e.id] = {}; });
      Object.entries(ENCUENTROS_CARGADOS).forEach(([enc, gs]) => {
        Object.entries(gs).forEach(([gid, sc]) => {
          if (!d[enc]) d[enc] = {};
          d[enc][Number(gid)] = sc;
        });
      });
      this.data = d;
    },

    async loadFromSupabase() {
      try {
        // Comisiones
        const { data: comData, error: comErr } = await supabase
          .from('comisiones')
          .select('*')
          .eq('activa', true)
          .order('nombre');
        if (comErr) throw comErr;
        if (comData && comData.length > 0) this.comisiones = comData;

        // Carreras
        const { data: carrerasData, error: carrErr } = await supabase
          .from('carreras')
          .select('*')
          .eq('activa', true)
          .order('nombre');
        if (carrErr) throw carrErr;
        this.carreras = carrerasData || [];
        if (this.carreras.length && !this.carreras.find(c => c.id === this.carreraFilter)) {
          this.carreraFilter = this.carreras[0].id;
        }

        // Catálogo de prácticas por carrera
        const { data: practicasData, error: pracErr } = await supabase
          .from('practicas')
          .select('*')
          .eq('activa', true)
          .order('orden');
        if (pracErr) throw pracErr;
        this.practicasCatalogo = practicasData || [];

        // Grupos
        const { data: gruposData, error: gErr } = await supabase
          .from('grupos')
          .select('*')
          .order('id');
        if (gErr) throw gErr;

        // Integrantes
        const { data: intData, error: intErr } = await supabase
          .from('integrantes')
          .select('id, grupo_id, nombre, rol, observacion, tags');
        if (intErr) throw intErr;

        const integrantesByGrupo = {};
        (intData || []).forEach(i => {
          const gid = String(i.grupo_id);
          if (!integrantesByGrupo[gid]) integrantesByGrupo[gid] = [];
          integrantesByGrupo[gid].push({
            id: i.id,
            nombre: i.nombre,
            rol: i.rol || '',
            obs: i.observacion || '',
            tags: i.tags || []
          });
        });

        let loadedGrupos = [];
        if (gruposData && gruposData.length > 0) {
          loadedGrupos = gruposData.map(g => ({
            ...g,
            integrantes: (integrantesByGrupo[String(g.id)] || []).map(i => ({ ...i }))
          }));
        } else {
          loadedGrupos = GRUPOS_INICIALES;
        }
        this.grupos = loadedGrupos;

        // Evaluaciones
        const { data: evalData, error: evErr } = await supabase
          .from('evaluaciones')
          .select('*');
        if (evErr) throw evErr;

        const practicaMap = {};
        (this.grupos || []).forEach(g => { practicaMap[g.id] = g.practica; });

        (evalData || []).forEach(ev => {
          const encId = ev.encuentro_meta_id;
          const gid = ev.grupo_id;
          const gp = practicaMap[gid];
          if (ev.practica && gp && ev.practica !== gp) return;
          if (!this.data[encId]) this.data[encId] = {};
          if (!this.data[encId][gid]) this.data[encId][gid] = {};
          const entry = this.data[encId][gid];
          entry.FN = ev.fn ?? entry.FN;
          entry.DEV = ev.dev ?? entry.DEV;
          entry.SM = ev.sm ?? entry.SM;
          if (!entry.fb) entry.fb = {};
          entry.fb.FN = ev.feedback_fn || entry.fb.FN || '';
          entry.fb.DEV = ev.feedback_dev || entry.fb.DEV || '';
          entry.fb.SM = ev.feedback_sm || entry.fb.SM || '';
          const key = `${encId}_${gid}`;
          this.evalMeta[key] = {
            id: ev.id,
            fecha_primera_nota: ev.fecha_primera_nota || null,
            fecha_modificacion: ev.fecha_modificacion || null,
            es_modificacion: ev.es_modificacion || false,
            override_limite: ev.override_limite || false
          };
        });

        // Asistencias
        const { data: asistData, error: asErr } = await supabase
          .from('asistencias')
          .select('*');
        if (asErr) throw asErr;

        (asistData || []).forEach(a => {
          const evalId = a.evaluacion_id;
          const evRow = (evalData || []).find(e => e.id === evalId);
          if (!evRow) return;
          const encId = evRow.encuentro_meta_id;
          const gid = evRow.grupo_id;
          if (!this.data[encId]) this.data[encId] = {};
          if (!this.data[encId][gid]) this.data[encId][gid] = {};
          if (!this.data[encId][gid].asistencia) this.data[encId][gid].asistencia = {};
          this.data[encId][gid].asistencia[a.integrante_nombre] = a.estado;
        });

        // Alumnos seguimiento (para promoción/transferencia)
        const { data: alumData, error: alumErr } = await supabase
          .from('alumnos_seguimiento')
          .select('id, nombre_completo, pp1_estado, pp1_mes_regularizada, pp2_estado, pp2_mes_regularizada, pp3_estado, pp3_mes_regularizada');
        if (alumErr) throw alumErr;
        this.alumnosSeguimiento = alumData || [];

        // Planilla (criterios por carrera/práctica/encuentro)
        const { data: planData, error: planErr } = await supabase
          .from('planilla')
          .select('carrera_id, practica, encuentro, nombre, pregunta, criterio_fn, criterio_dev, criterio_sm');
        if (planErr) throw planErr;

        const planilla = {};
        (planData || []).forEach(p => {
          const key = this.planillaKey(p.carrera_id, p.practica);
          if (!planilla[key]) planilla[key] = [];
          planilla[key].push({
            id: p.encuentro,
            nombre: p.nombre || '',
            pregunta: p.pregunta || '',
            criterios: {
              FN: p.criterio_fn || '',
              DEV: p.criterio_dev || '',
              SM: p.criterio_sm || ''
            }
          });
        });
        Object.values(planilla).forEach(rows => {
          rows.sort((a, b) => (parseInt(String(a.id).replace(/^E/i, ''), 10) || 0) - (parseInt(String(b.id).replace(/^E/i, ''), 10) || 0));
        });
        if (Object.keys(planilla).length > 0) {
          this.planilla = planilla;
        }
      } catch (e) {
        console.warn('Error loading from Supabase:', e);
        this.grupos = GRUPOS_INICIALES;
      }
    },

    async checkSession() {
      try {
        if (await enforceSessionExpiry()) {
          this.user = null;
          this.userRole = null;
          return;
        }
        const { data: { session } } = await supabase.auth.getSession();
        if (session?.user) {
          this.user = session.user;
          await this.loadProfile();
          scheduleSessionEnd(() => this.logout(true));
        }
      } catch (e) {
        console.error('Error checking session:', e);
      }
    },

    async loadProfile() {
      try {
        const { data, error } = await supabase
          .from('profiles')
          .select('role')
          .eq('id', this.user.id)
          .single();
        if (error) throw error;
        if (data) this.userRole = data.role;
      } catch (e) {
        console.error('Error loading profile:', e);
      }
    },

    get canEdit() {
      return ['profesor_practica', 'director', 'admin'].includes(this.userRole);
    },

    get gruposFiltrados() {
      let list = this.grupos.filter(g => g.proyecto && (this.mostrarInactivos || g.activo !== false));
      if (this.carreraFilter && this.carreraFilter !== 'Todas') {
        list = list.filter(g => (g.carrera_id || 'analista-sistemas') === this.carreraFilter);
      }
      if (this.practicaFilter !== 'Todas') {
        list = list.filter(g => g.practica === this.practicaFilter);
      }
      const f = this.filtro.toLowerCase();
      if (f) {
        list = list.filter(g => 
          g.proyecto.toLowerCase().includes(f) ||
          (g.comision || '').toLowerCase().includes(f) ||
          String(g.id).includes(f)
        );
      }
      const fi = this.filtroIntegrante.toLowerCase();
      if (fi) {
        list = list.filter(g => 
          (g.integrantes || []).some(int => (int.nombre || '').toLowerCase().includes(fi))
        );
      }
      const col = this.sortCol;
      const dir = this.sortDir === 'asc' ? 1 : -1;
      list.sort((a, b) => {
        let va, vb;
        if (col === 'id') { va = a.id; vb = b.id; }
        else if (col === 'proyecto') { va = (a.proyecto || '').toLowerCase(); vb = (b.proyecto || '').toLowerCase(); }
        else if (col === 'comision') { va = (a.comision || '').toLowerCase(); vb = (b.comision || '').toLowerCase(); }
        else if (col === 'promedio') { va = this.promedioEncuentros(a.id) ?? -1; vb = this.promedioEncuentros(b.id) ?? -1; }
        else if (col.startsWith('E')) {
          const pa = this.calcPct(this.data[col]?.[a.id]);
          const pb = this.calcPct(this.data[col]?.[b.id]);
          va = pa ?? -1; vb = pb ?? -1;
        }
        else { va = a.id; vb = b.id; }
        if (va < vb) return -1 * dir;
        if (va > vb) return 1 * dir;
        return 0;
      });
      return list;
    },

    get gruposPaginados() {
      const start = (this.page - 1) * this.perPage;
      return this.gruposFiltrados.slice(start, start + this.perPage);
    },

    get totalPages() {
      return Math.max(1, Math.ceil(this.gruposFiltrados.length / this.perPage));
    },

    get paginationInfo() {
      const total = this.gruposFiltrados.length;
      const start = Math.min((this.page - 1) * this.perPage + 1, total);
      const end = Math.min(this.page * this.perPage, total);
      return { start, end, total };
    },

    get gruposConProyecto() {
      let list = this.grupos.filter(g => g.proyecto && (this.mostrarInactivos || g.activo !== false));
      if (this.carreraFilter && this.carreraFilter !== 'Todas') {
        list = list.filter(g => (g.carrera_id || 'analista-sistemas') === this.carreraFilter);
      }
      if (this.practicaFilter !== 'Todas') {
        list = list.filter(g => g.practica === this.practicaFilter);
      }
      return list;
    },

    get practicaActual() {
      if (this.view === 'grupo') {
        return this.grupoActual?.practica || 'P2';
      }
      return this.practicaFilter === 'Todas' ? 'P2' : this.practicaFilter;
    },

    get carreraActualParaVista() {
      if (this.view === 'grupo') {
        return this.grupoActual?.carrera_id || 'analista-sistemas';
      }
      return this.carreraFilter || 'analista-sistemas';
    },

    get carrerasActivas() {
      return (this.carreras || []).filter(c => c.activa !== false);
    },

    practicasDeCarrera(carreraId) {
      return (this.practicasCatalogo || [])
        .filter(p => p.carrera_id === carreraId && p.activa !== false)
        .sort((a, b) => a.orden - b.orden);
    },

    get practicasNav() {
      const list = this.practicasDeCarrera(this.carreraFilter);
      return [{ id: 'Todas', label: 'Todas' }, ...list.map(p => ({ id: p.codigo, label: p.nombre }))];
    },

    setCarreraFilter(id) {
      this.carreraFilter = id;
      this.practicaFilter = 'Todas';
      this.page = 1;
    },

    get encuentrosMeta() {
      return this.planillaPara(this.carreraActualParaVista, this.practicaActual);
    },

    planillaKey(carreraId, practica) {
      return `${carreraId || 'analista-sistemas'}::${practica}`;
    },

    planillaPara(carreraId, practica) {
      const key = this.planillaKey(carreraId, practica);
      if (this.planilla[key]) return this.planilla[key];
      return (carreraId || 'analista-sistemas') === 'analista-sistemas' ? ENCUENTROS_META : [];
    },

    get grupoActual() {
      return this.grupos.find(g => g.id === this.selectedGrupo);
    },

    get encuentroActual() {
      return this.encuentrosMeta.find(e => e.id === this.activeE) || this.encuentrosMeta[0];
    },

    get encuentroSeleccionado() {
      return this.encuentrosMeta.find(e => e.id === this.selectedEnc) || this.encuentrosMeta[0];
    },

    get ranking() {
      const stats = this.gruposConProyecto.map(g => {
        const prom = this.promedioEncuentros(g.id);
        return { ...g, prom };
      }).filter(g => g.prom !== null).sort((a, b) => b.prom - a.prom);
      return stats;
    },

    toggleSort(col) {
      if (this.sortCol === col) {
        this.sortDir = this.sortDir === 'asc' ? 'desc' : 'asc';
      } else {
        this.sortCol = col;
        this.sortDir = 'asc';
      }
      this.page = 1;
    },

    sortIcon(col) {
      if (this.sortCol !== col) return '';
      return this.sortDir === 'asc' ? ' ↑' : ' ↓';
    },

    setPerPage(n) {
      this.perPage = n;
      this.page = 1;
    },

    promedioEncuentros(grupoId) {
      const g = this.grupos.find(x => x.id === grupoId);
      const meta = this.planillaPara(g?.carrera_id, g?.practica || 'P2');
      let sum = 0, count = 0;
      meta.forEach(e => {
        const sc = this.data[e.id]?.[grupoId];
        const p = this.calcPct(sc);
        if (p !== null) { sum += p; count++; }
      });
      return count ? sum / count : null;
    },

    // --- PROMOCIÓN / TRANSFERENCIA ---
    get gruposPromocion() {
      let list = this.grupos.filter(g => g.proyecto && g.activo !== false && g.practica === this.promocionPP && (g.carrera_id || 'analista-sistemas') === this.promocionCarrera);
      if (this.promocionFiltroPromovibles) {
        list = list.filter(g => this.promoSugeridoEstado(g) !== 'no_promueve');
      }
      list.sort((a, b) => a.id - b.id);
      return list;
    },

    get promoSeleccionadas() {
      return Object.values(this.promoSel).filter(s => s && s.promover).length;
    },

    promoSugeridoEstado(g) {
      const nota = parseFloat(this.calcNota(this.promedioEncuentros(g.id)));
      if (isNaN(nota)) return 'sin_nota';
      if (nota >= 7) return 'aprobada';
      if (nota >= 4) return 'regularizada';
      return 'no_promueve';
    },

    promoSugeridoLabel(estado) {
      const map = {
        aprobada: 'Aprueba (≥7)',
        regularizada: 'Regulariza (4–6.9)',
        no_promueve: 'No promueve (<4)',
        sin_nota: 'Sin notas'
      };
      return map[estado] || estado;
    },

    promoSugeridoBadgeClass(estado) {
      const map = {
        aprobada: 'bg-green-100 text-green-700',
        regularizada: 'bg-amber-100 text-amber-700',
        no_promueve: 'bg-red-100 text-red-700',
        sin_nota: 'bg-gray-100 text-gray-500'
      };
      return map[estado] || 'bg-gray-100 text-gray-600';
    },

    promoPromovidosCount(grupoId) {
      const sel = this.promoSel[grupoId];
      if (!sel) return 0;
      return Object.values(sel.integrantes).filter(Boolean).length;
    },

    get destinoPPCodigo() {
      const lista = this.practicasDeCarrera(this.promocionCarrera);
      const idx = lista.findIndex(p => p.codigo === this.promocionPP);
      if (idx < 0 || idx === lista.length - 1) return null;
      return lista[idx + 1].codigo;
    },

    get destinoPPLabel() {
      const codigo = this.destinoPPCodigo;
      if (!codigo) return '—';
      const p = this.practicasDeCarrera(this.promocionCarrera).find(p => p.codigo === codigo);
      return p ? p.nombre : codigo;
    },

    initPromocion() {
      this.grupos.forEach(g => {
        if (!g.proyecto || g.practica !== this.promocionPP || (g.carrera_id || 'analista-sistemas') !== this.promocionCarrera) return;
        if (this.promoSel[g.id]) return;
        const integrantes = {};
        (g.integrantes || []).forEach(i => { integrantes[i.nombre] = true; });
        this.promoSel[g.id] = {
          promover: this.promoSugeridoEstado(g) !== 'no_promueve' && this.promoSugeridoEstado(g) !== 'sin_nota',
          integrantes
        };
      });
      this.promoResultado = '';
    },

    async aplicarPromocion() {
      if (this.promoSeleccionadas === 0) return;
      const destino = this.destinoPPCodigo;
      if (!destino) {
        this.promoResultado = 'No hay una práctica siguiente a la que promover en esta carrera.';
        this.promoResultadoError = true;
        return;
      }
      this.promoSaving = true;
      this.promoResultado = '';
      this.promoResultadoError = false;
      const esAnalistaSistemas = this.promocionCarrera === 'analista-sistemas';
      const ppMap = { P1: 'pp1', P2: 'pp2', P3: 'pp3' };
      const ppKey = ppMap[this.promocionPP];
      const mesActual = new Date().toISOString().slice(0, 7); // YYYY-MM

      const resumen = { grupos: 0, alumnos: 0, sinMatch: 0 };
      try {
        for (const [gid, sel] of Object.entries(this.promoSel)) {
          if (!sel || !sel.promover) continue;
          const g = this.grupos.find(x => String(x.id) === String(gid));
          if (!g) continue;
          const estado = this.promoSugeridoEstado(g);

          const { error: gErr } = await supabase.from('grupos').update({ practica: destino, practica_origen: null }).eq('id', g.id);
          if (gErr) throw gErr;
          g.practica = destino;
          g.practica_origen = null;
          resumen.grupos++;

          for (const encId of Object.keys(this.data)) {
            if (this.data[encId] && this.data[encId][g.id]) delete this.data[encId][g.id];
          }
          const gidSufix = `_${g.id}`;
          for (const k of Object.keys(this.evalMeta)) {
            if (k.endsWith(gidSufix)) delete this.evalMeta[k];
          }

          for (const [nombre, promovido] of Object.entries(sel.integrantes)) {
            if (!promovido) continue;
            const rindio = !!this.promoRindieron[`${g.id}_${nombre}`];
            const nuevoTag = `${destino}-${rindio ? 'rendida' : 'regular'}`;
            const integrante = (g.integrantes || []).find(i => i.nombre === nombre);
            if (integrante && (integrante.id || integrante.dbId)) {
              const intId = integrante.id || integrante.dbId;
              const { error: intErr } = await supabase.from('integrantes').update({ tags: [nuevoTag] }).eq('id', intId);
              if (intErr) throw intErr;
              integrante.tags = [nuevoTag];
            }
            if (!esAnalistaSistemas || !ppKey) continue;
            const alumno = this.alumnosSeguimiento.find(a => this.normalizarNombre(a.nombre_completo) === this.normalizarNombre(nombre));
            if (!alumno) { resumen.sinMatch++; continue; }
            const payload = {
              [`${ppKey}_estado`]: estado === 'aprobada' ? 'aprobada' : 'regularizada',
              [`${ppKey}_mes_regularizada`]: mesActual
            };
            const { error: aErr } = await supabase.from('alumnos_seguimiento').update(payload).eq('id', alumno.id);
            if (aErr) throw aErr;
            resumen.alumnos++;
          }
        }
        const msg = `Promoción aplicada: ${resumen.grupos} grupo(s) pasaron a ${destino}, ${resumen.alumnos} alumno(s) actualizados.`;
        this.promoResultado = resumen.sinMatch ? `${msg} ${resumen.sinMatch} integrante(s) sin match en alumnos_seguimiento.` : msg;
        this.promoSel = {};
        this.promoRindieron = {};
        this.initPromocion();
      } catch (e) {
        this.promoResultado = 'Error al aplicar: ' + (e.message || e);
        this.promoResultadoError = true;
      } finally {
        this.promoSaving = false;
      }
    },

    normalizarNombre(nombre) {
      return (nombre || '')
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/[.,;:]/g, '')
        .replace(/\s+/g, ' ')
        .trim();
    },

    tagEstadoDesdeTags(tags, practica) {
      const prefijo = `${practica}-`;
      const t = (tags || []).find(x => x.startsWith(prefijo));
      if (!t) return 'cursando';
      const estado = t.slice(prefijo.length);
      return ['regular', 'rendida'].includes(estado) ? estado : 'cursando';
    },

    tagsParaIntegrante(practica, tagEstado) {
      const estado = (tagEstado || 'cursando') === 'regular' ? 'regular' : (tagEstado || 'cursando') === 'rendida' ? 'rendida' : 'cursando';
      return [`${practica}-${estado}`];
    },

    // --- PLANILLA (editor por carrera y práctica) ---
    get planillaEditorRows() {
      return this.planilla[this.planillaKey(this.planillaEditorCarrera, this.planillaEditorPP)] || [];
    },

    prepararPlanillaEditor() {
      const key = this.planillaKey(this.planillaEditorCarrera, this.planillaEditorPP);
      if (!this.planilla[key]) {
        this.planilla[key] = this.planillaEditorCarrera === 'analista-sistemas'
          ? ENCUENTROS_META.map(e => ({
              id: e.id,
              nombre: e.nombre,
              pregunta: e.pregunta,
              criterios: { FN: e.criterios.FN, DEV: e.criterios.DEV, SM: e.criterios.SM }
            }))
          : [];
      }
    },

    openPlanillaEditor() {
      this.planillaEditorCarrera = this.carreraFilter && this.carreraFilter !== 'Todas' ? this.carreraFilter : 'analista-sistemas';
      const pps = this.practicasDeCarrera(this.planillaEditorCarrera);
      const preferido = this.practicaActual !== 'Todas' ? this.practicaActual : null;
      this.planillaEditorPP = pps.find(p => p.codigo === preferido)?.codigo || pps[0]?.codigo || 'P1';
      this.prepararPlanillaEditor();
      this.planillaError = '';
      this.showPlanillaEditor = true;
    },

    nextEncuentroId() {
      const rows = this.planillaEditorRows;
      const nums = rows.map(r => parseInt(String(r.id).replace(/^E/i, ''), 10)).filter(n => !isNaN(n));
      const next = (nums.length ? Math.max(...nums) : 0) + 1;
      return `E${next}`;
    },

    agregarEncuentro() {
      const key = this.planillaKey(this.planillaEditorCarrera, this.planillaEditorPP);
      if (!this.planilla[key]) this.planilla[key] = [];
      this.planilla[key].push({
        id: this.nextEncuentroId(),
        nombre: '',
        pregunta: '',
        criterios: { FN: '', DEV: '', SM: '' }
      });
    },

    async eliminarEncuentro(encId) {
      const carreraId = this.planillaEditorCarrera;
      const pp = this.planillaEditorPP;
      const tieneEvaluaciones = this.grupos.some(g =>
        (g.carrera_id || 'analista-sistemas') === carreraId &&
        g.practica === pp &&
        this.data[encId]?.[g.id] &&
        Object.keys(this.data[encId][g.id]).length > 0
      );
      if (tieneEvaluaciones && !confirm(`El encuentro ${encId} tiene evaluaciones cargadas. ¿Eliminarlo igual? Se perderán esas notas.`)) {
        return;
      }
      const key = this.planillaKey(carreraId, pp);
      this.planilla[key] = (this.planilla[key] || []).filter(r => r.id !== encId);
      try {
        await supabase.from('planilla').delete()
          .eq('carrera_id', carreraId)
          .eq('practica', pp)
          .eq('encuentro', encId);
      } catch (e) {
        console.error('Error eliminando encuentro:', e);
      }
    },

    async guardarPlanilla() {
      this.planillaSaving = true;
      this.planillaError = '';
      const carreraId = this.planillaEditorCarrera;
      const pp = this.planillaEditorPP;
      const rows = this.planillaEditorRows;
      try {
        for (const r of rows) {
          const payload = {
            carrera_id: carreraId,
            practica: pp,
            encuentro: r.id,
            nombre: r.nombre || '',
            pregunta: r.pregunta || '',
            criterio_fn: r.criterios?.FN || '',
            criterio_dev: r.criterios?.DEV || '',
            criterio_sm: r.criterios?.SM || ''
          };
          const { error } = await supabase
            .from('planilla')
            .upsert(payload, { onConflict: 'carrera_id,practica,encuentro' });
          if (error) throw error;
        }
        const key = this.planillaKey(carreraId, pp);
        this.planilla[key] = rows.map(r => ({ ...r }));
        this.showPlanillaEditor = false;
      } catch (e) {
        this.planillaError = 'Error al guardar: ' + (e.message || e);
      } finally {
        this.planillaSaving = false;
      }
    },

    dimAvgForGrupo(grupoId, dim) {
      const g = this.grupos.find(x => x.id === grupoId);
      const meta = this.planillaPara(g?.carrera_id, g?.practica || 'P2');
      let sum = 0, count = 0;
      meta.forEach(e => {
        const v = this.data[e.id]?.[grupoId]?.[dim];
        if (v !== undefined && v !== null && v !== "") { sum += Number(v); count++; }
      });
      if (!count) return "—";
      const pct = sum / count / 10;
      return this.calcNota(pct);
    },

    selectGrupo(id) {
      if (!this.canEdit) return;
      this.selectedGrupo = id;
      this.view = 'grupo';
      this.activeE = 'E1';
      this.initLocalData(id);
    },

    selectEncuentro(id) {
      if (!this.canEdit) return;
      this.selectedEnc = id;
      this.view = 'encuentro';
    },

    editGrupoEncuentro(grupoId) {
      if (!this.canEdit) return;
      this.selectedGrupo = grupoId;
      this.activeE = this.selectedEnc;
      this.view = 'grupo';
      this.initLocalData(grupoId);
    },

    initLocalData(grupoId) {
      const g = this.grupos.find(x => x.id === grupoId);
      const meta = this.planillaPara(g?.carrera_id, g?.practica || 'P2');
      const d = {};
      const a = {};
      meta.forEach(e => {
        const sc = this.data[e.id]?.[grupoId] || {};
        d[e.id] = {
          FN: sc.FN ?? "",
          DEV: sc.DEV ?? "",
          SM: sc.SM ?? "",
          feedback: { FN: sc.fb?.FN ?? "", DEV: sc.fb?.DEV ?? "", SM: sc.fb?.SM ?? "" },
        };
        a[e.id] = { ...(sc.asistencia || {}) };
      });
      this.localData = d;
      this.localAsist = a;
    },

    setField(enc, dim, val) {
      if (!this.localData[enc]) this.localData[enc] = {};
      this.localData[enc][dim] = val;
      this.debounceGuardar(enc);
    },

    setFb(enc, dim, val) {
      if (!this.localData[enc]) this.localData[enc] = {};
      if (!this.localData[enc].feedback) this.localData[enc].feedback = {};
      this.localData[enc].feedback[dim] = val;
      this.debounceGuardar(enc);
    },

    setAsist(nombre, val) {
      if (!this.localAsist[this.activeE]) this.localAsist[this.activeE] = {};
      this.localAsist[this.activeE][nombre] = val;
      this.guardarEncuentro(this.activeE);
    },

    debounceGuardar(enc) {
      if (this.saveTimeout) clearTimeout(this.saveTimeout);
      this.saveTimeout = setTimeout(() => {
        this.guardarEncuentro(enc);
      }, 1000);
    },

    criterioActual(dim) {
      return this.encuentroActual?.criterios[dim] || '';
    },

    countGruposEvaluados(encId) {
      let cnt = 0;
      this.gruposConProyecto.forEach(g => { if (this.calcPct(this.data[encId]?.[g.id]) !== null) cnt++; });
      return cnt;
    },

    dimProm(dim) {
      const meta = this.encuentrosMeta;
      let sum = 0, count = 0;
      this.gruposConProyecto.forEach(g => {
        meta.forEach(e => {
          const v = this.data[e.id]?.[g.id]?.[dim];
          if (v !== undefined && v !== null && v !== "") { sum += Number(v); count++; }
        });
      });
      const avgPct = count ? (sum / count) / 10 : 0;
      return count ? parseFloat(this.calcNota(avgPct)) : 0;
    },

    dimAvg(dim) {
      const prom = this.dimProm(dim);
      return prom > 0 ? prom.toFixed(1) : "—";
    },

    encProm(encId) {
      let sum = 0, count = 0;
      this.gruposConProyecto.forEach(g => {
        const sc = this.data[encId]?.[g.id];
        const p = this.calcPct(sc);
        if (p !== null) { sum += parseFloat(this.calcNota(p)); count++; }
      });
      return count ? sum / count : 0;
    },

    encAvg(encId) {
      const prom = this.encProm(encId);
      return prom > 0 ? prom.toFixed(1) : "—";
    },

    encCount(encId) {
      let count = 0;
      this.gruposConProyecto.forEach(g => {
        const sc = this.data[encId]?.[g.id];
        const p = this.calcPct(sc);
        if (p !== null) count++;
      });
      return count;
    },

    encPromColor(encId) {
      const avg = this.encProm(encId);
      return this.pctColor(avg >= 7 ? 0.8 : avg >= 4 ? 0.6 : 0.3);
    },

    notaColorClass(nota) {
      return this.notaColor(nota);
    },

    // --- STATS HELPERS ---
    gruposStatsFiltrados() {
      let list = this.grupos.filter(g => g.proyecto && (this.mostrarInactivos || g.activo !== false));
      if (this.carreraFilter && this.carreraFilter !== 'Todas') {
        list = list.filter(g => (g.carrera_id || 'analista-sistemas') === this.carreraFilter);
      }
      if (this.statsComisionFilter) {
        list = list.filter(g => g.comision === this.statsComisionFilter);
      }
      if (this.statsPracticaFilter) {
        list = list.filter(g => g.practica === this.statsPracticaFilter);
      }
      return list;
    },

    statsEncuentros() {
      const pp = this.statsPracticaFilter || (this.practicaFilter === 'Todas' ? 'P2' : this.practicaFilter);
      return this.planillaPara(this.carreraFilter, pp);
    },

    calcStatsResumen() {
      const grupos = this.gruposStatsFiltrados();
      let evaluados = 0, promocionados = 0, regulares = 0, libres = 0;
      const total = grupos.length;
      
      grupos.forEach(g => {
        const prom = this.promedioEncuentros(g.id);
        if (prom !== null) {
          evaluados++;
          const nota = parseFloat(this.calcNota(prom));
          if (nota >= 7) promocionados++;
          else if (nota >= 4) regulares++;
          else libres++;
        }
      });
      
      const pctProm = evaluados > 0 ? Math.round((promocionados / evaluados) * 100) : 0;
      const pctReg = evaluados > 0 ? Math.round((regulares / evaluados) * 100) : 0;
      const pctLib = evaluados > 0 ? Math.round((libres / evaluados) * 100) : 0;
      const pctEval = total > 0 ? Math.round((evaluados / total) * 100) : 0;
      
      this.statsResumen = { evaluados, promocionados, regulares, libres, total, sinEvaluar: total - evaluados, pctProm, pctReg, pctLib, pctEval };
    },

    getEvolucionData() {
      const grupos = this.gruposStatsFiltrados();
      const encounters = this.statsEncuentroFilter 
        ? this.statsEncuentros().filter(e => e.id === this.statsEncuentroFilter)
        : this.statsEncuentros();
      
      const traces = ['FN', 'DEV', 'SM'].map((dim, idx) => {
        const colors = ['#4f46e5', '#0284c7', '#d97706'];
        const x = [], y = [];
        encounters.forEach(enc => {
          let sum = 0, count = 0;
          grupos.forEach(g => {
            const v = this.data[enc.id]?.[g.id]?.[dim];
            if (v !== undefined && v !== null && v !== '') { sum += Number(v); count++; }
          });
          if (count > 0) {
            x.push(enc.id);
            y.push(parseFloat(this.calcNota(sum / count / 10)));
          }
        });
        return { x, y, mode: 'lines+markers', name: dim, line: { color: colors[idx], width: 3 }, marker: { size: 8 } };
      });
      
      return { data: traces, layout: { margin: { t: 20, r: 20, b: 40, l: 40 }, xaxis: { title: 'Encuentro' }, yaxis: { title: 'Nota', range: [0, 10] }, legend: { orientation: 'h', y: -0.2 }, paper_bgcolor: 'rgba(0,0,0,0)', plot_bgcolor: 'rgba(0,0,0,0)', font: { family: 'sans-serif', size: 12 } } };
    },

    getScatterData() {
      const grupos = this.gruposStatsFiltrados();
      const x = [], y = [], text = [], color = [], size = [];
      
      grupos.forEach(g => {
        this.statsEncuentros().forEach(enc => {
          const asist = this.data[enc.id]?.[g.id]?.asistencia || {};
          let presentes = 0, total = 0;
          g.integrantes?.forEach(int => {
            const estado = asist[int.nombre];
            if (estado) {
              total++;
              if (estado === 'Presente') presentes++;
            }
          });
          
          const dims = ['FN','DEV','SM'];
          let sum = 0, count = 0;
          dims.forEach(d => {
            const v = this.data[enc.id]?.[g.id]?.[d];
            if (v !== undefined && v !== null && v !== '') { sum += Number(v); count++; }
          });
          
          if (count > 0 && total > 0) {
            const pctAvg = sum / count / 10;
            const notaAvg = parseFloat(this.calcNota(pctAvg));
            const asistPct = (presentes / total) * 100;
            x.push(asistPct);
            y.push(notaAvg);
            text.push(`G${g.id} · ${enc.id}`);
            color.push(notaAvg >= 7 ? '#10b981' : notaAvg >= 4 ? '#f59e0b' : '#ef4444');
            size.push(10 + total * 2);
          }
        });
      });
      
      if (x.length === 0) return { data: [], layout: {} };
      
      const trace = {
        x, y, mode: 'markers', text, hovertemplate: '%{text}<br>Nota: %{y:.1f}<br>Asistencia: %{x:.0f}%<extra></extra>',
        marker: { size, color, opacity: 0.8, line: { width: 1, color: 'white' } },
        type: 'scatter'
      };
      
      return {
        data: [trace],
        layout: {
          margin: { t: 20, r: 20, b: 40, l: 40 },
          xaxis: { title: '% Asistencia', range: [0, 105] },
          yaxis: { title: 'Nota', range: [0, 10] },
          paper_bgcolor: 'rgba(0,0,0,0)', plot_bgcolor: 'rgba(0,0,0,0)',
          font: { family: 'sans-serif', size: 12 }
        }
      };
    },

    getMejoraData() {
      const grupos = this.gruposStatsFiltrados();
      const y = [], x = [], text = [];
      
      grupos.forEach(g => {
        const dims = ['FN','DEV','SM'];
        const notas = [];
        
        this.statsEncuentros().forEach(enc => {
          let sum = 0, count = 0;
          dims.forEach(d => {
            const v = this.data[enc.id]?.[g.id]?.[d];
            if (v !== undefined && v !== null && v !== '') { sum += Number(v); count++; }
          });
          notas.push(count > 0 ? parseFloat(this.calcNota(sum / count / 10)) : null);
        });
        
        for (let i = 1; i < notas.length; i++) {
          if (notas[i] !== null && notas[i-1] !== null) {
            const delta = notas[i] - notas[i-1];
            y.push(`G${g.id}: ${this.statsEncuentros()[i-1].id} → ${this.statsEncuentros()[i].id}`);
            x.push(delta);
            text.push(`${delta >= 0 ? '+' : ''}${delta.toFixed(1)} nota`);
          }
        }
      });
      
      if (y.length === 0) return { data: [], layout: {} };
      
      return {
        data: [{ x, y, type: 'bar', orientation: 'h', marker: { color: x.map(v => v >= 0 ? '#10b981' : '#ef4444') }, text, textposition: 'auto', hovertemplate: '%{text}<extra></extra>' }],
        layout: {
          margin: { t: 20, r: 20, b: 40, l: 160 },
          xaxis: { title: 'Δ Nota' },
          paper_bgcolor: 'rgba(0,0,0,0)', plot_bgcolor: 'rgba(0,0,0,0)',
          font: { family: 'sans-serif', size: 12 }
        }
      };
    },

    getHistogramData() {
      const grupos = this.gruposStatsFiltrados();
      const dims = ['FN', 'DEV', 'SM'];
      const colors = ['#4f46e5', '#0284c7', '#d97706'];
      
      const traces = dims.map((dim, idx) => {
        const values = [];
        grupos.forEach(g => {
          this.statsEncuentros().forEach(enc => {
            if (this.statsEncuentroFilter && enc.id !== this.statsEncuentroFilter) return;
            const v = this.data[enc.id]?.[g.id]?.[dim];
            if (v !== undefined && v !== null && v !== '') values.push(Number(v));
          });
        });
        return { x: values, type: 'histogram', name: dim, marker: { color: colors[idx], line: { width: 1, color: 'white' } }, opacity: 0.75, nbinsx: 10 };
      });
      
      return {
        data: traces,
        layout: {
          margin: { t: 20, r: 20, b: 40, l: 40 },
          xaxis: { title: 'Completitud (%)', range: [0, 10] },
          yaxis: { title: 'Frecuencia' },
          barmode: 'overlay',
          legend: { orientation: 'h', y: -0.2 },
          paper_bgcolor: 'rgba(0,0,0,0)', plot_bgcolor: 'rgba(0,0,0,0)',
          font: { family: 'sans-serif', size: 12 }
        }
      };
    },

    getHeatmapData() {
      const grupos = this.gruposStatsFiltrados();
      const comisionesUnicas = [...new Set(grupos.map(g => g.comision || 'Sin comisión'))].sort();
      const encounters = this.statsEncuentroFilter 
        ? this.statsEncuentros().filter(e => e.id === this.statsEncuentroFilter)
        : this.statsEncuentros();
      
      const z = [];
      comisionesUnicas.forEach(com => {
        const row = [];
        encounters.forEach(enc => {
          let sum = 0, count = 0;
          grupos.filter(g => (g.comision || 'Sin comisión') === com).forEach(g => {
            const sc = this.data[enc.id]?.[g.id];
            const p = this.calcPct(sc);
            if (p !== null) { sum += p; count++; }
          });
          row.push(count > 0 ? parseFloat(this.calcNota(sum / count)) : null);
        });
        z.push(row);
      });
      
      return {
        data: [{
          z, x: encounters.map(e => e.id), y: comisionesUnicas,
          type: 'heatmap', colorscale: 'RdYlGn', zmin: 0, zmax: 10,
          colorbar: { title: 'Nota', titleside: 'right' },
          hovertemplate: 'Encuentro: %{x}<br>Comisión: %{y}<br>Nota: %{z}<extra></extra>'
        }],
        layout: {
          margin: { t: 20, r: 80, b: 40, l: 100 },
          paper_bgcolor: 'rgba(0,0,0,0)', plot_bgcolor: 'rgba(0,0,0,0)',
          font: { family: 'sans-serif', size: 12 }
        }
      };
    },

    getEstadosData() {
      const grupos = this.gruposStatsFiltrados();
      let prom = 0, reg = 0, lib = 0, ne = 0;
      
      grupos.forEach(g => {
        const promVal = this.promedioEncuentros(g.id);
        if (promVal === null) ne++;
        else {
          const nota = parseFloat(this.calcNota(promVal));
          if (nota >= 7) prom++;
          else if (nota >= 4) reg++;
          else lib++;
        }
      });
      
      return {
        data: [{
          values: [prom, reg, lib, ne],
          labels: ['Promocionados', 'Regulares', 'Libres', 'Sin evaluar'],
          type: 'pie',
          hole: 0.45,
          marker: { colors: ['#10b981', '#f59e0b', '#ef4444', '#9ca3af'] },
          textinfo: 'label+percent',
          textposition: 'outside'
        }],
        layout: {
          margin: { t: 20, r: 20, b: 20, l: 20 },
          showlegend: false,
          paper_bgcolor: 'rgba(0,0,0,0)', plot_bgcolor: 'rgba(0,0,0,0)',
          font: { family: 'sans-serif', size: 12 }
        }
      };
    },

    // --- AUSENCIAS GRÁFICOS ---
    getAusenciasHeatmapData() {
      const grupos = this.gruposStatsFiltrados();
      const alumnosRows = [];
      const yLabels = [];
      const hoverText = [];

      // Recolectar alumnos ordenados por grupo
      grupos.forEach(g => {
        g.integrantes?.forEach(int => {
          const row = [];
          const hoverRow = [];
          let tieneDatos = false;

          this.statsEncuentros().forEach(enc => {
            const asist = this.data[enc.id]?.[g.id]?.asistencia || {};
            const estado = asist[int.nombre];
            let val, label;
            if (estado === 'Presente') { val = 1; label = 'Presente'; tieneDatos = true; }
            else if (estado === 'Justificado') { val = 2; label = 'Justificado'; tieneDatos = true; }
            else if (estado === 'Ausente') { val = 3; label = 'Ausente'; tieneDatos = true; }
            else { val = 0; label = 'Sin dato'; }
            row.push(val);
            hoverRow.push(`${int.nombre}<br>${enc.id}: ${label}`);
          });

          if (tieneDatos) {
            alumnosRows.push(row);
            yLabels.push(`${int.nombre} (G${g.id})`);
            hoverText.push(hoverRow);
          }
        });
      });

      if (alumnosRows.length === 0) return { data: [], layout: {} };

      // Ordenar por cantidad de ausencias+justificados (más ausentes arriba)
      const counts = alumnosRows.map(row => row.filter(v => v >= 2).length);
      const indices = counts.map((_, i) => i);
      indices.sort((a, b) => counts[b] - counts[a]);

      const sortedRows = indices.map(i => alumnosRows[i]);
      const sortedY = indices.map(i => yLabels[i]);
      const sortedHover = indices.map(i => hoverText[i]);

      const z = sortedRows;
      const x = this.statsEncuentros().map(e => e.id);

      return {
        data: [{
          z,
          x,
          y: sortedY,
          type: 'heatmap',
          colorscale: [
            [0, '#e5e7eb'],
            [0.33, '#10b981'],
            [0.66, '#f59e0b'],
            [1, '#ef4444']
          ],
          zmin: 0,
          zmax: 3,
          showscale: false,
          text: sortedHover,
          hovertemplate: '%{text}<extra></extra>',
          xgap: 2,
          ygap: 2,
        }],
        layout: {
          margin: { t: 10, r: 10, b: 40, l: 180 },
          paper_bgcolor: 'rgba(0,0,0,0)',
          plot_bgcolor: 'rgba(0,0,0,0)',
          font: { family: 'sans-serif', size: 11 },
          yaxis: { automargin: true, tickfont: { size: 10 } },
          xaxis: { tickfont: { size: 11, weight: 700 } },
        }
      };
    },

    getAusenciasStackedData() {
      const grupos = this.gruposStatsFiltrados();
      const x = this.statsEncuentros().map(e => e.id);
      const ausentes = [];
      const justificados = [];
      const presentes = [];

      this.statsEncuentros().forEach(enc => {
        let a = 0, j = 0, p = 0;
        grupos.forEach(g => {
          const asist = this.data[enc.id]?.[g.id]?.asistencia || {};
          g.integrantes?.forEach(int => {
            const estado = asist[int.nombre];
            if (estado === 'Ausente') a++;
            else if (estado === 'Justificado') j++;
            else if (estado === 'Presente') p++;
          });
        });
        ausentes.push(a);
        justificados.push(j);
        presentes.push(p);
      });

      const hasData = ausentes.some(v => v > 0) || justificados.some(v => v > 0) || presentes.some(v => v > 0);
      if (!hasData) return { data: [], layout: {} };

      return {
        data: [
          {
            x, y: ausentes, name: 'Ausente', type: 'bar',
            marker: { color: '#ef4444' },
            hovertemplate: '%{x}: %{y} ausentes<extra></extra>'
          },
          {
            x, y: justificados, name: 'Justificado', type: 'bar',
            marker: { color: '#f59e0b' },
            hovertemplate: '%{x}: %{y} justificados<extra></extra>'
          },
          {
            x, y: presentes, name: 'Presente', type: 'bar',
            marker: { color: '#10b981' },
            hovertemplate: '%{x}: %{y} presentes<extra></extra>'
          }
        ],
        layout: {
          barmode: 'stack',
          margin: { t: 10, r: 10, b: 40, l: 50 },
          paper_bgcolor: 'rgba(0,0,0,0)',
          plot_bgcolor: 'rgba(0,0,0,0)',
          font: { family: 'sans-serif', size: 12 },
          xaxis: { tickfont: { size: 11, weight: 700 } },
          yaxis: { title: 'Alumnos', titlefont: { size: 11 } },
          legend: { orientation: 'h', y: -0.15, x: 0.5, xanchor: 'center' },
          bargap: 0.3,
        }
      };
    },

    renderStats() {
      if (!window.Plotly) return;
      
      this.calcStatsResumen();
      
      // Pequeño delay para asegurar que los contenedores existen en el DOM
      setTimeout(() => {
        const charts = [
          { id: 'plot-evolucion', getData: () => this.getEvolucionData() },
          { id: 'plot-scatter', getData: () => this.getScatterData() },
          { id: 'plot-mejora', getData: () => this.getMejoraData() },
          { id: 'plot-histogram', getData: () => this.getHistogramData() },
          { id: 'plot-heatmap', getData: () => this.getHeatmapData() },
          { id: 'plot-estados', getData: () => this.getEstadosData() },
          { id: 'plot-ausencias-heatmap', getData: () => this.getAusenciasHeatmapData() },
          { id: 'plot-ausencias-barras', getData: () => this.getAusenciasStackedData() },
        ];
        
        charts.forEach(({ id, getData }) => {
          const el = document.getElementById(id);
          if (el) {
            const { data, layout } = getData();
            if (data && data.length > 0) {
              Plotly.newPlot(id, data, layout, { responsive: true, displayModeBar: false });
            } else {
              el.innerHTML = '<div class="flex items-center justify-center h-full text-gray-400 text-sm">Sin datos</div>';
            }
          }
        });
      }, 50);
    },

