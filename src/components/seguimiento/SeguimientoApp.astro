                  <label class="block text-[10px] font-bold text-gray-500 uppercase mb-0.5">Nombre</label>
                  <input type="text" x-model="enc.nombre" class="w-full px-2.5 py-1.5 border border-gray-300 rounded-lg text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-600 bg-white">
                </div>
                <button
                  type="button"
                  @click="eliminarEncuentro(enc.id)"
                  class="shrink-0 w-8 h-8 flex items-center justify-center rounded-lg text-red-600 hover:bg-red-50"
                  title="Eliminar encuentro"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"/></svg>
                </button>
              </div>
              <div class="mb-3">
                <label class="block text-[10px] font-bold text-gray-500 uppercase mb-0.5">Pregunta</label>
                <textarea x-model="enc.pregunta" rows="2" class="w-full px-2.5 py-1.5 border border-gray-300 rounded-lg text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-600 bg-white resize-y"></textarea>
              </div>
              <div class="grid grid-cols-1 md:grid-cols-3 gap-2">
                <div>
                  <label class="block text-[10px] font-bold text-gray-500 uppercase mb-0.5">Criterio FN</label>
                  <textarea x-model="enc.criterios.FN" rows="2" class="w-full px-2.5 py-1.5 border border-gray-300 rounded-lg text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-600 bg-white resize-y"></textarea>
                </div>
                <div>
                  <label class="block text-[10px] font-bold text-gray-500 uppercase mb-0.5">Criterio DEV</label>
                  <textarea x-model="enc.criterios.DEV" rows="2" class="w-full px-2.5 py-1.5 border border-gray-300 rounded-lg text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-600 bg-white resize-y"></textarea>
                </div>
                <div>
                  <label class="block text-[10px] font-bold text-gray-500 uppercase mb-0.5">Criterio SM</label>
                  <textarea x-model="enc.criterios.SM" rows="2" class="w-full px-2.5 py-1.5 border border-gray-300 rounded-lg text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-600 bg-white resize-y"></textarea>
                </div>
              </div>
            </div>
          </template>

          <button
