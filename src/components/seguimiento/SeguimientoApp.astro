    <!-- MODAL PROMOVER -->
    <div x-show="showPromover" class="fixed inset-0 z-50 flex items-start sm:items-center justify-center bg-black/50 p-2 sm:p-4 overflow-y-auto" @click.self="showPromover = false">
      <div class="bg-white rounded-2xl shadow-2xl w-full max-w-2xl my-4 sm:my-8 flex flex-col max-h-[calc(100vh-2rem)]">
        <div class="flex items-center justify-between px-4 sm:px-6 py-4 border-b border-gray-200 shrink-0">
          <div>
            <h2 class="text-base font-bold text-gray-900">Promover / Transferencia de alumnos</h2>
            <p class="text-xs text-gray-500">Marcá los grupos que pasan al siguiente cuatrimestre. Sugerencia automática: promedio ≥ 4 regulariza, ≥ 7 aprueba.</p>
          </div>
          <button @click="showPromover = false; promoResultado = ''" class="w-8 h-8 flex items-center justify-center rounded-lg text-gray-500 hover:text-gray-900 hover:bg-gray-100 transition">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>

        <div class="px-4 sm:px-6 pt-4 shrink-0">
          <div class="flex gap-1.5 flex-wrap mb-2" x-show="carrerasActivas.length > 1">
            <template x-for="c in carrerasActivas" :key="c.id">
              <button
                @click="promocionCarrera = c.id; promocionPP = practicasDeCarrera(c.id)[0]?.codigo || 'P1'; promoSel = {}; promoRindieron = {}; initPromocion()"
                class="px-3 py-1 text-[11px] font-bold rounded-md transition"
                :class="promocionCarrera === c.id ? 'bg-gray-900 text-white' : 'bg-white text-gray-600 border border-gray-300 hover:bg-gray-100'"
                x-text="c.nombre"
              ></button>
            </template>
          </div>
          <div class="flex gap-1.5 flex-wrap mb-3">
            <template x-for="p in practicasDeCarrera(promocionCarrera)" :key="p.id">
              <button
                @click="promocionPP = p.codigo; promoSel = {}; promoRindieron = {}; initPromocion()"
                class="px-3 py-1.5 text-xs font-bold rounded-md transition"
                :class="promocionPP === p.codigo ? 'bg-indigo-700 text-white' : 'bg-white text-gray-600 border border-gray-300 hover:bg-gray-100'"
                x-text="p.nombre"
              ></button>
            </template>
          </div>
          <div class="flex flex-wrap items-center gap-2 mb-3">
            <label class="flex items-center gap-2 text-xs font-bold text-gray-700 cursor-pointer">
              <input type="checkbox" x-model="promocionFiltroPromovibles" class="w-4 h-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600">
              Solo promovibles (promedio ≥ 4)
            </label>
            <span class="text-xs text-gray-400" x-text="`${gruposPromocion.length} grupos en ${promocionPP}`"></span>
          </div>
          <div x-show="!destinoPPCodigo" class="mb-3 p-2.5 rounded-lg border border-amber-200 bg-amber-50 text-amber-800 text-xs font-medium">
            Esta es la última práctica de la carrera: no hay una etapa siguiente para promover.
          </div>
          <div x-show="promoResultado" class="mb-3 p-3 rounded-xl border text-sm" :class="promoResultadoError ? 'border-red-200 bg-red-50 text-red-700' : 'border-green-200 bg-green-50 text-green-700'" x-text="promoResultado"></div>
        </div>

        <div class="px-4 sm:px-6 py-4 overflow-y-auto flex-1 min-h-0 space-y-3">
          <template x-for="g in gruposPromocion" :key="g.id">
            <div class="bg-white rounded-xl border border-gray-200 shadow-sm" :class="promoSel[g.id]?.promover ? 'border-indigo-400 ring-1 ring-indigo-200' : ''">
              <div class="p-3 flex items-center gap-3">
                <input type="checkbox" x-model="promoSel[g.id].promover" class="w-5 h-5 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600">
                <div class="flex-1 min-w-0">
                  <div class="font-bold text-sm text-gray-900">
                    <span class="text-gray-500 mr-1" x-text="`G${g.id}`"></span>
                    <span x-text="g.proyecto"></span>
                  </div>
                  <div class="text-xs text-gray-500" x-text="`${g.comision || '—'} · ${g.integrantes?.length || 0} integrantes`"></div>
                </div>
                <div class="text-center">
                  <div class="text-[10px] text-gray-500 font-bold uppercase">Promedio</div>
                  <span class="inline-flex items-center justify-center min-w-[3rem] h-8 rounded-lg text-sm font-bold" :class="notaBadgeClass(calcNota(promedioEncuentros(g.id)))" x-text="calcNota(promedioEncuentros(g.id))"></span>
                </div>
                <div class="text-center">
                  <div class="text-[10px] text-gray-500 font-bold uppercase">Sugerido</div>
                  <span class="inline-flex items-center px-2 py-1 rounded-lg text-xs font-bold" :class="promoSugeridoBadgeClass(promoSugeridoEstado(g))" x-text="promoSugeridoLabel(promoSugeridoEstado(g))"></span>
                </div>
              </div>
              <div x-show="promoSel[g.id].promover" class="border-t border-gray-100 px-3 py-2 bg-indigo-50/50">
                <div class="flex items-center justify-between mb-1.5">
                  <span class="text-[10px] font-bold text-gray-600 uppercase tracking-wide">Integrantes (desmarcá quien repite) · ¿Rindió?</span>
                  <span class="text-[10px] text-gray-500 font-bold" x-text="`${promoPromovidosCount(g.id)} de ${g.integrantes?.length || 0}`"></span>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-1">
                  <template x-for="int in g.integrantes" :key="int.nombre">
                    <div class="flex items-center justify-between gap-1.5 text-xs text-gray-700 rounded px-1.5 py-0.5 hover:bg-white">
                      <label class="flex items-center gap-1.5 cursor-pointer flex-1 min-w-0">
                        <input type="checkbox" x-model="promoSel[g.id].integrantes[int.nombre]" class="w-3.5 h-3.5 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600">
                        <span class="truncate" x-text="int.nombre"></span>
                      </label>
                      <label class="flex items-center gap-1 cursor-pointer shrink-0" :class="promoSel[g.id].integrantes[int.nombre] ? 'text-gray-700' : 'text-gray-300'">
                        <input type="checkbox" :disabled="!promoSel[g.id].integrantes[int.nombre]" x-model="promoRindieron[`${g.id}_${int.nombre}`]" class="w-3.5 h-3.5 rounded border-gray-300 text-emerald-600 focus:ring-emerald-600">
                        <span class="text-[10px] font-bold" x-text="promoRindieron[`${g.id}_${int.nombre}`] ? 'Rindió' : '¿Rindió?'"></span>
                      </label>
                    </div>
                  </template>
                </div>
                <div class="mt-2 text-[10px] text-gray-500">Tags a asignar: <span class="font-bold" x-text="destinoPPLabel"></span> · <span class="font-bold">Regularizado</span> (o <span class="font-bold">Rendido</span> si marcás "Rindió")</div>
              </div>
            </div>
          </template>
          <template x-if="gruposPromocion.length === 0">
            <div class="bg-white rounded-xl p-8 text-center text-gray-500 text-sm border border-gray-200">No hay grupos en esta práctica.</div>
          </template>
        </div>

        <div class="flex items-center justify-between px-4 sm:px-6 py-4 border-t border-gray-200 shrink-0">
          <div class="text-xs text-gray-500" x-text="`${promoSeleccionadas} grupos seleccionados`"></div>
          <div class="flex gap-2">
            <button @click="showPromover = false; promoResultado = ''" class="px-4 py-2.5 text-sm font-bold rounded-xl border border-gray-300 text-gray-600 hover:bg-gray-50 transition">Cancelar</button>
            <button
              @click="aplicarPromocion()"
              :disabled="promoSeleccionadas === 0 || promoSaving || !destinoPPCodigo"
              class="px-5 py-2.5 bg-indigo-700 text-white text-sm font-bold rounded-xl hover:bg-indigo-800 transition disabled:opacity-40 disabled:cursor-not-allowed"
            >
              <span x-text="promoSaving ? 'Aplicando...' : 'Aplicar promoción'"></span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- MODAL PLANILLA -->
    <div x-show="showPlanillaEditor" class="fixed inset-0 z-50 flex items-start sm:items-center justify-center bg-black/50 p-2 sm:p-4 overflow-y-auto" @click.self="showPlanillaEditor = false">
      <div class="bg-white rounded-2xl shadow-2xl w-full max-w-3xl my-4 sm:my-8 flex flex-col max-h-[calc(100vh-2rem)]">
        <div class="flex items-center justify-between px-4 sm:px-6 py-4 border-b border-gray-200 shrink-0">
          <div>
            <h2 class="text-base font-bold text-gray-900">Editor de planilla</h2>
            <p class="text-xs text-gray-500">Criterios, preguntas y nombres por práctica y encuentro.</p>
          </div>
          <button @click="showPlanillaEditor = false; planillaError = ''" class="w-8 h-8 flex items-center justify-center rounded-lg text-gray-500 hover:text-gray-900 hover:bg-gray-100 transition">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>

