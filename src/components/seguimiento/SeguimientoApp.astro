                class="px-3 py-1.5 text-xs font-bold rounded-md transition"
                :class="planillaEditorPP === p.codigo ? 'bg-indigo-700 text-white' : 'bg-white text-gray-600 border border-gray-300 hover:bg-gray-100'"
                x-text="p.nombre"
              ></button>
            </template>
          </div>
          <div x-show="planillaError" class="mb-3 p-3 rounded-xl border border-red-200 bg-red-50 text-red-700 text-sm" x-text="planillaError"></div>
