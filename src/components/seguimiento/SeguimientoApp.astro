          <div class="flex gap-1.5 flex-wrap mb-2" x-show="carrerasActivas.length > 1">
            <template x-for="c in carrerasActivas" :key="c.id">
              <button
                @click="planillaEditorCarrera = c.id; planillaEditorPP = practicasDeCarrera(c.id)[0]?.codigo || 'P1'; prepararPlanillaEditor(); planillaError = ''"
                class="px-3 py-1 text-[11px] font-bold rounded-md transition"
                :class="planillaEditorCarrera === c.id ? 'bg-gray-900 text-white' : 'bg-white text-gray-600 border border-gray-300 hover:bg-gray-100'"
                x-text="c.nombre"
              ></button>
