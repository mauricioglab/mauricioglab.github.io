---
// Componente principal de seguimiento - Alpine.js + Firebase
---

<div 
  x-data="seguimientoApp()" 
  x-init="init()" 
  class="min-h-screen bg-gray-100 font-sans"
  x-cloak
>
  <!-- Header -->
  <header class="bg-white border-b border-gray-300 sticky top-0 z-30 shadow-sm">
    <div class="max-w-6xl mx-auto px-3 sm:px-4 py-3">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <div class="min-w-0">
          <h1 class="text-base sm:text-lg font-bold text-gray-900">Práctica Profesionalizante</h1>
          <p class="text-[11px] sm:text-xs text-gray-600" x-text="`${gruposFiltrados.length} grupos`"></p>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          <button
            x-show="canEdit && (view === 'resumen' || view === 'encuentros' || view === 'stats')"
            @click="openAddGrupoModal()"
            class="px-3 py-1.5 flex items-center gap-1.5 rounded-lg bg-indigo-600 text-white text-xs sm:text-sm font-bold hover:bg-indigo-700 transition whitespace-nowrap"
            title="Agregar grupo"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
            <span class="hidden sm:inline">Grupo</span>
          </button>

          <div class="relative" x-show="canEdit && (view === 'resumen' || view === 'encuentros' || view === 'stats')" @click.outside="mobileMenuOpen = false">
            <button
              @click="mobileMenuOpen = !mobileMenuOpen"
              class="w-9 h-9 flex items-center justify-center rounded-lg border border-gray-300 bg-white text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition"
              title="Más acciones"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="5" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="12" cy="19" r="1.5"/></svg>
            </button>
            <div
              x-show="mobileMenuOpen"
              x-transition
              x-cloak
              class="absolute right-0 mt-2 w-56 bg-white rounded-xl border border-gray-200 shadow-lg py-1.5 z-40"
            >
              <button @click="mobileMenuOpen = false; showPromover = true; initPromocion()" class="w-full flex items-center gap-2 px-3 py-2 text-sm font-bold text-gray-700 hover:bg-gray-50 text-left">
                <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg>
                Promover grupos
              </button>
              <button @click="mobileMenuOpen = false; openPlanillaEditor()" class="w-full flex items-center gap-2 px-3 py-2 text-sm font-bold text-gray-700 hover:bg-gray-50 text-left">
                <svg class="w-4 h-4 text-slate-600 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                Editar planilla
              </button>
              <button @click="mobileMenuOpen = false; document.getElementById('excelFileInput').click()" class="w-full flex items-center gap-2 px-3 py-2 text-sm font-bold text-gray-700 hover:bg-gray-50 text-left">
                <svg class="w-4 h-4 text-amber-600 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 4v16m8-8H4"/></svg>
                Importar Excel
              </button>
            </div>
          </div>
          <input type="file" id="excelFileInput" accept=".xlsx,.xls" class="hidden" @change="handleExcelImport($event)">
          <template x-if="!user">
            <button
              @click="showLogin = true"
              class="px-3 py-1.5 bg-indigo-700 text-white text-xs sm:text-sm font-medium rounded-lg hover:bg-indigo-800 transition whitespace-nowrap"
            >
              Ingresar
            </button>
          </template>
          <template x-if="user">
            <div class="flex items-center gap-2 shrink-0">
              <span class="hidden sm:inline text-xs text-gray-700 font-medium max-w-[140px] truncate" x-text="user.email"></span>
              <button
                @click="logout()"
                class="px-3 py-1.5 text-xs text-red-700 hover:bg-red-50 rounded-lg transition font-medium whitespace-nowrap"
              >
                Salir
              </button>
            </div>
          </template>
        </div>
      </div>

      <!-- Nivel 1: Carrera (solo si hay más de una activa) -->
      <nav class="flex gap-1 mt-2 overflow-x-auto" x-show="carrerasActivas.length > 1 && (view === 'resumen' || view === 'encuentros' || view === 'stats')">
        <template x-for="c in carrerasActivas" :key="c.id">
          <button
            @click="setCarreraFilter(c.id)"
            class="px-2.5 py-1 text-xs font-bold rounded-md transition whitespace-nowrap"
            :class="carreraFilter === c.id ? 'bg-gray-900 text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'"
            x-text="c.nombre"
          ></button>
        </template>
      </nav>

      <!-- Nivel 2: Práctica -->
      <nav class="flex gap-1 mt-2 overflow-x-auto" x-show="view === 'resumen' || view === 'encuentros' || view === 'stats'">
        <template x-for="p in practicasNav" :key="p.id">
          <button
            @click="practicaFilter = p.id; page = 1"
            class="px-2.5 py-1 text-xs font-bold rounded-md transition whitespace-nowrap"
            :class="practicaFilter === p.id ? 'bg-indigo-700 text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'"
            x-text="p.label"
          ></button>
        </template>
      </nav>

      <!-- Nivel 3: Vista -->
      <nav class="flex gap-0 mt-2 -mb-px overflow-x-auto" x-show="view === 'resumen' || view === 'encuentros' || view === 'stats'">
        <button
          @click="view = 'resumen'"
          class="flex-1 py-2 text-sm font-bold border-b-2 transition"
          :class="view === 'resumen' ? 'border-indigo-700 text-indigo-700' : 'border-transparent text-gray-600 hover:text-gray-800'"
        >
          Resumen
        </button>
        <button
          x-show="canEdit"
          @click="view = 'encuentros'"
          class="flex-1 py-2 text-sm font-bold border-b-2 transition"
          :class="view === 'encuentros' ? 'border-indigo-700 text-indigo-700' : 'border-transparent text-gray-600 hover:text-gray-800'"
        >
          Encuentros
        </button>
        <button
          x-show="canEdit"
          @click="view = 'stats'"
          class="flex-1 py-2 text-sm font-bold border-b-2 transition"
          :class="view === 'stats' ? 'border-indigo-700 text-indigo-700' : 'border-transparent text-gray-600 hover:text-gray-800'"
        >
          Stats
        </button>
        </nav>
    </div>
  </header>

  <!-- Main Content -->
  <main class="max-w-6xl mx-auto px-4 py-4">
    
    <!-- Loading -->
    <div x-show="loadingData" class="text-center py-12">
      <div class="inline-block w-8 h-8 border-2 border-indigo-700 border-t-transparent rounded-full animate-spin"></div>
      <p class="text-sm text-gray-600 mt-2 font-medium">Cargando datos...</p>
    </div>

    <!-- VISTA RESUMEN -->
    <div x-show="view === 'resumen' && !loadingData" x-transition>
      <div class="flex flex-wrap gap-2 mb-4">
        <input 
          x-model="filtro"
          @input="page = 1"
          placeholder="Buscar grupo o proyecto..."
          class="flex-1 min-w-[200px] px-4 py-2.5 border border-gray-300 rounded-xl text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-600 bg-white"
        >
        <input 
          x-model="filtroIntegrante"
          @input="page = 1"
          placeholder="Buscar integrante..."
          class="flex-1 min-w-[200px] px-4 py-2.5 border border-gray-300 rounded-xl text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-600 bg-white"
        >
      </div>
      
      <div class="flex items-center gap-2 mb-2">
        <label class="flex items-center gap-2 text-xs font-bold text-gray-700 cursor-pointer">
          <input type="checkbox" x-model="mostrarInactivos" class="w-4 h-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600">
          Mostrar inactivos
        </label>
      </div>

      <!-- Tabla (desktop) -->
      <div class="overflow-x-auto hidden md:block">
        <table class="w-full text-sm min-w-[640px]">
          <thead>
            <tr class="text-gray-600 text-left">
              <th class="px-2 py-2 font-bold cursor-pointer select-none hover:text-indigo-700" @click="toggleSort('id')">
                Grupo<span class="text-xs" x-text="sortIcon('id')"></span>
              </th>
              <th class="px-2 py-2 font-bold cursor-pointer select-none hover:text-indigo-700" @click="toggleSort('proyecto')">
                Proyecto<span class="text-xs" x-text="sortIcon('proyecto')"></span>
              </th>
              <th class="px-2 py-2 font-bold cursor-pointer select-none hover:text-indigo-700" @click="toggleSort('comision')">
                Comisión<span class="text-xs" x-text="sortIcon('comision')"></span>
              </th>
              <template x-for="enc in encuentrosMeta" :key="enc.id">
                <th class="px-1 py-2 font-bold text-center w-12 cursor-pointer select-none hover:text-indigo-700" @click="toggleSort(enc.id)">
                  <button @click.stop="selectEncuentro(enc.id)" class="text-indigo-700 font-bold hover:underline" x-text="enc.id"></button>
                  <span class="text-xs" x-text="sortIcon(enc.id)"></span>
                </th>
              </template>
              <th class="px-2 py-2 font-bold text-center cursor-pointer select-none hover:text-indigo-700" @click="toggleSort('promedio')">
                Prom.<span class="text-xs" x-text="sortIcon('promedio')"></span>
              </th>
              <th class="px-2 py-2 font-bold text-center w-10" x-show="canEdit"></th>
            </tr>
          </thead>
          <tbody>
            <template x-for="grupo in gruposPaginados" :key="grupo.id">
              <tr
                @click="selectGrupo(grupo.id)"
                class="bg-white cursor-pointer hover:bg-gray-50 transition shadow-sm border-b border-gray-100"
                :class="(grupo.activo === false ? 'opacity-50 grayscale' : '') + ' ' + (grupoAlertas(grupo.id).length > 0 ? (grupoAlertas(grupo.id).includes('riesgo') ? 'bg-amber-50' : 'bg-blue-50') : '')"
              >
                <td class="px-2 py-2.5 rounded-l-lg whitespace-nowrap">
                  <span class="text-gray-500 text-xs mr-1 font-bold" x-text="`G${grupo.id}`"></span>
                  <template x-for="alertaId in grupoAlertas(grupo.id)" :key="alertaId">
                    <span
                      class="inline-flex items-center justify-center w-5 h-5 rounded-full text-xs ml-0.5"
                      :class="alertaColor(alertaId)"
                      :title="alertaNombre(alertaId)"
                      x-text="alertaIcon(alertaId)"
                    ></span>
                  </template>
                  <span x-show="esTrasladado(grupo)" class="inline-flex items-center px-1.5 py-0.5 ml-0.5 rounded-md bg-purple-100 text-purple-700 text-[10px] font-bold" title="En Tutorías (trasladado desde PP3)">↔ Tutorías</span>
                </td>
                <td class="px-2 py-2.5 text-gray-900 font-bold" x-text="grupo.proyecto"></td>
                <td class="px-2 py-2.5 text-gray-700 font-medium" x-text="grupo.comision || '—'"></td>
                <template x-for="enc in encuentrosMeta" :key="enc.id">
                  <td class="px-1 py-2.5 text-center">
                    <span
                      class="inline-flex items-center justify-center min-w-[2.5rem] h-6 rounded-md text-xs font-bold"
                      :class="notaBadgeClass(calcNota(calcPct(data[enc.id]?.[grupo.id])))"
                      x-text="calcNota(calcPct(data[enc.id]?.[grupo.id]))"
                    ></span>
                    <span class="block text-[10px] text-gray-400 mt-0.5" x-text="calcPctStr(calcPct(data[enc.id]?.[grupo.id]))"></span>
                  </td>
                </template>
                <td class="px-2 py-2.5 text-center">
                  <span
                    class="inline-flex items-center justify-center min-w-[3rem] h-8 rounded-lg text-sm font-bold"
                    :class="notaBadgeClass(calcNota(promedioEncuentros(grupo.id)))"
                    x-text="calcNota(promedioEncuentros(grupo.id))"
                  ></span>
                  <span class="block text-[10px] text-gray-400 mt-0.5" x-text="calcPctStr(promedioEncuentros(grupo.id))"></span>
                </td>
                <td class="px-1 py-2.5 text-center rounded-r-lg" x-show="canEdit">
                  <button
                    @click.stop="selectedGrupo = grupo.id; openEditGrupoModal()"
                    class="w-8 h-8 inline-flex items-center justify-center rounded-lg text-gray-500 hover:text-indigo-700 hover:bg-indigo-50 transition"
                    title="Editar grupo"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                  </button>
                </td>
              </tr>
            </template>
          </tbody>
        </table>
      </div>

      <!-- Cards (mobile) -->
      <div class="md:hidden space-y-2">
        <template x-for="grupo in gruposPaginados" :key="grupo.id">
          <div
            class="bg-white rounded-xl border border-gray-200 shadow-sm p-3"
            :class="(grupo.activo === false ? 'opacity-50 grayscale' : '') + ' ' + (grupoAlertas(grupo.id).length > 0 ? (grupoAlertas(grupo.id).includes('riesgo') ? 'bg-amber-50' : 'bg-blue-50') : '')"
          >
            <div class="flex items-start gap-2" @click="selectGrupo(grupo.id)">
              <div class="flex-1 min-w-0">
                <div class="flex items-center flex-wrap gap-1">
                  <span class="text-gray-500 text-xs font-bold" x-text="`G${grupo.id}`"></span>
                  <span class="font-bold text-sm text-gray-900 truncate" x-text="grupo.proyecto"></span>
                </div>
                <div class="text-xs text-gray-600 font-medium mt-0.5" x-text="grupo.comision || '—'"></div>
                <div class="flex flex-wrap items-center gap-1 mt-1.5">
                  <template x-for="alertaId in grupoAlertas(grupo.id)" :key="alertaId">
                    <span
                      class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-md text-[10px] font-bold"
                      :class="alertaColor(alertaId)"
                      x-text="alertaIcon(alertaId) + ' ' + alertaNombre(alertaId)"
                    ></span>
                  </template>
                  <span x-show="esTrasladado(grupo)" class="inline-flex items-center px-1.5 py-0.5 rounded-md bg-purple-100 text-purple-700 text-[10px] font-bold">↔ En Tutorías (desde PP3)</span>
                </div>
              </div>
              <div class="text-center shrink-0">
                <span
                  class="inline-flex items-center justify-center min-w-[3rem] h-9 rounded-lg text-sm font-bold"
                  :class="notaBadgeClass(calcNota(promedioEncuentros(grupo.id)))"
                  x-text="calcNota(promedioEncuentros(grupo.id))"
                ></span>
                <span class="block text-[10px] text-gray-400 mt-0.5" x-text="calcPctStr(promedioEncuentros(grupo.id))"></span>
              </div>
            </div>
            <div class="flex items-center gap-2 mt-2.5 pt-2.5 border-t border-gray-100" x-show="canEdit">
              <button
                @click="selectGrupo(grupo.id)"
                class="flex-1 h-10 flex items-center justify-center gap-1.5 rounded-lg border border-gray-300 text-gray-700 text-xs font-bold hover:bg-gray-50"
              >
                Ver detalle
              </button>
              <button
                @click="selectedGrupo = grupo.id; openEditGrupoModal()"
                class="w-10 h-10 flex items-center justify-center rounded-lg border border-gray-300 text-gray-600 hover:bg-gray-50"
                title="Editar grupo"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
              </button>
              <button
                x-show="puedeTrasladarATutorias(grupo)"
                @click="abrirTraslado(grupo)"
                class="w-10 h-10 flex items-center justify-center rounded-lg border border-purple-200 bg-purple-50 text-purple-700 hover:bg-purple-100"
                title="Trasladar a Tutorías"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 1l4 4-4 4"/><path d="M3 11V9a4 4 0 014-4h14"/><path d="M7 23l-4-4 4-4"/><path d="M21 13v2a4 4 0 01-4 4H3"/></svg>
              </button>
              <button
                x-show="esTrasladado(grupo)"
                @click="abrirTraslado(grupo)"
                class="w-10 h-10 flex items-center justify-center rounded-lg border border-purple-200 bg-purple-50 text-purple-700 hover:bg-purple-100"
                title="Devolver a PP3"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 1l4 4-4 4"/><path d="M3 11V9a4 4 0 014-4h14"/><path d="M7 23l-4-4 4-4"/><path d="M21 13v2a4 4 0 01-4 4H3"/></svg>
              </button>
            </div>
          </div>
        </template>
      </div>

      <!-- Paginación -->
      <div class="flex flex-wrap items-center justify-between gap-3 mt-4 text-sm text-gray-600">
        <div class="flex items-center gap-2">
          <span>Mostrar</span>
          <template x-for="n in [10, 25, 50]" :key="n">
            <button 
              @click="setPerPage(n)"
              class="px-2 py-1 rounded text-xs font-bold transition"
              :class="perPage === n ? 'bg-indigo-700 text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'"
              x-text="n"
            ></button>
          </template>
        </div>
        <div x-text="`${paginationInfo.start}–${paginationInfo.end} de ${paginationInfo.total} grupos`"></div>
        <div class="flex items-center gap-1 overflow-x-auto max-w-full">
          <button 
            @click="page = Math.max(1, page - 1)"
            :disabled="page <= 1"
            class="px-3 py-1 rounded bg-gray-100 hover:bg-gray-200 disabled:opacity-40 disabled:cursor-not-allowed text-xs font-bold"
          >&larr; Anterior</button>
          <template x-for="p in Array.from({length: totalPages}, (_, i) => i + 1)" :key="p">
            <button 
              @click="page = p"
              class="w-8 h-8 rounded text-xs font-bold transition"
              :class="page === p ? 'bg-indigo-700 text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'"
              x-text="p"
            ></button>
          </template>
          <button 
            @click="page = Math.min(totalPages, page + 1)"
            :disabled="page >= totalPages"
            class="px-3 py-1 rounded bg-gray-100 hover:bg-gray-200 disabled:opacity-40 disabled:cursor-not-allowed text-xs font-bold"
          >Siguiente &rarr;</button>
        </div>
      </div>
    </div>

    <!-- VISTA ENCUENTROS LISTA -->
    <div x-show="view === 'encuentros' && !loadingData" x-transition>
      <h2 class="text-base font-bold text-gray-900 mb-3">Encuentros</h2>
      <div class="space-y-2">
        <template x-for="enc in encuentrosMeta" :key="enc.id">
          <button 
            @click="selectEncuentro(enc.id)"
            class="w-full bg-white rounded-xl p-4 text-left hover:shadow-md transition flex items-center gap-3 border border-gray-200"
          >
            <div class="w-10 h-10 rounded-xl bg-indigo-100 flex items-center justify-center font-bold text-indigo-700 text-sm" x-text="enc.id"></div>
            <div class="flex-1">
              <div class="font-bold text-sm text-gray-900" x-text="enc.nombre"></div>
              <div class="text-xs text-gray-500 italic" x-text="enc.pregunta"></div>
            </div>
            <div class="text-xs text-gray-500 font-bold" x-text="`${countGruposEvaluados(enc.id)} grupos`"></div>
            <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
          </button>
        </template>
      </div>
    </div>

    <!-- VISTA ESTADISTICAS -->
    <div x-show="view === 'stats' && !loadingData" x-transition x-effect="if(view==='stats') renderStats()">
      <h2 class="text-base font-bold text-gray-900 mb-3">Estadísticas Avanzadas</h2>
      
      <!-- Filtros -->
      <div class="bg-white rounded-xl p-3 mb-3 border border-gray-200 shadow-sm flex flex-wrap gap-2 items-center">
        <label class="text-xs font-bold text-gray-700">Comisión:</label>
        <select x-model="statsComisionFilter" class="px-2 py-1 text-xs border border-gray-300 rounded bg-white" @change="renderStats()">
          <option value="">Todas</option>
          <template x-for="c in comisiones" :key="c.id">
            <option :value="c.id" x-text="c.nombre"></option>
          </template>
        </select>
        
        <label class="text-xs font-bold text-gray-700 ml-2">Práctica:</label>
        <select x-model="statsPracticaFilter" class="px-2 py-1 text-xs border border-gray-300 rounded bg-white" @change="renderStats()">
          <option value="">Todas</option>
          <template x-for="p in practicasDeCarrera(carreraFilter)" :key="p.id">
            <option :value="p.codigo" x-text="p.nombre"></option>
          </template>
        </select>
        
        <label class="text-xs font-bold text-gray-700 ml-2">Encuentro:</label>
        <select x-model="statsEncuentroFilter" class="px-2 py-1 text-xs border border-gray-300 rounded bg-white" @change="renderStats()">
          <option value="">Todos</option>
          <template x-for="enc in statsEncuentros()" :key="enc.id">
            <option :value="enc.id" x-text="enc.id"></option>
          </template>
        </select>
      </div>
      
      <!-- Métricas resumen KPIs -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-3">
        <!-- Evaluados -->
        <div class="bg-white rounded-xl p-4 border border-gray-200 shadow-sm">
          <div class="flex items-start justify-between mb-2">
            <div>
              <div class="text-[10px] text-gray-500 font-bold uppercase tracking-wider">Grupos evaluados</div>
              <div class="text-3xl font-extrabold text-gray-900 leading-tight" x-text="statsResumen.evaluados"></div>
            </div>
            <div class="w-9 h-9 rounded-lg bg-indigo-50 flex items-center justify-center text-indigo-600">
