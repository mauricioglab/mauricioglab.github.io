---
// Pestañas del blog: Artículos | Zona Lab | Acerca de | Archivo | Buscar.
// «Zona Lab» es una sección del blog y solo aparece si el sitio la tiene activa (site_settings.sections.recursos).
import { getSettings } from '../../utils/portal-data';
import { normalizeBaseUrl } from '../../utils/blog';

const { sections } = await getSettings();
const base = normalizeBaseUrl(import.meta.env.BASE_URL);
const path = Astro.url.pathname;
const tabs = [
  { label: 'Artículos', href: `${base}blog/`, exact: true },
  ...(sections.recursos ? [{ label: 'Zona Lab', href: `${base}zona-lab/`, exact: false }] : []),
  { label: 'Acerca de', href: `${base}blog/about/`, exact: true },
  { label: 'Archivo', href: `${base}blog/archives/`, exact: true },
  { label: 'Buscar', href: `${base}blog/search/`, exact: true },
];
const isOn = (t: { href: string; exact: boolean }) => (t.exact ? path === t.href : path.startsWith(t.href));
---
<nav class="blog-tabs" aria-label="Secciones del blog">
  <ul>
    {tabs.map((t) => <li><a href={t.href} aria-current={isOn(t) ? 'page' : undefined}>{t.label}</a></li>)}
  </ul>
</nav>

<style is:global>
  .blog-tabs { background: #fff; border-bottom: 1px solid #e4e8f0; }
  .blog-tabs ul { max-width: 1140px; margin: 0 auto; padding: 0 20px; display: flex; flex-wrap: wrap; justify-content: center; list-style: none; }
  .blog-tabs a { display: block; padding: 16px 20px; font: 600 12px/1 Montserrat, system-ui, sans-serif; letter-spacing: .1em; text-transform: uppercase; color: #5c6785; text-decoration: none; border-bottom: 3px solid transparent; }
  .blog-tabs a:hover { color: #082D3A; }
  .blog-tabs a[aria-current="page"] { color: #082D3A; border-bottom-color: #16B6C9; }
</style>
