---
interface Props {
  url: string;
  type?: string;
}

const { url, type } = Astro.props;
const normalizedType = (type || '').toLowerCase();
const isOfficeDoc = normalizedType === 'ppt' || normalizedType === 'pptx';
const iframeSrc = isOfficeDoc
  ? `https://view.officeapps.live.com/op/embed.aspx?src=${encodeURIComponent(url)}`
  : url;
---

<div class="mb-8 rounded-xl overflow-hidden border border-[#e4e8f0] shadow-sm">
  <div class="relative w-full aspect-video bg-slate-100">
    <iframe
      src={iframeSrc}
      class="absolute inset-0 w-full h-full"
      frameborder="0"
      allowfullscreen
      loading="lazy"
      sandbox="allow-scripts allow-same-origin allow-popups"
    ></iframe>
  </div>
  <div class="px-4 py-2 bg-[#f7f9fc] text-right">
    <a
      href={url}
      target="_blank"
      rel="noopener"
      class="text-xs font-semibold text-vcl-turquesa hover:underline"
    >
      Abrir en una pestaña nueva ↗
    </a>
  </div>
</div>
