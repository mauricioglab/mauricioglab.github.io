---
import type { BlogPost } from '../../utils/blog';
import { normalizeBaseUrl } from '../../utils/blog';
import ReadingTime from './ReadingTime.astro';

interface Props {
  post: BlogPost;
  baseUrl?: string;
  /** i18n texts for the component */
  i18n?: {
    writtenBy?: string;
    readMore?: string;
    readingTimeUnit?: string;
  };
}

const {
  post,
  baseUrl = import.meta.env.BASE_URL,
  i18n = {}
} = Astro.props;

// Default translations (Spanish)
const texts = {
  writtenBy: i18n.writtenBy || 'Escrito por',
  readMore: i18n.readMore || 'Leer más',
  readingTimeUnit: i18n.readingTimeUnit || 'min de lectura',
};

const normalizedBase = normalizeBaseUrl(baseUrl);
const url = `${normalizedBase}blog/${post.slug}/`;
---

<article
  data-post-card
  data-title={post.title}
  data-description={post.description}
  data-categories={post.categories.join(' ')}
  class="post entry mb-[50px] pb-[50px] border-b border-[#e5e5e5] last:border-b-0"
  itemscope
  itemtype="https://schema.org/BlogPosting"
>
  <header class="entry-header mb-5">
    <h2 class="entry-title">
      <a class="entry-title-link hover:opacity-80" href={url} itemprop="headline">
        {post.title}
      </a>
    </h2>
    <p class="entry-meta">
      {texts.writtenBy} <span class="entry-author-name" itemprop="author">{post.author}</span>
      <time datetime={post.pubDate.toISOString()} itemprop="datePublished" class="hidden">{post.pubDate.toISOString()}</time>
      <ReadingTime content={post.body} unitText={texts.readingTimeUnit} />
    </p>
  </header>

  <div class="entry-content" itemprop="description">
    <p>{post.description}</p>
    <p><a href={url} class="more-link underline hover:opacity-80" aria-label={`${texts.readMore} ${post.title}`}>{texts.readMore}</a></p>
  </div>
</article>