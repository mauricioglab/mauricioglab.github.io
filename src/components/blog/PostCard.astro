---
import type { BlogPost } from '../../utils/blog';
import { normalizeBaseUrl } from '../../utils/blog';
import ReadingTime from './ReadingTime.astro';

interface Props {
  post: BlogPost;
  baseUrl?: string;
  /** Da al post el tratamiento "destacado" (card oscura petróleo/dorado) en vez de la card blanca estándar. */
  featured?: boolean;
  /** i18n texts for the component */
  i18n?: {
    writtenBy?: string;
    readMore?: string;
    readingTimeUnit?: string;
  };
}

const {
  post,
  baseUrl = import.meta.env.BASE_URL,
  featured = false,
  i18n = {}
} = Astro.props;

// Default translations (Spanish)
const texts = {
  writtenBy: i18n.writtenBy || 'Escrito por',
  readMore: i18n.readMore || 'Leer más',
  readingTimeUnit: i18n.readingTimeUnit || 'min de lectura',
};

const normalizedBase = normalizeBaseUrl(baseUrl);
const url = `${normalizedBase}blog/${post.slug}/`;
---

<article
  data-post-card
  data-title={post.title}
  data-description={post.description}
  data-categories={post.categories.join(' ')}
  class:list={[
    'post entry mb-4 rounded-2xl transition-shadow',
    featured
      ? 'p-5 md:p-6 shadow-lg'
      : 'p-4 md:p-5 bg-white border border-[#e4e8f0] border-l-4 border-l-vcl-turquesa shadow-sm hover:shadow-md',
  ]}
  style={featured ? 'background: linear-gradient(135deg, #082D3A 0%, #0A1E28 70%, #16B6C9 160%);' : undefined}
  itemscope
  itemtype="https://schema.org/BlogPosting"
>
  <header class="entry-header mb-2">
    {featured && (
      <span class="inline-block mb-2 text-[10px] font-semibold uppercase tracking-[0.12em] text-[#082D3A] bg-[#D4AF37] px-2.5 py-0.5 rounded-full">
        Último artículo
      </span>
    )}
    <h2 class:list={['entry-title !text-xl !mb-1', featured && '!text-white']}>
      <a class:list={['entry-title-link hover:opacity-80', featured && '!text-white hover:!text-vcl-cian']} href={url} itemprop="headline">
        {post.title}
      </a>
    </h2>
    <p class:list={['entry-meta', featured && '!text-vcl-cian/80']}>
      {texts.writtenBy} <span class="entry-author-name" itemprop="author">{post.author}</span>
      <time datetime={post.pubDate.toISOString()} itemprop="datePublished" class="hidden">{post.pubDate.toISOString()}</time>
      <ReadingTime content={post.body} unitText={texts.readingTimeUnit} />
    </p>
  </header>

  <div class:list={['entry-content !text-[15px] !leading-normal', featured && '!text-white/90']} itemprop="description">
    <p class:list={['line-clamp-2 !mb-2', featured && '!text-white/90']}>{post.description}</p>
    <p class="!mb-0"><a href={url} class:list={['more-link underline hover:opacity-80', featured && '!text-vcl-cian hover:!text-white']} aria-label={`${texts.readMore} ${post.title}`}>{texts.readMore}</a></p>
  </div>
</article>