---
import BaseTailwind from '@layouts/BaseTailwind.astro';
import CaseStudyModal from '@components/case-study/CaseStudyModal.astro';
import { getProjectsByProfile } from '@data/projects';
import { getLanguagePaths } from '@utils/i18n-paths';
import { type Lang, useTranslations, getAlternateUrl } from '@i18n/index';
import { isCompanyBuild, PERSONAL_ORIGIN } from '@data/site-target';
import { getProjectRows } from '@utils/portal-data';

export const getStaticPaths = getLanguagePaths;

const { lang } = Astro.params as { lang: Lang };
const content = await useTranslations<any>(lang, 'engineer');
const t = await useTranslations<any>(lang, 'portfolio');
const projectsT = await useTranslations<any>(lang, 'projects');
const modalT = await useTranslations<any>(lang, 'case-modal');
const altPath = getAlternateUrl(Astro.url, lang);
const altLang = lang === 'es' ? 'en' : 'es';

const projects = getProjectsByProfile('engineer', true);

// Agrupación por tipo de proyecto (los 3 pilares del posicionamiento)
const categoryLabels: Record<string, string> = {
  ia: lang === 'es' ? 'IA y Datos' : 'AI & Data',
  desarrollo: lang === 'es' ? 'Desarrollo y Arquitectura' : 'Development & Architecture',
  analisis: lang === 'es' ? 'Análisis de Sistemas' : 'Systems Analysis',
};
// En la empresa los grupos se nombran por servicio (no por "formación") y Mundial 2026 se muestra
// como análisis de datos. El dominio personal conserva su agrupación.
const companyLabels: Record<string, string> = {
  desarrollo: lang === 'es' ? 'Desarrollo de software' : 'Software development',
  ia: lang === 'es' ? 'IA y automatización' : 'AI & automation',
  analisis: lang === 'es' ? 'Análisis de datos y sistemas' : 'Data & systems analysis',
};
const companyCategoryOverride: Record<string, 'ia' | 'desarrollo' | 'analisis'> = { 'mundial-2026': 'analisis' };
const categoryOrder = isCompanyBuild ? (['desarrollo', 'ia', 'analisis'] as const) : (['ia', 'desarrollo', 'analisis'] as const);
const categoryOf = (p: { id: string; category?: string }) =>
  (isCompanyBuild && companyCategoryOverride[p.id]) || p.category || 'ia';
const projectGroups = categoryOrder
  .map((cat) => ({
    category: cat,
    label: isCompanyBuild ? companyLabels[cat] : categoryLabels[cat],
    items: projects.filter((p) => categoryOf(p) === cat),
  }))
  .filter((g) => g.items.length > 0);

// Portafolio personal: los proyectos salen de la base (con valores por defecto). Si no hay filas para el idioma, se usa el código.
const dbRows = isCompanyBuild ? [] : await getProjectRows(lang);
const personalGroups = dbRows.length
  ? [...new Set(dbRows.map((r) => r.category))].map((cat) => ({
      label: categoryLabels[cat] ?? cat,
      items: dbRows.filter((r) => r.category === cat).map((r) => ({ id: r.slug, title: r.title, description: r.summary, caseStudy: r.links?.caseStudy ?? null })),
    }))
  : projectGroups.map((g) => ({
      label: g.label,
      items: g.items.map((project) => {
        const p = projectsT[project.id];
        return { id: project.id, title: p?.title || project.id, description: p?.shortDescription || p?.profiles?.engineer?.description || '', caseStudy: project.links?.caseStudy ?? null };
      }),
    }));

const startDate = new Date('2021-07-01');
const years = Math.floor((Date.now() - startDate.getTime()) / (1000 * 60 * 60 * 24 * 365.25));

// Voz de estudio en el dominio empresa; voz personal en el dominio personal.
const copy = isCompanyBuild
  ? {
      seoTitle: t.company.seo.title,
      seoDescription: t.company.seo.description,
      badges: t.company.badges.map((b: string) => b.replace('{years}', String(years))),
      headlineMain: t.company.headlineMain,
      headlineAccent: t.company.headlineAccent,
      subheadline: t.company.subheadline,
      projectsNote: t.company.projectsNote as string | null,
      ctaTitle: t.company.ctaTitle,
      ctaDescription: t.company.ctaDescription,
    }
  : {
      seoTitle: t.seo.title,
      seoDescription: t.seo.description,
      badges: [
        `${years}+ ${lang === 'es' ? 'años de experiencia' : 'years of experience'}`,
        lang === 'es' ? 'IA en producción (RENAPER/AWS Rekognition)' : 'AI in production (RENAPER/AWS Rekognition)',
        lang === 'es' ? 'Docente en Ciencia de Datos e IA' : 'Instructor in Data Science & AI',
      ],
      headlineMain: content.hero.headlineMain,
      headlineAccent: content.hero.headlineAccent,
      subheadline: content.hero.subheadline,
      projectsNote: null as string | null,
      ctaTitle: content.ctaTitle,
      ctaDescription: content.ctaDescription,
    };

const modalLabels = {
  title: modalT.title,
  viewFull: modalT.viewFull,
  contact: modalT.contact,
  close: modalT.close,
  problem: modalT.problem,
  solution: modalT.solution,
};
// En la empresa se mezclan los textos `company` de cada caso y se agregan los links de demo/código.
const modalCases: Record<string, any> = {};
for (const project of projects) {
  const base = modalT.cases[project.id];
  if (!base) continue;
  const { company: companyOverride, ...rest } = base;
  const merged = isCompanyBuild ? { ...rest, ...(companyOverride || {}) } : rest;
  if (isCompanyBuild) {
    const demo = project.links.demo;
    merged.demo = demo && /^https?:/.test(demo) ? demo : null;
    merged.code = project.links.github || null;
  }
  modalCases[project.id] = merged;
}

const caseStudyUrls: Record<string, string | undefined> = {
  'validacion-biometrica': '/proyectos/validacion-biometrica',
  'billetera-virtual': '/proyectos/billetera-virtual',
  'monitoreo-agricola': '/proyectos/monitoreo-agricola',
  'auditorias-datos': '/proyectos/auditorias-datos',
  'coca-cola-embonor': '/proyectos/coca-cola-embonor',
  'mundial-2026': '/proyectos/mundial-2026',
  'abandono-estudiantil': '/proyectos/abandono-estudiantil',
  'caso-arquitectura': '/caso-arquitectura',
};

// Estas páginas no tienen versión en otro idioma: no llevan prefijo /es ni /en.
const singleLanguageCaseStudies = new Set(['caso-arquitectura']);

// Los casos /proyectos/<id> viven solo en el dominio personal (detalle técnico completo);
// caso-arquitectura también es solo del dominio personal (en la empresa se enlaza al origen personal).

// Stack técnico: cada tecnología con su slug oficial de Simple Icons (isologotipo)
// Los slugs sin logo se marcan con "" (chip de solo texto)
const skillGroups: { label: string; items: { name: string; slug: string }[] }[] = [
  {
    label: 'Backend',
    items: [
      { name: '.NET Core', slug: 'dotnet' },
      { name: 'C#', slug: 'csharp' },
      { name: 'ASP.NET', slug: 'dotnet' },
      { name: 'Entity Framework', slug: 'dotnet' },
      { name: 'Node.js', slug: 'nodedotjs' },
      { name: 'NestJS', slug: 'nestjs' },
    ],
  },
  {
    label: 'Frontend',
    items: [
      { name: 'Angular', slug: 'angular' },
      { name: 'TypeScript', slug: 'typescript' },
      { name: 'JavaScript', slug: 'javascript' },
      { name: 'React', slug: 'react' },
      { name: 'React Native', slug: 'react' },
    ],
  },
  {
    label: lang === 'es' ? 'IA y Datos' : 'AI & Data',
    items: [
      { name: 'Python', slug: 'python' },
      { name: 'Pandas', slug: 'pandas' },
      { name: 'NumPy', slug: 'numpy' },
      { name: 'scikit-learn', slug: 'scikitlearn' },
      { name: 'Streamlit', slug: 'streamlit' },
      { name: 'Plotly', slug: 'plotly' },
      { name: 'Power BI', slug: 'powerbi' },
      { name: 'AWS Rekognition', slug: 'amazonwebservices' },
      { name: 'SQL', slug: '' },
    ],
  },
  {
    label: lang === 'es' ? 'Cloud, DevOps & Arquitectura' : 'Cloud, DevOps & Architecture',
    items: [
      { name: 'AWS', slug: 'amazonwebservices' },
      { name: 'Docker', slug: 'docker' },
      { name: 'Amazon ECS', slug: 'amazonwebservices' },
      { name: 'CI/CD', slug: '' },
      { name: 'DDD / CQRS', slug: '' },
      { name: lang === 'es' ? 'Microservicios' : 'Microservices', slug: '' },
    ],
  },
  {
    label: lang === 'es' ? 'Idiomas' : 'Languages',
    items: [{ name: lang === 'es' ? 'Inglés B2 (intermedio alto)' : 'English B2 (upper-intermediate)', slug: '' }],
  },
];
---

<BaseTailwind title={copy.seoTitle} description={copy.seoDescription} lang={lang} layoutType="landing" current="portfolio" altHref={altPath}>
  <style>
    :root {
      --paper: #f4f6fa;
      --ink: #082d3a;
      --ink-soft: #5c6785;
      --ink-faint: #8b94ab;
      --line: #e4e8f0;
      --teal: #16b6c9;
      --teal-deep: #082d3a;
      --teal-tint: #e6fafc;
      --sand-deep: #0b6e7d;
      --font-head: 'Montserrat', system-ui, sans-serif;
      --font-body: 'Montserrat', system-ui, sans-serif;
    }
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--paper); color: var(--ink); font-family: var(--font-body); font-size: 16px; line-height: 1.65; -webkit-font-smoothing: antialiased; }
    h1, h2, h3, h4 { font-family: var(--font-head); line-height: 1.15; margin: 0; letter-spacing: -0.015em; font-weight: 600; }
    p { margin: 0; }
    a { color: inherit; text-decoration: none; }
    .wrap { width: 100%; max-width: 1080px; margin: 0 auto; padding: 0 28px; }
    .accent { color: var(--teal-deep); }

    /* Header */

    /* Hero */
    .pf-hero { padding: 72px 0 40px; text-align: center; }
    .pf-badges { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin-bottom: 26px; }
    .pf-badges span { font-family: var(--font-head); font-size: .72rem; font-weight: 600; letter-spacing: .04em; color: var(--teal-deep); background: var(--teal-tint); padding: 6px 14px; border-radius: 999px; }
    .pf-hero h1 { font-size: clamp(2rem, 5vw, 3.2rem); font-weight: 600; letter-spacing: -0.02em; max-width: 780px; margin: 0 auto; }
    .pf-hero p.sub { margin: 18px auto 0; max-width: 620px; color: var(--ink-soft); font-size: 1.05rem; line-height: 1.7; }
    .pf-trusted { margin-top: 28px; display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 8px 22px; font-size: .82rem; color: var(--ink-faint); }
    .pf-trusted .lbl { font-family: var(--font-head); font-size: .68rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-faint); }
    .pf-trusted .cl { font-weight: 600; color: var(--ink-soft); }
    .pf-hero .actions { margin-top: 32px; display: flex; flex-wrap: wrap; justify-content: center; gap: 14px; }
    .pf-btn-solid { display: inline-flex; align-items: center; gap: 8px; background: var(--teal-deep); color: #fff; font-weight: 600; font-size: .9rem; padding: 12px 22px; border-radius: 999px; transition: opacity .15s; }
    .pf-btn-solid:hover { opacity: .9; }
    .pf-btn-ghost { display: inline-flex; align-items: center; gap: 8px; color: var(--teal-deep); font-weight: 600; font-size: .9rem; padding: 11px 20px; border-radius: 999px; border: 1.5px solid var(--teal-deep); transition: background .15s, color .15s; }
    .pf-btn-ghost:hover { background: var(--teal-deep); color: #fff; }
    .rule { border: 0; border-top: 1px solid var(--line); margin: 40px 0 0; }

    /* Sections */
    .pf-section { padding: 56px 0; }
    .eyebrow { display: flex; align-items: baseline; gap: .85rem; margin-bottom: 1.6rem; }
    .eyebrow .num { font-family: var(--font-head); font-size: .74rem; font-weight: 700; color: var(--sand-deep); letter-spacing: .08em; }
    .eyebrow .label { font-family: var(--font-head); font-size: .78rem; font-weight: 600; text-transform: uppercase; letter-spacing: .18em; color: var(--teal-deep); }
    .eyebrow .label::before { content: ''; display: inline-block; width: 22px; height: 2px; background: var(--teal); vertical-align: middle; margin-right: .7rem; transform: translateY(-3px); }

    /* Projects grid */
    .pf-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    .pf-card {
      background: #fff; border: 1px solid var(--line); border-radius: 6px; padding: 24px;
      display: flex; flex-direction: column; gap: 12px; cursor: pointer; transition: transform .15s, box-shadow .15s, border-color .15s;
    }
    .pf-card:focus-visible { outline: 2px solid var(--accent, #16b6c9); outline-offset: 3px; }
    .pf-card:hover { transform: translateY(-2px); box-shadow: 0 18px 40px -22px rgba(8,45,58,.25); border-color: #a6e9f1; }
    .pf-card h3 { font-size: 1.08rem; font-weight: 600; color: var(--ink); }
    .pf-card p { font-size: .88rem; color: var(--ink-soft); line-height: 1.6; }
    .pf-card .tags { display: flex; flex-wrap: wrap; gap: 6px; }
    .pf-card .tags span { font-family: var(--font-head); font-size: .66rem; font-weight: 600; color: var(--teal-deep); background: var(--teal-tint); padding: 3px 9px; border-radius: 999px; }
    .pf-card .more { margin-top: auto; font-size: .82rem; font-weight: 600; color: var(--teal-deep); }
    .pf-card .more span { transition: transform .15s; display: inline-block; }
    .pf-card:hover .more span { transform: translateX(2px); }

    /* Grupos de proyectos por tipo */
    .pf-group { margin-bottom: 36px; }
    .pf-group:last-child { margin-bottom: 0; }
    .pf-group-title { font-family: var(--font-head); font-size: .82rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--teal-deep); margin: 0 0 14px; }

    /* Card destacada (caso de análisis, ancho completo) */
    .pf-card--featured {
      grid-column: 1 / -1;
      flex-direction: row; align-items: center; gap: 24px; padding: 28px;
      background: linear-gradient(135deg, #e6fafc, #f4f6fa);
    }
    .pf-card--featured .body { flex: 1; display: flex; flex-direction: column; gap: 10px; }
    .pf-card--featured h3 { font-size: 1.25rem; }
    .pf-card--featured p { font-size: .92rem; }
    .pf-card--featured .badge-featured {
      font-family: var(--font-head); font-size: .7rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase;
      color: #d4af37; background: #082d3a; border: 1px solid #082d3a; padding: 5px 12px; border-radius: 999px; width: fit-content;
    }
    .pf-card .badge-own {
      font-family: var(--font-head); font-size: .68rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase;
      color: var(--teal-deep); background: #e6fafc; padding: 4px 10px; border-radius: 999px; width: fit-content;
    }
    @media (max-width: 820px) {
      .pf-card--featured { flex-direction: column; align-items: flex-start; }
    }

    /* Skills */
    .pf-skills { border-top: 1px solid var(--line); }
    .pf-skill-row { display: grid; grid-template-columns: 180px 1fr; gap: 2.2rem; padding: 1.15rem 0; border-top: 1px solid var(--line); }
    .pf-skill-row:first-child { border-top: 0; }
    .pf-skill-row .label { font-family: var(--font-head); font-size: .78rem; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--sand-deep); padding-top: .35rem; }
    .pf-skill-row .vals { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
    .pf-skill {
      display: inline-flex; align-items: center; gap: 8px;
      background: #fff; border: 1px solid var(--line); border-radius: 999px;
      padding: 7px 14px; font-size: .85rem; color: var(--ink);
      transition: border-color .15s;
    }
    .pf-skill:hover { border-color: #a6e9f1; }
    .pf-skill .logo {
      width: 16px; height: 16px; flex-shrink: 0; display: inline-block;
    }
    .pf-skill .logo img { width: 100%; height: 100%; display: block; }

    /* CTA final */
    .pf-final { padding: 56px 0 60px; }
    .pf-final .box { background: var(--ink); color: #fff; border-radius: 14px; padding: 48px 36px; text-align: center; }
    .pf-final h2 { font-size: 1.7rem; font-weight: 600; margin-bottom: 10px; }
    .pf-final p { color: #b9b4a6; margin-bottom: 26px; }
    .pf-final .actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 14px; }
    .pf-final .a-solid { background: var(--teal); color: #fff; font-weight: 600; padding: 12px 22px; border-radius: 999px; transition: opacity .15s; }
    .pf-final .a-solid:hover { opacity: .9; }

    /* Variante personal: misma plantilla editorial que Inicio, Sobre mí y Contáctame (paleta Velocity, Raleway, 750/1006 px). */
    :global(body:has(.pf-personal)) { background: #fff; }
    .pf-personal { --paper: #fff; --ink: #082D3A; --ink-soft: #5c6785; --teal: #16B6C9; --teal-deep: #0b6e7d; --teal-tint: #e6fafc; --line: #ccc; --sand-deep: #0b6e7d; --font-head: Raleway, Montserrat, system-ui, sans-serif; font-weight: 300; font-size: 16.6667px; }
    @media (min-width: 900px) { .pf-personal { font-size: 20px; } }
    .pf-personal .wrap { max-width: 1038px; padding: 0 16px; }
    .pf-personal .pf-hero { padding: 48px 0 24px; }
    .pf-personal .pf-hero h1 { font-family: var(--font-head); font-weight: 300; letter-spacing: 0; font-size: clamp(2.2rem, 7vw, 59.7px); line-height: 1.1; max-width: 782px; }
    .pf-personal .pf-hero p.sub { color: #082D3A; font-size: 1em; line-height: 1.6; max-width: 750px; }
    .pf-personal .pf-badges span { border-radius: 0; background: transparent; border: 1px solid #0b6e7d; color: #0b6e7d; font-family: Montserrat, system-ui, sans-serif; }
    .pf-personal h1, .pf-personal h2, .pf-personal h3 { font-family: var(--font-head); letter-spacing: 0; }
    .pf-personal .pf-btn-solid, .pf-personal .pf-btn-ghost { border-radius: 5px; border: 1px solid #0b6e7d; min-height: 57px; padding: 0 28px; font-size: 16.6667px; font-weight: 700; }
    .pf-personal .pf-btn-solid { background: #0b6e7d; color: #fff; }
    .pf-personal .pf-btn-ghost { color: #0b6e7d; background: transparent; }
    .pf-personal .pf-btn-ghost:hover { background: #0b6e7d; color: #fff; }
    .pf-personal .pf-card { border-radius: 0; border: 1px solid #ccc; box-shadow: none; }
    .pf-personal .pf-card:hover { transform: none; box-shadow: none; border-color: #0b6e7d; }
    .pf-personal .pf-card h3 { font-weight: 700; font-size: 1.2em; }
    .pf-personal .pf-card p { font-size: .83em; color: #5c6785; }
    .pf-personal .pf-card .tags span, .pf-personal .pf-card .badge-own { border-radius: 0; color: #0b6e7d; background: #e6fafc; }
    .pf-personal .pf-card--featured { background: #e6fafc; }
    .pf-personal .pf-card--featured .badge-featured { background: #0b6e7d; border-color: #0b6e7d; color: #fff; border-radius: 0; }
    .pf-personal .pf-card .more { color: #0b6e7d; }
    .pf-personal .pf-skill { border-radius: 0; border-color: #ccc; }
    .pf-personal .pf-final .box { background: #0A1E28; border-radius: 0; }
    .pf-personal .pf-final .a-solid { background: #0b6e7d; border-radius: 5px; }

    @media (max-width: 820px) {
      .pf-grid { grid-template-columns: 1fr; }
      .pf-skill-row { grid-template-columns: 1fr; gap: .4rem; }
      .pf-hero { padding-top: 52px; }
    }
  </style>

  {!isCompanyBuild ? (
    <div class="pt">
      <h1 class="pt-page-title">{lang === 'es' ? 'Portafolio' : 'Portfolio'}</h1>
      <div class="pt-folio" id="proyectos">
        <p>{content.projectsDescription}</p>
        {personalGroups.map((group) => (
          <section>
            <p class="pt-folio-group"><strong>{group.label}</strong></p>
            <ul>
              {group.items.map((item) => {
                const caseStudyPath = caseStudyUrls[item.id] ?? item.caseStudy;
                const caseStudyUrl = caseStudyPath
                  ? (singleLanguageCaseStudies.has(item.id) ? caseStudyPath : `/${lang}${caseStudyPath}`)
                  : null;
                const hasModal = !!modalCases[item.id];
                return (
                  <li>
                    {hasModal || caseStudyUrl ? (
                      <a class="pt-link-gold pt-folio-link" href={caseStudyUrl || '#proyectos'} data-case={hasModal ? item.id : undefined} data-case-full={caseStudyUrl || ''} aria-haspopup={hasModal ? 'dialog' : undefined}>{item.title}</a>
                    ) : (
                      <strong>{item.title}</strong>
                    )}
                    {item.description && <span> · {item.description}</span>}
                  </li>
                );
              })}
            </ul>
          </section>
        ))}
        <blockquote class="pt-quote"><p>{lang === 'es' ? 'Entender los fundamentos, comprobar los resultados y usar la IA con criterio.' : 'Understand the fundamentals, check the results and use AI with judgment.'}</p></blockquote>
        <div class="pt-folio-shot"><div class="pt-ph">{lang === 'es' ? 'Imagen de proyecto pendiente' : 'Project image pending'}</div></div>
        <section id="skills">
          <p class="pt-folio-group"><strong>{lang === 'es' ? 'Stack técnico' : 'Tech stack'}</strong></p>
          <ul>
            {skillGroups.map((group) => (
              <li><strong>{group.label}:</strong> {group.items.map((i) => i.name).join(' · ')}</li>
            ))}
          </ul>
        </section>
        <p class="pt-folio-end"><a class="pt-link-gold" href="/es/contacto/">{lang === 'es' ? 'Contáctame' : 'Contact me'}</a> · <a class="pt-link-gold" href={`/${lang}/disertaciones/`}>{lang === 'es' ? 'Disertaciones' : 'Talks'}</a></p>
      </div>
    </div>
  ) : (
  <div class:list={['pf-root', { 'pf-personal': !isCompanyBuild }]}>
    <!-- Hero -->
    <section class="pf-hero">
      <div class="wrap">
        <div class="pf-badges">
          {copy.badges.map((b: string) => <span>{b}</span>)}
        </div>
        <h1>{copy.headlineMain} <span class="accent">{copy.headlineAccent}</span>.</h1>
        <p class="sub">{copy.subheadline}</p>
        <div class="pf-trusted">
          <span class="lbl">{lang === 'es' ? 'Proyectos para' : 'Projects for'}</span>
          <span class="cl">Coca-Cola Embonor</span>
          <span class="cl">Renaseg (SSN)</span>
          <span class="cl">{lang === 'es' ? 'Agencia de Sistemas de Información' : 'Information Systems Agency'}</span>
        </div>
        <div class="actions">
          <a class="pf-btn-solid" href="#proyectos">{lang === 'es' ? 'Ver proyectos' : 'View projects'}</a>
          <a class="pf-btn-ghost" href={`/${lang}/disertaciones/`}>{lang === 'es' ? 'Disertaciones' : 'Talks'}</a>
          <button class="pf-btn-ghost" data-contact-trigger>{lang === 'es' ? 'Contactar' : 'Contact'}</button>
        </div>
        <hr class="rule" />
      </div>
    </section>

    <!-- Proyectos -->
    <section class="pf-section" id="proyectos">
      <div class="wrap">
        <div class="eyebrow"><span class="num">01</span><span class="label">{t.projectsLabel}</span></div>
        <p style="color:var(--ink-soft);max-width:62ch;margin-bottom:1.6rem">{content.projectsDescription}{copy.projectsNote ? ` ${copy.projectsNote}` : ''}</p>
        {projectGroups.map((group) => (
          <div class="pf-group">
            <h3 class="pf-group-title">{group.label}</h3>
            <div class="pf-grid">
              {group.items.map((project) => {
                const p = projectsT[project.id];
                const profile = project.profiles['engineer'];
                const title = p?.title || project.id;
                const shortDescription = p?.shortDescription || p?.profiles?.engineer?.description || '';
                const caseStudyPath = caseStudyUrls[project.id];
                const caseStudyUrl = caseStudyPath
                  ? (singleLanguageCaseStudies.has(project.id)
                      ? (isCompanyBuild ? `${PERSONAL_ORIGIN}${caseStudyPath}` : caseStudyPath)
                      : (isCompanyBuild ? `${PERSONAL_ORIGIN}/${lang}${caseStudyPath}` : `/${lang}${caseStudyPath}`))
                  : null;
                const isFeaturedCard = !isCompanyBuild && project.category === 'analisis';
                const hasLiveDemo = isCompanyBuild && /^https?:/.test(project.links.demo || '');
                return (
                  <div class:list={['pf-card', isFeaturedCard && 'pf-card--featured']} data-case={project.id} data-case-full={caseStudyUrl || ''} role="button" tabindex="0" aria-haspopup="dialog">
                    <div class="body">
                      {hasLiveDemo && <span class="badge-own">{modalT.company.own}</span>}
                      {isFeaturedCard && <span class="badge-featured">{lang === 'es' ? 'Caso de estudio · 14 capítulos' : 'Case study · 14 chapters'}</span>}
                      <h3>{title}</h3>
                      <p>{shortDescription}</p>
                      <div class="tags">
                        {profile.tags.map((tag: string) => <span>{tag}</span>)}
                      </div>
                      <div class="more">{lang === 'es' ? 'Ver resumen' : 'View summary'} <span>→</span></div>
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Skills -->
    <section class="pf-section" id="skills">
      <div class="wrap">
        <div class="eyebrow"><span class="num">02</span><span class="label">{lang === 'es' ? 'Stack técnico' : 'Tech stack'}</span></div>
        <div class="pf-skills">
          {skillGroups.map((group) => (
            <div class="pf-skill-row">
              <div class="label">{group.label}</div>
              <div class="vals">
                {group.items.map((item) => (
                  <span class="pf-skill">
                    {item.slug && (
                      <span class="logo">
                        <img src={`https://cdn.jsdelivr.net/npm/simple-icons@latest/icons/${item.slug}.svg`} alt="" width="16" height="16" loading="lazy" />
                      </span>
                    )}
                    {item.name}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA final -->
    <section class="pf-final">
      <div class="wrap">
        <div class="box">
          <h2>{copy.ctaTitle}</h2>
          <p>{copy.ctaDescription}</p>
          <div class="actions">
            <button class="a-solid" data-contact-trigger>{lang === 'es' ? 'Contactar' : 'Contact'}</button>
          </div>
        </div>
      </div>
    </section>
  </div>
  )}

  <CaseStudyModal lang={lang} cases={modalCases} labels={modalLabels} company={isCompanyBuild ? modalT.company : null} />

  <script is:inline>
    document.addEventListener('click', function (e) {
      var card = e.target.closest('.pf-card[data-case], .pt-folio-link[data-case]');
      if (!card) return;
      e.preventDefault();
      window.openCaseModal(card.getAttribute('data-case'), card.getAttribute('data-case-full'));
    });
    document.addEventListener('keydown', function (e) {
      if (e.key !== 'Enter' && e.key !== ' ') return;
      var card = e.target.closest && e.target.closest('.pf-card[data-case]');
      if (!card || e.target !== card) return;
      e.preventDefault();
      window.openCaseModal(card.getAttribute('data-case'), card.getAttribute('data-case-full'));
    });
  </script>
</BaseTailwind>
