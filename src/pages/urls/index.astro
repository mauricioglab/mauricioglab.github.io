---
import BaseTailwind from '../../layouts/BaseTailwind.astro';

export const prerender = true;

const base = import.meta.env.BASE_URL;
const b = base.endsWith("/") ? base : `${base}/`;

const urlCategories = [
	{
		title: "🛠️ DESARROLLO Y PROGRAMACIÓN",
		subcategories: [
			{
				name: "IDEs y Editores de Código",
				items: [
					{ name: "Visual Studio Code", url: "https://code.visualstudio.com/", winget: "winget install Microsoft.VisualStudioCode" },
					{ name: "PyCharm 2025.1", url: "https://www.jetbrains.com/pycharm/download/", winget: "winget install JetBrains.PyCharm.Community" },
					{ name: "Microsoft Visual Studio Community 2022", url: "https://visualstudio.microsoft.com/", winget: "winget install Microsoft.VisualStudio.2022.Community" },
					{ name: "Notepad++", url: "https://notepad-plus-plus.org/", winget: "winget install Notepad++.Notepad++" },
					{ name: "Kate", url: "https://kate-editor.org/", winget: "winget install KDE.Kate" },
					{ name: "Bambu Studio", url: "https://bambulab.com/en/download/studio", winget: "winget install BambuLab.BambuStudio" }
				]
			},
			{
				name: "Herramientas de Desarrollo con IA",
				items: [
					{ name: "Cursor", url: "https://cursor.sh/", winget: "winget install Cursor.Cursor" },
					{ name: "Windsurf", url: "https://codeium.com/windsurf", winget: "winget install Codeium.Windsurf" },
					{ name: "Kiro", url: "https://kiro.app/", winget: "" },
					{ name: "Codeium", url: "https://codeium.com/", winget: "" },
					{ name: "Tabnine", url: "https://www.tabnine.com/", winget: "" },
					{ name: "GitHub Copilot", url: "https://github.com/features/copilot", winget: "" },
					{ name: "Amazon CodeWhisperer", url: "https://aws.amazon.com/codewhisperer/", winget: "" }
				]
			},
			{
				name: "Terminales y Shells",
				items: [
					{ name: "Warp", url: "https://www.warp.dev/", winget: "winget install warp.warp" },
					{ name: "Oh My Posh", url: "https://ohmyposh.dev/", winget: "winget install JanDeDobbeleer.OhMyPosh" },
					{ name: "starship", url: "https://starship.rs/", winget: "winget install Starship.Starship" }
				]
			},
			{
				name: "Control de Versiones",
				items: [
					{ name: "Git", url: "https://git-scm.com/", winget: "winget install Git.Git" },
					{ name: "TortoiseGit", url: "https://tortoisegit.org/", winget: "winget install TortoiseGit.TortoiseGit" }
				]
			},
			{
				name: "Lenguajes y Runtimes",
				items: [
					{ name: "Node.js LTS", url: "https://nodejs.org/", winget: "winget install OpenJS.NodeJS.LTS" },
					{ name: "Python 3.12.8", url: "https://www.python.org/", winget: "winget install Python.Python.3.12" },
					{ name: "Java SE Development Kit 21", url: "https://www.oracle.com/java/technologies/downloads/", winget: "winget install Oracle.JDK.21" },
					{ name: "Bun", url: "https://bun.sh/", winget: "winget install Oven-sh.Bun" },
					{ name: "Microsoft .NET SDK 9.0", url: "https://dotnet.microsoft.com/", winget: "winget install Microsoft.DotNet.SDK.9" },
					{ name: "XAMPP", url: "https://www.apachefriends.org/", winget: "winget install ApacheFriends.Xampp" }
				]
			}
		]
	},
	{
		title: "🗄️ BASES DE DATOS",
		items: [
			{ name: "MySQL Server 8.0", url: "https://dev.mysql.com/downloads/mysql/", winget: "winget install Oracle.MySQL" },
			{ name: "MySQL Workbench 8.0 CE", url: "https://dev.mysql.com/downloads/workbench/", winget: "winget install Oracle.MySQLWorkbench" },
			{ name: "PostgreSQL 18", url: "https://www.postgresql.org/download/", winget: "winget install PostgreSQL.PostgreSQL" },
			{ name: "Microsoft SQL Server 2022", url: "https://www.microsoft.com/sql-server/", winget: "winget install Microsoft.SQLServer.2022.Developer" },
			{ name: "SQL Server Management Studio", url: "https://aka.ms/ssmsfullsetup", winget: "winget install Microsoft.SQLServerManagementStudio" },
			{ name: "DB Browser for SQLite", url: "https://sqlitebrowser.org/", winget: "winget install DBBrowserForSQLite.DBBrowserForSQLite" },
			{ name: "SQLiteStudio", url: "https://sqlitestudio.pl/", winget: "winget install SQLiteStudio.SQLiteStudio" },
			{ name: "DBeaver", url: "https://dbeaver.io/", winget: "winget install dbeaver.dbeaver" }
		]
	},
	{
		title: "🐳 CONTENEDORES Y VIRTUALIZACIÓN",
		items: [
			{ name: "Docker Desktop", url: "https://www.docker.com/products/docker-desktop/", winget: "winget install Docker.DockerDesktop" }
		]
	},
	{
		title: "🌐 NAVEGADORES WEB",
		items: [
			{ name: "Google Chrome", url: "https://www.google.com/chrome/", winget: "winget install Google.Chrome" },
			{ name: "Brave", url: "https://brave.com/", winget: "winget install Brave.Brave" },
			{ name: "Brave Beta", url: "https://brave.com/download/", winget: "winget install Brave.Brave.Beta" },
			{ name: "Zen Browser", url: "https://zen-browser.app/", winget: "winget install Zen-Team.Zen-Browser" }
		]
	},
	{
		title: "💬 COMUNICACIÓN Y COLABORACIÓN",
		items: [
			{ name: "Discord", url: "https://discord.com/", winget: "winget install Discord.Discord" },
			{ name: "Telegram for Windows", url: "https://desktop.telegram.org/", winget: "winget install Telegram.TelegramDesktop" },
			{ name: "WhatsApp", url: "https://www.whatsapp.com/download", winget: "winget install WhatsApp.WhatsApp" },
			{ name: "Microsoft Teams", url: "https://www.microsoft.com/microsoft-teams/", winget: "winget install Microsoft.Teams" },
			{ name: "Slack", url: "https://slack.com/downloads/", winget: "winget install SlackTechnologies.Slack" },
			{ name: "Zoom Workplace", url: "https://zoom.us/download", winget: "winget install Zoom.Zoom" }
		]
	},
	{
		title: "🛠️ UTILIDADES DEL SISTEMA",
		items: [
			{ name: "PowerToys", url: "https://github.com/microsoft/PowerToys", winget: "winget install Microsoft.PowerToys" },
			{ name: "7-Zip", url: "https://www.7-zip.org/", winget: "winget install 7zip.7zip" },
			{ name: "WinMerge", url: "https://winmerge.org/", winget: "winget install WinMerge.WinMerge" },
			{ name: "TreeSize Free", url: "https://www.jam-software.com/treesize_free", winget: "winget install JAMSoftware.TreeSize.Free" },
			{ name: "BCUninstaller", url: "https://www.bcuninstaller.com/", winget: "winget install Klocman.BulkCrapUninstaller" },
			{ name: "AnyDesk", url: "https://anydesk.com/", winget: "winget install AnyDesk.AnyDesk" },
			{ name: "PuTTY", url: "https://www.putty.org/", winget: "winget install PuTTY.PuTTY" },
			{ name: "TigerVNC", url: "https://tigervnc.org/", winget: "winget install TigerVNC.TigerVNC" },
			{ name: "SpeedCrunch", url: "https://heldercorreia.bitbucket.io/speedcrunch/", winget: "winget install SpeedCrunch.SpeedCrunch" },
			{ name: "Greenshot", url: "https://getgreenshot.org/", winget: "winget install Greenshot.Greenshot" },
			{ name: "Raycast", url: "https://www.raycast.com/", winget: "winget install Raycast.Raycast" }
		]
	},
	{
		title: "☁️ ALMACENAMIENTO EN LA NUBE",
		items: [
			{ name: "Dropbox", url: "https://www.dropbox.com/", winget: "winget install Dropbox.Dropbox" },
			{ name: "MEGAsync", url: "https://mega.nz/sync", winget: "winget install Mega.MEGAsync" },
			{ name: "Microsoft OneDrive", url: "https://www.microsoft.com/microsoft-365/onedrive/", winget: "(Pre-instalado en Windows)" },
			{ name: "Box", url: "https://www.box.com/", winget: "winget install Box.Box" }
		]
	},
	{
		title: "🎨 DISEÑO Y MULTIMEDIA",
		items: [
			{ name: "Obsidian", url: "https://obsidian.md/", winget: "winget install Obsidian.Obsidian" },
			{ name: "PotPlayer", url: "https://potplayer.daum.net/", winget: "winget install Daum.PotPlayer" },
			{ name: "OBS Studio", url: "https://obsproject.com/", winget: "winget install OBSProject.OBSStudio" },
			{ name: "Scanner X - PDF Scanner", url: "https://www.microsoft.com/store/apps/9N438MZHD3ZF", winget: "(Aplicación de Microsoft Store)" }
		]
	},
	{
		title: "📡 API Y TESTING",
		items: [
			{ name: "Postman", url: "https://www.postman.com/", winget: "winget install Postman.Postman" }
		]
	},
	{
		title: "🖥️ HARDWARE Y DRIVERS",
		items: [
			{ name: "HWiNFO", url: "https://www.hwinfo.com/", winget: "winget install REALiX.HWiNFO" },
			{ name: "DisplayLink Graphics", url: "https://www.synaptics.com/products/displaylink-graphics", winget: "(Driver específico)" },
			{ name: "AMD Software", url: "https://www.amd.com/support", winget: "winget install AMD.AMDSoftware" },
			{ name: "HuionTablet", url: "https://www.huion.com/download/", winget: "(Driver específico del fabricante)" },
			{ name: "Lenovo Vantage", url: "https://www.microsoft.com/store/apps/9WZDNCRFJ4MV", winget: "winget install Lenovo.Vantage" },
			{ name: "HP Smart", url: "https://www.hp.com/us-en/solutions/hp-smart-app.html", winget: "winget install HP.HPSmart" }
		]
	},
	{
		title: "📝 PRODUCTIVIDAD",
		items: [
			{ name: "Power BI Desktop", url: "https://powerbi.microsoft.com/desktop/", winget: "winget install Microsoft.PowerBI" },
			{ name: "Microsoft Whiteboard", url: "https://www.microsoft.com/microsoft-365/microsoft-whiteboard/", winget: "winget install Microsoft.Whiteboard" },
			{ name: "Microsoft PC Manager", url: "https://www.microsoft.com/windows/pc-manager", winget: "winget install Microsoft.PCManager" },
			{ name: "Logi Options+", url: "https://www.logitech.com/software/logi-options-plus.html", winget: "winget install Logitech.OptionsPlus" },
			{ name: "Divvy (Gestor de ventanas)", url: "https://mizage.com/divvy/", winget: "" }
		]
	}
];
---

<BaseTailwind title="URLs útiles — MG Lab" description="URLs útiles">
	<main class="bg-[#f4f6fa] text-[#141a2e]">
		<div class="max-w-6xl mx-auto px-4 sm:px-6 py-6">
			<header class="mb-5">
				<h1 class="text-2xl sm:text-3xl font-semibold tracking-tight text-[#141a2e]">URLs útiles</h1>
				<p class="text-[#5c6785] text-xs mt-1">Dev tools, runtimes y utilidades que uso a diario.</p>
			</header>

			{
				urlCategories.map((category) => (
					<section class="mb-5 bg-white border border-[#e4e8f0] rounded-lg p-4">
						<h2 class="text-base font-semibold mb-3 text-[#1e40af] border-b border-[#e4e8f0] pb-1.5">{category.title}</h2>

						{category.subcategories ? (
							<div class="space-y-4">
								{
									category.subcategories.map((subcategory) => (
										<div>
											<h3 class="text-xs font-semibold mb-2 text-[#5c6785] uppercase tracking-wide">{subcategory.name}</h3>
											<div class="grid gap-2 grid-cols-2 sm:grid-cols-3 lg:grid-cols-4">
												{
													subcategory.items.map((item) => (
														<div class="border border-[#e4e8f0] rounded-md p-2.5 hover:border-blue-300 hover:shadow-sm transition-all bg-white">
															<div class="flex flex-col space-y-1">
																<a
																	href={item.url}
																	target="_blank"
																	rel="noopener noreferrer"
																	class="text-[#1e40af] hover:text-[#1d4ed8] hover:underline text-sm font-medium leading-tight"
																>
																	{item.name}
																</a>
																{item.winget && (
																	<code class="text-[0.65rem] bg-[#eef2ff] px-1.5 py-0.5 rounded text-[#1e40af] font-mono inline-block w-fit truncate max-w-full">
																		{item.winget}
																	</code>
																)}
															</div>
														</div>
													))
												}
											</div>
										</div>
									))
								}
							</div>
						) : (
							<div class="grid gap-2 grid-cols-2 sm:grid-cols-3 lg:grid-cols-4">
								{
									category.items.map((item) => (
										<div class="border border-[#e4e8f0] rounded-md p-2.5 hover:border-blue-300 hover:shadow-sm transition-all bg-white">
											<div class="flex flex-col space-y-1">
												<a
													href={item.url}
													target="_blank"
													rel="noopener noreferrer"
													class="text-[#1e40af] hover:text-[#1d4ed8] hover:underline text-sm font-medium leading-tight"
												>
													{item.name}
												</a>
												{item.winget && (
													<code class="text-[0.65rem] bg-[#eef2ff] px-1.5 py-0.5 rounded text-[#1e40af] font-mono inline-block w-fit truncate max-w-full">
														{item.winget}
													</code>
												)}
											</div>
										</div>
									))
								}
							</div>
						)}
					</section>
				))
			}

			<div class="mt-6 pt-4 border-t border-[#e4e8f0]">
				<p>
					<small><a href={b} class="text-[#5c6785] hover:text-[#1e40af] transition-colors">← Inicio</a></small>
				</p>
			</div>
		</div>
	</main>
</BaseTailwind>
