---
import BaseTailwind from '../../layouts/BaseTailwind.astro';
import SeoHead from '@components/shared/SeoHead.astro';
import { getRecursos, formatFecha } from '../../utils/recursos';
import { createMarkdownProcessor } from '@astrojs/markdown-remark';

export const prerender = true;

export async function getStaticPaths() {
  const recursos = await getRecursos();
  return recursos.map((r) => ({ params: { slug: r.slug }, props: { r } }));
}

const { r } = Astro.props;
const markdownProcessor = await createMarkdownProcessor({
  syntaxHighlight: 'shiki',
  shikiConfig: { theme: 'github-light', wrap: true },
});
const { code: contentHtml } = await markdownProcessor.render(r.body);
const canonical = new URL(`/zona-lab/${r.slug}/`, Astro.site).toString();
const isVideo = r.sourceType === 'youtube';
---

<BaseTailwind title={`${r.title} — Zona Lab | MG Lab`} description={r.description} lang="es" layoutType="landing">
  <SeoHead slot="head" title={`${r.title} — Zona Lab | MG Lab`} description={r.description} lang="es" canonical={canonical} />

  <style>
    :root {
      --accent: #1d4ed8;
      --accent-deep: #1e40af;
      --accent-soft: #eef2ff;
      --ink: #141a2e;
      --muted: #5c6785;
      --faint: #8b94ab;
      --line: #e4e8f0;
      --panel: #f4f6fa;
      --font-head: 'Space Grotesk', 'Inter', system-ui, sans-serif;
      --font-body: 'Inter', system-ui, sans-serif;
    }
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--panel); color: var(--ink); font-family: var(--font-body); font-size: 16px; line-height: 1.65; -webkit-font-smoothing: antialiased; }
    h1, h2, h3, h4 { font-family: var(--font-head); line-height: 1.15; margin: 0; letter-spacing: -0.02em; font-weight: 600; }
    p { margin: 0; }
    a { color: inherit; text-decoration: none; }

    .zl-header {
      position: sticky; top: 0; z-index: 50;
      background: rgba(255,255,255,.92); backdrop-filter: saturate(1.4) blur(8px);
      border-bottom: 1px solid var(--line);
    }
    .zl-header .row { max-width: 1000px; margin: 0 auto; padding: 14px 28px; display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
    .zl-brand { font-family: var(--font-head); font-weight: 600; font-size: .95rem; color: var(--ink); letter-spacing: .02em; }
    .zl-brand b { color: var(--accent); }
    .zl-nav { display: flex; align-items: center; gap: .9rem; }
    .zl-nav a { color: var(--muted); font-size: .85rem; padding: 6px 10px; border-radius: 8px; transition: color .15s; }
    .zl-nav a:hover { color: var(--ink); background: var(--panel); }

    .zl-main { max-width: 820px; margin: 0 auto; padding: 48px 28px 72px; }

    .zl-crumbs { font-family: var(--font-head); font-size: .78rem; font-weight: 600; color: var(--muted); margin-bottom: 16px; }
    .zl-crumbs a:hover { color: var(--accent-deep); }

    .zl-meta {
      font-family: var(--font-head); font-size: .74rem; font-weight: 600; letter-spacing: .05em; text-transform: uppercase;
      color: var(--accent-deep); display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 14px;
    }
    .zl-type { color: #fff; background: var(--accent-deep); border-radius: 999px; padding: 3px 12px; }

    .zl-title { font-size: clamp(1.9rem, 4.4vw, 2.6rem); font-weight: 600; line-height: 1.08; color: var(--ink); letter-spacing: -0.025em; margin-bottom: 16px; }
    .zl-desc { font-size: 1.08rem; color: var(--muted); line-height: 1.7; margin-bottom: 32px; max-width: 700px; }

    .zl-cats { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 32px; }
    .zl-cat { font-size: .74rem; font-weight: 600; color: var(--accent-deep); background: var(--accent-soft); border-radius: 999px; padding: 5px 13px; }

    .zl-video { margin-bottom: 32px; border-radius: 16px; overflow: hidden; border: 1px solid var(--line); background: #000; }
    .zl-video iframe { display: block; width: 100%; aspect-ratio: 16/9; border: 0; }
    .zl-video-cap { padding: 10px 16px; font-size: .82rem; color: var(--muted); background: #fff; border-top: 1px solid var(--line); }

    .zl-cover { border-radius: 16px; overflow: hidden; border: 1px solid var(--line); margin-bottom: 32px; }
    .zl-cover img { width: 100%; aspect-ratio: 16/9; object-fit: cover; display: block; }

    .zl-article {
      background: #fff; border: 1px solid var(--line); border-radius: 16px; padding: 36px 38px;
    }
    .zl-article :global(h1), .zl-article :global(h2), .zl-article :global(h3) { font-weight: 600; color: var(--ink); margin: 1.4em 0 .5em; line-height: 1.2; }
    .zl-article :global(h1) { font-size: 1.5em; } .zl-article :global(h2) { font-size: 1.3em; } .zl-article :global(h3) { font-size: 1.12em; }
    .zl-article :global(h2:first-child) { margin-top: 0; }
    .zl-article :global(p) { margin: .7em 0; color: var(--ink); line-height: 1.7; }
    .zl-article :global(ul), .zl-article :global(ol) { margin: .7em 0 .7em 1.4em; }
    .zl-article :global(ul) { list-style: disc; } .zl-article :global(ol) { list-style: decimal; }
    .zl-article :global(li) { margin: .3em 0; line-height: 1.6; }
    .zl-article :global(strong) { font-weight: 600; }
    .zl-article :global(code) { background: var(--panel); padding: 2px 6px; border-radius: 5px; font-size: .9em; }
    .zl-article :global(pre) { background: #0f172a; color: #e2e8f0; padding: 16px; border-radius: 10px; overflow-x: auto; margin: 1em 0; }
    .zl-article :global(pre code) { background: transparent; padding: 0; }
    .zl-article :global(blockquote) { border-left: 3px solid var(--accent); padding-left: 16px; color: var(--muted); font-style: italic; margin: 1em 0; }
    .zl-article :global(a) { color: var(--accent-deep); text-decoration: underline; }

    .zl-source { margin-top: 24px; font-family: var(--font-head); font-size: .88rem; font-weight: 600; }
    .zl-source a { color: var(--accent-deep); }
    .zl-source a:hover { text-decoration: underline; }

    .zl-footer { border-top: 1px solid var(--line); background: #fff; padding: 26px 28px; text-align: center; font-size: .82rem; color: var(--faint); }

    @media (max-width: 560px) {
      .zl-main { padding: 32px 20px 56px; }
      .zl-article { padding: 24px 20px; }
    }
  </style>

  <header class="zl-header">
    <div class="row">
      <div class="zl-brand">MG<b>.</b></div>
      <div class="zl-nav">
        <a href="/zona-lab/">← Zona Lab</a>
        <a href="/disertaciones/">Disertaciones</a>
      </div>
    </div>
  </header>

  <main class="zl-main">
    <div class="zl-crumbs"><a href="/zona-lab/">Zona Lab</a> <span>·</span> {r.title}</div>

    <div class="zl-meta">
      <span class="zl-type">{isVideo ? '🎬 Video' : '📄 Reporte'}</span>
      <time datetime={r.createdAt.toISOString()}>{formatFecha(r.createdAt)}</time>
      {r.sourceTitle && <span>{r.sourceTitle}</span>}
    </div>

    <h1 class="zl-title">{r.title}</h1>
    {r.description && <p class="zl-desc">{r.description}</p>}

    {r.categories.length > 0 && (
      <div class="zl-cats">
        {r.categories.map((c) => <span class="zl-cat">{c}</span>)}
      </div>
    )}

    {isVideo && r.videoId ? (
      <div class="zl-video">
        <iframe src={`https://www.youtube.com/embed/${r.videoId}`} title={r.title} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
        <div class="zl-video-cap">Fuente: {r.sourceTitle || 'YouTube'}</div>
      </div>
    ) : r.coverUrl ? (
      <div class="zl-cover"><img src={r.coverUrl} alt={`Portada de ${r.title}`} /></div>
    ) : null}

    <div class="zl-article" set:html={contentHtml}></div>

    {r.sourceUrl && (
      <p class="zl-source">Fuente: <a href={r.sourceUrl} target="_blank" rel="noopener noreferrer">{r.sourceUrl}</a></p>
    )}
  </main>

  <footer class="zl-footer">
    <p>© 2026 Mauricio González · Córdoba, Argentina</p>
  </footer>
</BaseTailwind>