---
import BaseTailwind from '../layouts/BaseTailwind.astro';
import { SITE_CONFIG } from '../data/config';

export const prerender = true;

const base = import.meta.env.BASE_URL;
const b = base.endsWith("/") ? base : `${base}/`;

const resolveUrl = (url: string) => url.startsWith('/') ? `${b}${url.slice(1)}` : url;

const clusters = [
  {
    label: "Profesional",
    primary: true,
    links: [
      { id: 'cv', label: 'CV', url: resolveUrl('/es/cv/'), hint: 'Perfil completo' },
      { id: 'servicios', label: 'Servicios', url: resolveUrl('/es/servicios/'), hint: 'Consultoría, desarrollo, IA' },
      { id: 'portfolio', label: 'Portfolio', url: resolveUrl('/es/portfolio/'), hint: 'Proyectos y casos' },
    ],
  },
  {
    label: "Blog",
    primary: false,
    links: [
      { id: 'blog', label: 'Blog', url: resolveUrl('/blog/'), hint: 'Artículos y pensamientos' },
    ],
  },
  {
    label: "Recursos",
    primary: false,
    links: [
      { id: 'noticias', label: 'Noticias IA', url: resolveUrl('/noticias/'), hint: 'OpenAI · Gemini · Reddit' },
      { id: 'urls', label: 'URLs útiles', url: resolveUrl('/urls/'), hint: 'Dev tools y apps' },
    ],
  },
  {
    label: "Apps",
    primary: false,
    links: [
      { id: 'prompt', label: 'Teleprompter', url: resolveUrl('/prompt/'), hint: 'Ingeniería de prompts' },
      { id: 'videos', label: 'Video Organizer', url: resolveUrl('/videos/'), hint: 'YouTube + Udemy' },
      { id: 'extensions', label: 'Extensiones', url: resolveUrl('/extensions/'), hint: 'Chrome / Firefox' },
      { id: 'vsagenda', label: 'vsagenda', url: resolveUrl('/vsagenda/'), hint: 'Agenda PWA estilo VS Code' },
      { id: 'seguimiento', label: 'Panel Seguimiento', url: resolveUrl('/seguimiento/'), hint: 'Tutorías y prácticas' },
    ],
  },
  {
    label: "Retro",
    primary: false,
    links: [
      { id: 'main', label: 'Main (Retro)', url: resolveUrl('/main/'), hint: 'El MG Lab Depot original' },
    ],
  },
];
---

<BaseTailwind
  title="Mauricio González · Software Engineer, IA & Automatización"
  description="CV, servicios, portfolio y recursos de Mauricio González, Software Engineer especializado en IA y automatización."
  layoutType="index"
  showPromptModal={true}
>
<main>
    <div class="home-split mx-auto max-w-6xl h-[calc(100vh-112px)] min-h-[560px] flex flex-col md:flex-row">

      <!-- Left: Clusters -->
      <section class="home-clusters md:w-1/2 px-6 sm:px-10 py-8 md:py-10 overflow-y-auto">
        <nav aria-label="Secciones principales" class="border-t border-[#e4e8f0]">
          {clusters.map((cluster) => (
            <section class="py-4 border-b border-[#e4e8f0]">
              <div class="flex items-baseline justify-between gap-4 mb-2">
                <h2 class:list={[
                  'uppercase tracking-[0.14em] text-[#1e40af]',
                  cluster.primary ? 'text-sm font-semibold' : 'text-xs font-semibold',
                ]}>
                  {cluster.label}
                </h2>
                {!cluster.primary && (
                  <span class="text-xs text-[#8b94ab]">
                    {cluster.links.length} {cluster.links.length === 1 ? 'página' : 'páginas'}
                  </span>
                )}
              </div>
              <ul class:list={[cluster.primary ? 'grid sm:grid-cols-3 gap-x-2' : 'divide-y divide-[#e4e8f0]']}>
                {cluster.links.map((link) => (
                  <li class={cluster.primary ? '' : 'py-2.5'}>
                    <a
                      href={link.url}
                      class:list={[
                        'group flex items-baseline justify-between gap-3 transition-colors duration-200',
                        cluster.primary
                          ? 'block px-3 py-3 rounded-md hover:bg-[#eef2ff]'
                          : 'text-[#141a2e] hover:text-[#1e40af]',
                      ]}
                    >
                      <span class={cluster.primary ? 'font-medium text-[#141a2e] text-base' : 'text-sm'}>
                        {link.label}
                      </span>
                      {link.hint && (
                        <span class:list={[
                          'text-[#8b94ab] group-hover:text-[#1e40af] transition-colors',
                          cluster.primary ? 'text-xs' : 'text-[0.7rem]',
                        ]}>
                          {link.hint}
                        </span>
                      )}
                      {!cluster.primary && (
                        <span aria-hidden="true" class="text-[#8b94ab] group-hover:text-[#1e40af] transition-colors text-sm">→</span>
                      )}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </nav>
      </section>

      <!-- Divider -->
      <div class="hidden md:block w-px bg-[#e4e8f0]"></div>

      <!-- Right: Greeting + secret trigger -->
      <section class="home-greeting md:w-1/2 px-6 sm:px-10 py-8 md:py-10 flex items-center justify-center">
        <p
          id="secretTrigger"
          class="text-center text-2xl sm:text-3xl text-[#8b94ab] cursor-default select-none italic"
          aria-hidden="true"
        >
          "Hola..."
        </p>
      </section>
    </div>
  </main>
</BaseTailwind>

<style>
  @media (max-width: 767px) {
    .home-split { height: auto; min-height: calc(100vh - 112px); }
    .home-clusters { overflow-y: visible; }
    .home-greeting { min-height: 30vh; }
  }
</style>

<script is:inline>
(function() {
  const trigger = document.getElementById('secretTrigger');
  if (!trigger) return;

  const STORAGE_KEY = 'mglab_admin_session';
  const base = document.querySelector('base')?.href || '/';

  const DURATIONS = {
    '10min': 10 * 60 * 1000,
    '1hora': 60 * 60 * 1000,
    '8horas': 8 * 60 * 60 * 1000,
    '1semana': 7 * 24 * 60 * 60 * 1000,
    'siempre': null
  };

  function hasValidSession() {
    try {
      const session = JSON.parse(localStorage.getItem(STORAGE_KEY));
      if (!session) return false;
      if (session.expires === null) return true;
      return Date.now() < session.expires;
    } catch {
      return false;
    }
  }

  function saveSession(duration) {
    const expires = duration === null ? null : Date.now() + duration;
    localStorage.setItem(STORAGE_KEY, JSON.stringify({ expires }));
  }

  function verifyPassword(input) {
    const diaCordoba = new Date().toLocaleString('en-US', {
      timeZone: 'America/Argentina/Cordoba',
      day: 'numeric'
    });
    return input === 'gusfraba' + diaCordoba;
  }

  async function askDuration() {
    const choice = await window.showSelectModal({
      title: '⏱️ Duración de sesión',
      message: '¿Por cuánto tiempo mantener la sesión activa?',
      options: [
        { value: '10min', label: '10 minutos' },
        { value: '1hora', label: '1 hora' },
        { value: '8horas', label: '8 horas' },
        { value: '1semana', label: '1 semana' },
        { value: 'siempre', label: 'Siempre' }
      ],
      cancelText: 'Cancelar'
    });
    return choice ? DURATIONS[choice] : DURATIONS['1hora'];
  }

  trigger.addEventListener('dblclick', async function() {
    if (hasValidSession()) {
      window.location.href = base + 'admin/';
      return;
    }
    const input = await window.showPromptModal({
      title: '🔐',
      inputType: 'password',
      placeholder: 'Contraseña...',
      confirmText: 'Entrar',
      cancelText: 'Cancelar'
    });
    if (!input) return;
    if (verifyPassword(input)) {
      const duration = await askDuration();
      saveSession(duration);
      window.location.href = base + 'admin/';
    } else {
      await window.showAlertModal({
        title: '❌ Acceso denegado',
        message: 'Contraseña incorrecta',
        confirmText: 'OK'
      });
    }
  });
})();
</script>
