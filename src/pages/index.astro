---
import BaseTailwind from '../layouts/BaseTailwind.astro';
import HomeClusters from '../components/shared/HomeClusters.astro';

export const prerender = true;

const base = import.meta.env.BASE_URL;
const b = base.endsWith("/") ? base : `${base}/`;

const resolveUrl = (url: string) => url.startsWith('/') ? `${b}${url.slice(1)}` : url;
---

<BaseTailwind
  title="Mauricio González · Software Engineer, IA & Automatización"
  description="CV, servicios, portfolio y recursos de Mauricio González, Software Engineer especializado en IA y automatización."
  layoutType="index"
  showPromptModal={true}
>
<main>
    <div class="home-split mx-auto max-w-6xl h-[calc(100vh-112px)] min-h-[560px] flex flex-col md:flex-row">

      <!-- Left: Clusters -->
      <section class="home-clusters md:w-1/2 px-6 sm:px-10 py-8 md:py-10 overflow-y-auto">
        <HomeClusters />
      </section>

      <!-- Divider -->
      <div class="hidden md:block w-px bg-[#e4e8f0]"></div>

      <!-- Right: Greeting + secret trigger -->
      <section class="home-greeting md:w-1/2 px-6 sm:px-10 py-8 md:py-10 flex items-center justify-center">
        <div class="text-center space-y-6 max-w-md">
          <p
            id="secretTrigger"
            class="text-5xl sm:text-6xl text-[#141a2e] cursor-default select-none font-semibold tracking-tight leading-none"
            aria-hidden="true"
          >
            "Hola..."
          </p>
          <div class="space-y-2">
            <h1 class="text-2xl sm:text-3xl font-semibold text-[#141a2e]">
              Soy Mauricio González
            </h1>
            <p class="text-base text-[#5c6785]">
              Software Engineer &middot; IA &amp; Automatización
            </p>
          </div>
          <p class="text-sm text-[#8b94ab]">
            CV, proyectos, blog y herramientas para aprender y construir.
          </p>
          <div class="flex flex-wrap justify-center gap-3 pt-2">
            <a
              href={resolveUrl('/es/cv/')}
              class="px-6 py-3 rounded-lg bg-[#1e40af] text-white text-sm font-semibold shadow-sm hover:bg-[#1d4ed8] transition-colors"
            >
              Ver mi CV
            </a>
            <a
              href={resolveUrl('/blog/')}
              class="px-6 py-3 rounded-lg bg-white text-[#1e40af] border border-[#c7d4f0] text-sm font-semibold hover:bg-[#eef2ff] transition-colors"
            >
              Leer el blog
            </a>
          </div>
        </div>
      </section>
    </div>
  </main>
</BaseTailwind>

<style>
  @media (max-width: 767px) {
    .home-split { height: auto; min-height: calc(100vh - 112px); }
    .home-clusters { overflow-y: visible; }
    .home-greeting { min-height: 30vh; }
  }
</style>

<script is:inline>
(function() {
  const trigger = document.getElementById('secretTrigger');
  if (!trigger) return;

  const STORAGE_KEY = 'mglab_admin_session';
  const base = document.querySelector('base')?.href || '/';

  const DURATIONS = {
    '10min': 10 * 60 * 1000,
    '1hora': 60 * 60 * 1000,
    '8horas': 8 * 60 * 60 * 1000,
    '1semana': 7 * 24 * 60 * 60 * 1000,
    'siempre': null
  };

  function hasValidSession() {
    try {
      const session = JSON.parse(localStorage.getItem(STORAGE_KEY));
      if (!session) return false;
      if (session.expires === null) return true;
      return Date.now() < session.expires;
    } catch {
      return false;
    }
  }

  function saveSession(duration) {
    const expires = duration === null ? null : Date.now() + duration;
    localStorage.setItem(STORAGE_KEY, JSON.stringify({ expires }));
  }

  function verifyPassword(input) {
    const diaCordoba = new Date().toLocaleString('en-US', {
      timeZone: 'America/Argentina/Cordoba',
      day: 'numeric'
    });
    return input === 'gusfraba' + diaCordoba;
  }

  async function askDuration() {
    const choice = await window.showSelectModal({
      title: '⏱️ Duración de sesión',
      message: '¿Por cuánto tiempo mantener la sesión activa?',
      options: [
        { value: '10min', label: '10 minutos' },
        { value: '1hora', label: '1 hora' },
        { value: '8horas', label: '8 horas' },
        { value: '1semana', label: '1 semana' },
        { value: 'siempre', label: 'Siempre' }
      ],
      cancelText: 'Cancelar'
    });
    return choice ? DURATIONS[choice] : DURATIONS['1hora'];
  }

  trigger.addEventListener('dblclick', async function() {
    if (hasValidSession()) {
      window.location.href = base + 'admin/';
      return;
    }
    const input = await window.showPromptModal({
      title: '🔐',
      inputType: 'password',
      placeholder: 'Contraseña...',
      confirmText: 'Entrar',
      cancelText: 'Cancelar'
    });
    if (!input) return;
    if (verifyPassword(input)) {
      const duration = await askDuration();
      saveSession(duration);
      window.location.href = base + 'admin/';
    } else {
      await window.showAlertModal({
        title: '❌ Acceso denegado',
        message: 'Contraseña incorrecta',
        confirmText: 'OK'
      });
    }
  });
})();
</script>
