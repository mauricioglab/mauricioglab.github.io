---
export const prerender = true;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>VeloCityLab</title>
    <meta name="description" content="VeloCityLab — IA y automatización para equipos." />
    <meta http-equiv="refresh" content="0; url=/es/servicios/" />
    <link rel="canonical" href="https://velocitylab.com.ar/es/servicios/" />
    <script is:inline>
      (function () {
        var lang = (navigator.language || 'es').toLowerCase().startsWith('en') ? 'en' : 'es';
        window.location.replace('/' + lang + '/servicios/');
      })();
    </script>
  </head>
  <body>
    <p>Redirigiendo a <a href="/es/servicios/">VeloCityLab</a>&hellip;</p>
  </body>
</html>
