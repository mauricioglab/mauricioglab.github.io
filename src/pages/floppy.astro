---
import BaseTailwind from '../layouts/BaseTailwind.astro';
import { SITE_CONFIG } from '../data/config';

export const prerender = true;

const base = import.meta.env.BASE_URL;
const b = base.endsWith('/') ? base : `${base}/`;
---

<BaseTailwind
  title="Disquete 3½ — MG Lab"
  description="Disquete 3½ · Mauricio Gonzalez, Software Engineer especializado en IA y Automatización"
>
  <link slot="head" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

  <main class="min-h-screen max-w-md mx-auto px-4 py-6 bg-slate-50 dark:bg-slate-900">
    <!-- Presentación -->
    <section class="text-center">
      <i class="fa-solid fa-floppy-disk text-5xl text-slate-500 block mb-3" aria-hidden="true"></i>

      <p class="text-base font-medium text-slate-500 dark:text-slate-400 mb-1">¡Hola! Soy</p>
      <h1 class="text-4xl font-black tracking-tight text-slate-900 dark:text-white mb-1">
        {SITE_CONFIG.author}
      </h1>
      <p class="text-base text-slate-500 dark:text-slate-400 mb-4">
        {SITE_CONFIG.location}
      </p>

      <div class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl shadow-sm px-4 py-3 mb-5 transition-colors">
        <p class="text-sm text-slate-600 dark:text-slate-400 leading-snug">
          El disquete 3½ nació en <strong class="text-slate-900 dark:text-white">1981</strong> con Sony y guardaba
          <strong class="text-slate-900 dark:text-white">1.44 MB</strong> — menos que una canción.
        </p>
        <p class="text-sm text-slate-600 dark:text-slate-400 leading-snug mt-2">
          Su inventor fue <strong class="text-slate-900 dark:text-white">Alan Shugart</strong>, que en
          <strong class="text-slate-900 dark:text-white">1971</strong> creó en IBM el primer disquete, de 8 pulgadas,
          para cargar software en las mainframes.
        </p>
        <p class="text-sm text-slate-600 dark:text-slate-400 leading-snug mt-2">
          Dato curioso: Microsoft usó un formato especial (DMF) para exprimir
          <strong class="text-slate-900 dark:text-white">1.68 MB</strong> en cada disquete y así repartió
          <strong class="text-slate-900 dark:text-white">Windows 95 en 13 disquetes</strong>.
        </p>
        <p class="text-sm text-slate-600 dark:text-slate-400 leading-snug mt-2">
          El 3½ reinó 30 años: Sony los fabricó hasta <strong class="text-slate-900 dark:text-white">2011</strong> y en
          <strong class="text-slate-900 dark:text-white">2015</strong> cerró la última fábrica de disquetes del planeta.
        </p>
      </div>
    </section>

    <!-- Contacto -->
    <section class="text-center mb-5">
      <h2 class="text-lg font-bold text-slate-900 dark:text-white mb-1">Guardá mi contacto</h2>
      <p class="text-sm text-slate-500 dark:text-slate-400 mb-3">Escribime por el canal que prefieras:</p>
      <div class="grid gap-2.5">
        <a
          id="waLink"
          href="#"
          class="w-full flex items-center justify-center gap-2.5 px-5 py-3 rounded-xl font-bold text-white bg-green-600 hover:bg-green-700 active:bg-green-800 transition shadow-sm cursor-pointer"
        >
          <i class="fa-brands fa-whatsapp text-lg" aria-hidden="true"></i>
          WhatsApp
        </a>
        <a
          id="mailLink"
          href="#"
          class="w-full flex items-center justify-center gap-2.5 px-5 py-3 rounded-xl font-bold text-white bg-slate-800 hover:bg-slate-900 active:bg-black transition shadow-sm dark:bg-slate-200 dark:text-slate-900 dark:hover:bg-white cursor-pointer"
        >
          <i class="fa-solid fa-envelope text-lg" aria-hidden="true"></i>
          Enviarme un mail
        </a>
        <a
          href={SITE_CONFIG.linkedin}
          class="w-full flex items-center justify-center gap-2.5 px-5 py-3 rounded-xl font-bold text-white bg-[#0a66c2] hover:bg-[#084b8f] active:bg-[#063a6b] transition shadow-sm"
        >
          <i class="fa-brands fa-linkedin text-lg" aria-hidden="true"></i>
          LinkedIn
        </a>
      </div>
    </section>

    <p class="text-center text-xs mb-1">
      <a href={SITE_CONFIG.cv} class="text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors">
        ← Ver mi CV
      </a>
    </p>
  </main>

  <script is:inline define:vars={{
    chunks: SITE_CONFIG.whatsappChunks,
    waMessage: SITE_CONFIG.whatsappMessage,
    emailParts: SITE_CONFIG.emailParts,
    emailDomain: SITE_CONFIG.emailDomain,
  }}>
    function buildWhatsAppUrl() {
      return 'https://wa.me/' + chunks.join('') + '?text=' + encodeURIComponent(waMessage);
    }

    function buildMailtoUrl() {
      return 'mailto:' + emailParts.join('') + '@' + emailDomain.join('.');
    }

    function buildOnTouch(target, id, builder) {
      var el = target && target.closest ? target.closest('#' + id) : null;
      if (el && !el.hasAttribute('data-built')) {
        el.setAttribute('href', builder());
        el.setAttribute('data-built', '1');
      }
    }

    document.addEventListener('pointerdown', function (e) {
      buildOnTouch(e.target, 'waLink', buildWhatsAppUrl);
      buildOnTouch(e.target, 'mailLink', buildMailtoUrl);
    });

    document.addEventListener('click', function (e) {
      buildOnTouch(e.target, 'waLink', buildWhatsAppUrl);
      buildOnTouch(e.target, 'mailLink', buildMailtoUrl);
    });
  </script>
</BaseTailwind>