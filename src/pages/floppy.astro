---
import BaseTailwind from '../layouts/BaseTailwind.astro';
import { SITE_CONFIG } from '../data/config';

export const prerender = true;

const base = import.meta.env.BASE_URL;
const b = base.endsWith('/') ? base : `${base}/`;
---

<BaseTailwind
  title="Disquete 3½ — MG Lab"
  description="Disquete 3½ · Mauricio Gonzalez, Full Stack Developer"
>
  <main class="max-w-md mx-auto px-4 py-6">
    <!-- Presentación -->
    <section class="text-center">
      <svg viewBox="0 0 100 104" class="w-20 h-20 mx-auto mb-3" role="img" aria-label="Disquete de 3½ pulgadas">
        <rect x="0" y="4" width="100" height="100" rx="8" fill="#1e293b" opacity="0.15" />
        <rect x="0" y="0" width="100" height="100" rx="8" fill="#475569" stroke="#1e293b" stroke-width="2" />
        <rect x="0" y="90" width="100" height="10" rx="5" fill="#334155" />
        <rect x="60" y="20" width="20" height="17" rx="1" fill="#0f172a" />
        <rect x="56" y="15" width="28" height="26" rx="2" fill="#cbd5e1" stroke="#64748b" stroke-width="1.5" />
        <rect x="60" y="11" width="20" height="8" rx="1" fill="#94a3b8" />
        <rect x="16" y="12" width="13" height="13" rx="2" fill="#0f172a" />
        <rect x="18" y="14" width="9" height="9" rx="1" fill="#cbd5e1" />
        <rect x="10" y="70" width="80" height="20" rx="2" fill="#f8fafc" stroke="#94a3b8" stroke-width="1" />
        <rect x="14" y="74" width="48" height="3.5" rx="1.75" fill="#dc2626" />
        <rect x="14" y="80" width="62" height="2" rx="1" fill="#cbd5e1" />
        <rect x="14" y="84" width="40" height="2" rx="1" fill="#cbd5e1" />
      </svg>

      <h1 class="text-2xl font-extrabold text-slate-900 dark:text-white mb-1">
        ¡Hola! Soy {SITE_CONFIG.author}
      </h1>
      <p class="text-base text-slate-600 dark:text-slate-400 mb-4">
        {SITE_CONFIG.authorTitle} — {SITE_CONFIG.location}
      </p>

      <div class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl shadow-sm px-4 py-3 mb-5 transition-colors">
        <p class="text-sm text-slate-600 dark:text-slate-400 leading-snug">
          El disquete 3½ nació en <strong class="text-slate-900 dark:text-white">1981</strong> con Sony y guardaba
          <strong class="text-slate-900 dark:text-white">1.44 MB</strong> — menos que una canción.
          Su «clic» al insertarlo era inconfundible. Hoy vive en el ícono de
          <strong class="text-slate-900 dark:text-white">«guardar»</strong> de tus apps.
        </p>
      </div>
    </section>

    <!-- Contacto -->
    <section class="text-center mb-5">
      <h2 class="text-lg font-bold text-slate-900 dark:text-white mb-1">Guardá mi contacto</h2>
      <p class="text-sm text-slate-500 dark:text-slate-400 mb-3">Escribime por el canal que prefieras:</p>
      <div class="grid gap-2.5">
        <a
          id="waLink"
          href="#"
          class="w-full flex items-center justify-center gap-2.5 px-5 py-3 rounded-xl font-bold text-white bg-green-600 hover:bg-green-700 active:bg-green-800 transition shadow-sm cursor-pointer"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          WhatsApp
        </a>
        <a
          id="mailLink"
          href="#"
          class="w-full flex items-center justify-center gap-2.5 px-5 py-3 rounded-xl font-bold text-white bg-slate-800 hover:bg-slate-900 active:bg-black transition shadow-sm dark:bg-slate-200 dark:text-slate-900 dark:hover:bg-white cursor-pointer"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
          Enviarme un mail
        </a>
      </div>
    </section>

    <p class="text-center text-xs mb-1">
      <a href={b} class="text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors">
        ← Explorar MG Lab
      </a>
    </p>
  </main>

  <script is:inline define:vars={{
    chunks: SITE_CONFIG.whatsappChunks,
    waMessage: SITE_CONFIG.whatsappMessage,
    emailParts: SITE_CONFIG.emailParts,
    emailDomain: SITE_CONFIG.emailDomain,
  }}>
    function buildWhatsAppUrl() {
      return 'https://wa.me/' + chunks.join('') + '?text=' + encodeURIComponent(waMessage);
    }

    function buildMailtoUrl() {
      return 'mailto:' + emailParts.join('') + '@' + emailDomain.join('.');
    }

    function buildOnTouch(target, id, builder) {
      var el = target && target.closest ? target.closest('#' + id) : null;
      if (el && !el.hasAttribute('data-built')) {
        el.setAttribute('href', builder());
        el.setAttribute('data-built', '1');
      }
    }

    document.addEventListener('pointerdown', function (e) {
      buildOnTouch(e.target, 'waLink', buildWhatsAppUrl);
      buildOnTouch(e.target, 'mailLink', buildMailtoUrl);
    });

    document.addEventListener('click', function (e) {
      buildOnTouch(e.target, 'waLink', buildWhatsAppUrl);
      buildOnTouch(e.target, 'mailLink', buildMailtoUrl);
    });
  </script>
</BaseTailwind>