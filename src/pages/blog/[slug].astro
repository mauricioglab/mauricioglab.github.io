---
import BlogLayout from "../../layouts/BlogLayout.astro";
import ShareButtons from "../../components/blog/ShareButtons.astro";
import { calculateReadingTime, getBlogPosts, normalizeBaseUrl, type BlogPost } from "../../utils/blog";
import { createMarkdownProcessor } from "@astrojs/markdown-remark";
import { Image } from "astro:assets";

export async function getStaticPaths() {
  const posts = await getBlogPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const normalizedBase = normalizeBaseUrl(import.meta.env.BASE_URL);
const fullUrl = `${Astro.site}${normalizedBase}blog/${post.slug}/`;

const markdownProcessor = await createMarkdownProcessor({
  syntaxHighlight: 'shiki',
  shikiConfig: { theme: 'github-light', wrap: true },
});
const { code: contentHtml } = await markdownProcessor.render(post.body);
const readingTime = calculateReadingTime(post.body);
---

<BlogLayout
  title={`${post.title} | Blog`}
  description={post.description}
  blogTitle="Blog"
  blogSubtitle="Artículos y pensamientos"
>
  <slot name="head">
    <link rel="canonical" href={fullUrl} />
    <meta property="og:title" content={post.title} />
    <meta property="og:description" content={post.description} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={fullUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={post.title} />
    <meta name="twitter:description" content={post.description} />
    <meta
      name="article:published_time"
      content={post.pubDate.toISOString()}
    />
    <meta name="article:author" content={post.author} />
    {
      post.categories.map((category) => (
        <meta name="article:tag" content={category} />
      ))
    }
  </slot>

  <article
    class="post entry"
    itemscope
    itemtype="https://schema.org/BlogPosting"
  >
    <header class="entry-header mb-8">
      {
        post.coverUrl && (
          <div class="mb-8 flex justify-center w-full">
            <img
              src={post.coverUrl}
              alt={post.title}
              class="rounded-xl shadow-lg transition-transform duration-500 w-full max-w-[800px] h-auto object-cover hover:scale-105"
            />
          </div>
        )
      }
      {
        !post.coverUrl && post.localImage && (
          <div class="mb-8 flex justify-center w-full">
            <Image
              src={post.localImage}
              alt={post.title}
              class="rounded-xl shadow-lg transition-transform duration-500 w-full max-w-[800px] h-auto object-cover hover:scale-105"
              width={800}
              height={450}
            />
          </div>
        )
      }
      <h1 class="entry-title text-4xl font-bold mb-4" itemprop="headline">
        {post.title}
      </h1>
      <p class="entry-meta text-gray-500">
        Escrito <span class="by">por</span>
        <span class="entry-author-name" itemprop="author"
          >{post.author}</span
        >
        <time
          datetime={post.pubDate.toISOString()}
          itemprop="datePublished"
          class="hidden">{post.pubDate.toISOString()}</time
        >
        {
          readingTime > 0 && (
            <>
              <span> &middot; </span>
              <span>{readingTime} min de lectura</span>
            </>
          )
        }
      </p>
    </header>

    <div class="entry-content" itemprop="articleBody">
      <Fragment set:html={contentHtml} />
    </div>

    <ShareButtons title={post.title} url={fullUrl} />
  </article>
</BlogLayout>