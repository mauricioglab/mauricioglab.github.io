---
import BlogLayout from '../../layouts/BlogLayout.astro';
import { getBlogPosts, normalizeBaseUrl } from '../../utils/blog';
import PostCard from '../../components/blog/PostCard.astro';
import RecursoCard from '../../components/recursos/RecursoCard.astro';
import { getUltimosRecursos } from '../../utils/relacionados';

export const prerender = true;

const posts = await getBlogPosts();
const recursos = await getUltimosRecursos(3);
const normalizedBase = normalizeBaseUrl(import.meta.env.BASE_URL);
const currentUrl = `${Astro.site}${normalizedBase}blog/`;
---

<BlogLayout 
  title="Blog" 
  description="Artículos y publicaciones"
  blogTitle="Blog"
  blogSubtitle="Artículos y pensamientos"
>
  <slot name="head">
    <link rel="canonical" href={currentUrl} />
  </slot>

  {posts.length === 0 ? (
    <p class="text-center text-[#5c6785]">No hay posts disponibles.</p>
  ) : (
    <div role="list">
      {posts.map((post) => (
        <PostCard post={post} />
      ))}
    </div>
  )}

  <section class="mt-14 mb-4">
    <div class="flex items-baseline justify-between gap-4 mb-3">
      <h2 class="text-2xl font-semibold tracking-tight text-[#141a2e]">
        Zona Lab
      </h2>
      <a
        href={`${normalizedBase}zona-lab/`}
        class="text-sm text-[#1e40af] hover:text-[#1d4ed8] hover:underline whitespace-nowrap"
      >
        Ver todos →
      </a>
    </div>
    <p class="text-sm text-[#5c6785] mb-6">
      Recursos de estudio para alumnos: el mismo hilo, en modo estudio.
    </p>

    {recursos.length === 0 ? (
      <p class="text-sm text-[#5c6785]">Aún no hay recursos publicados.</p>
    ) : (
      <div class="grid gap-6 sm:grid-cols-2">
        {recursos.map((recurso) => (
          <RecursoCard recurso={recurso} />
        ))}
      </div>
    )}
  </section>
</BlogLayout>
