---
// src/pages/[lang]/cv.astro
// CV único bilingüe. Lenguaje editorial (paper/ink/teal) alineado con el caso
// de estudio "Analista de Sistemas" (src/styles/caso-arquitectura.css). Una sola
// paleta de marca, sin emojis ni grillas de tarjetas: jerarquía tipográfica +
// separadores. Imprimible vía el botón del header.
import { type Lang, useTranslations, getAlternateUrl } from '@i18n/index';
import { getLanguagePaths } from '@utils/i18n-paths';
import SeoHead from '@components/shared/SeoHead.astro';

export const getStaticPaths = getLanguagePaths;

const { lang } = Astro.params as { lang: Lang };
const content = await useTranslations<any>(lang, 'cv');
const altUrl = getAlternateUrl(Astro.url, lang);
const altLang = lang === 'es' ? 'en' : 'es';
const canonical = new URL(Astro.url.pathname, Astro.site).toString();

const startDate = new Date('2021-07-01');
const years = Math.floor((Date.now() - startDate.getTime()) / (1000 * 60 * 60 * 24 * 365.25));
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{content.meta.title}</title>
        <meta name="description" content={content.meta.description} />
        <SeoHead title={content.meta.title} description={content.meta.description} lang={lang} canonical={canonical} type="profile" />
        <style>
            /* ---------- Fuentes (self-hosted, mismas del caso de estudio) ---------- */
            @font-face {
                font-family: 'Inter';
                font-style: normal;
                font-weight: 100 900;
                font-display: swap;
                src: url('/fonts/inter-latin.woff2') format('woff2');
                unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
            }
            @font-face {
                font-family: 'Inter';
                font-style: normal;
                font-weight: 100 900;
                font-display: swap;
                src: url('/fonts/inter-latin-ext.woff2') format('woff2');
                unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
            }
            @font-face {
                font-family: 'Space Grotesk';
                font-style: normal;
                font-weight: 300 700;
                font-display: swap;
                src: url('/fonts/space-grotesk-latin.woff2') format('woff2');
                unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
            }
            @font-face {
                font-family: 'Space Grotesk';
                font-style: normal;
                font-weight: 300 700;
                font-display: swap;
                src: url('/fonts/space-grotesk-latin-ext.woff2') format('woff2');
                unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
            }

            /* ---------- Tokens de marca ---------- */
            :root {
                --paper: #ffffff;
                --paper-alt: #f4f6fa;
                --ink: #141a2e;
                --ink-soft: #5c6785;
                --ink-faint: #8b94ab;
                --line: #e4e8f0;
                --teal: #1d4ed8;
                --teal-deep: #1e40af;
                --teal-tint: #eef2ff;
                --navy: #1b2430;
                --sand-deep: #1e40af;

                --font-head: 'Space Grotesk', 'Inter', system-ui, sans-serif;
                --font-body: 'Inter', system-ui, sans-serif;
                --maxw: 880px;
            }

            /* ---------- Base ---------- */
            * { box-sizing: border-box; }
            html { scroll-behavior: smooth; }
            body {
                margin: 0;
                background: var(--paper-alt);
                color: var(--ink);
                font-family: var(--font-body);
                font-size: 16px;
                line-height: 1.65;
                -webkit-font-smoothing: antialiased;
                text-rendering: optimizeLegibility;
            }
            .sheet {
                max-width: var(--maxw);
                margin: 32px auto 80px;
                background: var(--paper);
                border: 1px solid var(--line);
                border-radius: 14px;
                overflow: hidden;
                box-shadow: 0 30px 60px -30px rgba(20, 26, 46, 0.18);
            }
            h1, h2, h3, h4 {
                font-family: var(--font-head);
                line-height: 1.15;
                margin: 0;
                letter-spacing: -0.015em;
                font-weight: 600;
            }
            p { margin: 0; }
            a { color: inherit; text-decoration: none; }
            ul { margin: 0; padding: 0; list-style: none; }

            .wrap {
                width: 100%;
                max-width: var(--maxw);
                margin: 0 auto;
                padding: 0 28px;
            }

            /* ---------- Header ---------- */
            .site-header {
                position: sticky;
                top: 0;
                z-index: 50;
                background: rgba(255, 255, 255, 0.92);
                backdrop-filter: saturate(1.4) blur(8px);
                border-bottom: 1px solid var(--line);
            }
            .site-header .wrap {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 1rem;
                padding-top: 16px;
                padding-bottom: 16px;
            }
            .site-brand {
                font-family: var(--font-head);
                font-weight: 600;
                font-size: 0.95rem;
                letter-spacing: 0.02em;
                color: var(--ink);
            }
            .site-brand span { color: var(--ink-faint); font-weight: 400; }
            .site-actions { display: flex; align-items: center; gap: 1.25rem; }
            .btn-print {
                font-family: var(--font-head);
                font-size: 0.82rem;
                font-weight: 600;
                letter-spacing: 0.04em;
                color: var(--teal-deep);
                border: 1px solid var(--teal-deep);
                padding: 0.5rem 1.1rem;
                border-radius: 999px;
                background: transparent;
                cursor: pointer;
                transition: background 0.15s ease, color 0.15s ease;
            }
            .btn-print:hover { background: var(--teal-deep); color: var(--paper); }
            .lang-toggle {
                font-family: var(--font-head);
                font-size: 0.8rem;
                font-weight: 600;
                color: var(--ink-soft);
                border: 1px solid var(--line);
                padding: 0.45rem 0.9rem;
                border-radius: 999px;
                background: transparent;
                text-decoration: none;
                transition: border-color 0.15s ease, color 0.15s ease;
            }
            .lang-toggle:hover { border-color: var(--teal-deep); color: var(--teal-deep); }
            .back-link {
                font-size: 0.85rem;
                color: var(--ink-soft);
                transition: color 0.15s ease;
            }
            .back-link:hover { color: var(--teal-deep); }

            /* ---------- Masthead ---------- */
            .masthead { padding: 3.25rem 0 2.25rem; }
            .masthead h1 {
                font-size: clamp(2.5rem, 6vw, 3.6rem);
                font-weight: 600;
                letter-spacing: -0.03em;
            }
            .masthead .role {
                margin-top: 0.75rem;
                font-family: var(--font-head);
                font-size: 1.3rem;
                font-weight: 500;
                color: var(--ink-soft);
                letter-spacing: -0.01em;
            }
            .masthead .role .accent { color: var(--teal-deep); }
            .masthead .stack {
                margin-top: 0.9rem;
                font-family: var(--font-head);
                font-size: 0.82rem;
                font-weight: 600;
                letter-spacing: 0.16em;
                text-transform: uppercase;
                color: var(--ink-faint);
            }
            .masthead .contact {
                margin-top: 1.5rem;
                font-size: 0.9rem;
                color: var(--ink-soft);
                display: flex;
                flex-wrap: wrap;
                gap: 0.5rem 1.25rem;
                align-items: center;
            }
            .masthead .contact a { transition: color 0.15s ease; }
            .masthead .contact a:hover { color: var(--teal-deep); }
            .masthead .contact .sep { color: var(--line); }
            .rule {
                border: 0;
                border-top: 1px solid var(--line);
                margin: 2.25rem 0 0;
            }

            /* ---------- Secciones ---------- */
            section.block { padding: 2.75rem 0; }
            .eyebrow {
                display: flex;
                align-items: baseline;
                gap: 0.85rem;
                margin-bottom: 1.75rem;
            }
            .eyebrow .num {
                font-family: var(--font-head);
                font-size: 0.74rem;
                font-weight: 700;
                color: var(--sand-deep);
                letter-spacing: 0.08em;
            }
            .eyebrow .label {
                font-family: var(--font-head);
                font-size: 0.78rem;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 0.18em;
                color: var(--teal-deep);
            }
            .eyebrow .label::before {
                content: '';
                display: inline-block;
                width: 22px;
                height: 2px;
                background: var(--teal);
                vertical-align: middle;
                margin-right: 0.7rem;
                transform: translateY(-3px);
            }

            /* ---------- Perfil ---------- */
            .perfil p { color: var(--ink-soft); max-width: 62ch; }
            .perfil p + p { margin-top: 1rem; }
            .highlights {
                margin-top: 1.5rem;
                display: grid;
                gap: 0.65rem;
            }
            .highlights li {
                display: flex;
                gap: 0.85rem;
                font-size: 0.92rem;
                color: var(--ink);
            }
            .highlights li::before {
                content: '—';
                color: var(--teal);
                font-weight: 600;
            }

            /* ---------- Filas editoriales (experiencia, formación, tech) ---------- */
            .rows { display: flex; flex-direction: column; }
            .row {
                display: grid;
                grid-template-columns: 170px 1fr;
                gap: 2.5rem;
                padding: 1.85rem 0;
                border-top: 1px solid var(--line);
            }
            .row:first-child { border-top: 0; padding-top: 0; }
            .row .meta {
                font-family: var(--font-head);
                font-size: 0.8rem;
                font-weight: 600;
                letter-spacing: 0.06em;
                color: var(--ink-faint);
                text-transform: uppercase;
            }
            .row .body { min-width: 0; }

            /* ---------- Experiencia ---------- */
            .exp .company {
                font-family: var(--font-head);
                font-size: 1.12rem;
                font-weight: 600;
                color: var(--ink);
            }
            .exp .company.current { color: var(--teal-deep); }
            .exp .role {
                font-size: 0.98rem;
                color: var(--ink-soft);
                margin-left: 0.5rem;
            }
            .exp .summary { margin-top: 0.6rem; color: var(--ink-soft); font-size: 0.95rem; max-width: 62ch; }
            .exp ul.items { margin-top: 0.85rem; display: flex; flex-direction: column; gap: 0.4rem; }
            .exp ul.items li {
                position: relative;
                padding-left: 1.1rem;
                color: var(--ink-soft);
                font-size: 0.92rem;
            }
            .exp ul.items li::before {
                content: '';
                position: absolute;
                left: 0;
                top: 0.62rem;
                width: 5px;
                height: 5px;
                border-radius: 50%;
                background: var(--teal);
            }
            .exp .subhead {
                margin-top: 1rem;
                font-family: var(--font-head);
                font-size: 0.82rem;
                font-weight: 600;
                letter-spacing: 0.05em;
                text-transform: uppercase;
                color: var(--ink);
            }
            .exp .subhead + ul.items { margin-top: 0.5rem; }
            .exp .also {
                margin-top: 0.85rem;
                font-size: 0.9rem;
                color: var(--ink-soft);
                max-width: 62ch;
            }
            .exp .tech {
                margin-top: 1rem;
                font-size: 0.82rem;
                color: var(--ink-faint);
                font-family: var(--font-head);
                letter-spacing: 0.02em;
            }
            .exp .tech b { color: var(--sand-deep); font-weight: 600; }

            /* ---------- Proyectos ---------- */
            .proyectos-intro { color: var(--ink-soft); font-size: 0.92rem; max-width: 62ch; margin-bottom: 1.5rem; }
            .proyectos-list { display: flex; flex-direction: column; }
            .proyecto {
                padding: 1.5rem 0;
                border-top: 1px solid var(--line);
            }
            .proyecto:first-child { border-top: 0; padding-top: 0; }
            .proyecto-head {
                display: flex;
                flex-wrap: wrap;
                align-items: baseline;
                justify-content: space-between;
                gap: 0.5rem 1.25rem;
            }
            .proyecto-title { font-size: 1.08rem; font-weight: 600; color: var(--ink); }
            .proyecto-client {
                font-family: var(--font-head);
                font-size: 0.72rem;
                font-weight: 600;
                letter-spacing: 0.06em;
                text-transform: uppercase;
                color: var(--teal-deep);
            }
            .proyecto-desc { margin-top: 0.5rem; color: var(--ink-soft); font-size: 0.92rem; max-width: 62ch; }
            .proyecto .tech { margin-top: 0.75rem; }

            /* ---------- IA & Datos ---------- */
            .ia-flagship {
                background: var(--teal-tint);
                border: 1px solid #c9d5f7;
                border-radius: 14px;
                padding: 1.6rem 1.75rem;
            }
            .ia-flagship .head {
                display: flex;
                flex-wrap: wrap;
                align-items: baseline;
                justify-content: space-between;
                gap: 0.75rem 1.5rem;
                margin-bottom: 0.9rem;
            }
            .ia-flagship .title { font-size: 1.08rem; font-weight: 600; color: var(--ink); }
            .ia-flagship .badge {
                font-family: var(--font-head);
                font-size: 0.72rem;
                font-weight: 600;
                letter-spacing: 0.06em;
                text-transform: uppercase;
                color: var(--teal-deep);
            }
            .ia-flagship ul { display: flex; flex-direction: column; gap: 0.4rem; }
            .ia-flagship li {
                position: relative;
                padding-left: 1.1rem;
                color: #2d4a7a;
                font-size: 0.9rem;
            }
            .ia-flagship li::before {
                content: '';
                position: absolute;
                left: 0; top: 0.6rem;
                width: 5px; height: 5px;
                border-radius: 50%;
                background: var(--teal-deep);
            }
            .ia-personal { margin-top: 0.4rem; }
            .ia-personal .row { padding: 1.3rem 0; }
            .ia-personal .pi-title { font-size: 1rem; font-weight: 600; color: var(--ink); }
            .ia-personal .pi-badge {
                display: inline-block;
                margin-left: 0.6rem;
                font-family: var(--font-head);
                font-size: 0.7rem;
                font-weight: 600;
                letter-spacing: 0.06em;
                text-transform: uppercase;
                color: var(--ink-faint);
            }
            .ia-personal .pi-desc { margin-top: 0.4rem; color: var(--ink-soft); font-size: 0.92rem; max-width: 62ch; }

            /* ---------- Tecnologías ---------- */
            .tech-list .row { padding: 1.3rem 0; }
            .tech-list .label {
                font-family: var(--font-head);
                font-size: 0.78rem;
                font-weight: 600;
                letter-spacing: 0.06em;
                text-transform: uppercase;
                color: var(--sand-deep);
            }
            .tech-list .vals { color: var(--ink); font-size: 0.95rem; }
            .tech-list .vals .sep { color: var(--line); margin: 0 0.35rem; }

            /* ---------- Formación ---------- */
            .edu .title { font-size: 1rem; font-weight: 600; color: var(--ink); }
            .edu .inst { color: var(--teal-deep); }
            .edu .period { color: var(--ink-faint); font-size: 0.88rem; }

            /* ---------- Docencia ---------- */
            .doc .head {
                display: flex;
                flex-wrap: wrap;
                align-items: baseline;
                justify-content: space-between;
                gap: 0.5rem 1.5rem;
            }
            .doc .role { font-size: 1.05rem; font-weight: 600; color: var(--ink); }
            .doc .org { color: var(--teal-deep); font-weight: 500; }
            .doc .when {
                font-family: var(--font-head);
                font-size: 0.78rem;
                font-weight: 600;
                letter-spacing: 0.06em;
                text-transform: uppercase;
                color: var(--ink-faint);
            }
            .doc p { margin-top: 0.85rem; color: var(--ink-soft); max-width: 62ch; }
            .doc .materias { margin-top: 1rem; color: var(--ink-faint); font-size: 0.88rem; }
            .doc .materias b { color: var(--sand-deep); font-family: var(--font-head); font-weight: 600; }

            /* ---------- Cierre ---------- */
            .closing { padding: 3rem 0 2.5rem; }
            .closing .wrap { display: flex; flex-direction: column; gap: 0.6rem; }
            .closing h2 {
                font-size: clamp(1.6rem, 3.5vw, 2.1rem);
                font-weight: 600;
                letter-spacing: -0.02em;
            }
            .closing .links { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; font-size: 0.95rem; color: var(--ink-soft); }
            .closing .links a { color: var(--teal-deep); border-bottom: 1px solid transparent; transition: border-color 0.15s ease; }
            .closing .links a:hover { border-bottom-color: var(--teal-deep); }
            .closing .links .sep { color: var(--line); }

            /* ---------- Footer ---------- */
            .site-footer { border-top: 1px solid var(--line); padding: 1.75rem 0; }
            .site-footer p { text-align: center; font-size: 0.82rem; color: var(--ink-faint); }

            /* ---------- Focus visible ---------- */
            a:focus-visible, button:focus-visible {
                outline: 2px solid var(--teal-deep);
                outline-offset: 2px;
                border-radius: 2px;
            }

            /* ---------- Responsive ---------- */
            @media (max-width: 720px) {
                .row { grid-template-columns: 1fr; gap: 0.4rem; }
                .row .meta { font-size: 0.74rem; }
                .exp .role { display: block; margin-left: 0; margin-top: 0.15rem; }
                .masthead { padding: 2.5rem 0 1.75rem; }
                section.block { padding: 2.25rem 0; }
                .sheet { margin: 16px auto 48px; border-radius: 10px; }
            }

            /* ---------- Print ---------- */
            @media print {
                :root { --paper: #fff; --paper-alt: #fff; --line: #d8d2c0; }
                .no-print { display: none !important; }
                body { background: #fff; font-size: 11pt; }
                .sheet { max-width: 100%; margin: 0; box-shadow: none; border: none; border-radius: 0; }
                .wrap { max-width: 100%; padding: 0; }
                .site-header, .site-footer, .closing { display: none; }
                .masthead { padding: 0 0 1.5rem; }
                section.block { padding: 1.4rem 0; }
                .rule { margin-top: 1.5rem; }
                .ia-flagship { background: #fff; border-color: var(--teal-deep); }
                * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
                a { color: var(--ink); }
                .exp .company.current { color: var(--teal-deep); }
            }
        </style>
    </head>
    <body>
        <header class="site-header no-print">
            <div class="wrap">
                <div class="site-brand">{content.header.brand}<span>{content.header.brandSub}</span></div>
                <div class="site-actions">
                    <a class="back-link" href={`/${lang}/portfolio`}>{content.header.portfolio}</a>
                    <a class="back-link" href={`/${lang}/servicios`}>{content.header.servicios}</a>
                    <a class="lang-toggle" href={altUrl}>{content.header.langLabel}</a>
                    <button class="btn-print" onclick="window.print()">{content.header.print}</button>
                </div>
            </div>
        </header>

        <div class="sheet">
        <main>
            <!-- Masthead -->
            <section class="masthead">
                <div class="wrap">
                    <h1>{content.masthead.name}</h1>
                    <p class="role" set:html={content.masthead.role}></p>
                    <p class="stack">{content.masthead.stack}</p>
                    <div class="contact">
                        <span>{content.masthead.location}</span>
                        <span class="sep">·</span>
                        <a href={`mailto:${content.closing.links[0].url.replace('mailto:', '')}`}>{content.closing.links[0].text}</a>
                        <span class="sep">·</span>
                        <a href={content.closing.links[1].url} target="_blank" rel="noopener">{content.closing.links[1].text}</a>
                        <span class="sep">·</span>
                        <a href={content.closing.links[2].url} target="_blank" rel="noopener">{content.closing.links[2].text}</a>
                    </div>
                    <hr class="rule" />
                </div>
            </section>

            <!-- PERFIL -->
            <section class="block perfil" id="perfil">
                <div class="wrap">
                    <div class="eyebrow"><span class="num">{content.perfil.num}</span><span class="label">{content.perfil.label}</span></div>
                    {content.perfil.paragraphs.map((p: string) => <p>{p}</p>)}
                    <ul class="highlights">
                        {content.perfil.highlights.map((h: string) => (
                            <li set:html={h.replace('{years}', String(years))}></li>
                        ))}
                    </ul>
                </div>
            </section>

            <!-- EXPERIENCIA -->
            <section class="block" id="experiencia">
                <div class="wrap">
                    <div class="eyebrow"><span class="num">{content.experiencia.num}</span><span class="label">{content.experiencia.label}</span></div>
                    <div class="rows exp">
                        {content.experiencia.jobs.map((job: any) => (
                            <div class="row">
                                <div class="meta">{job.period}</div>
                                <div class="body">
                                    <span class:list={['company', job.current ? 'current' : '']}>{job.company}</span><span class="role">{job.role}</span>
                                    {job.summary && <p class="summary">{job.summary}</p>}

                                    {job.sections.map((section: any) => (
                                        <div class="subhead">{section.title}</div>
                                        <ul class="items">
                                            {section.items.map((item: string) => <li>{item}</li>)}
                                        </ul>
                                    ))}

                                    {job.items && (
                                        <ul class="items">
                                            {job.items.map((item: string) => <li>{item}</li>)}
                                        </ul>
                                    )}

                                    {job.also && <p class="also" set:html={job.also}></p>}
                                    {job.stack && <p class="tech"><b>Stack</b> · {job.stack}</p>}
                                </div>
                            </div>
                        ))}
                    </div>
                </div>
            </section>

            <!-- PROYECTOS -->
            <section class="block" id="proyectos">
                <div class="wrap">
                    <div class="eyebrow"><span class="num">{content.proyectos.num}</span><span class="label">{content.proyectos.label}</span></div>
                    <p class="proyectos-intro">{content.proyectos.intro}</p>
                    <div class="proyectos-list">
                        {content.proyectos.items.map((p: any) => (
                            <div class="proyecto">
                                <div class="proyecto-head">
                                    <span class="proyecto-title">{p.title}</span>
                                    <span class="proyecto-client">{p.client} · {p.meta}</span>
                                </div>
                                <p class="proyecto-desc">{p.desc}</p>
                                <p class="tech"><b>Stack</b> · {p.stack}</p>
                            </div>
                        ))}
                    </div>
                </div>
            </section>

            <!-- IA & DATOS -->
            <section class="block" id="ia-datos">
                <div class="wrap">
                    <div class="eyebrow"><span class="num">{content.ia.num}</span><span class="label">{content.ia.label}</span></div>
                    <div class="ia-flagship">
                        <div class="head">
                            <span class="title">{content.ia.flagship.title}</span>
                            <span class="badge">{content.ia.flagship.badge}</span>
                        </div>
                        <ul>
                            {content.ia.flagship.items.map((item: string) => <li>{item}</li>)}
                        </ul>
                    </div>

                    <div class="ia-personal">
                        {content.ia.personal.map((p: any) => (
                            <div class="row">
                                <div class="meta">{content.ia.personalMeta}</div>
                                <div class="body">
                                    <span class="pi-title">{p.title}</span><span class="pi-badge"></span>
                                    <p class="pi-desc">{p.desc}</p>
                                </div>
                            </div>
                        ))}
                    </div>
                </div>
            </section>

            <!-- TECNOLOGÍAS -->
            <section class="block" id="tecnologias">
                <div class="wrap">
                    <div class="eyebrow"><span class="num">{content.tecnologias.num}</span><span class="label">{content.tecnologias.label}</span></div>
                    <div class="rows tech-list">
                        {content.tecnologias.rows.map((row: any) => (
                            <div class="row">
                                <div class="meta label" set:html={row.label}></div>
                                <div class="vals">
                                    {row.vals.map((v: string, i: number) => (
                                        <>
                                            <span set:html={v}></span>{i < row.vals.length - 1 && <span class="sep">·</span>}
                                        </>
                                    ))}
                                </div>
                            </div>
                        ))}
                    </div>
                </div>
            </section>

            <!-- FORMACIÓN -->
            <section class="block" id="formacion">
                <div class="wrap">
                    <div class="eyebrow"><span class="num">{content.formacion.num}</span><span class="label">{content.formacion.label}</span></div>
                    <div class="rows edu">
                        {content.formacion.rows.map((row: any) => (
                            <div class="row">
                                <div class="meta">{row.period}</div>
                                <div class="body">
                                    <span class="title">{row.title}</span>
                                    <div class="period"><span class="inst">{row.inst}</span></div>
                                </div>
                            </div>
                        ))}
                    </div>
                </div>
            </section>

            <!-- DOCENCIA -->
            <section class="block doc" id="docencia">
                <div class="wrap">
                    <div class="eyebrow"><span class="num">{content.docencia.num}</span><span class="label">{content.docencia.label}</span></div>
                    <div class="head">
                        <div><span class="role">{content.docencia.role}</span> <span class="org">{content.docencia.org}</span></div>
                        <span class="when">{content.docencia.when}</span>
                    </div>
                    <p>{content.docencia.description}</p>
                    <p class="materias">
                        <b>{content.docencia.materiasLabel}</b> · {content.docencia.materias}
                    </p>
                </div>
            </section>

            <!-- Cierre -->
            <section class="closing no-print">
                <div class="wrap">
                    <h2>{content.closing.title}</h2>
                    <div class="links">
                        {content.closing.links.map((link: any, i: number) => (
                            <>
                                {i > 0 && <span class="sep">·</span>}
                                <a href={link.url} target={link.url.startsWith('http') ? '_blank' : undefined} rel={link.url.startsWith('http') ? 'noopener' : undefined}>{link.text}</a>
                            </>
                        ))}
                    </div>
                </div>
            </section>
        </main>

        <footer class="site-footer">
            <div class="wrap">
                <p set:html={content.footer.text}></p>
            </div>
        </footer>
        </div>
    </body>
</html>
