  <script is:inline>
    (function () {
      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* ============ Headline rotativo ============ */
      if (!reduceMotion) {
        var rotate = document.getElementById('svRotate');
        var items = rotate ? rotate.querySelectorAll('.rotate-item') : [];
        if (items.length > 1) {
          var idx = 0;
          setInterval(function () {
            items[idx].classList.remove('is-active');
            idx = (idx + 1) % items.length;
            items[idx].classList.add('is-active');
          }, 3200);
        }
      }

      /* ============ Spotlight que sigue al cursor ============ */
      if (!reduceMotion) {
        var hero = document.getElementById('svHero');
        var spot = document.getElementById('svSpotlight');
        var raf = null;
        function onMove(e) {
          if (raf) return;
          raf = requestAnimationFrame(function () {
            raf = null;
            var rect = hero.getBoundingClientRect();
            var x = e.clientX - rect.left;
            var y = e.clientY - rect.top;
            spot.style.setProperty('--mx', x + 'px');
            spot.style.setProperty('--my', y + 'px');
          });
        }
        hero.addEventListener('mousemove', onMove);
      }

      /* ============ Count-up ============ */
      function countUp(el, target, suffix) {
        var dur = 1400;
        var start = null;
        function step(ts) {
          if (!start) start = ts;
          var p = Math.min((ts - start) / dur, 1);
          var eased = 1 - Math.pow(1 - p, 3);
          var val = target * eased;
          var decimals = (target % 1 !== 0) ? 1 : 0;
          el.textContent = val.toFixed(decimals) + suffix;
          if (p < 1) requestAnimationFrame(step);
        }
        requestAnimationFrame(step);
      }

      /* ============ Reveal + count-up ============ */
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              var el = entry.target;
              el.classList.add('is-visible');
              if (el.hasAttribute('data-count')) {
                countUp(el, parseFloat(el.getAttribute('data-count')), el.getAttribute('data-suffix') || '');
              }
              io.unobserve(el);
            }
          });
        }, { threshold: 0.25 });

        document.querySelectorAll('.reveal').forEach(function (el) { io.observe(el); });

        if (!reduceMotion) {
          document.querySelectorAll('.sv-verify b[data-count]').forEach(function (el) {
            el.setAttribute('data-count', el.getAttribute('data-count'));
            io.observe(el);
          });
        }
      } else {
        document.querySelectorAll('.reveal').forEach(function (el) { el.classList.add('is-visible'); });
      }
    })();
  </script>
