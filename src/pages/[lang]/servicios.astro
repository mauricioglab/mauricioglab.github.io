---
import BaseTailwind from '@layouts/BaseTailwind.astro';
import ContactModal from '@components/landing/ContactModal.astro';
import { SITE_CONFIG } from '@data/config';
import { getLanguagePaths } from '@utils/i18n-paths';
import { type Lang, useTranslations, getAlternateUrl } from '@i18n/index';
import SeoHead from '@components/shared/SeoHead.astro';

export const getStaticPaths = getLanguagePaths;

const { lang } = Astro.params as { lang: Lang };
const content = await useTranslations<any>(lang, 'services');
const altPath = getAlternateUrl(Astro.url, lang);
const altLang = lang === 'es' ? 'en' : 'es';
const canonical = new URL(Astro.url.pathname, Astro.site).toString();

const cards = content.services.map((s: any) => ({
  title: s.title,
  description: s.description,
  icon: s.icon,
  color: s.color,
  group: s.group,
}));

const groups = content.groups.map((g: any) => ({
  id: g.id,
  label: g.label,
  items: cards.filter((c: any) => c.group === g.id),
}));

// Mapa de colores por servicio (para diferenciar el ícono de cada card)
const iconColorMap: Record<string, string> = {
  'blue-600': '#1d4ed8',
  'slate-900': '#334155',
  'purple-600': '#7c3aed',
  'emerald-600': '#059669',
  'orange-600': '#ea580c',
  'green-600': '#16a34a',
};

// Mailto del speaking (funnel separado del modal genérico)
const speakingSubject = lang === 'es' ? 'Evento / Charla' : 'Event / Talk';
const speakingMailto = `mailto:${SITE_CONFIG.email}?subject=${encodeURIComponent(speakingSubject)}`;

// Íconos (SVG inline — sin FontAwesome)
const iconPaths: Record<string, string> = {
  'fas fa-comments': 'M8 10h.01M12 10h.01M16 10h.01M21 16c0 1.1-.9 2-2 2H7l-4 4V5c0-1.1.9-2 2-2h14c1.1 0 2 .9 2 2v11z',
  'fas fa-code': 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
  'fas fa-brain': 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z',
  'fas fa-cogs': 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z',
  'fas fa-chalkboard-teacher': 'M12 14l9-5-9-5-9 5 9 5zm0 0v5m-5 0h10M7 14l-3 5m16-5l3 5',
  'fas fa-microphone': 'M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-11a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z',
  'fas fa-search': 'M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z',
  'fas fa-clipboard-check': 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4',
};
const defaultIcon = 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253';
---

<BaseTailwind title={content.seo.title} description={content.seo.description} lang={lang} layoutType="landing">
  <SeoHead slot="head" title={content.seo.title} description={content.seo.description} lang={lang} canonical={canonical} />
  <style>
    :root {
      --accent: #1d4ed8;
      --accent-deep: #1e40af;
      --accent-soft: #eef2ff;
      --ink: #141a2e;
      --muted: #5c6785;
      --faint: #8b94ab;
      --line: #e4e8f0;
      --panel: #f4f6fa;
      --font-head: 'Space Grotesk', 'Inter', system-ui, sans-serif;
      --font-body: 'Inter', system-ui, sans-serif;
    }
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--panel); color: var(--ink); font-family: var(--font-body); font-size: 16px; line-height: 1.65; -webkit-font-smoothing: antialiased; }
    h1, h2, h3, h4 { font-family: var(--font-head); line-height: 1.15; margin: 0; letter-spacing: -0.02em; font-weight: 600; }
    p { margin: 0; }
    a { color: inherit; text-decoration: none; }
    .accent { color: var(--accent-deep); }

    /* ---------- Header ---------- */
    .sv-header {
      position: sticky; top: 0; z-index: 50;
      background: rgba(255,255,255,.92);
      backdrop-filter: saturate(1.4) blur(8px);
      border-bottom: 1px solid var(--line);
    }
    .sv-header .row { max-width: 1100px; margin: 0 auto; padding: 16px 28px; display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
    .sv-brand { font-family: var(--font-head); font-weight: 600; font-size: .95rem; color: var(--ink); letter-spacing: .02em; }
    .sv-brand b { color: var(--accent); }
    .sv-brand .sub { font-weight: 400; font-size: .8rem; color: var(--faint); margin-left: .5rem; }
    .sv-nav { display: flex; align-items: center; gap: .75rem; }
    .sv-nav a.link { color: var(--muted); font-size: .85rem; text-decoration: none; padding: 6px 10px; border-radius: 8px; transition: color .15s; }
    .sv-nav a.link:hover { color: var(--ink); background: var(--panel); }
    .sv-toggle {
      font-family: var(--font-head); font-size: .8rem; font-weight: 600; color: var(--muted);
      border: 1px solid var(--line); background: #fff;
      padding: 7px 14px; border-radius: 999px; text-decoration: none; transition: border-color .15s, color .15s;
    }
    .sv-toggle:hover { border-color: var(--accent); color: var(--accent-deep); }
    .sv-cta {
      font-family: var(--font-head); font-size: .82rem; font-weight: 600; color: #fff; background: var(--accent-deep);
      border: none; padding: 10px 18px; border-radius: 10px; cursor: pointer; transition: opacity .15s;
    }
    .sv-cta:hover { opacity: .9; }

    /* ---------- Hero ---------- */
    .sv-hero {
      position: relative; overflow: hidden;
      padding: 96px 28px 72px; text-align: center;
      background: #fff; border-bottom: 1px solid var(--line);
    }
    .sv-hero .wrap { position: relative; z-index: 2; max-width: 820px; margin: 0 auto; }

    /* Aurora gradient (dos blobs que se desplazan lento) */
    .sv-aurora { position: absolute; inset: 0; z-index: 0; pointer-events: none; filter: blur(70px); }
    .sv-aurora .blob {
      position: absolute; width: 55vw; height: 55vw; max-width: 720px; max-height: 720px; border-radius: 50%;
      opacity: .3;
    }
    .sv-aurora .b1 { background: #7ea2ff; top: -20%; left: -10%; animation: drift1 16s ease-in-out infinite alternate; }
    .sv-aurora .b2 { background: #b7a6ff; bottom: -30%; right: -10%; animation: drift2 20s ease-in-out infinite alternate; }
    @keyframes drift1 { 0% { transform: translate(0,0) scale(1); } 100% { transform: translate(12vw, 8vh) scale(1.15); } }
    @keyframes drift2 { 0% { transform: translate(0,0) scale(1.1); } 100% { transform: translate(-10vw, -6vh) scale(.95); } }

    /* Spotlight que sigue al cursor */
    .sv-spotlight {
      position: absolute; inset: 0; z-index: 1; pointer-events: none;
      background: radial-gradient(420px circle at var(--mx, 50%) var(--my, 30%), rgba(29,78,216,.14), transparent 70%);
    }

    .sv-badge {
      display: inline-flex; align-items: center; gap: 8px;
      font-family: var(--font-head); font-size: .72rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase;
      color: var(--accent-deep); background: var(--accent-soft);
      padding: 7px 16px; border-radius: 999px; margin-bottom: 26px;
    }
    .sv-badge .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); animation: sv-pulse 2s infinite; }
    @keyframes sv-pulse { 0%,100% { opacity: 1; } 50% { opacity: .35; } }

    .sv-hero h1 {
      font-size: clamp(2.3rem, 5.4vw, 3.6rem); font-weight: 600; line-height: 1.06;
      color: var(--ink); letter-spacing: -0.03em; max-width: 780px; margin: 0 auto;
    }
    .sv-hero h1 .rotate {
      display: grid; color: var(--accent-deep); margin-top: .1em;
    }
    .sv-hero h1 .rotate-item {
      grid-area: 1 / 1; opacity: 0; transform: translateY(8px);
      transition: opacity .45s ease, transform .45s ease;
    }
    .sv-hero h1 .rotate-item.is-active { opacity: 1; transform: translateY(0); }
    .sv-hero .sub { margin: 20px auto 0; max-width: 620px; color: var(--muted); font-size: 1.06rem; line-height: 1.7; }
    .sv-hero .actions { margin-top: 36px; display: flex; flex-wrap: wrap; justify-content: center; gap: 14px; }
    .sv-btn-primary {
      background: var(--accent-deep); color: #fff; font-family: var(--font-head); font-weight: 600; font-size: .92rem;
      padding: 13px 26px; border-radius: 12px; border: none; cursor: pointer; transition: opacity .15s, transform .15s;
    }
    .sv-btn-primary:hover { opacity: .92; transform: translateY(-1px); }
    .sv-btn-ghost {
      background: transparent; color: var(--accent-deep); font-family: var(--font-head); font-weight: 600; font-size: .92rem;
      padding: 12px 24px; border-radius: 12px; border: 1.5px solid var(--accent-deep); text-decoration: none; transition: background .15s, color .15s;
    }
    .sv-btn-ghost:hover { background: var(--accent-deep); color: #fff; }

    .sv-verify {
      margin-top: 52px; display: flex; justify-content: center; gap: 40px; flex-wrap: wrap;
      font-family: var(--font-head); font-size: 12px; color: var(--muted);
    }
    .sv-verify b { display: block; font-family: inherit; font-size: 24px; color: var(--ink); font-weight: 700; letter-spacing: -.01em; }

    /* ---------- Servicios ---------- */
    .sv-section { padding: 64px 28px; max-width: 1100px; margin: 0 auto; }
    .sv-title { text-align: center; font-size: 1.7rem; font-weight: 600; color: var(--ink); margin-bottom: 8px; letter-spacing: -.02em; }
    .sv-subtitle { text-align: center; color: var(--muted); max-width: 560px; margin: 0 auto 44px; }
    .sv-group { margin-bottom: 40px; }
    .sv-group:last-child { margin-bottom: 0; }
    .sv-group-title { font-family: var(--font-head); font-size: .82rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--accent-deep); margin: 0 0 16px; }

    .sv-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; }
    .sv-pair { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; margin-bottom: 40px; }
    .sv-pair:last-child { margin-bottom: 0; }
    .sv-pair .sv-group { margin-bottom: 0; }
    .sv-grid--stacked { display: grid; grid-template-columns: 1fr; gap: 20px; }
    .sv-card {
      background: #fff; padding: 30px 26px; border-radius: 14px; border: 1px solid var(--line);
      display: flex; flex-direction: column; gap: 14px; transition: transform .18s, box-shadow .18s, border-color .18s;
    }
    .sv-card:hover { transform: translateY(-3px); box-shadow: 0 20px 44px -24px rgba(29,78,216,.28); border-color: #c7d2fe; }
    .sv-card .icon {
      width: 46px; height: 46px; border-radius: 12px; display: flex; align-items: center; justify-content: center;
      background: var(--icon-bg, var(--accent-soft)); color: var(--icon-color, var(--accent-deep));
    }
    .sv-card .icon svg { width: 22px; height: 22px; }
    .sv-card h3 { font-size: 1.1rem; font-weight: 600; color: var(--ink); margin: 0; }
    .sv-card p { font-size: .9rem; color: var(--muted); line-height: 1.65; margin: 0; }

    /* ---------- Casos con resultado ---------- */
    .sv-cases { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
    .sv-case {
      background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 26px 24px;
      display: flex; flex-direction: column; gap: 12px; transition: transform .18s, box-shadow .18s;
    }
    .sv-case:hover { transform: translateY(-3px); box-shadow: 0 20px 44px -24px rgba(29,78,216,.28); }
    .sv-case .who { font-family: var(--font-head); font-size: .72rem; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--accent-deep); }
    .sv-case .what { font-size: .95rem; font-weight: 600; color: var(--ink); }
    .sv-case .res { font-size: .86rem; color: var(--muted); line-height: 1.6; }
    .sv-case .metric { font-family: var(--font-head); font-size: 2rem; font-weight: 700; color: var(--accent); letter-spacing: -.02em; }

    /* ---------- Cómo trabajo ---------- */
    .sv-steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
    .sv-step {
      background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 26px 24px;
      display: flex; flex-direction: column; gap: 10px;
    }
    .sv-step .n {
      font-family: var(--font-head); font-size: .9rem; font-weight: 700; color: #fff; background: var(--accent-deep);
      width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center;
    }
    .sv-step h3 { font-size: 1.05rem; font-weight: 600; color: var(--ink); }
    .sv-step p { font-size: .88rem; color: var(--muted); line-height: 1.6; }

    /* ---------- Speaking ---------- */
    .sv-speaking {
      max-width: 820px; margin: 0 auto; text-align: center;
      background: var(--accent-soft); border: 1px solid #c7d2fe; border-radius: 18px;
      padding: 44px 40px;
    }
    .sv-speaking .k { font-family: var(--font-head); font-size: .72rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--accent-deep); margin-bottom: 12px; }
    .sv-speaking h2 { font-size: 1.6rem; font-weight: 600; color: var(--ink); margin: 0 0 12px; letter-spacing: -.02em; }
    .sv-speaking p { color: var(--muted); line-height: 1.7; max-width: 620px; margin: 0 auto 18px; }
    .sv-speaking .cred { font-size: .82rem; color: var(--accent-deep); font-weight: 600; margin-bottom: 24px; }
    .sv-speaking .sp-cta {
      display: inline-block; font-family: var(--font-head); font-weight: 600; font-size: .92rem;
      color: #fff; background: var(--accent-deep); padding: 13px 26px; border-radius: 12px; border: none; cursor: pointer; transition: transform .15s, opacity .15s;
    }
    .sv-speaking .sp-cta:hover { transform: translateY(-1px); opacity: .92; }

    /* ---------- CTA final ---------- */
    .sv-final { padding: 72px 28px; }
    .sv-final .box {
      max-width: 900px; margin: 0 auto; text-align: center;
      background: linear-gradient(135deg, #1e40af, #4338ca); color: #fff;
      border-radius: 18px; padding: 56px 44px;
    }
    .sv-final h2 { font-size: 1.9rem; font-weight: 600; margin: 0 0 12px; letter-spacing: -.02em; }
    .sv-final p { font-size: 1.05rem; opacity: .92; margin: 0 0 28px; }
    .sv-final .actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 14px; }
    .sv-final .a-white { background: #fff; color: var(--accent-deep); font-family: var(--font-head); font-weight: 600; font-size: .92rem; padding: 13px 26px; border-radius: 12px; border: none; cursor: pointer; transition: transform .15s; }
    .sv-final .a-white:hover { transform: translateY(-1px); }
    .sv-final .a-ghost { background: transparent; color: #fff; font-family: var(--font-head); font-weight: 600; font-size: .92rem; padding: 12px 24px; border-radius: 12px; border: 2px solid #fff; text-decoration: none; }

    /* ---------- Footer ---------- */
    .sv-footer { border-top: 1px solid var(--line); background: #fff; padding: 26px 28px; text-align: center; font-size: .82rem; color: var(--faint); }

    /* ---------- Reveal ---------- */
    .reveal { opacity: 0; transform: translateY(18px); transition: opacity .6s ease, transform .6s ease; }
    .reveal.is-visible { opacity: 1; transform: translateY(0); }

    /* ---------- Responsive ---------- */
    @media (max-width: 860px) {
      .sv-cases, .sv-steps { grid-template-columns: 1fr 1fr; }
      .sv-aurora .blob { width: 80vw; height: 80vw; }
      .sv-pair { grid-template-columns: 1fr; gap: 32px; }
    }
    @media (max-width: 560px) {
      .sv-cases, .sv-steps { grid-template-columns: 1fr; }
      .sv-hero { padding: 64px 20px 52px; }
      .sv-verify { gap: 24px; }
    }

    @media (prefers-reduced-motion: reduce) {
      .sv-aurora, .sv-spotlight { display: none; }
      .reveal { opacity: 1; transform: none; transition: none; }
    }
  </style>

  <!-- Header -->
  <header class="sv-header">
    <div class="row">
      <div class="sv-brand">MG<b>.</b><span class="sub">| {content.subtitle}</span></div>
      <div class="sv-nav">
        <a class="link" href={`/${lang}/portfolio`}>{content.nav.portfolio}</a>
        <a class="link" href={`/${lang}/cv`}>{content.nav.cv}</a>
        <a class="sv-toggle" href={altPath}>{altLang.toUpperCase()}</a>
        <button class="sv-cta" data-contact-trigger>{lang === 'es' ? 'Contactar' : 'Contact'}</button>
      </div>
    </div>
  </header>

  <main>
    <!-- Hero -->
    <section class="sv-hero" id="svHero">
      <div class="sv-aurora" aria-hidden="true">
        <div class="blob b1"></div>
        <div class="blob b2"></div>
      </div>
      <div class="sv-spotlight" aria-hidden="true" id="svSpotlight"></div>
      <div class="wrap">
        <div class="sv-badge"><span class="dot"></span>{content.hero.badge}</div>
        <h1>
          {content.hero.headlinePrefix}
          <span class="rotate" id="svRotate">
            {content.hero.rotate.map((r: string, i: number) => (
              <span class:list={['rotate-item', i === 0 ? 'is-active' : '']}>{r}</span>
            ))}
          </span>
        </h1>
        <p class="sub">{content.hero.subheadline}</p>
        <div class="actions">
          <button class="sv-btn-primary" data-contact-trigger>{content.hero.ctaPrimary}</button>
          <a class="sv-btn-ghost" href={`/${lang}/portfolio`}>{content.hero.ctaSecondary}</a>
        </div>
        <div class="sv-verify">
          <div><b data-count="99.8" data-suffix="%">0%</b>{lang === 'es' ? 'precisión biométrica' : 'biometric precision'}</div>
          <div><b data-count="500" data-suffix="+">0+</b>{lang === 'es' ? 'verificaciones/día en prod' : 'verifications/day in prod'}</div>
          <div><b data-count="87.5" data-suffix="%">0%</b>{lang === 'es' ? 'reducción de tiempo' : 'time reduction'}</div>
        </div>
      </div>
    </section>

    <!-- Servicios -->
    <section class="sv-section">
      <h2 class="sv-title">{content.description}</h2>
      <p class="sv-subtitle">{content.sectionSubtitle}</p>
      {(() => {
        const pairIds = ['consultoria', 'capacitacion'];
        const pair = pairIds.map(id => groups.find((g: any) => g.id === id)).filter(Boolean);
        const rest = groups.filter((g: any) => !pairIds.includes(g.id));
        return (
          <>
            {pair.length > 0 && (
              <div class="sv-pair">
                {pair.map((group: any) => (
                  <div class="sv-group">
                    <h3 class="sv-group-title">{group.label}</h3>
                    <div class="sv-grid sv-grid--stacked">
                      {group.items.map((card: any) => (
                        <div class="sv-card reveal" style={`--icon-bg:${iconColorMap[card.color] || '#1d4ed8'}1a; --icon-color:${iconColorMap[card.color] || '#1d4ed8'}`}>
                          <div class="icon">
                            <svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" d={iconPaths[card.icon] || defaultIcon} />
                            </svg>
                          </div>
                          <h3>{card.title}</h3>
                          <p>{card.description}</p>
                        </div>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            )}
            {rest.map((group) => (
              <div class="sv-group">
                <h3 class="sv-group-title">{group.label}</h3>
                <div class="sv-grid">
                  {group.items.map((card) => (
                    <div class="sv-card reveal" style={`--icon-bg:${iconColorMap[card.color] || '#1d4ed8'}1a; --icon-color:${iconColorMap[card.color] || '#1d4ed8'}`}>
                      <div class="icon">
                        <svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" d={iconPaths[card.icon] || defaultIcon} />
                        </svg>
                      </div>
                      <h3>{card.title}</h3>
                      <p>{card.description}</p>
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </>
        );
      })()}
    </section>

    <!-- Casos con resultado -->
    <section class="sv-section">
      <h2 class="sv-title">{lang === 'es' ? 'Casos con resultado' : 'Results, not promises'}</h2>
      <p class="sv-subtitle">{lang === 'es' ? 'No te cuento lo que podría hacer. Te muestro lo que ya hice, con números.' : "I won't tell you what I could do. I'll show you what I already did, with numbers."}</p>
      <div class="sv-cases">
        <div class="sv-case reveal">
          <div class="who">Coca-Cola Embonor</div>
          <div class="what">{lang === 'es' ? 'Integración contable con SAP' : 'SAP accounting integration'}</div>
