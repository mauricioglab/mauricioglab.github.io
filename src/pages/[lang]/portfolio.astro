---
import BaseTailwind from '@layouts/BaseTailwind.astro';
import ContactModal from '@components/landing/ContactModal.astro';
import CaseStudyModal from '@components/case-study/CaseStudyModal.astro';
import { getProjectsByProfile } from '@data/projects';
import { getLanguagePaths } from '@utils/i18n-paths';
import { type Lang, useTranslations, getAlternateUrl } from '@i18n/index';
import SeoHead from '@components/shared/SeoHead.astro';

export const getStaticPaths = getLanguagePaths;

const { lang } = Astro.params as { lang: Lang };
const content = await useTranslations<any>(lang, 'engineer');
const t = await useTranslations<any>(lang, 'portfolio');
const projectsT = await useTranslations<any>(lang, 'projects');
const modalT = await useTranslations<any>(lang, 'case-modal');
const altPath = getAlternateUrl(Astro.url, lang);
const altLang = lang === 'es' ? 'en' : 'es';
const canonical = new URL(Astro.url.pathname, Astro.site).toString();

const projects = getProjectsByProfile('engineer', true);

// Agrupación por tipo de proyecto (los 3 pilares del posicionamiento)
const categoryLabels: Record<string, string> = {
  ia: lang === 'es' ? 'IA y Datos' : 'AI & Data',
  desarrollo: lang === 'es' ? 'Desarrollo y Arquitectura' : 'Development & Architecture',
  analisis: lang === 'es' ? 'Análisis de Sistemas' : 'Systems Analysis',
};
const categoryOrder = ['ia', 'desarrollo', 'analisis'] as const;
const projectGroups = categoryOrder
  .map((cat) => ({
    category: cat,
    label: categoryLabels[cat],
    items: projects.filter((p) => (p.category || 'ia') === cat),
  }))
  .filter((g) => g.items.length > 0);

const startDate = new Date('2021-07-01');
const years = Math.floor((Date.now() - startDate.getTime()) / (1000 * 60 * 60 * 24 * 365.25));

const headline = content.hero.headline
  .replace('text-blue-600 dark:text-blue-400', 'accent');

const modalLabels = {
  title: modalT.title,
  viewFull: modalT.viewFull,
  contact: modalT.contact,
  close: modalT.close,
  problem: modalT.problem,
  solution: modalT.solution,
};
const modalCases = modalT.cases;

const caseStudyUrls: Record<string, string | undefined> = {
  'validacion-biometrica': '/proyectos/validacion-biometrica',
  'billetera-virtual': '/proyectos/billetera-virtual',
  'monitoreo-agricola': '/proyectos/monitoreo-agricola',
  'auditorias-datos': '/proyectos/auditorias-datos',
  'coca-cola-embonor': '/proyectos/coca-cola-embonor',
  'mundial-2026': '/proyectos/mundial-2026',
  'abandono-estudiantil': '/proyectos/abandono-estudiantil',
  'caso-arquitectura': '/caso-arquitectura',
};

// Stack técnico: cada tecnología con su slug oficial de Simple Icons (isologotipo)
// Los slugs sin logo se marcan con "" (chip de solo texto)
const skillGroups: { label: string; items: { name: string; slug: string }[] }[] = [
  {
    label: 'Backend',
    items: [
      { name: '.NET Core', slug: 'dotnet' },
      { name: 'C#', slug: 'csharp' },
      { name: 'ASP.NET', slug: 'dotnet' },
      { name: 'Entity Framework', slug: 'dotnet' },
      { name: 'Node.js', slug: 'nodedotjs' },
      { name: 'NestJS', slug: 'nestjs' },
    ],
  },
  {
    label: 'Frontend',
    items: [
      { name: 'Angular', slug: 'angular' },
      { name: 'TypeScript', slug: 'typescript' },
      { name: 'JavaScript', slug: 'javascript' },
      { name: 'React', slug: 'react' },
      { name: 'React Native', slug: 'react' },
    ],
  },
  {
    label: lang === 'es' ? 'IA y Datos' : 'AI & Data',
    items: [
      { name: 'Python', slug: 'python' },
      { name: 'Pandas', slug: 'pandas' },
      { name: 'NumPy', slug: 'numpy' },
      { name: 'scikit-learn', slug: 'scikitlearn' },
      { name: 'Streamlit', slug: 'streamlit' },
      { name: 'Plotly', slug: 'plotly' },
      { name: 'Power BI', slug: 'powerbi' },
      { name: 'AWS Rekognition', slug: 'amazonwebservices' },
      { name: 'SQL', slug: '' },
    ],
  },
  {
    label: lang === 'es' ? 'Cloud, DevOps & Arquitectura' : 'Cloud, DevOps & Architecture',
    items: [
      { name: 'AWS', slug: 'amazonwebservices' },
      { name: 'Docker', slug: 'docker' },
      { name: 'Amazon ECS', slug: 'amazonwebservices' },
      { name: 'CI/CD', slug: '' },
      { name: 'DDD / CQRS', slug: '' },
      { name: lang === 'es' ? 'Microservicios' : 'Microservices', slug: '' },
    ],
  },
  {
    label: lang === 'es' ? 'Idiomas' : 'Languages',
    items: [{ name: lang === 'es' ? 'Inglés B2 (intermedio alto)' : 'English B2 (upper-intermediate)', slug: '' }],
  },
];
---

<BaseTailwind title={t.seo.title} description={t.seo.description} lang={lang} layoutType="landing">
  <SeoHead slot="head" title={t.seo.title} description={t.seo.description} lang={lang} canonical={canonical} />
  <style>
    :root {
      --paper: #f4f6fa;
      --ink: #141a2e;
      --ink-soft: #5c6785;
      --ink-faint: #8b94ab;
      --line: #e4e8f0;
      --teal: #1d4ed8;
      --teal-deep: #1e40af;
      --teal-tint: #eef2ff;
      --sand-deep: #1e40af;
      --font-head: 'Space Grotesk', 'Inter', system-ui, sans-serif;
      --font-body: 'Inter', system-ui, sans-serif;
    }
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--paper); color: var(--ink); font-family: var(--font-body); font-size: 16px; line-height: 1.65; -webkit-font-smoothing: antialiased; }
    h1, h2, h3, h4 { font-family: var(--font-head); line-height: 1.15; margin: 0; letter-spacing: -0.015em; font-weight: 600; }
    p { margin: 0; }
    a { color: inherit; text-decoration: none; }
    .wrap { width: 100%; max-width: 1080px; margin: 0 auto; padding: 0 28px; }
    .accent { color: var(--teal-deep); }

    /* Header */
    .pf-header { position: sticky; top: 0; z-index: 50; background: rgba(255,255,255,.92); backdrop-filter: blur(8px); border-bottom: 1px solid var(--line); }
    .pf-header .row { max-width: 1080px; margin: 0 auto; padding: 16px 28px; display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
    .pf-brand { font-family: var(--font-head); font-weight: 600; font-size: .95rem; color: var(--ink); }
    .pf-brand span { color: var(--ink-faint); font-weight: 400; }
    .pf-nav { display: flex; align-items: center; gap: 1.1rem; }
    .pf-nav a.link { font-size: .85rem; color: var(--ink-soft); transition: color .15s; }
    .pf-nav a.link:hover { color: var(--teal-deep); }
    .pf-toggle { font-family: var(--font-head); font-size: .8rem; font-weight: 600; color: var(--ink-soft); border: 1px solid var(--line); padding: .45rem .9rem; border-radius: 999px; transition: border-color .15s, color .15s; }
    .pf-toggle:hover { border-color: var(--teal-deep); color: var(--teal-deep); }
    .pf-cta { font-family: var(--font-head); font-size: .82rem; font-weight: 600; color: #fff; background: var(--teal-deep); border: none; padding: .55rem 1.15rem; border-radius: 999px; cursor: pointer; transition: opacity .15s; }
    .pf-cta:hover { opacity: .9; }

    /* Hero */
    .pf-hero { padding: 72px 0 40px; text-align: center; }
    .pf-badges { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin-bottom: 26px; }
    .pf-badges span { font-family: var(--font-head); font-size: .72rem; font-weight: 600; letter-spacing: .04em; color: var(--teal-deep); background: var(--teal-tint); padding: 6px 14px; border-radius: 999px; }
    .pf-hero h1 { font-size: clamp(2rem, 5vw, 3.2rem); font-weight: 600; letter-spacing: -0.02em; max-width: 780px; margin: 0 auto; }
    .pf-hero p.sub { margin: 18px auto 0; max-width: 620px; color: var(--ink-soft); font-size: 1.05rem; line-height: 1.7; }
    .pf-trusted { margin-top: 28px; display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 8px 22px; font-size: .82rem; color: var(--ink-faint); }
    .pf-trusted .lbl { font-family: var(--font-head); font-size: .68rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-faint); }
    .pf-trusted .cl { font-weight: 600; color: var(--ink-soft); }
    .pf-hero .actions { margin-top: 32px; display: flex; flex-wrap: wrap; justify-content: center; gap: 14px; }
    .pf-btn-solid { display: inline-flex; align-items: center; gap: 8px; background: var(--teal-deep); color: #fff; font-weight: 600; font-size: .9rem; padding: 12px 22px; border-radius: 999px; transition: opacity .15s; }
    .pf-btn-solid:hover { opacity: .9; }
    .pf-btn-ghost { display: inline-flex; align-items: center; gap: 8px; color: var(--teal-deep); font-weight: 600; font-size: .9rem; padding: 11px 20px; border-radius: 999px; border: 1.5px solid var(--teal-deep); transition: background .15s, color .15s; }
    .pf-btn-ghost:hover { background: var(--teal-deep); color: #fff; }
    .rule { border: 0; border-top: 1px solid var(--line); margin: 40px 0 0; }

    /* Sections */
    .pf-section { padding: 56px 0; }
    .eyebrow { display: flex; align-items: baseline; gap: .85rem; margin-bottom: 1.6rem; }
    .eyebrow .num { font-family: var(--font-head); font-size: .74rem; font-weight: 700; color: var(--sand-deep); letter-spacing: .08em; }
    .eyebrow .label { font-family: var(--font-head); font-size: .78rem; font-weight: 600; text-transform: uppercase; letter-spacing: .18em; color: var(--teal-deep); }
    .eyebrow .label::before { content: ''; display: inline-block; width: 22px; height: 2px; background: var(--teal); vertical-align: middle; margin-right: .7rem; transform: translateY(-3px); }

    /* Projects grid */
    .pf-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    .pf-card {
      background: #fff; border: 1px solid var(--line); border-radius: 6px; padding: 24px;
      display: flex; flex-direction: column; gap: 12px; cursor: pointer; transition: transform .15s, box-shadow .15s, border-color .15s;
    }
    .pf-card:hover { transform: translateY(-2px); box-shadow: 0 18px 40px -22px rgba(20,26,46,.25); border-color: #c9d5f7; }
    .pf-card h3 { font-size: 1.08rem; font-weight: 600; color: var(--ink); }
    .pf-card p { font-size: .88rem; color: var(--ink-soft); line-height: 1.6; }
    .pf-card .tags { display: flex; flex-wrap: wrap; gap: 6px; }
    .pf-card .tags span { font-family: var(--font-head); font-size: .66rem; font-weight: 600; color: var(--teal-deep); background: var(--teal-tint); padding: 3px 9px; border-radius: 999px; }
    .pf-card .more { margin-top: auto; font-size: .82rem; font-weight: 600; color: var(--teal-deep); }
    .pf-card .more span { transition: transform .15s; display: inline-block; }
    .pf-card:hover .more span { transform: translateX(2px); }

    /* Grupos de proyectos por tipo */
    .pf-group { margin-bottom: 36px; }
    .pf-group:last-child { margin-bottom: 0; }
    .pf-group-title { font-family: var(--font-head); font-size: .82rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--teal-deep); margin: 0 0 14px; }

    /* Card destacada (caso de análisis, ancho completo) */
    .pf-card--featured {
      grid-column: 1 / -1;
      flex-direction: row; align-items: center; gap: 24px; padding: 28px;
      background: linear-gradient(135deg, #eef2ff, #f4f6fa);
    }
    .pf-card--featured .body { flex: 1; display: flex; flex-direction: column; gap: 10px; }
    .pf-card--featured h3 { font-size: 1.25rem; }
    .pf-card--featured p { font-size: .92rem; }
    .pf-card--featured .badge-featured {
      font-family: var(--font-head); font-size: .7rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase;
      color: var(--teal-deep); background: #fff; border: 1px solid #c9d5f7; padding: 5px 12px; border-radius: 999px; width: fit-content;
    }
    @media (max-width: 820px) {
      .pf-card--featured { flex-direction: column; align-items: flex-start; }
    }

    /* Skills */
    .pf-skills { border-top: 1px solid var(--line); }
    .pf-skill-row { display: grid; grid-template-columns: 180px 1fr; gap: 2.2rem; padding: 1.15rem 0; border-top: 1px solid var(--line); }
    .pf-skill-row:first-child { border-top: 0; }
    .pf-skill-row .label { font-family: var(--font-head); font-size: .78rem; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--sand-deep); padding-top: .35rem; }
    .pf-skill-row .vals { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
    .pf-skill {
      display: inline-flex; align-items: center; gap: 8px;
      background: #fff; border: 1px solid var(--line); border-radius: 999px;
      padding: 7px 14px; font-size: .85rem; color: var(--ink);
      transition: border-color .15s;
    }
    .pf-skill:hover { border-color: #c7d2fe; }
    .pf-skill .logo {
      width: 16px; height: 16px; flex-shrink: 0; display: inline-block;
    }
    .pf-skill .logo img { width: 100%; height: 100%; display: block; }

    /* CTA final */
    .pf-final { padding: 56px 0 60px; }
    .pf-final .box { background: var(--ink); color: #fff; border-radius: 14px; padding: 48px 36px; text-align: center; }
    .pf-final h2 { font-size: 1.7rem; font-weight: 600; margin-bottom: 10px; }
    .pf-final p { color: #b9b4a6; margin-bottom: 26px; }
    .pf-final .actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 14px; }
    .pf-final .a-solid { background: var(--teal); color: #fff; font-weight: 600; padding: 12px 22px; border-radius: 999px; transition: opacity .15s; }
    .pf-final .a-solid:hover { opacity: .9; }

    .pf-footer { border-top: 1px solid var(--line); padding: 26px 0; text-align: center; font-size: .82rem; color: var(--ink-faint); }

    @media (max-width: 820px) {
      .pf-grid { grid-template-columns: 1fr; }
      .pf-skill-row { grid-template-columns: 1fr; gap: .4rem; }
      .pf-hero { padding-top: 52px; }
    }
  </style>

  <!-- Header -->
  <header class="pf-header">
    <div class="row">
      <div class="pf-brand">Mauricio González<span> · Portfolio</span></div>
      <div class="pf-nav">
        <a class="link" href="#proyectos">{lang === 'es' ? 'Proyectos' : 'Projects'}</a>
        <a class="link" href={`/${lang}/servicios`}>{t.nav.servicios}</a>
        <a class="link" href={`/${lang}/cv`}>{t.nav.cv}</a>
        <a class="pf-toggle" href={altPath}>{altLang.toUpperCase()}</a>
        <button class="pf-cta" data-contact-trigger>{t.contact}</button>
      </div>
    </div>
  </header>

  <main>
    <!-- Hero -->
    <section class="pf-hero">
      <div class="wrap">
        <div class="pf-badges">
          <span>{years}+ {lang === 'es' ? 'años de experiencia' : 'years of experience'}</span>
          <span>{lang === 'es' ? 'IA en producción (RENAPER/AWS Rekognition)' : 'AI in production (RENAPER/AWS Rekognition)'}</span>
          <span>{lang === 'es' ? 'Docente en Ciencia de Datos e IA' : 'Instructor in Data Science & AI'}</span>
        </div>
        <h1 set:html={headline}></h1>
        <p class="sub">{content.hero.subheadline}</p>
        <div class="pf-trusted">
          <span class="lbl">{lang === 'es' ? 'Proyectos para' : 'Projects for'}</span>
          <span class="cl">Coca-Cola Embonor</span>
          <span class="cl">{lang === 'es' ? 'Renaseg (SSN)' : 'Renaseg (SSN)'}</span>
          <span class="cl">{lang === 'es' ? 'Agencia de Sistemas de Información' : 'Information Systems Agency'}</span>
        </div>
        <div class="actions">
          <a class="pf-btn-solid" href="#proyectos">{lang === 'es' ? 'Ver proyectos' : 'View projects'}</a>
          <button class="pf-btn-ghost" data-contact-trigger>{lang === 'es' ? 'Contactar' : 'Contact'}</button>
        </div>
        <hr class="rule" />
      </div>
    </section>

    <!-- Proyectos -->
    <section class="pf-section" id="proyectos">
      <div class="wrap">
        <div class="eyebrow"><span class="num">01</span><span class="label">{t.projectsLabel}</span></div>
        <p style="color:var(--ink-soft);max-width:62ch;margin-bottom:1.6rem">{content.projectsDescription}</p>
        {projectGroups.map((group) => (
          <div class="pf-group">
            <h3 class="pf-group-title">{group.label}</h3>
            <div class="pf-grid">
              {group.items.map((project) => {
                const p = projectsT[project.id];
                const profile = project.profiles['engineer'];
                const title = p?.title || project.id;
                const shortDescription = p?.shortDescription || p?.profiles?.engineer?.description || '';
                const caseStudyUrl = caseStudyUrls[project.id] ? `/${lang}${caseStudyUrls[project.id]}` : null;
                const isFeaturedCard = project.category === 'analisis';
                return (
                  <div class:list={['pf-card', isFeaturedCard && 'pf-card--featured']} data-case={project.id} data-case-full={caseStudyUrl || ''}>
                    <div class="body">
                      {isFeaturedCard && <span class="badge-featured">{lang === 'es' ? 'Caso de estudio · 14 capítulos' : 'Case study · 14 chapters'}</span>}
                      <h3>{title}</h3>
                      <p>{shortDescription}</p>
                      <div class="tags">
                        {profile.tags.map((tag: string) => <span>{tag}</span>)}
                      </div>
                      <div class="more">{lang === 'es' ? 'Ver resumen' : 'View summary'} <span>→</span></div>
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Skills -->
    <section class="pf-section" id="skills">
      <div class="wrap">
        <div class="eyebrow"><span class="num">02</span><span class="label">{lang === 'es' ? 'Stack técnico' : 'Tech stack'}</span></div>
        <div class="pf-skills">
          {skillGroups.map((group) => (
            <div class="pf-skill-row">
              <div class="label">{group.label}</div>
              <div class="vals">
                {group.items.map((item) => (
                  <span class="pf-skill">
                    {item.slug && (
                      <span class="logo">
                        <img src={`https://cdn.jsdelivr.net/npm/simple-icons@latest/icons/${item.slug}.svg`} alt="" width="16" height="16" loading="lazy" />
                      </span>
                    )}
                    {item.name}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA final -->
    <section class="pf-final">
      <div class="wrap">
        <div class="box">
          <h2>{content.ctaTitle}</h2>
          <p>{content.ctaDescription}</p>
          <div class="actions">
            <button class="a-solid" data-contact-trigger>{lang === 'es' ? 'Contactar' : 'Contact'}</button>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="pf-footer">
    <div class="wrap">© 2026 Mauricio González — Software Engineer · IA &amp; Automatización</div>
  </footer>

  <CaseStudyModal lang={lang} cases={modalCases} labels={modalLabels} />
  <ContactModal lang={lang} />

  <script is:inline>
    document.addEventListener('click', function (e) {
      var card = e.target.closest('.pf-card[data-case]');
      if (!card) return;
      e.preventDefault();
      window.openCaseModal(card.getAttribute('data-case'), card.getAttribute('data-case-full'));
    });
  </script>
</BaseTailwind>
