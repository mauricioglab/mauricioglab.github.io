---
// src/pages/extensions.astro
import BaseTailwind from '../../layouts/BaseTailwind.astro';
import extensionsData from '../../utils/build-extensions';

export const prerender = true;
---
<BaseTailwind title="Extensiones Chrome y Firefox" description="Mis extensiones">
    <main class="bg-[#f4f6fa] py-8 px-5">
        <div class="max-w-4xl mx-auto">

            <div class="mb-6">
                <h1 class="text-2xl font-semibold tracking-tight text-[#141a2e] mb-1">
                    Extensiones Chrome y Firefox
                </h1>
                <p class="text-[#5c6785] text-sm">
                    {extensionsData.length} extensiones disponibles
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                {extensionsData.map((ext: any) => (
                    <div class="bg-white rounded-lg p-4 border border-[#e4e8f0] hover:border-blue-300 hover:shadow-md transition-all duration-200">
                        <div class="flex items-start justify-between mb-2 gap-2">
                            <h3 class="text-sm font-semibold text-[#141a2e] leading-tight">
                                {ext.name}
                            </h3>
                            <div class="flex flex-col items-end gap-1 shrink-0">
                                <span class="text-[0.65rem] text-[#5c6785] bg-[#f4f6fa] px-1.5 py-0.5 rounded">
                                    v{ext.version}
                                </span>
                                {ext.size && (
                                    <span class="text-[0.65rem] text-[#1e40af] bg-[#eef2ff] px-1.5 py-0.5 rounded font-medium">
                                        {ext.size}
                                    </span>
                                )}
                            </div>
                        </div>

                        <p class="text-xs text-[#5c6785] mb-3 leading-relaxed line-clamp-3">
                            {ext.description}
                        </p>

                        <a
                            href={ext.downloadUrl}
                            download
                            class="inline-flex items-center gap-1.5 bg-[#1e40af] text-white px-3 py-1.5 rounded-md text-xs hover:bg-[#1d4ed8] transition-colors w-full justify-center"
                        >
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                            </svg>
                            Descargar ZIP
                        </a>
                    </div>
                ))}
            </div>

            <!-- Link a instrucciones -->
            <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-3">
                <div class="bg-[#eef2ff] border border-[#c7d2fe] rounded-lg p-4 text-center">
                    <p class="text-xs text-[#1e40af] mb-2">
                        ¿Primera vez instalando una extensión de Chrome en modo desarrollador?
                    </p>
                    <a
                        href="https://support.google.com/chrome/a/answer/2714278?hl=es"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-1.5 text-[#1e40af] hover:text-[#1d4ed8] font-medium text-xs transition-colors"
                    >
                        Ver guía oficial de Google Chrome
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                        </svg>
                    </a>
                </div>
                <div class="bg-[#fff7ed] border border-[#fed7aa] rounded-lg p-4 text-center">
                    <p class="text-xs text-[#c2410c] mb-2">
                        ¿Instalando en Firefox? La extensión se carga como complemento temporal desde about:debugging.
                    </p>
                    <a
                        href="https://extensionworkshop.com/documentation/develop/temporary-installation-in-firefox/"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-1.5 text-[#c2410c] hover:text-[#9a3412] font-medium text-xs transition-colors"
                    >
                        Ver guía oficial de Firefox
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                        </svg>
                    </a>
                </div>
            </div>
        </div>
    </main>
</BaseTailwind>
