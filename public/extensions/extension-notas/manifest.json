{
  "manifest_version": 2,
  "name": "Notas",
  "description": "Trasladá notas desde Teams a Autogestión en un clic.",
  "version": "1.4",
  "browser_specific_settings": {
    "gecko": {
      "id": "notas-ext@mglab",
      "strict_min_version": "91.0"
    }
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "https://teams.microsoft.com/*",
    "https://teams.cloud.microsoft/*",
    "https://*.edu.cloud.microsoft/*",
    "https://assignments.edu.cloud.microsoft/*",
    "*://*/autog/*"
  ],
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
