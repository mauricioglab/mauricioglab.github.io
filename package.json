{
  "name": "mglab-spa-depot",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "images:optimize": "node src/utils/resize-blog-images.js",
    "dev": "npm run images:optimize && astro dev",
    "dev:personal": "cross-env SITE_TARGET=personal npm run dev -- --port 4321",
    "dev:company": "cross-env SITE_TARGET=company npm run dev -- --port 4322",
    "build": "npm run images:optimize && astro build",
    "build:personal": "cross-env SITE_TARGET=personal npm run build",
    "build:company": "cross-env SITE_TARGET=company npm run build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "@astrojs/markdown-remark": "^6.3.10",
    "@astrojs/preact": "^4.1.0",
    "@astrojs/rss": "^4.0.15",
    "@astrojs/sitemap": "^3.7.4",
    "@preact/signals": "^2.11.2",
    "astro": "^5.16.15",
    "preact": "^10.29.8",
    "shiki": "^3.21.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/tailwind": "^6.0.2",
    "@types/node": "^25.0.10",
    "cross-env": "^10.1.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  }
}
